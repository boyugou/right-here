    "app.agentCommandHelp": {
      "comment": "Caption under the command field. A flag is a command-line option such as --model.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُكتب في الوحدة الطرفية لتشغيل الوكيل. ويمكن إضافة خيارات بعد الأمر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এজেন্ট শুরু করতে এটি টার্মিনালে টাইপ করা হয়। কমান্ডের পরে ফ্ল্যাগ দেওয়া যায়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird im Terminal eingegeben, um den Agenten zu starten. Hinter dem Befehl können Flags stehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πληκτρολογείται στο τερματικό για να ξεκινήσει ο πράκτορας. Μετά την εντολή μπορούν να ακολουθούν σημαίες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Typed into the terminal to start the agent. Flags can follow the command."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se escribe en la terminal para iniciar el agente. Después del comando pueden ir opciones."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای شروع عامل، در ترمینال تایپ می‌شود. گزینه‌ها می‌توانند بعد از دستور بیایند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisie dans le terminal pour démarrer l’agent. Des options peuvent suivre la commande."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מוקלדת במסוף כדי להפעיל את הסוכן. אחרי הפקודה אפשר לכתוב דגלים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एजेंट शुरू करने के लिए टर्मिनल में टाइप किया जाता है। कमांड के बाद फ़्लैग भी लिखे जा सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diketik di terminal untuk memulai agen. Opsi bisa ditulis setelah perintah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viene digitato nel terminale per avviare l’agente. Dopo il comando si possono aggiungere delle opzioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントを起動するために、ターミナルへ入力されます。コマンドの後にオプションを続けられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트를 시작할 때 터미널에 입력하는 명령입니다. 명령 뒤에 옵션을 붙일 수 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एजंट सुरू करण्यासाठी टर्मिनलमध्ये टाइप केले जाते. कमांडनंतर फ्लॅग देता येतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditaip ke dalam terminal untuk memulakan ejen. Bendera boleh diletakkan selepas perintah."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt in de terminal getypt om de agent te starten. Vlaggen kunnen na het commando volgen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisywane w terminalu, aby uruchomić agenta. Po poleceniu można dodać flagi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digitado no terminal para iniciar o agente. Flags podem vir depois do comando."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se scrie în terminal pentru a porni agentul. După comandă pot urma opțiuni."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вводится в терминал, чтобы запустить агента. После команды можно указать флаги."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முகவரைத் தொடங்க டெர்மினலில் தட்டச்சு செய்யப்படுகிறது. கட்டளைக்குப் பின் கொடிகளையும் சேர்க்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఏజెంట్‌ను ప్రారంభించడానికి టెర్మినల్‌లో టైప్ చేయబడుతుంది. ఆదేశం తర్వాత ఫ్లాగ్‌లను కూడా చేర్చవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำสั่งนี้จะถูกพิมพ์ลงในเทอร์มินัลเพื่อเริ่มเอเจนต์ และต่อท้ายด้วยแฟล็กได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajanı başlatmak için terminale yazılır. Komuttan sonra bayraklar da eklenebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вводиться в термінал, щоб запустити агента. Після команди можна додати параметри."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایجنٹ شروع کرنے کے لیے ٹرمینل میں ٹائپ کیا جاتا ہے۔ فلیگز کمانڈ کے بعد لکھے جا سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Được gõ vào terminal để khởi chạy tác tử. Các cờ có thể đặt sau lệnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "命令会输入到终端中以启动智能体。标志可以放在命令后面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "指令會輸入到終端機中以啟動代理程式。旗標可以接在指令後面。"
          }
        }
      }
    },
    "app.agentCommandReset": {
