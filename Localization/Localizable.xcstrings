    "app.mcpCopied": {
      "comment": "Confirmation after the button app.copyMCPConfig was pressed.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم نسخ إعدادات MCP. الصقها في إعدادات MCP لدى مساعدك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "MCP কনফিগারেশন কপি হয়েছে। আপনার সহকারীর MCP সেটিংসে এটি পেস্ট করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MCP-Konfiguration kopiert. Füge sie in die MCP-Einstellungen deines Assistenten ein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι ρυθμίσεις MCP αντιγράφηκαν. Επικολλήστε τις στις ρυθμίσεις MCP του βοηθού σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MCP configuration copied. Paste it into your assistant's MCP settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configuración de MCP copiada. Pégala en los ajustes de MCP de tu asistente."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیکربندی MCP کپی شد. آن را در تنظیمات MCP دستیار خود جای‌گذاری کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configuration MCP copiée. Collez-la dans les réglages MCP de votre assistant."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תצורת ה-MCP הועתקה. יש להדביק אותה בהגדרות ה-MCP של העוזר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "MCP कॉन्फ़िगरेशन कॉपी हो गई। इसे अपने AI असिस्टेंट की MCP सेटिंग में पेस्ट करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurasi MCP disalin. Tempelkan ke pengaturan MCP asisten Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurazione MCP copiata. Incollala nelle impostazioni MCP del tuo assistente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MCP の設定をコピーしました。AIアシスタントの MCP 設定にペーストしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MCP 설정을 복사했습니다. 어시스턴트의 MCP 설정에 붙여넣으십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "MCP कॉन्फिगरेशन कॉपी झाले. ते तुमच्या असिस्टंटच्या MCP सेटिंग्जमध्ये पेस्ट करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurasi MCP telah disalin. Tampalkannya dalam seting MCP pembantu anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "MCP-configuratie gekopieerd. Plak die in de MCP-instellingen van je assistent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skopiowano konfigurację MCP. Wklej ją w ustawieniach MCP asystenta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Configuração MCP copiada. Cole-a nas configurações MCP do seu assistente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurația MCP a fost copiată. Lipiți-o în configurările MCP ale asistentului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Конфигурация MCP скопирована. Вставьте ее в настройки MCP ассистента."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "MCP உள்ளமைவு நகலெடுக்கப்பட்டது. அதை உங்கள் உதவியாளரின் MCP அமைப்புகளில் ஒட்டவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "MCP కాన్ఫిగరేషన్ కాపీ చేయబడింది. దాన్ని మీ సహాయకుడి MCP సెట్టింగ్లలో అతికించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คัดลอกการกำหนดค่า MCP แล้ว วางลงในการตั้งค่า MCP ของผู้ช่วยของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "MCP yapılandırması kopyalandı. Bunu asistanınızın MCP ayarlarına yapıştırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Конфігурацію MCP скопійовано. Вставте її в налаштування MCP вашого асистента."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "‏MCP کنفیگریشن کاپی ہو گئی۔ اسے اپنے اسسٹنٹ کی MCP سیٹنگز میں پیسٹ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã sao chép cấu hình MCP. Hãy dán vào phần cài đặt MCP của trợ lý."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已拷贝 MCP 配置。请将其粘贴到助手的 MCP 设置中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已拷貝 MCP 設定。請將其貼到助理的 MCP 設定中。"
          }
        }
      }
    },
    "app.menuAdd": {
