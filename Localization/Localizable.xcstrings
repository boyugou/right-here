    "app.worktreesIntro": {
      "comment": "Text at the top of the Worktrees section of the setup window. The command between backticks stays exactly as it is.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "نسخ عمل منفصلة يُنشئها `rh run --worktree`، ليتمكن وكيل من العمل على فرع خاص به."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আলাদা চেকআউট, যেগুলো `rh run --worktree` তৈরি করে, যাতে কোনো এজেন্ট নিজের একটি ব্রাঞ্চে কাজ করতে পারে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Getrennte Arbeitskopien, die `rh run --worktree` anlegt, damit ein Agent an einem eigenen Branch arbeiten kann."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ξεχωριστά αντίγραφα εργασίας που δημιουργεί το `rh run --worktree`, ώστε ένας πράκτορας να μπορεί να εργάζεται σε δικό του κλάδο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Separate checkouts that `rh run --worktree` makes, so that an agent can work on a branch of its own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Copias de trabajo separadas que crea `rh run --worktree`, para que un agente pueda trabajar en una rama propia."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "نسخه‌های کاری جداگانه‌ای که `rh run --worktree` می‌سازد، تا یک عامل هوش مصنوعی بتواند روی شاخهٔ خودش کار کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Copies de travail séparées créées par `rh run --worktree`, pour qu’un agent puisse travailler sur sa propre branche."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "עותקי עבודה נפרדים שנוצרים על ידי `rh run --worktree`, כך שסוכן AI יוכל לעבוד על ענף משלו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अलग-अलग वर्किंग कॉपी जो `rh run --worktree` बनाता है, ताकि कोई AI एजेंट अपनी एक अलग ब्रांच पर काम कर सके।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salinan kerja terpisah yang dibuat oleh `rh run --worktree`, agar agen dapat bekerja pada branch-nya sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Checkout separati creati con `rh run --worktree`, così un agente può lavorare su un branch proprio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "`rh run --worktree` が作る独立したチェックアウトです。エージェントはそれぞれ専用のブランチで作業できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "에이전트가 자체 브랜치에서 작업할 수 있도록 `rh run --worktree`가 만드는 별도의 체크아웃입니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "`rh run --worktree` ने तयार केलेले वेगळे चेकआउट, जेणेकरून एखादा एजंट स्वतःच्या ब्रांचवर काम करू शकेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Checkout berasingan yang dibuat oleh `rh run --worktree`, supaya ejen boleh bekerja pada cawangannya sendiri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Afzonderlijke werkkopieën die `rh run --worktree` maakt, zodat een agent op een eigen branch kan werken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Osobne kopie robocze, które tworzy `rh run --worktree`, dzięki czemu agent może pracować na własnej gałęzi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cópias separadas que `rh run --worktree` cria, para que um agente possa trabalhar em uma branch própria."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Copii de lucru separate, create de `rh run --worktree`, pentru ca un agent să poată lucra pe o ramură proprie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Отдельные рабочие копии, которые создает `rh run --worktree`, чтобы агент мог работать в собственной ветке."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "`rh run --worktree` உருவாக்கும் தனிப் பிரதிகள்; இதனால் ஒரு முகவர் தனக்கென ஒரு branch-இல் வேலை செய்ய முடியும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "needs_review",
            "value": "`rh run --worktree` తయారు చేసే వేర్వేరు చెక్అవుట్లు; తద్వారా ఒక ఏజెంట్ తనకంటూ ఒక బ్రాంచ్లో పని చేయగలదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "สำเนาทำงานแยกที่ `rh run --worktree` สร้างขึ้น เพื่อให้เอเจนต์ทำงานบน branch ของตัวเองได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "`rh run --worktree` komutunun oluşturduğu ayrı çalışma kopyaları; böylece bir ajan kendi dalında çalışabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Окремі робочі копії, які створює `rh run --worktree`, щоб агент міг працювати на власній гілці."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "وہ الگ چیک آؤٹ جو `rh run --worktree` بناتا ہے، تاکہ کوئی AI ایجنٹ اپنی ایک الگ برانچ پر کام کر سکے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Các bản sao làm việc riêng do `rh run --worktree` tạo ra, để tác tử AI có thể làm việc trên một nhánh riêng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "由 `rh run --worktree` 创建的独立检出副本，让 AI 智能体可以在自己的分支上工作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "由 `rh run --worktree` 建立的獨立檢出副本，讓 AI 代理程式可以在自己的分支上作業。"
          }
        }
      }
    },
    "app.worktreesNoRepository": {
      "comment": "Text in the Worktrees section of the setup window when none of the pinned and recent folders is in a git repository and none was chosen.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يوجد مستودع git لعرضه بعد. ثبّت مجلداً موجوداً داخل أحد المستودعات، أو اختر مجلداً."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "দেখানোর মতো কোনো git রিপোজিটরি এখনও নেই। এমন একটি ফোল্ডার পিন করুন যেটি একটির ভেতরে আছে, অথবা একটি ফোল্ডার বেছে নিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Noch kein Git-Repository zum Anzeigen. Pinne einen Ordner an, der in einem liegt, oder wähle einen Ordner aus."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Δεν υπάρχει ακόμη αποθετήριο git για εμφάνιση. Καρφιτσώστε έναν φάκελο που βρίσκεται σε ένα τέτοιο, ή επιλέξτε έναν φάκελο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No git repository to show yet. Pin a folder that is in one, or choose a folder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Todavía no hay ningún repositorio de git que mostrar. Fija una carpeta que esté en uno, o elige una carpeta."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "هنوز مخزن git برای نمایش وجود ندارد. پوشه‌ای را که داخل یک مخزن است سنجاق کنید یا پوشه‌ای را انتخاب کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aucun dépôt git à afficher pour l’instant. Épinglez un dossier qui se trouve dans un dépôt, ou choisissez un dossier."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "אין עדיין מאגר git להצגה. יש להצמיד תיקיה שנמצאת במאגר כזה, או לבחור תיקיה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "दिखाने के लिए अभी कोई git रिपॉज़िटरी नहीं है। किसी ऐसे फ़ोल्डर को पिन करें जो एक रिपॉज़िटरी के अंदर हो, या कोई फ़ोल्डर चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Belum ada repositori git yang bisa ditampilkan. Sematkan folder yang berada di dalam repositori, atau pilih folder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nessun repository git da mostrare per ora. Fissa una cartella che si trova in un repository, oppure scegline una."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "表示できる git リポジトリはまだありません。リポジトリ内のフォルダを固定するか、フォルダを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "표시할 git 저장소가 아직 없습니다. 저장소 안에 있는 폴더를 고정하거나 폴더를 선택하십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अजून दाखवण्यासाठी git रेपॉझिटरी नाही. रेपॉझिटरीमध्ये असलेला फोल्डर पिन करा, किंवा फोल्डर निवडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tiada repositori git untuk dipaparkan lagi. Pinkan folder yang berada dalam repositori, atau pilih folder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nog geen git-repository om te tonen. Maak een map vast die in een repository staat, of kies een map."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie ma jeszcze repozytorium git do pokazania. Przypnij folder, który znajduje się w repozytorium, albo wybierz folder."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ainda não há repositório git para mostrar. Fixe uma pasta que esteja em um, ou escolha uma pasta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Încă nu există un depozit git de afișat. Fixați un dosar care se află într-unul sau alegeți un dosar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Пока нет репозитория git для показа. Закрепите папку, которая находится в репозитории, или выберите папку."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "காட்டுவதற்கு இன்னும் git repository எதுவும் இல்லை. அதற்குள் உள்ள ஒரு கோப்புறையைப் பின் செய்யுங்கள், அல்லது ஒரு கோப்புறையைத் தேர்ந்தெடுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "needs_review",
            "value": "చూపించడానికి ఇంకా git repository లేదు. అందులో ఉన్న ఫోల్డర్ను పిన్ చేయండి, లేదా ఒక ఫోల్డర్ను ఎంచుకోండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ยังไม่มีรีโพซิทอรี git ให้แสดง ปักหมุดโฟลเดอร์ที่อยู่ในรีโพซิทอรีหนึ่ง หรือเลือกโฟลเดอร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Henüz gösterilecek git deposu yok. Deponun içindeki bir klasörü sabitleyin veya bir klasör seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Поки що немає git-репозиторію для показу. Закріпіть папку, що належить до нього, або виберіть папку."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ابھی دکھانے کے لیے کوئی git ریپازٹری نہیں ہے۔ کسی ایسے فولڈر کو پن کریں جو ریپازٹری میں ہو، یا کوئی فولڈر منتخب کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chưa có kho git nào để hiển thị. Hãy ghim một thư mục nằm trong kho git, hoặc chọn một thư mục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "还没有可显示的 git 仓库。请固定一个位于仓库中的文件夹，或选择一个文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "尚無可顯示的 git 儲存庫。請釘選一個位於儲存庫中的檔案夾，或選擇一個檔案夾。"
          }
        }
      }
    },
