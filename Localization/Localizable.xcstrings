    "doctor.config.symlink": {
      "comment": "Extra line under a check in the setup window's Details list; it adds to the detail line. %@ is a file name (config.toml). The Finder extension runs in a sandbox and cannot always read through a symbolic link.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "‏%@ رابط رمزي، وقد لا يتمكن وضع الحماية الخاص بملحق فايندر من اتباعه"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ একটি সিমলিংক, যা Finder এক্সটেনশনের স্যান্ডবক্স হয়তো অনুসরণ করতে পারবে না"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ ist ein symbolischer Link, dem die Sandbox der Finder-Erweiterung möglicherweise nicht folgen kann"
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "το %@ είναι συμβολικός σύνδεσμος, τον οποίο ίσως δεν μπορεί να ακολουθήσει το sandbox της επέκτασης του Finder"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is a symlink, which the Finder extension's sandbox may not be able to follow"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ es un enlace simbólico, y es posible que el sandbox de la extensión del Finder no pueda seguirlo"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "‏%@ یک پیوند نمادین است و ممکن است محیط ایزولهٔ افزونهٔ Finder نتواند آن را دنبال کند"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ est un lien symbolique, que le bac à sable de l’extension du Finder ne peut pas toujours suivre"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "‏%@ הוא קישור סמלי, ואולי ארגז החול של הרחבת Finder לא יוכל לעקוב אחריו"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ एक सिमलिंक है, जिसे Finder एक्सटेंशन का सैंडबॉक्स शायद फ़ॉलो न कर पाए"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ adalah symlink, yang mungkin tidak dapat diikuti oleh sandbox ekstensi Finder"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ è un link simbolico, che la sandbox dell’estensione del Finder potrebbe non riuscire a seguire"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ はシンボリックリンクのため、Finder 機能拡張のサンドボックスでたどれない場合があります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@은(는) 심볼릭 링크이므로 Finder 확장 프로그램의 샌드박스가 따라가지 못할 수 있음"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ सिम्लिंक आहे; Finder एक्सटेंशनचा सँडबॉक्स कदाचित सिम्लिंकचे अनुसरण करू शकणार नाही"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ ialah pautan simbolik; sandbox sambungan Finder mungkin tidak dapat mengikutinya"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ is een symlink, die de sandbox van de Finder-extensie mogelijk niet kan volgen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ to dowiązanie symboliczne; rozszerzenie Findera działające w piaskownicy może nie mieć do niego dostępu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ é um link simbólico, que o sandbox da extensão do Finder pode não conseguir seguir"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ este un link simbolic, pe care sandboxul extensiei Finder s-ar putea să nu-l poată urma"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ — символическая ссылка, по которой песочница расширения Finder может не суметь перейти"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ ஒரு symlink; Finder நீட்டிப்பின் sandbox ஆல் அதைப் பின்தொடர முடியாமல் போகலாம்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ ఒక symlink; దాన్ని Finder ఎక్స్‌టెన్షన్ యొక్క sandbox అనుసరించలేకపోవచ్చు"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ เป็น symlink ซึ่งส่วนขยายของ Finder อาจตามไปไม่ได้ในแซนด์บ็อกซ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ bir sembolik bağlantı; Finder genişletmesinin sandbox ortamı bunu izleyemeyebilir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ є символічним посиланням, за яким пісочниця розширення Finder може не змогти перейти"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "‏%@ ایک سمبولک لنک ہے، جسے Finder ایکسٹینشن کا سینڈ باکس شاید فالو نہ کر سکے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ là liên kết tượng trưng, mà hộp cát của phần mở rộng Finder có thể không theo được"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 是符号链接，访达扩展的沙盒可能无法跟随该链接"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 是符號連結，Finder 延伸功能的沙箱可能無法追蹤該連結"
          }
        }
      }
    },
