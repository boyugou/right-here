    "refusal.unknownTerminal": {
      "comment": "Why an action did nothing, shown in the alert after a click in Finder (and, in English, by the command line). %@ is a terminal id. default, link and desktop are words of the config: keep them in English.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وحدة طرفية غير معروفة «%@». شغّل `rh apps` لعرض قائمة الوحدات الطرفية؛ ويمكن أيضًا تشغيل الوكيل بواسطة default أو link أو desktop."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অজানা টার্মিনাল “%@”। টার্মিনালগুলোর তালিকা দেখতে `rh apps` চালান; কোনো এজেন্টকে default, link বা desktop দিয়েও শুরু করা যায়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unbekanntes Terminal „%@“. Führe `rh apps` aus, um die Terminals aufzulisten; ein Agent kann außerdem über default, link oder desktop gestartet werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άγνωστο τερματικό «%@». Εκτελέστε `rh apps` για να δείτε τη λίστα των τερματικών· ο τρόπος εκκίνησης ενός πράκτορα μπορεί επίσης να είναι default, link ή desktop."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unknown terminal \"%@\". Run `rh apps` to list them; an agent's launcher can also be default, link or desktop."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal desconocida «%@». Ejecuta `rh apps` para ver la lista de terminales; un agente también se puede iniciar con default, link o desktop."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ترمینال ناشناخته «%@». برای دیدن فهرست ترمینال‌ها `rh apps` را اجرا کنید؛ یک عامل را می‌توان با default، link یا desktop هم اجرا کرد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal inconnu « %@ ». Exécutez `rh apps` pour afficher la liste des terminaux ; un agent peut aussi être lancé avec default, link ou desktop."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מסוף לא מוכר ״%@״. כדי להציג את רשימת המסופים יש להריץ את `rh apps`; דרך ההפעלה של סוכן יכולה להיות גם default, link או desktop."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अज्ञात टर्मिनल “%@”। टर्मिनलों की सूची देखने के लिए `rh apps` चलाएँ; एजेंट को default, link या desktop से भी शुरू किया जा सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal tidak dikenal “%@”. Jalankan `rh apps` untuk melihat daftar terminal; agen juga dapat dijalankan dengan default, link, atau desktop."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminale “%@” sconosciuto. Esegui `rh apps` per elencarli; per avviare un agente puoi indicare anche default, link o desktop."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不明なターミナル「%@」です。`rh apps` を実行すると一覧を表示できます。エージェントの起動方法には default、link、desktop も指定できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알 수 없는 터미널 “%@”입니다. `rh apps` 명령을 실행하면 목록을 볼 수 있습니다. 에이전트를 시작하는 방법으로 default, link, desktop도 지정할 수 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अज्ञात टर्मिनल “%@”. त्यांची यादी पाहण्यासाठी `rh apps` चालवा; एजंट सुरू करण्यासाठी default, link किंवा desktop देखील देता येते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal “%@” tidak dikenali. Jalankan `rh apps` untuk menyenaraikannya; ejen juga boleh dimulakan dengan default, link atau desktop."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onbekende terminal „%@”. Voer `rh apps` uit om ze te tonen; een agent kan ook worden gestart met default, link of desktop."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieznany terminal „%@”. Uruchom `rh apps`, aby wyświetlić ich listę; jako sposób uruchamiania agenta można też podać default, link lub desktop."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal “%@” desconhecido. Execute `rh apps` para listá-los; um agente também pode ser iniciado com default, link ou desktop."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal necunoscut: „%@”. Rulați `rh apps` pentru a le afișa; un agent poate fi pornit și cu default, link sau desktop."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неизвестный терминал «%@». Выполните `rh apps`, чтобы увидеть их список; агента также можно запускать через default, link или desktop."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” என்பது அறியப்படாத டெர்மினல். அவற்றைப் பட்டியலிட `rh apps` ஐ இயக்கவும்; ஒரு முகவரைத் தொடங்கும் முறை default, link அல்லது desktop ஆகவும் இருக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” అనేది తెలియని టెర్మినల్. వాటి జాబితా కోసం `rh apps` రన్ చేయండి; ఏజెంట్‌ను ప్రారంభించే విధానం default, link లేదా desktop కూడా కావచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่รู้จักเทอร์มินัล “%@” เรียกใช้ `rh apps` เพื่อดูรายการเทอร์มินัล ส่วนวิธีเริ่มเอเจนต์ยังเป็น default, link หรือ desktop ได้ด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilinmeyen terminal: “%@”. Terminalleri listelemek için `rh apps` komutunu çalıştırın; bir ajanın başlatılma biçimi default, link veya desktop da olabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Невідомий термінал «%@». Виконайте `rh apps`, щоб побачити список терміналів; спосіб запуску агента також може бути default, link або desktop."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نامعلوم ٹرمینل “%@”۔ ٹرمینلز کی فہرست کے لیے `rh apps` چلائیں؛ ایجنٹ کو شروع کرنے کا طریقہ default، link یا desktop بھی ہو سکتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal “%@” không xác định. Chạy `rh apps` để liệt kê các terminal; cách khởi chạy của tác tử cũng có thể là default, link hoặc desktop."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未知的终端“%@”。运行 `rh apps` 可列出所有终端；智能体的启动方式也可以是 default、link 或 desktop。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未知的終端機「%@」。執行 `rh apps` 可列出所有終端機；代理程式的啟動方式也可以是 default、link 或 desktop。"
          }
        }
      }
    },
    "refusal.unknownVariant": {
      "comment": "Why an action did nothing, shown in the alert after a click in Finder (and, in English, by the command line). %1$@ is an agent id, %2$@ a variant id.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليس لدى الوكيل «%1$@» خيار تشغيل باسم «%2$@»."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এজেন্ট “%1$@”-এর “%2$@” নামে কোনো শুরুর বিকল্প নেই।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Agent „%1$@“ hat keine Startoption „%2$@“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο πράκτορας «%1$@» δεν έχει επιλογή εκκίνησης «%2$@»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent \"%1$@\" has no variant \"%2$@\"."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El agente «%1$@» no tiene la opción de inicio «%2$@»."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "عامل «%1$@» گزینهٔ شروعی به نام «%2$@» ندارد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’agent « %1$@ » n’a pas d’option de démarrage « %2$@ »."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לסוכן ״%1$@״ אין אפשרות הפעלה ״%2$@״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एजेंट “%1$@” में शुरू करने का विकल्प “%2$@” नहीं है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Agen “%1$@” tidak memiliki opsi mulai “%2$@”."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’agente “%1$@” non ha l’opzione di avvio “%2$@”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェント「%1$@」には起動オプション「%2$@」がありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트 “%1$@”에는 “%2$@” 시작 옵션이 없습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एजंट “%1$@” कडे “%2$@” हा सुरुवातीचा पर्याय नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejen “%1$@” tiada pilihan permulaan “%2$@”."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent „%1$@” heeft geen startoptie „%2$@”."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent „%1$@” nie ma opcji uruchamiania „%2$@”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O agente “%1$@” não tem a opção de início “%2$@”."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Agentul „%1$@” nu are opțiunea de pornire „%2$@”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У агента «%1$@» нет параметра запуска «%2$@»."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” முகவருக்கு “%2$@” என்ற தொடக்க விருப்பம் இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” ఏజెంట్‌కు “%2$@” అనే ప్రారంభ ఎంపిక లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอเจนต์ “%1$@” ไม่มีตัวเลือกการเริ่มต้น “%2$@”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” adlı ajanın “%2$@” adlı bir başlatma seçeneği yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Агент «%1$@» не має параметра запуску «%2$@»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایجنٹ “%1$@” کے پاس “%2$@” نام کا شروع کرنے کا کوئی اختیار نہیں ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tác tử “%1$@” không có tùy chọn khởi chạy “%2$@”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体“%1$@”没有名为“%2$@”的启动选项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代理程式「%1$@」沒有名為「%2$@」的啟動選項。"
          }
        }
      }
    },
    "refusal.unreadable": {
      "comment": "Why an action did nothing, shown in the alert after a click in Finder (and, in English, by the command line). %@ is a path. Name the places in System Settings as macOS names them in this language (as alert.permissionMessage does for Automation); for a language macOS does not ship, keep the English names.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يسمح macOS لتطبيق Right Here بالاطلاع على %@، لذا لا يمكنه معرفة ما إذا كان مجلدًا. اسمح بالوصول إلى هذا المجلد من إعدادات النظام › الخصوصية والأمن › الملفات والمجلدات (أو الوصول الكامل إلى القرص)، ثم حاول مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS Right Here-কে %@ দেখতে দেয়নি, তাই এটি ফোল্ডার কি না তা বোঝা যাচ্ছে না। System Settings › Privacy & Security › Files & Folders-এ (অথবা Full Disk Access-এ) ওই ফোল্ডারে অ্যাক্সেসের অনুমতি দিন, তারপর আবার চেষ্টা করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS hat Right Here nicht erlaubt, %@ anzusehen, daher lässt sich nicht feststellen, ob es ein Ordner ist. Erlaube den Zugriff auf diesen Ordner unter Systemeinstellungen › Datenschutz & Sicherheit › Dateien & Ordner (oder Festplattenvollzugriff) und versuche es dann erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το macOS δεν επέτρεψε στο Right Here να δει το %@, οπότε δεν μπορεί να καταλάβει αν είναι φάκελος. Επιτρέψτε την πρόσβαση σε αυτόν τον φάκελο στις Ρυθμίσεις συστήματος › Απόρρητο και ασφάλεια › Αρχεία και φάκελοι (ή Πλήρης πρόσβαση στον δίσκο) και δοκιμάστε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS did not let Right Here look at %@, so it cannot tell whether it is a folder. Allow access to that folder under System Settings, Privacy & Security, Files & Folders (or Full Disk Access), then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS no permitió que Right Here viera %@, así que no puede saber si es una carpeta. Permite el acceso a esa carpeta en Ajustes del Sistema › Privacidad y seguridad › Archivos y carpetas (o Acceso total al disco) y vuelve a intentarlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "‏macOS به Right Here اجازه نداد %@ را ببیند، بنابراین نمی‌تواند تشخیص دهد که پوشه است یا نه. در System Settings › Privacy & Security › Files & Folders (یا Full Disk Access) اجازهٔ دسترسی به آن پوشه را بدهید و دوباره تلاش کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS n’a pas autorisé Right Here à examiner %@, il ne peut donc pas savoir s’il s’agit d’un dossier. Autorisez l’accès à ce dossier dans Réglages Système › Confidentialité et sécurité › Fichiers et dossiers (ou Accès complet au disque), puis réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏macOS לא איפשר ל-Right Here לבדוק את %@, ולכן אי אפשר לדעת אם זו תיקיה. יש לאשר גישה לתיקיה זו בהגדרות המערכת › פרטיות ואבטחה › קבצים ותיקיות (או גישה מלאה לכונן) ולנסות שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ने Right Here को %@ देखने नहीं दिया, इसलिए वह नहीं बता सकता कि यह फ़ोल्डर है या नहीं। सिस्टम सेटिंग › गोपनीयता और सुरक्षा › फ़ाइल और फ़ोल्डर (या पूर्ण डिस्क ऐक्सेस) में उस फ़ोल्डर तक पहुँच की अनुमति दें, फिर दोबारा कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS tidak mengizinkan Right Here melihat %@, jadi Right Here tidak dapat mengetahui apakah itu folder. Izinkan akses ke folder tersebut di Pengaturan Sistem › Privasi & Keamanan › File & Folder (atau Akses Disk Penuh), lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS non ha permesso a Right Here di esaminare %@, quindi non può stabilire se è una cartella. Consenti l’accesso a quella cartella in Impostazioni di Sistema › Privacy e sicurezza › File e cartelle (o Accesso completo al disco), poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSがRight Hereによる%@の参照を許可しなかったため、フォルダかどうかを判断できません。システム設定 › プライバシーとセキュリティ › ファイルとフォルダ（またはフルディスクアクセス）で、そのフォルダへのアクセスを許可してから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS가 Right Here의 %@ 확인을 허용하지 않아 폴더인지 알 수 없습니다. 시스템 설정 › 개인정보 보호 및 보안 › 파일 및 폴더(또는 전체 디스크 접근 권한)에서 해당 폴더에 대한 접근을 허용한 다음 다시 시도하십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ने Right Here ला %@ पाहू दिले नाही, त्यामुळे तो फोल्डर आहे की नाही हे ठरवता येत नाही. System Settings › Privacy & Security › Files & Folders (किंवा Full Disk Access) मध्ये त्या फोल्डरच्या ॲक्सेसची परवानगी द्या आणि पुन्हा प्रयत्न करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS tidak membenarkan Right Here melihat %@, jadi Right Here tidak dapat menentukan sama ada itu folder. Benarkan akses kepada folder itu dalam Seting Sistem › Privasi & Keselamatan › Fail & Folder (atau Akses Cakera Penuh), kemudian cuba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS liet Right Here niet in %@ kijken, dus Right Here kan niet bepalen of het een map is. Sta toegang tot die map toe in Systeeminstellingen › Privacy en beveiliging › Bestanden en mappen (of Volledige schijftoegang) en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS nie pozwolił Right Here odczytać ścieżki %@, więc nie wiadomo, czy jest to folder. Zezwól na dostęp do tego folderu w Ustawieniach systemowych › Prywatność i ochrona › Pliki i foldery (lub Pełny dostęp do dysku), a następnie spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS não deixou o Right Here examinar %@, então não é possível saber se é uma pasta. Permita o acesso a essa pasta em Ajustes do Sistema › Privacidade e Segurança › Arquivos e Pastas (ou Acesso Total ao Disco) e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS nu a permis aplicației Right Here să examineze %@, deci nu se poate stabili dacă este un dosar. Permiteți accesul la acel dosar în Configurări sistem › Intimitate și securitate › Fișiere și dosare (sau Acces complet la disc), apoi încercați din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS не позволила Right Here получить доступ к %@, поэтому нельзя определить, папка ли это. Разрешите доступ к этой папке в Системных настройках › Конфиденциальность и безопасность › Файлы и папки (или Доступ к диску) и повторите попытку."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ஐப் பார்க்க Right Here ஐ macOS அனுமதிக்கவில்லை, எனவே அது ஒரு கோப்புறையா என்பதை Right Here ஆல் அறிய முடியாது. System Settings › Privacy & Security › Files & Folders (அல்லது Full Disk Access) இல் அந்தக் கோப்புறைக்கு அணுகலை அனுமதித்து, மீண்டும் முயலவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ను చూడటానికి Right Here ను macOS అనుమతించలేదు, కాబట్టి అది ఫోల్డరో కాదో Right Here తెలుసుకోలేకపోతుంది. System Settings › Privacy & Security › Files & Folders (లేదా Full Disk Access) లో ఆ ఫోల్డర్‌కు యాక్సెస్ అనుమతించి, మళ్లీ ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ไม่อนุญาตให้ Right Here ดู %@ จึงบอกไม่ได้ว่าเป็นโฟลเดอร์หรือไม่ อนุญาตการเข้าถึงโฟลเดอร์นั้นได้ที่การตั้งค่าระบบ › ความเป็นส่วนตัวและความปลอดภัย › ไฟล์และโฟลเดอร์ (หรือการเข้าถึงดิสก์ทั้งหมด) แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS, Right Here’in %@ konumuna bakmasına izin vermedi, bu yüzden bunun bir klasör olup olmadığı anlaşılamıyor. Sistem Ayarları › Gizlilik ve Güvenlik › Dosyalar ve Klasörler (veya Tam Disk Erişimi) bölümünden o klasöre erişim izni verin ve tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS не дозволила Right Here переглянути %@, тому неможливо визначити, чи це папка. Дозвольте доступ до цієї папки в Системних параметрах › Приватність і безпека › Файли та папки (або Повний доступ до диска) та повторіть спробу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "‏macOS نے Right Here کو %@ دیکھنے نہیں دیا، اس لیے وہ یہ نہیں بتا سکتا کہ یہ فولڈر ہے یا نہیں۔ System Settings › Privacy & Security › Files & Folders (یا Full Disk Access) میں اس فولڈر تک رسائی کی اجازت دیں، پھر دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS không cho Right Here xem %@, nên không thể biết đó có phải là thư mục hay không. Hãy cho phép truy cập thư mục đó trong Cài đặt hệ thống › Quyền riêng tư & Bảo mật › Tệp & Thư mục (hoặc Quyền truy cập đầy đủ vào ổ đĩa), rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 不允许 Right Here 查看 %@，因此无法判断它是否为文件夹。请在“系统设置” › “隐私与安全” › “文件与文件夹”（或“完全磁盘访问权限”）中允许访问该文件夹，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 不允許 Right Here 查看 %@，因此無法判斷它是否為檔案夾。請在「系統設定」›「隱私權與安全性」›「檔案和檔案夾」（或「完全取用磁碟」）中允許取用該檔案夾，然後重試。"
          }
        }
      }
    },
    "refusal.unsafeFolder": {
      "comment": "Why an action did nothing, shown in the alert after a click in Finder (and, in English, by the command line). %@ is a path, quoted.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتوي مسار المجلد %@ على فاصل أسطر أو حرف تحكم آخر، لذا لا يمكن كتابته في وحدة طرفية. أعد تسمية المجلد، أو استخدم وحدة طرفية يُسلَّم إليها المجلد مباشرةً، مثل Ghostty."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফোল্ডার %@-এর পাথে একটি লাইন ব্রেক বা অন্য কোনো কন্ট্রোল ক্যারেক্টার আছে, তাই এটি টার্মিনালে টাইপ করা যায় না। ফোল্ডারটির নাম বদলান, অথবা এমন একটি টার্মিনাল ব্যবহার করুন যাকে ফোল্ডারটি সরাসরি দেওয়া হয়, যেমন Ghostty।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Pfad des Ordners %@ enthält einen Zeilenumbruch oder ein anderes Steuerzeichen, daher kann er nicht in ein Terminal eingegeben werden. Benenne den Ordner um oder nutze ein Terminal, dem der Ordner direkt übergeben wird, etwa Ghostty."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η διαδρομή του φακέλου %@ περιέχει αλλαγή γραμμής ή άλλον χαρακτήρα ελέγχου, οπότε δεν μπορεί να πληκτρολογηθεί σε τερματικό. Μετονομάστε τον φάκελο ή χρησιμοποιήστε ένα τερματικό στο οποίο παραδίδεται απευθείας ο φάκελος, όπως το Ghostty."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The folder %@ has a line break or another control character in its path, so it cannot be typed into a terminal. Rename it, or use a terminal that is handed the folder, such as Ghostty."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ruta de la carpeta %@ tiene un salto de línea u otro carácter de control, así que no se puede escribir en una terminal. Cambia el nombre de la carpeta o usa una terminal que reciba la carpeta directamente, como Ghostty."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مسیر پوشهٔ %@ یک شکست خط یا نویسهٔ کنترلی دیگری دارد، بنابراین نمی‌توان آن را در ترمینال تایپ کرد. نام پوشه را تغییر دهید، یا از ترمینالی استفاده کنید که پوشه مستقیماً به آن داده می‌شود، مانند Ghostty."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chemin du dossier %@ contient un saut de ligne ou un autre caractère de contrôle, il ne peut donc pas être saisi dans un terminal. Renommez le dossier ou utilisez un terminal qui reçoit directement le dossier, comme Ghostty."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הנתיב של התיקיה %@ מכיל מעבר שורה או תו בקרה אחר, ולכן אי אפשר להקליד אותו במסוף. יש לשנות את שם התיקיה, או להשתמש במסוף שהתיקיה מועברת אליו ישירות, כמו Ghostty."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोल्डर %@ के पाथ में लाइन ब्रेक या कोई दूसरा कंट्रोल कैरेक्टर है, इसलिए इसे टर्मिनल में टाइप नहीं किया जा सकता। फ़ोल्डर का नाम बदलें, या ऐसा टर्मिनल इस्तेमाल करें जिसे फ़ोल्डर सीधे सौंपा जाता है, जैसे Ghostty।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jalur folder %@ berisi jeda baris atau karakter kontrol lain, jadi tidak dapat diketik ke terminal. Ganti nama folder tersebut, atau gunakan terminal yang menerima folder secara langsung, seperti Ghostty."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il percorso della cartella %@ contiene un a capo o un altro carattere di controllo, quindi non può essere digitato in un terminale. Rinomina la cartella, oppure usa un terminale a cui viene passata la cartella, come Ghostty."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダ%@のパスに改行またはその他の制御文字が含まれているため、ターミナルに入力できません。フォルダの名前を変更するか、Ghosttyのようにフォルダを直接受け取るターミナルを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 폴더의 경로에 줄바꿈 또는 다른 제어 문자가 있어 터미널에 입력할 수 없습니다. 폴더 이름을 바꾸거나, Ghostty처럼 폴더를 직접 전달받는 터미널을 사용하십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फोल्डर %@ च्या पाथमध्ये लाइन ब्रेक किंवा दुसरे कंट्रोल कॅरेक्टर आहे, त्यामुळे तो टर्मिनलमध्ये टाइप करता येत नाही. फोल्डरचे नाव बदला, किंवा Ghostty सारखे फोल्डर थेट दिले जाणारे टर्मिनल वापरा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Laluan folder %@ mengandungi pemisah baris atau aksara kawalan lain, jadi ia tidak boleh ditaip ke dalam terminal. Namakan semula folder itu, atau gunakan terminal yang menerima folder secara terus, seperti Ghostty."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het pad van de map %@ bevat een regeleinde of een ander stuurteken, dus het kan niet in een terminal worden getypt. Wijzig de naam van de map, of gebruik een terminal die de map rechtstreeks krijgt, zoals Ghostty."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ścieżka folderu %@ zawiera znak końca wiersza lub inny znak sterujący, więc nie można jej wpisać do terminala. Zmień nazwę folderu albo użyj terminala, któremu przekazywany jest folder, na przykład Ghostty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O caminho da pasta %@ tem uma quebra de linha ou outro caractere de controle, então não pode ser digitado em um terminal. Renomeie a pasta ou use um terminal que recebe a pasta diretamente, como o Ghostty."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Calea dosarului %@ conține un salt de linie sau alt caracter de control, deci nu poate fi tastată într-un terminal. Redenumiți dosarul sau folosiți un terminal căruia i se transmite dosarul, cum ar fi Ghostty."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Путь папки %@ содержит перенос строки или другой управляющий символ, поэтому его нельзя ввести в терминал. Переименуйте папку или используйте терминал, которому передается сама папка, например Ghostty."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ என்ற கோப்புறையின் பாதையில் வரி முறிவு அல்லது வேறொரு கட்டுப்பாட்டு எழுத்து உள்ளது, எனவே அதை டெர்மினலில் தட்டச்சு செய்ய முடியாது. கோப்புறையின் பெயரை மாற்றவும், அல்லது Ghostty போன்ற, கோப்புறையை நேரடியாகப் பெறும் டெர்மினலைப் பயன்படுத்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ఫోల్డర్ పాత్‌లో లైన్ బ్రేక్ లేదా మరో కంట్రోల్ క్యారెక్టర్ ఉంది, కాబట్టి దాన్ని టెర్మినల్‌లో టైప్ చేయలేము. ఫోల్డర్ పేరు మార్చండి, లేదా Ghostty వంటి, ఫోల్డర్‌ను నేరుగా అందుకునే టెర్మినల్‌ను ఉపయోగించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เส้นทางของโฟลเดอร์ %@ มีการขึ้นบรรทัดใหม่หรืออักขระควบคุมอื่น จึงพิมพ์ลงในเทอร์มินัลไม่ได้ เปลี่ยนชื่อโฟลเดอร์ หรือใช้เทอร์มินัลที่รับโฟลเดอร์ไปโดยตรง เช่น Ghostty"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ klasörünün yolunda bir satır sonu veya başka bir denetim karakteri var, bu yüzden bir terminale yazılamaz. Klasörü yeniden adlandırın ya da klasörün doğrudan verildiği bir terminal kullanın, örneğin Ghostty."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шлях до папки %@ містить розрив рядка або інший керівний символ, тому його не можна ввести в термінал. Перейменуйте папку або скористайтеся терміналом, якому папку передають напряму, наприклад Ghostty."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فولڈر %@ کے پاتھ میں لائن بریک یا کوئی اور کنٹرول کیریکٹر ہے، اس لیے اسے ٹرمینل میں ٹائپ نہیں کیا جا سکتا۔ فولڈر کا نام بدلیں، یا کوئی ایسا ٹرمینل استعمال کریں جسے فولڈر براہِ راست دیا جاتا ہے، جیسے Ghostty۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đường dẫn của thư mục %@ có dấu xuống dòng hoặc một ký tự điều khiển khác nên không thể gõ vào terminal. Hãy đổi tên thư mục, hoặc dùng một terminal nhận thư mục trực tiếp, chẳng hạn Ghostty."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件夹 %@ 的路径中有换行符或其他控制字符，因此无法输入到终端中。请重命名该文件夹，或使用直接接收文件夹的终端，例如 Ghostty。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案夾 %@ 的路徑中有換行字元或其他控制字元，因此無法輸入到終端機中。請重新命名該檔案夾，或使用直接接收檔案夾的終端機，例如 Ghostty。"
          }
        }
      }
    },
