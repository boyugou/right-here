            "value": "మొదటి ప్రాంప్ట్"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พรอมต์แรก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk istem"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перший промпт"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پہلا پرامپٹ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lời nhắc đầu tiên"
          }
        },
        "zh-Hans": {
          "stringUnit": {
