          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "`rh agents` menyenaraikannya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "`rh agents` toont ze."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Polecenie `rh agents` wyświetla ich listę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "`rh agents` lista os agentes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "`rh agents` îi afișează."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Команда `rh agents` показывает их список."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "`rh agents` முகவர்களைப் பட்டியலிடும்."
