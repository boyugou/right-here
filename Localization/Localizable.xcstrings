    "doctor.app.fallback": {
      "comment": "Detail line of the check \"Default terminal\" or \"Default editor\" in the setup window's Details list: the app the config chooses is not installed on this Mac, so another app of the same kind is used. %1$@ is the app the config chooses (for example iTerm), %2$@ the app used instead (for example Ghostty). A sentence with a final period.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
