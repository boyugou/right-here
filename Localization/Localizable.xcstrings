    "app.agentStartsWithoutAsking": {
      "comment": "Caption under the Permission prompts settings of one agent, shown when a click starts the agent with its permission prompts switched off. %@ is the command-line flag that does it (for example --dangerously-skip-permissions; never translate it). The permission prompts are the questions an AI agent asks before it runs a command or changes a file. It matches app.bypassTitle ('Start agents without asking').",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
