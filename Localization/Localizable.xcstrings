        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ஒரு டெர்மினல், எடிட்டர் அல்ல. அதில் ஒரு கோப்புறையைத் திறக்க %2$@ ஐப் பயன்படுத்தவும்."
