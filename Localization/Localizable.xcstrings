        "te": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ఈ Mac యొక్క సొంత కాన్ఫిగరేషన్ ఫైల్ config.local.toml లో ఏజెంట్ల జాబితా ఉంది, కాబట్టి మార్పులు అక్కడే చేయబడతాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไฟล์ config.local.toml ซึ่งเป็นไฟล์การกำหนดค่าของ Mac เครื่องนี้เอง มีรายการเอเจนต์อยู่ จึงต้องทำการเปลี่ยนแปลงที่ไฟล์นั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu Mac’in kendi yapılandırma dosyası config.local.toml, ajanları listeler; bu nedenle değişiklikler orada yapılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Власний файл конфігурації цього Mac — config.local.toml — містить список агентів, тому зміни вносяться саме туди."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اس Mac کی اپنی کنفیگریشن فائل، config.local.toml، ایجنٹس کی فہرست رکھتی ہے، اس لیے تبدیلیاں وہیں کی جاتی ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tệp cấu hình riêng của máy Mac này, config.local.toml, liệt kê các tác tử, nên mọi thay đổi được thực hiện ở đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "这台 Mac 自己的配置文件 config.local.toml 列出了智能体，因此更改在该文件中进行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "這台 Mac 自己的設定檔 config.local.toml 列出了代理程式，因此變更會在該檔案中進行。"
          }
        }
      }
    },
    "app.aiMCPBody": {
      "comment": "Text under the heading app.aiMCPTitle, above a JSON snippet. Claude Desktop and Cursor are app names and stay as they are; 'MCP' stays as it is.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أضِف هذا إلى إعدادات MCP لمساعد ذكاء اصطناعي، مثل Claude Desktop أو Cursor. بعدها يستطيع المساعد استخدام Right Here."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Claude Desktop বা Cursor-এর মতো কোনো AI সহকারীর MCP সেটিংসে এটি যোগ করুন। তখন সহকারীটি Right Here ব্যবহার করতে পারবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Füge dies zu den MCP-Einstellungen eines KI-Assistenten hinzu, etwa Claude Desktop oder Cursor. Dann kann der Assistent Right Here verwenden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Προσθέστε αυτό στις ρυθμίσεις MCP ενός βοηθού AI, όπως το Claude Desktop ή το Cursor. Τότε ο βοηθός μπορεί να χρησιμοποιεί το Right Here."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add this to the MCP settings of an AI assistant, such as Claude Desktop or Cursor. Then the assistant can use Right Here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Añade esto a los ajustes de MCP de un asistente de IA, como Claude Desktop o Cursor. Entonces el asistente podrá usar Right Here."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "این را به تنظیمات MCP یک دستیار هوش مصنوعی اضافه کنید، مانند Claude Desktop یا Cursor. آن وقت دستیار می‌تواند از Right Here استفاده کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ajoutez ceci aux réglages MCP d’un assistant IA, comme Claude Desktop ou Cursor. L’assistant pourra alors utiliser Right Here."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "יש להוסיף את הקטע הזה להגדרות ה-MCP של עוזר AI, כמו Claude Desktop או Cursor. כך העוזר יוכל להשתמש ב-Right Here."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इसे किसी AI असिस्टेंट, जैसे Claude Desktop या Cursor, की MCP सेटिंग में जोड़ें। तब वह असिस्टेंट Right Here का उपयोग कर सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tambahkan ini ke pengaturan MCP asisten AI, seperti Claude Desktop atau Cursor. Setelah itu, asisten tersebut dapat menggunakan Right Here."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aggiungilo alle impostazioni MCP di un assistente IA, come Claude Desktop o Cursor. Poi l’assistente potrà usare Right Here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Claude Desktop や Cursor などの AIアシスタントの MCP 設定にこれを追加してください。そうすると、アシスタントが Right Here を使えるようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Claude Desktop이나 Cursor 같은 AI 어시스턴트의 MCP 설정에 이것을 추가하십시오. 그러면 어시스턴트가 Right Here를 사용할 수 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Claude Desktop किंवा Cursor सारख्या AI असिस्टंटच्या MCP सेटिंग्जमध्ये हे जोडा. मग असिस्टंट Right Here वापरू शकतो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tambahkan ini pada seting MCP pembantu AI seperti Claude Desktop atau Cursor. Kemudian pembantu itu boleh menggunakan Right Here."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Voeg dit toe aan de MCP-instellingen van een AI-assistent, zoals Claude Desktop of Cursor. Dan kan de assistent Right Here gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dodaj to do ustawień MCP asystenta AI, na przykład Claude Desktop lub Cursor. Wtedy asystent będzie mógł korzystać z Right Here."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Adicione isto às configurações MCP de um assistente de IA, como o Claude Desktop ou o Cursor. Assim, o assistente poderá usar o Right Here."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Adăugați aceasta în configurările MCP ale unui asistent AI, precum Claude Desktop sau Cursor. Apoi asistentul poate folosi Right Here."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Добавьте это в настройки MCP ИИ-ассистента, например Claude Desktop или Cursor. Тогда ассистент сможет использовать Right Here."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Claude Desktop அல்லது Cursor போன்ற AI உதவியாளரின் MCP அமைப்புகளில் இதைச் சேர்க்கவும். அதன் பிறகு அந்த உதவியாளர் Right Here-ஐப் பயன்படுத்த முடியும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Claude Desktop లేదా Cursor వంటి AI సహాయకుడి MCP సెట్టింగ్లకు దీన్ని జోడించండి. అప్పుడు ఆ సహాయకుడు Right Here ను ఉపయోగించగలడు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เพิ่มข้อความนี้ในการตั้งค่า MCP ของผู้ช่วย AI เช่น Claude Desktop หรือ Cursor จากนั้นผู้ช่วยจะใช้ Right Here ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bunu, Claude Desktop veya Cursor gibi bir YZ asistanının MCP ayarlarına ekleyin. Ardından asistan Right Here’i kullanabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Додайте це в налаштування MCP ШІ-асистента, наприклад Claude Desktop або Cursor. Тоді асистент зможе використовувати Right Here."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اسے Claude Desktop یا Cursor جیسے AI اسسٹنٹ کی MCP سیٹنگز میں شامل کریں۔ پھر وہ اسسٹنٹ Right Here استعمال کر سکتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Thêm nội dung này vào phần cài đặt MCP của một trợ lý AI, chẳng hạn Claude Desktop hoặc Cursor. Khi đó trợ lý có thể dùng Right Here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "将此内容添加到 Claude Desktop 或 Cursor 等 AI 助手的 MCP 设置中。之后该助手就能使用 Right Here。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "將此內容加入 Claude Desktop 或 Cursor 等 AI 助理的 MCP 設定中。之後該助理就能使用 Right Here。"
          }
        }
      }
    },
    "app.aiMCPTitle": {
