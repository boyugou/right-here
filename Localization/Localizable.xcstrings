    },
    "config.editedMeanwhile": {
      "comment": "Shown in the setup window (and, in English, by the command line) when a change or a setup did not work. %@ is the path of a config file.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّر الملف %@ أثناء تعديلك له، لذلك لم يُحفظ شيء. انسخ ما كتبته، وأعِد تحميل الملف، ثم أجرِ التغيير مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি সম্পাদনা করার সময় %@ ফাইলটি বদলে গেছে, তাই কিছুই সংরক্ষণ করা হয়নি। আপনি যা লিখেছেন তা কপি করুন, ফাইলটি আবার লোড করুন এবং পরিবর্তনটি আবার করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei %@ wurde geändert, während du sie bearbeitet hast, daher wurde nichts gespeichert. Kopiere, was du geschrieben hast, lade die Datei neu und mache die Änderung erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το αρχείο %@ άλλαξε ενώ το επεξεργαζόσασταν, οπότε δεν αποθηκεύτηκε τίποτα. Αντιγράψτε όσα γράψατε, φορτώστε ξανά το αρχείο και κάντε ξανά την αλλαγή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ was changed while you were editing it, so nothing was saved. Copy what you wrote, reload the file, and make the change again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo %@ cambió mientras lo editabas, así que no se guardó nada. Copia lo que escribiste, vuelve a cargar el archivo y haz el cambio de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فایل %@ در حین ویرایش شما تغییر کرد، بنابراین چیزی ذخیره نشد. آنچه را نوشته‌اید کپی کنید، فایل را دوباره بارگذاری کنید و تغییر را دوباره انجام دهید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier %@ a été modifié pendant que vous travailliez dessus, donc rien n’a été enregistré. Copiez ce que vous avez écrit, rechargez le fichier et refaites la modification."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקובץ %@ השתנה במהלך העריכה, ולכן דבר לא נשמר. יש להעתיק את מה שנכתב, לטעון את הקובץ מחדש ולבצע את השינוי שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके संपादन के दौरान फ़ाइल %@ बदल गई, इसलिए कुछ भी सहेजा नहीं गया। आपने जो लिखा है उसे कॉपी करें, फ़ाइल दोबारा लोड करें और बदलाव फिर से करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File %@ diubah saat Anda sedang mengeditnya, jadi tidak ada yang disimpan. Salin apa yang Anda tulis, muat ulang file, lalu buat perubahan itu lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file %@ è stato cambiato mentre lo stavi modificando, quindi non è stato salvato nulla. Copia ciò che hai scritto, ricarica il file e rifai la modifica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編集中にファイル %@ が変更されたため、何も保存されませんでした。書いた内容をコピーし、ファイルを再読み込みしてから、もう一度変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집하는 동안 %@ 파일이 변경되어 아무것도 저장되지 않았습니다. 작성한 내용을 복사하고 파일을 다시 불러온 다음 다시 변경하십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही संपादन करत असताना %@ ही फाइल बदलली, त्यामुळे काहीही जतन झाले नाही. तुम्ही लिहिलेला मजकूर कॉपी करा, फाइल पुन्हा लोड करा आणि बदल पुन्हा करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fail %@ telah diubah semasa anda mengeditnya, jadi tiada apa-apa yang disimpan. Salin apa yang anda tulis, muat semula fail, dan buat perubahan itu semula."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bestand %@ is gewijzigd terwijl je het aan het bewerken was, dus er is niets bewaard. Kopieer wat je hebt geschreven, laad het bestand opnieuw en breng de wijziging nog een keer aan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plik %@ został zmieniony podczas edycji, więc nic nie zapisano. Skopiuj wpisany tekst, wczytaj plik ponownie i wprowadź zmianę jeszcze raz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo %@ foi alterado enquanto você o editava, então nada foi salvo. Copie o que você escreveu, recarregue o arquivo e faça a alteração de novo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fișierul %@ a fost modificat în timp ce îl editați, așa că nu s-a salvat nimic. Copiați ce ați scris, reîncărcați fișierul și faceți din nou modificarea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл %@ изменился, пока Вы его редактировали, поэтому ничего не сохранено. Скопируйте написанное, загрузите файл заново и внесите изменение еще раз."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் திருத்திக்கொண்டிருந்தபோது %@ கோப்பு மாற்றப்பட்டது, அதனால் எதுவும் சேமிக்கப்படவில்லை. நீங்கள் எழுதியதை நகலெடுத்து, கோப்பை மீண்டும் ஏற்றி, மாற்றத்தை மீண்டும் செய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఎడిట్ చేస్తుండగా %@ ఫైల్ మారింది, అందుకే ఏదీ సేవ్ కాలేదు. మీరు రాసినదాన్ని కాపీ చేసి, ఫైల్‌ను మళ్లీ లోడ్ చేసి, మార్పును మళ్లీ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์ %@ ถูกเปลี่ยนระหว่างที่คุณกำลังแก้ไข จึงไม่มีสิ่งใดถูกบันทึก คัดลอกสิ่งที่คุณเขียนไว้ โหลดไฟล์ใหม่ แล้วทำการเปลี่ยนแปลงอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dosyası siz düzenlerken değiştirildi, bu yüzden hiçbir şey kaydedilmedi. Yazdıklarınızı kopyalayın, dosyayı yeniden yükleyin ve değişikliği tekrar yapın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл %@ змінився, поки ви його редагували, тому нічого не збережено. Скопіюйте написане, завантажте файл знову і внесіть зміну ще раз."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی ترمیم کے دوران فائل %@ بدل گئی، اس لیے کچھ بھی محفوظ نہیں ہوا۔ جو آپ نے لکھا ہے اسے کاپی کریں، فائل دوبارہ لوڈ کریں، اور تبدیلی دوبارہ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp %@ đã bị thay đổi trong lúc bạn đang chỉnh sửa, nên chưa có gì được lưu. Hãy sao chép những gì bạn đã viết, tải lại tệp, rồi thực hiện lại thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你编辑时，文件 %@ 被更改了，因此没有保存任何内容。请拷贝你写的内容，重新载入文件，然后再做一次更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你編輯時，檔案 %@ 已被變更，因此沒有儲存任何內容。請拷貝你寫的內容，重新載入檔案，然後再做一次變更。"
          }
        }
      }
    },
    "config.lockUnavailable": {
      "comment": "Shown in the setup window (and, in English, by the command line) when a change or a setup did not work. %@ is the path of the lock file next to the config.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر أخذ ملف القفل %@ (فهو رابط رمزي، أو لا يمكن الكتابة في مجلده)، لذلك لم يتغيّر ملف الإعداد: إذ لا يمكن التمييز بين تعديلين يحدثان في الوقت نفسه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লক ফাইল %@ নেওয়া যাচ্ছে না (এটি একটি সিমলিংক, অথবা এর ফোল্ডারে লেখা যায় না), তাই কনফিগারেশন বদলানো হয়নি: একই সময়ে করা দুটি সম্পাদনা আলাদা করে চেনা যেত না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sperrdatei %@ kann nicht belegt werden (sie ist ein symbolischer Link, oder in ihren Ordner kann nicht geschrieben werden), daher wurde die Konfiguration nicht geändert: Zwei gleichzeitige Änderungen ließen sich nicht auseinanderhalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το αρχείο κλειδώματος %@ δεν μπορεί να αποκτηθεί (είναι συμβολικός σύνδεσμος ή δεν επιτρέπεται η εγγραφή στον φάκελό του), οπότε το αρχείο ρυθμίσεων δεν άλλαξε: δύο ταυτόχρονες αλλαγές δεν θα ξεχώριζαν μεταξύ τους."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The lock %@ cannot be taken (it is a link, or its folder cannot be written to), so the config was not changed: two edits made at once could not be told apart."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede obtener el archivo de bloqueo %@ (es un enlace simbólico o no se puede escribir en su carpeta), así que la configuración no se cambió: dos cambios hechos a la vez no se podrían distinguir."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فایل قفل %@ گرفته نمی‌شود (یک پیوند نمادین است، یا در پوشهٔ آن نمی‌توان نوشت)، بنابراین پیکربندی تغییر نکرد: دو ویرایش هم‌زمان را نمی‌شد از هم تشخیص داد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le verrou %@ ne peut pas être pris (c’est un lien symbolique, ou son dossier n’est pas accessible en écriture), donc la configuration n’a pas été modifiée : deux modifications faites en même temps ne pourraient pas être distinguées."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לתפוס את קובץ הנעילה %@ (הוא קישור סמלי, או שלא ניתן לכתוב לתיקיה שלו), ולכן התצורה לא שונתה: לא ניתן היה להבחין בין שתי עריכות שנעשו בו-זמנית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लॉक फ़ाइल %@ नहीं ली जा सकती (वह एक सिमलिंक है, या उसके फ़ोल्डर में लिखा नहीं जा सकता), इसलिए कॉन्फ़िगरेशन नहीं बदला गया: एक साथ किए गए दो बदलावों में फ़र्क़ नहीं किया जा सकता था।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File kunci %@ tidak dapat diambil (file itu adalah symlink, atau foldernya tidak dapat ditulisi), jadi konfigurasi tidak diubah: dua pengeditan yang dilakukan bersamaan tidak dapat dibedakan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file di blocco %@ non può essere acquisito (è un link simbolico, oppure non si può scrivere nella sua cartella), quindi la configurazione non è stata modificata: due modifiche fatte nello stesso momento non si potrebbero distinguere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロックファイル %@ を取得できません（シンボリックリンクであるか、そのフォルダに書き込めません）。そのため設定ファイルは変更していません。同時に行われた2つの編集を区別できないためです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 잠금 파일을 획득할 수 없어(심볼릭 링크이거나 해당 폴더에 쓸 수 없음) 설정 파일을 변경하지 않았습니다. 동시에 이루어진 두 편집을 구별할 수 없기 때문입니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "लॉक फाइल %@ घेता येत नाही (ती सिम्लिंक आहे, किंवा तिच्या फोल्डरमध्ये लिहिता येत नाही), त्यामुळे कॉन्फिगरेशन बदलले नाही: एकाच वेळी केलेली दोन संपादने वेगळी ओळखता आली नसती."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fail kunci %@ tidak dapat diambil (ia ialah pautan simbolik, atau foldernya tidak boleh ditulis), jadi konfigurasi tidak diubah: dua suntingan yang dibuat serentak tidak dapat dibezakan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het vergrendelingsbestand %@ kan niet worden verkregen (het is een symlink, of er kan niet in de map worden geschreven), dus de configuratie is niet gewijzigd: twee gelijktijdige wijzigingen zouden niet uit elkaar te houden zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można zająć pliku blokady %@ (jest dowiązaniem symbolicznym albo w jego folderze nie można zapisywać), więc konfiguracji nie zmieniono: dwóch zmian wprowadzonych jednocześnie nie dałoby się rozróżnić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível obter o arquivo de bloqueio %@ (é um link simbólico, ou não é possível gravar na pasta dele), então a configuração não foi alterada: duas edições feitas ao mesmo tempo não poderiam ser diferenciadas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fișierul de blocare %@ nu poate fi obținut (este un link simbolic sau în dosarul său nu se poate scrie), așa că configurația nu a fost modificată: două modificări făcute în același timp nu ar putea fi deosebite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удается захватить файл блокировки %@ (это символическая ссылка, или в его папку нельзя записывать), поэтому конфигурация не изменена: две одновременные правки было бы не различить."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பூட்டுக் கோப்பு %@ ஐப் பெற முடியவில்லை (அது ஒரு symlink, அல்லது அதன் கோப்புறையில் எழுத முடியாது), அதனால் உள்ளமைவு மாற்றப்படவில்லை: ஒரே நேரத்தில் செய்யப்பட்ட இரண்டு திருத்தங்களைப் பிரித்தறிய முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "లాక్ ఫైల్ %@ ను పొందలేము (అది ఒక symlink, లేదా దాని ఫోల్డర్‌లో రాయలేము), అందుకే కాన్ఫిగరేషన్ మార్చబడలేదు: ఒకేసారి చేసిన రెండు ఎడిట్‌లను వేరు చేసి గుర్తించలేము."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ไฟล์ล็อก %@ ไม่ได้ (ไฟล์นี้เป็น symlink หรือเขียนลงในโฟลเดอร์ของไฟล์ไม่ได้) จึงไม่ได้เปลี่ยนการกำหนดค่า เพราะจะแยกการแก้ไขสองครั้งที่เกิดขึ้นพร้อมกันไม่ออก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilit dosyası %@ alınamıyor (sembolik bağlantıdır ya da klasörüne yazılamıyor), bu yüzden yapılandırma değiştirilmedi: aynı anda yapılan iki düzenleme birbirinden ayırt edilemezdi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдається захопити файл блокування %@ (це символічне посилання, або в його папку не можна записувати), тому конфігурацію не змінено: дві одночасні зміни неможливо було б розрізнити."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لاک فائل %@ حاصل نہیں کی جا سکتی (یہ ایک سمبولک لنک ہے، یا اس کے فولڈر میں لکھا نہیں جا سکتا)، اس لیے کنفیگریشن تبدیل نہیں کی گئی: ایک ہی وقت میں کی گئی دو ترامیم میں فرق نہیں کیا جا سکتا تھا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể lấy tệp khóa %@ (đó là liên kết tượng trưng, hoặc không thể ghi vào thư mục chứa nó), nên cấu hình chưa được thay đổi: hai lần chỉnh sửa cùng lúc sẽ không thể phân biệt được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法获取锁文件 %@（它是符号链接，或者无法写入它所在的文件夹），因此配置未更改：同时进行的两次编辑将无法区分。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法取得鎖定檔 %@（它是符號連結，或無法寫入它所在的檔案夾），因此設定檔未變更：同時進行的兩次編輯將無法區分。"
          }
        }
      }
    },
    "config.noConfig": {
      "comment": "Shown in the setup window (and, in English, by the command line) when a change or a setup did not work. %@ is the path where the config file would be.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد ملف إعداد في %@ بعد. شغّل `rh setup` لإنشائه، ثم غيّره."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-এ এখনো কোনো কনফিগারেশন ফাইল নেই। একটি তৈরি করতে `rh setup` চালান, তারপর সেটি বদলান।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter %@ gibt es noch keine Konfigurationsdatei. Führe `rh setup` aus, um eine zu erstellen, und ändere sie dann."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχει ακόμα αρχείο ρυθμίσεων στη θέση %@. Εκτελέστε `rh setup` για να δημιουργηθεί και μετά αλλάξτε το."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no config file at %@ yet. Run `rh setup` to make one, then change it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay ningún archivo de configuración en %@. Ejecuta `rh setup` para crear uno y luego cámbialo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنوز فایل پیکربندی در %@ وجود ندارد. برای ساختن آن `rh setup` را اجرا کنید، سپس آن را تغییر دهید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n’y a pas encore de fichier de configuration à l’emplacement %@. Exécutez `rh setup` pour en créer un, puis modifiez-le."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדיין אין קובץ תצורה בנתיב %@. יש להריץ את `rh setup` כדי ליצור אותו, ואז לשנות אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ पर अभी कोई कॉन्फ़िगरेशन फ़ाइल नहीं है। उसे बनाने के लिए `rh setup` चलाएँ, फिर उसे बदलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada file konfigurasi di %@. Jalankan `rh setup` untuk membuatnya, lalu ubah file itu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c’è ancora alcun file di configurazione in %@. Esegui `rh setup` per crearne uno, poi modificalo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ にはまだ設定ファイルがありません。`rh setup` を実行して作成してから、変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 위치에 아직 설정 파일이 없습니다. `rh setup` 명령을 실행하여 설정 파일을 만든 다음 변경하십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ येथे अजून कॉन्फिगरेशन फाइल नाही. ती तयार करण्यासाठी `rh setup` चालवा, मग ती बदला."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada fail konfigurasi di %@. Jalankan `rh setup` untuk menciptanya, kemudian ubah fail itu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is nog geen configuratiebestand op %@. Voer `rh setup` uit om er een te maken en wijzig het daarna."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W lokalizacji %@ nie ma jeszcze pliku konfiguracji. Uruchom `rh setup`, aby go utworzyć, a potem go zmień."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há arquivo de configuração em %@. Execute `rh setup` para criar um e depois altere-o."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu există încă un fișier de configurare la %@. Rulați `rh setup` pentru a crea unul, apoi modificați-l."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По пути %@ еще нет файла конфигурации. Выполните `rh setup`, чтобы создать его, а затем измените его."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ இல் இன்னும் உள்ளமைவுக் கோப்பு இல்லை. அதை உருவாக்க `rh setup` ஐ இயக்கவும், பிறகு அதை மாற்றவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ వద్ద ఇంకా కాన్ఫిగరేషన్ ఫైల్ లేదు. దాన్ని సృష్టించడానికి `rh setup` రన్ చేయండి, ఆపై దాన్ని మార్చండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีไฟล์การกำหนดค่าที่ %@ เรียกใช้ `rh setup` เพื่อสร้างไฟล์ แล้วจึงเปลี่ยนแปลงไฟล์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ konumunda henüz yapılandırma dosyası yok. Bir tane oluşturmak için `rh setup` komutunu çalıştırın, ardından dosyayı değiştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За шляхом %@ ще немає файлу конфігурації. Виконайте `rh setup`, щоб створити його, а потім змініть його."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%@ پر ابھی کوئی کنفیگریشن فائل نہیں ہے۔ اسے بنانے کے لیے `rh setup` چلائیں، پھر اسے تبدیل کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có tệp cấu hình nào tại %@. Hãy chạy `rh setup` để tạo tệp, rồi thay đổi nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 处还没有配置文件。请运行 `rh setup` 创建一个，然后再更改它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 處還沒有設定檔。請執行 `rh setup` 建立一個，然後再變更它。"
          }
        }
      }
    },
    "config.readOnly": {
      "comment": "Shown in the setup window (and, in English, by the command line) when a change or a setup did not work. %@ is the path of a config file.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الملف %@ للقراءة فقط، لذلك لم يتغيّر. اجعله قابلًا للكتابة ليتمكن `rh config` والنافذة من تغييره."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ফাইলটি শুধু পড়ার জন্য, তাই এটি বদলানো হয়নি। `rh config` এবং উইন্ডো যাতে এটি বদলাতে পারে, সেজন্য এটিকে লেখার যোগ্য করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei %@ ist schreibgeschützt und wurde daher nicht geändert. Hebe den Schreibschutz auf, damit `rh config` und das Fenster sie ändern können."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το αρχείο %@ είναι μόνο για ανάγνωση, οπότε δεν άλλαξε. Επιτρέψτε την εγγραφή σε αυτό, ώστε να μπορούν να το αλλάζουν η εντολή `rh config` και το παράθυρο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is read-only, so it was not changed. Make it writable to let `rh config` and the window change it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo %@ es de solo lectura, así que no se cambió. Permite escribir en él para que `rh config` y la ventana puedan cambiarlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فایل %@ فقط‌خواندنی است، بنابراین تغییر نکرد. آن را قابل نوشتن کنید تا `rh config` و پنجره بتوانند آن را تغییر دهند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier %@ est en lecture seule, il n’a donc pas été modifié. Rendez-le accessible en écriture pour que `rh config` et la fenêtre puissent le modifier."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקובץ %@ מוגדר לקריאה בלבד, ולכן לא שונה. יש לאפשר כתיבה אליו כדי לאפשר לפקודה `rh config` ולחלון לשנות אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइल %@ केवल पढ़ने के लिए है, इसलिए इसे बदला नहीं गया। इसे लिखने योग्य बनाएँ, ताकि `rh config` और विंडो इसे बदल सकें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File %@ bersifat hanya baca, jadi tidak diubah. Buat file itu dapat ditulisi agar `rh config` dan jendela dapat mengubahnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file %@ è di sola lettura, quindi non è stato modificato. Rendilo scrivibile per permettere a `rh config` e alla finestra di modificarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイル %@ は読み出し専用のため、変更されませんでした。`rh config` とウインドウで変更できるように、書き込み可能にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 파일은 읽기 전용이므로 변경하지 않았습니다. `rh config`와 윈도우에서 변경할 수 있도록 쓰기 가능하게 만드십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ही फाइल फक्त वाचण्यासाठी आहे, त्यामुळे ती बदलली नाही. `rh config` आणि विंडोला ती बदलता यावी म्हणून ती लिहिण्यायोग्य करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fail %@ hanya boleh dibaca, jadi ia tidak diubah. Jadikannya boleh ditulis supaya `rh config` dan tetingkap dapat mengubahnya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bestand %@ is alleen-lezen, dus het is niet gewijzigd. Maak het schrijfbaar zodat `rh config` en het venster het kunnen wijzigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plik %@ jest tylko do odczytu, więc nie został zmieniony. Zezwól na zapis w nim, aby `rh config` i okno mogły go zmieniać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo %@ é somente leitura, então não foi alterado. Torne-o gravável para que `rh config` e a janela possam alterá-lo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fișierul %@ este doar pentru citire, așa că nu a fost modificat. Faceți-l inscriptibil pentru ca `rh config` și fereastra să-l poată modifica."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл %@ доступен только для чтения, поэтому он не изменен. Разрешите запись в него, чтобы `rh config` и окно могли его менять."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ கோப்பு படிக்க மட்டுமே உரியது, அதனால் அது மாற்றப்படவில்லை. `rh config` மற்றும் சாளரம் அதை மாற்ற, அதை எழுதக்கூடியதாக ஆக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ఫైల్ చదవడానికి మాత్రమే, అందుకే అది మార్చబడలేదు. `rh config` మరియు విండో దాన్ని మార్చగలిగేలా దాన్ని రాయగలిగేదిగా చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์ %@ เป็นแบบอ่านอย่างเดียว จึงไม่ได้ถูกเปลี่ยน ทำให้ไฟล์เขียนได้เพื่อให้ `rh config` และหน้าต่างเปลี่ยนแปลงไฟล์ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dosyası salt okunur olduğu için değiştirilmedi. `rh config` ve pencerenin onu değiştirebilmesi için dosyayı yazılabilir yapın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл %@ доступний лише для читання, тому його не змінено. Дозвольте запис у нього, щоб `rh config` і вікно могли його змінювати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فائل %@ صرف پڑھنے کے لیے ہے، اس لیے اسے تبدیل نہیں کیا گیا۔ اسے قابلِ تحریر بنائیں تاکہ `rh config` اور ونڈو اسے تبدیل کر سکیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp %@ chỉ đọc, nên chưa được thay đổi. Hãy cho phép ghi vào tệp để `rh config` và cửa sổ có thể thay đổi nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件 %@ 为只读，因此未被更改。请将其设为可写，以便 `rh config` 和窗口能够更改它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案 %@ 為唯讀，因此未被變更。請將其設為可寫入，讓 `rh config` 和視窗能夠變更它。"
          }
        }
      }
    },
    "config.replaceLockUnavailable": {
      "comment": "Shown in the setup window (and, in English, by the command line) when a change or a setup did not work. %@ is the path of the lock file next to the config. Said when a new config was to replace the old one.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر أخذ ملف القفل %@ (فهو رابط رمزي، أو لا يمكن الكتابة في مجلده)، لذلك لم يُستبدل ملف الإعداد: إذ لا يمكن تمييز تغيير يحدث في اللحظة نفسها. لم يتغيّر شيء."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লক ফাইল %@ নেওয়া যাচ্ছে না (এটি একটি সিমলিংক, অথবা এর ফোল্ডারে লেখা যায় না), তাই কনফিগারেশন প্রতিস্থাপন করা হয়নি: একই মুহূর্তে করা কোনো পরিবর্তন আলাদা করে চেনা যেত না। কিছুই বদলানো হয়নি।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sperrdatei %@ kann nicht belegt werden (sie ist ein symbolischer Link, oder in ihren Ordner kann nicht geschrieben werden), daher wurde die Konfiguration nicht ersetzt: Eine Änderung im selben Moment ließe sich nicht unterscheiden. Es wurde nichts geändert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το αρχείο κλειδώματος %@ δεν μπορεί να αποκτηθεί (είναι συμβολικός σύνδεσμος ή δεν επιτρέπεται η εγγραφή στον φάκελό του), οπότε το αρχείο ρυθμίσεων δεν αντικαταστάθηκε: μια αλλαγή την ίδια στιγμή δεν θα ξεχώριζε. Δεν άλλαξε τίποτα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The lock %@ cannot be taken (it is a link, or its folder cannot be written to), so the config was not replaced: a change made at the same moment could not be told apart. Nothing was changed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede obtener el archivo de bloqueo %@ (es un enlace simbólico o no se puede escribir en su carpeta), así que la configuración no se reemplazó: un cambio hecho en el mismo momento no se podría distinguir. No se cambió nada."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فایل قفل %@ گرفته نمی‌شود (یک پیوند نمادین است، یا در پوشهٔ آن نمی‌توان نوشت)، بنابراین پیکربندی جایگزین نشد: تغییری را که در همان لحظه انجام شود نمی‌شد تشخیص داد. هیچ چیزی تغییر نکرد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le verrou %@ ne peut pas être pris (c’est un lien symbolique, ou son dossier n’est pas accessible en écriture), donc la configuration n’a pas été remplacée : une modification faite au même moment ne pourrait pas être distinguée. Rien n’a été modifié."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לתפוס את קובץ הנעילה %@ (הוא קישור סמלי, או שלא ניתן לכתוב לתיקיה שלו), ולכן התצורה לא הוחלפה: לא ניתן היה להבחין בשינוי שנעשה באותו רגע. דבר לא שונה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लॉक फ़ाइल %@ नहीं ली जा सकती (वह एक सिमलिंक है, या उसके फ़ोल्डर में लिखा नहीं जा सकता), इसलिए कॉन्फ़िगरेशन प्रतिस्थापित नहीं किया गया: उसी पल किया गया कोई बदलाव अलग से पहचाना नहीं जा सकता था। कुछ भी नहीं बदला गया।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File kunci %@ tidak dapat diambil (file itu adalah symlink, atau foldernya tidak dapat ditulisi), jadi konfigurasi tidak diganti: perubahan yang dilakukan pada saat yang sama tidak dapat dibedakan. Tidak ada yang diubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file di blocco %@ non può essere acquisito (è un link simbolico, oppure non si può scrivere nella sua cartella), quindi la configurazione non è stata sostituita: una modifica fatta nello stesso momento non si potrebbe distinguere. Non è stato cambiato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロックファイル %@ を取得できません（シンボリックリンクであるか、そのフォルダに書き込めません）。そのため設定ファイルは置き換えていません。同時に行われた変更を区別できないためです。何も変更されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 잠금 파일을 획득할 수 없어(심볼릭 링크이거나 해당 폴더에 쓸 수 없음) 설정 파일을 교체하지 않았습니다. 같은 순간에 이루어진 변경을 구별할 수 없기 때문입니다. 아무것도 변경되지 않았습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "लॉक फाइल %@ घेता येत नाही (ती सिम्लिंक आहे, किंवा तिच्या फोल्डरमध्ये लिहिता येत नाही), त्यामुळे कॉन्फिगरेशनच्या जागी नवीन कॉन्फिगरेशन ठेवले नाही: त्याच क्षणी केलेला बदल वेगळा ओळखता आला नसता. काहीही बदलले नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fail kunci %@ tidak dapat diambil (ia ialah pautan simbolik, atau foldernya tidak boleh ditulis), jadi konfigurasi tidak diganti: perubahan yang dibuat pada saat yang sama tidak dapat dibezakan. Tiada apa-apa yang diubah."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het vergrendelingsbestand %@ kan niet worden verkregen (het is een symlink, of er kan niet in de map worden geschreven), dus de configuratie is niet vervangen: een wijziging op hetzelfde moment zou niet te onderscheiden zijn. Er is niets gewijzigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można zająć pliku blokady %@ (jest dowiązaniem symbolicznym albo w jego folderze nie można zapisywać), więc konfiguracji nie zastąpiono: zmiany wprowadzonej w tej samej chwili nie dałoby się odróżnić. Nic nie zostało zmienione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível obter o arquivo de bloqueio %@ (é um link simbólico, ou não é possível gravar na pasta dele), então a configuração não foi substituída: uma alteração feita no mesmo momento não poderia ser diferenciada. Nada foi alterado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fișierul de blocare %@ nu poate fi obținut (este un link simbolic sau în dosarul său nu se poate scrie), așa că configurația nu a fost înlocuită: o modificare făcută în același moment nu ar putea fi deosebită. Nu s-a modificat nimic."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удается захватить файл блокировки %@ (это символическая ссылка, или в его папку нельзя записывать), поэтому конфигурация не заменена: изменение, сделанное в тот же момент, было бы не отличить. Ничего не изменено."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பூட்டுக் கோப்பு %@ ஐப் பெற முடியவில்லை (அது ஒரு symlink, அல்லது அதன் கோப்புறையில் எழுத முடியாது), அதனால் உள்ளமைவு மாற்றீடு செய்யப்படவில்லை: அதே நேரத்தில் செய்யப்பட்ட ஒரு மாற்றத்தைப் பிரித்தறிய முடியாது. எதுவும் மாற்றப்படவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "లాక్ ఫైల్ %@ ను పొందలేము (అది ఒక symlink, లేదా దాని ఫోల్డర్‌లో రాయలేము), అందుకే కాన్ఫిగరేషన్ భర్తీ చేయబడలేదు: అదే క్షణంలో చేసిన మార్పును వేరు చేసి గుర్తించలేము. ఏదీ మార్చబడలేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ไฟล์ล็อก %@ ไม่ได้ (ไฟล์นี้เป็น symlink หรือเขียนลงในโฟลเดอร์ของไฟล์ไม่ได้) จึงไม่ได้แทนที่การกำหนดค่า เพราะจะแยกการเปลี่ยนแปลงที่เกิดขึ้นในเวลาเดียวกันไม่ออก ไม่มีสิ่งใดถูกเปลี่ยน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilit dosyası %@ alınamıyor (sembolik bağlantıdır ya da klasörüne yazılamıyor), bu yüzden yapılandırmanın yerine yenisi konmadı: aynı anda yapılan bir değişiklik ayırt edilemezdi. Hiçbir şey değiştirilmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдається захопити файл блокування %@ (це символічне посилання, або в його папку не можна записувати), тому конфігурацію не замінено: зміну, зроблену в ту саму мить, неможливо було б розрізнити. Нічого не змінено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لاک فائل %@ حاصل نہیں کی جا سکتی (یہ ایک سمبولک لنک ہے، یا اس کے فولڈر میں لکھا نہیں جا سکتا)، اس لیے کنفیگریشن کی جگہ نئی کنفیگریشن نہیں رکھی گئی: اسی لمحے کی گئی کسی تبدیلی کو الگ سے پہچانا نہیں جا سکتا تھا۔ کچھ بھی تبدیل نہیں کیا گیا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể lấy tệp khóa %@ (đó là liên kết tượng trưng, hoặc không thể ghi vào thư mục chứa nó), nên cấu hình chưa được thay thế: một thay đổi thực hiện cùng lúc sẽ không thể phân biệt được. Không có gì bị thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法获取锁文件 %@（它是符号链接，或者无法写入它所在的文件夹），因此配置未被替换：同一时刻进行的更改将无法区分。没有更改任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法取得鎖定檔 %@（它是符號連結，或無法寫入它所在的檔案夾），因此設定檔未被取代：同一時刻進行的變更將無法區分。沒有變更任何內容。"
          }
        }
      }
    },
    "config.tooLarge": {
      "comment": "Shown in the setup window (and, in English, by the command line) when a change or a setup did not work. %1$@ and %2$@ are numbers of kilobytes.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيصبح حجم ملف الإعداد %1$@ KB، ولا يقرأ Right Here أكثر من %2$@ KB: فملف الإعداد لا يتجاوز عادةً بضعة كيلوبايتات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কনফিগারেশনের আকার হবে %1$@ KB, অথচ Right Here সর্বোচ্চ %2$@ KB পড়ে: একটি কনফিগারেশন সাধারণত কয়েক কিলোবাইট হয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Konfiguration wäre %1$@ KB groß, und Right Here liest höchstens %2$@ KB: Eine Konfiguration ist ein paar Kilobyte groß."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το αρχείο ρυθμίσεων θα είχε μέγεθος %1$@ KB, ενώ το Right Here διαβάζει το πολύ %2$@ KB: ένα αρχείο ρυθμίσεων είναι λίγα κιλομπάιτ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The config would be %1$@ KB, and Right Here reads at most %2$@ KB: a config is a few kilobytes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuración ocuparía %1$@ KB, y Right Here lee como máximo %2$@ KB: una configuración ocupa unos pocos kilobytes."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حجم پیکربندی %1$@ KB می‌شود، اما Right Here حداکثر %2$@ KB می‌خواند: یک پیکربندی معمولاً چند کیلوبایت است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuration ferait %1$@ ko, et Right Here lit au plus %2$@ ko : une configuration fait quelques kilo-octets."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גודל התצורה יהיה %1$@ KB, ו-Right Here קורא לכל היותר %2$@ KB: תצורה היא בגודל של קילובייטים ספורים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कॉन्फ़िगरेशन %1$@ KB का हो जाएगा, जबकि Right Here अधिकतम %2$@ KB पढ़ता है: कॉन्फ़िगरेशन आम तौर पर कुछ किलोबाइट का होता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurasi akan berukuran %1$@ KB, padahal Right Here membaca paling banyak %2$@ KB: sebuah konfigurasi biasanya hanya beberapa kilobyte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La configurazione sarebbe di %1$@ KB, e Right Here legge al massimo %2$@ KB: una configurazione occupa pochi kilobyte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定ファイルは %1$@ KB になりますが、Right Here が読み込むのは最大 %2$@ KB です。設定ファイルは通常、数キロバイトです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 파일이 %1$@ KB가 되는데, Right Here는 최대 %2$@ KB까지 읽습니다. 설정 파일은 보통 몇 킬로바이트입니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कॉन्फिगरेशन %1$@ KB होईल, पण Right Here जास्तीत जास्त %2$@ KB वाचतो: कॉन्फिगरेशन साधारणपणे काही किलोबाइट असते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurasi akan menjadi %1$@ KB, sedangkan Right Here membaca paling banyak %2$@ KB: konfigurasi biasanya hanya beberapa kilobait."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De configuratie zou %1$@ KB worden, en Right Here leest hooguit %2$@ KB: een configuratie is een paar kilobyte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfiguracja miałaby rozmiar %1$@ KB, a Right Here odczytuje najwyżej %2$@ KB: konfiguracja ma zwykle kilka kilobajtów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A configuração teria %1$@ KB, e o Right Here lê no máximo %2$@ KB: uma configuração tem poucos kilobytes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurația ar avea %1$@ KB, iar Right Here citește cel mult %2$@ KB: o configurație are câțiva kilobyți."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размер конфигурации составил бы %1$@ КБ, а Right Here читает не более %2$@ КБ: конфигурация обычно занимает несколько килобайт."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உள்ளமைவின் அளவு %1$@ KB ஆகும், ஆனால் Right Here அதிகபட்சம் %2$@ KB மட்டுமே படிக்கும்: ஒரு உள்ளமைவு பொதுவாகச் சில கிலோபைட்டுகள்தான்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కాన్ఫిగరేషన్ పరిమాణం %1$@ KB అవుతుంది, కానీ Right Here గరిష్ఠంగా %2$@ KB మాత్రమే చదువుతుంది: కాన్ఫిగరేషన్ సాధారణంగా కొన్ని కిలోబైట్లే ఉంటుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การกำหนดค่าจะมีขนาด %1$@ KB แต่ Right Here อ่านได้ไม่เกิน %2$@ KB โดยปกติการกำหนดค่ามีขนาดเพียงไม่กี่กิโลไบต์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapılandırmanın boyutu %1$@ KB olur, Right Here ise en fazla %2$@ KB okur: bir yapılandırma birkaç kilobayttır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розмір конфігурації становив би %1$@ КБ, а Right Here читає не більше %2$@ КБ: конфігурація зазвичай займає кілька кілобайтів."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کنفیگریشن کا سائز %1$@ KB ہو جائے گا، جبکہ Right Here زیادہ سے زیادہ %2$@ KB پڑھتا ہے: کنفیگریشن عام طور پر چند کلوبائٹ کی ہوتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cấu hình sẽ có dung lượng %1$@ KB, trong khi Right Here chỉ đọc tối đa %2$@ KB: một cấu hình thường chỉ vài kilobyte."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置将达到 %1$@ KB，而 Right Here 最多读取 %2$@ KB：配置通常只有几千字节。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定檔將達到 %1$@ KB，而 Right Here 最多讀取 %2$@ KB：設定檔通常只有幾千位元組。"
          }
        }
      }
    },
    "config.wouldBeInvalid": {
      "comment": "Shown in the setup window (and, in English, by the command line) when a change or a setup did not work. %@ is the problem as the config check says it, in English (a file name, a setting and a sentence).",
