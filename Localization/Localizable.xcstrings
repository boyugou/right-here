    "app.menuEmpty": {
      "comment": "Text in the Finder menu section of the setup window when the config leaves the menu empty or has an error. 'Checks' is the name of a section of the window (app.tabChecks); use the same word.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد قائمة لعرضها الآن. يُذكر السبب ضمن الفحوصات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই মুহূর্তে দেখানোর মতো কোনো মেনু নেই। কারণটি “চেক” পৃষ্ঠায় দেওয়া আছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Moment gibt es kein Menü zum Anzeigen. Der Grund steht auf der Seite „Prüfungen“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχει μενού για εμφάνιση αυτή τη στιγμή. Η αιτία αναφέρεται στη σελίδα «Έλεγχοι»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no menu to show right now. The reason is listed under Checks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora mismo no hay ningún menú que mostrar. El motivo aparece en Comprobaciones."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در حال حاضر منوی قابل نمایشی وجود ندارد. دلیل آن در بخش بررسی‌ها فهرست شده است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun menu à afficher pour l’instant. La raison figure sous Vérifications."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין כרגע תפריט להצגה. הסיבה מופיעה בעמוד ״בדיקות״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी दिखाने के लिए कोई मेन्यू नहीं है। कारण जाँच में सूचीबद्ध है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada menu yang bisa ditampilkan saat ini. Alasannya tercantum di bagian Pemeriksaan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al momento non c’è nessun menu da mostrare. Il motivo è elencato in Controlli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在表示できるメニューがありません。理由は「確認」に表示されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 표시할 메뉴가 없습니다. 이유는 확인 항목에 나와 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सध्या दाखवण्यासाठी कोणताही मेनू नाही. त्याचे कारण तपासण्या विभागात दिले आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada menu untuk dipaparkan buat masa ini. Sebabnya disenaraikan di bawah Semakan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is op dit moment geen menu om te tonen. De reden staat onder Controles."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma teraz menu do pokazania. Przyczyna jest podana w sekcji Kontrole."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No momento não há menu para mostrar. O motivo está listado em Verificações."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Momentan nu există niciun meniu de afișat. Motivul este indicat în secțiunea Verificări."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас нечего показать. Причина указана на странице «Проверки»."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இப்போது காட்ட மெனு எதுவும் இல்லை. காரணம் சோதனைகளின் கீழ் பட்டியலிடப்பட்டுள்ளது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రస్తుతం చూపించడానికి మెనూ ఏదీ లేదు. కారణం తనిఖీల కింద జాబితా చేయబడింది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้ไม่มีเมนูให้แสดง ดูเหตุผลได้ในหน้าการตรวจสอบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu anda gösterilecek bir menü yok. Nedeni Denetimler altında listelenmiştir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зараз немає меню для показу. Причину наведено в розділі «Перевірки»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس وقت دکھانے کے لیے کوئی مینو نہیں ہے۔ وجہ چیکس کے تحت درج ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện không có menu nào để hiển thị. Lý do được liệt kê trong phần Kiểm tra."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在没有可显示的菜单。原因列在“检查”下。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前沒有可顯示的選單。原因列在「檢查」下。"
          }
        }
      }
    },
    "app.menuHiddenHeading": {
      "comment": "Heading in the Finder menu editor above the list of lines that the menu could have and does not have now; checking one of them puts it in the menu. A short phrase, no final period.",
      "extractionState": "manual",
