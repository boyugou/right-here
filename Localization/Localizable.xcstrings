    "doctor.fix.syncFolder": {
      "comment": "Fix line under a check in the setup window's Details list: what the person should do. A sentence. About the config sync feature.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تحقّق من توفّر القرص أو iCloud Drive، أو شغّل `rh config sync push` لإنشاء المجلد، أو اختر مجلدًا آخر باستخدام `rh config sync enable --folder <folder>`‎."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ড্রাইভ বা iCloud Drive পাওয়া যাচ্ছে কি না দেখুন, ফোল্ডার তৈরি করতে `rh config sync push` চালান, অথবা `rh config sync enable --folder <folder>` দিয়ে অন্য একটি বেছে নিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prüfen Sie, ob das Laufwerk oder iCloud Drive verfügbar ist, führen Sie `rh config sync push` aus, um den Ordner anzulegen, oder wählen Sie mit `rh config sync enable --folder <folder>` einen anderen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ελέγξτε ότι ο δίσκος ή το iCloud Drive είναι διαθέσιμο, εκτελέστε `rh config sync push` για να δημιουργήσετε τον φάκελο ή επιλέξτε άλλον με `rh config sync enable --folder <folder>`."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check that the drive or iCloud Drive is available, or run `rh config sync push` to create the folder, or choose another with `rh config sync enable --folder <folder>`."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Compruebe que la unidad o iCloud Drive esté disponible, ejecute `rh config sync push` para crear la carpeta, o elija otra con `rh config sync enable --folder <folder>`."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "بررسی کنید که درایو یا iCloud Drive در دسترس باشد، یا `rh config sync push` را برای ساختن پوشه اجرا کنید، یا با `rh config sync enable --folder <folder>`‎ پوشهٔ دیگری انتخاب کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vérifiez que le disque ou iCloud Drive est disponible, ou exécutez `rh config sync push` pour créer le dossier, ou choisissez-en un autre avec `rh config sync enable --folder <folder>`."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "בדקו שהכונן או iCloud Drive זמינים, או הריצו את `rh config sync push` כדי ליצור את התיקייה, או בחרו תיקייה אחרת עם `rh config sync enable --folder <folder>`‎."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "जाँचें कि ड्राइव या iCloud Drive उपलब्ध है, या फ़ोल्डर बनाने के लिए `rh config sync push` चलाएँ, या `rh config sync enable --folder <folder>` से कोई दूसरा फ़ोल्डर चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pastikan drive atau iCloud Drive tersedia, atau jalankan `rh config sync push` untuk membuat folder, atau pilih folder lain dengan `rh config sync enable --folder <folder>`."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verifica che il disco o iCloud Drive sia disponibile, oppure esegui `rh config sync push` per creare la cartella, oppure scegline un'altra con `rh config sync enable --folder <folder>`."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ドライブまたは iCloud Drive が利用可能か確認するか、`rh config sync push` を実行してフォルダを作成するか、`rh config sync enable --folder <folder>` で別のフォルダを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "드라이브 또는 iCloud Drive를 사용할 수 있는지 확인하거나, `rh config sync push` 명령을 실행해 폴더를 만들거나, `rh config sync enable --folder <folder>` 명령으로 다른 폴더를 선택하세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ड्राइव्ह किंवा iCloud Drive उपलब्ध आहे का ते तपासा, किंवा फोल्डर तयार करण्यासाठी `rh config sync push` चालवा, किंवा `rh config sync enable --folder <folder>` वापरून दुसरे फोल्डर निवडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Semak sama ada pemacu atau iCloud Drive tersedia, atau jalankan `rh config sync push` untuk mencipta folder, atau pilih yang lain dengan `rh config sync enable --folder <folder>`."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Controleer of de schijf of iCloud Drive beschikbaar is, voer `rh config sync push` uit om de map aan te maken, of kies een andere map met `rh config sync enable --folder <folder>`."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sprawdź, czy dysk lub iCloud Drive jest dostępny, uruchom `rh config sync push`, aby utworzyć folder, albo wybierz inny z użyciem `rh config sync enable --folder <folder>`."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verifique se o drive ou o iCloud Drive está disponível, execute `rh config sync push` para criar a pasta ou escolha outra com `rh config sync enable --folder <folder>`."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verificați dacă unitatea sau iCloud Drive este disponibilă, sau rulați `rh config sync push` pentru a crea dosarul, sau alegeți alt dosar cu `rh config sync enable --folder <folder>`."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Проверьте, доступен ли диск или iCloud Drive, или выполните `rh config sync push`, чтобы создать папку, или выберите другую с помощью `rh config sync enable --folder <folder>`."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இயக்ககம் அல்லது iCloud Drive கிடைக்கிறதா எனச் சரிபார்க்கவும், அல்லது கோப்புறையை உருவாக்க `rh config sync push` ஐ இயக்கவும், அல்லது `rh config sync enable --folder <folder>` மூலம் வேறொன்றைத் தேர்ந்தெடுக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "needs_review",
            "value": "డ్రైవ్ లేదా iCloud Drive అందుబాటులో ఉందో లేదో తనిఖీ చేయండి, లేదా ఫోల్డర్‌ను సృష్టించడానికి `rh config sync push` రన్ చేయండి, లేదా `rh config sync enable --folder <folder>` తో మరొకదాన్ని ఎంచుకోండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ตรวจสอบว่าไดรฟ์หรือ iCloud Drive พร้อมใช้งาน หรือเรียกใช้ `rh config sync push` เพื่อสร้างโฟลเดอร์ หรือเลือกโฟลเดอร์อื่นด้วย `rh config sync enable --folder <folder>`."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sürücünün veya iCloud Drive’ın kullanılabilir olduğunu denetleyin, klasörü oluşturmak için `rh config sync push` komutunu çalıştırın veya `rh config sync enable --folder <folder>` ile başka bir klasör seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Перевірте, чи доступний диск або iCloud Drive, або виконайте `rh config sync push`, щоб створити папку, або виберіть іншу за допомогою `rh config sync enable --folder <folder>`."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "دیکھیں کہ ڈرائیو یا iCloud Drive دستیاب ہے، یا فولڈر بنانے کے لیے `rh config sync push` چلائیں، یا `rh config sync enable --folder <folder>`‎ کے ساتھ کوئی اور منتخب کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kiểm tra xem ổ đĩa hoặc iCloud Drive có sẵn sàng không, hoặc chạy `rh config sync push` để tạo thư mục, hoặc chọn thư mục khác bằng `rh config sync enable --folder <folder>`."
