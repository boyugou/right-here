    "refusal.agent.variantBackslash": {
      "comment": "Why an action did nothing, shown in the alert after a click in Finder (and, in English, by the command line). %1$@ is a command-line argument, %2$@ a variant id.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتوي الوسيط «%1$@» في خيار التشغيل «%2$@» على شرطة مائلة عكسية، ولا تقرؤها كل برامج Shell بالطريقة نفسها داخل علامات الاقتباس. ضع الأمر كاملًا في `command` الخاص بالوكيل، والذي يُكتب كما هو."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুরুর বিকল্প “%2$@”-এর আর্গুমেন্ট “%1$@”-এ একটি ব্যাকস্ল্যাশ আছে, যা উদ্ধৃতিচিহ্নের ভেতরে সব শেল একইভাবে পড়ে না। পুরো কমান্ডটি এজেন্টের `command`-এ রাখুন, যা যেমন লেখা আছে তেমনই টাইপ করা হয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Argument „%1$@“ der Startoption „%2$@“ enthält einen Backslash, den nicht alle Shells in Anführungszeichen gleich lesen. Schreibe den ganzen Befehl in den `command` des Agenten, der so eingegeben wird, wie er dasteht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το όρισμα «%1$@» της επιλογής εκκίνησης «%2$@» περιέχει ανάστροφη κάθετο, την οποία δεν διαβάζουν όλα τα κελύφη με τον ίδιο τρόπο μέσα σε εισαγωγικά. Βάλτε ολόκληρη την εντολή στο `command` του πράκτορα, που πληκτρολογείται όπως είναι γραμμένο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The argument \"%1$@\" of the variant \"%2$@\" has a backslash, which shells do not all read the same way inside quotes. Put the whole command in the agent's `command`, which is typed as written."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El argumento «%1$@» de la opción de inicio «%2$@» tiene una barra invertida, que no todos los shells leen igual dentro de comillas. Pon el comando completo en el `command` del agente, que se escribe tal cual."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آرگومان «%1$@» در گزینهٔ شروع «%2$@» یک بک‌اسلش دارد که همهٔ پوسته‌ها آن را داخل گیومه یکسان نمی‌خوانند. کل دستور را در `command` عامل بگذارید که همان‌طور که نوشته شده تایپ می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’argument « %1$@ » de l’option de démarrage « %2$@ » contient une barre oblique inverse, que les shells ne lisent pas tous de la même façon entre guillemets. Mettez toute la commande dans le `command` de l’agent, qui est saisi tel quel."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הארגומנט ״%1$@״ של אפשרות ההפעלה ״%2$@״ מכיל לוכסן הפוך, ולא כל המעטפות קוראות אותו באותו אופן בתוך מירכאות. יש לשים את הפקודה כולה ב-`command` של הסוכן, שמוקלד כפי שהוא כתוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शुरू करने के विकल्प “%2$@” के आर्ग्युमेंट “%1$@” में बैकस्लैश है, जिसे सभी शेल उद्धरण चिह्नों के अंदर एक ही तरह से नहीं पढ़ते। पूरी कमांड एजेंट के `command` में रखें, जो जैसा लिखा है वैसा ही टाइप किया जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Argumen “%1$@” dari opsi mulai “%2$@” berisi garis miring terbalik, yang tidak dibaca dengan cara yang sama oleh semua shell di dalam tanda kutip. Masukkan seluruh perintah ke `command` agen, yang diketik persis seperti tertulis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’argomento “%1$@” dell’opzione di avvio “%2$@” contiene una barra rovesciata, che le shell non leggono tutte allo stesso modo tra virgolette. Metti l’intero comando nel `command` dell’agente, che viene digitato così com’è scritto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起動オプション「%2$@」の引数「%1$@」にバックスラッシュが含まれています。引用符の中のバックスラッシュの解釈はシェルによって異なります。コマンド全体をエージェントの `command` に記述してください。この値は書かれたとおりに入力されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%2$@” 시작 옵션의 인수 “%1$@”에 백슬래시가 있습니다. 따옴표 안의 백슬래시는 셸마다 다르게 읽습니다. 명령 전체를 에이전트의 `command`에 넣으십시오. 이 값은 적힌 그대로 입력됩니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सुरुवातीचा पर्याय “%2$@” मधील आर्ग्युमेंट “%1$@” मध्ये बॅकस्लॅश आहे, आणि अवतरणचिन्हांच्या आतील बॅकस्लॅश सर्व शेल सारखा वाचत नाहीत. संपूर्ण कमांड एजंटच्या `command` मध्ये ठेवा, जी लिहिल्याप्रमाणेच टाइप केली जाते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Argumen “%1$@” bagi pilihan permulaan “%2$@” mengandungi garis condong terbalik, yang tidak dibaca dengan cara yang sama oleh semua cangkerang di dalam tanda petikan. Letakkan seluruh perintah dalam `command` ejen, yang ditaip tepat seperti yang ditulis."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het argument „%1$@” van startoptie „%2$@” bevat een backslash, en niet alle shells lezen een backslash binnen aanhalingstekens op dezelfde manier. Zet het hele commando in `command` van de agent, dat wordt getypt zoals het er staat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Argument „%1$@” opcji uruchamiania „%2$@” zawiera ukośnik wsteczny, a nie wszystkie powłoki odczytują go w cudzysłowie tak samo. Umieść całe polecenie w polu `command` agenta, które jest wpisywane dokładnie tak, jak je zapisano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O argumento “%1$@” da opção de início “%2$@” tem uma barra invertida, que nem todos os shells leem da mesma forma entre aspas. Coloque o comando inteiro no `command` do agente, que é digitado exatamente como está escrito."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Argumentul „%1$@” al opțiunii de pornire „%2$@” conține o bară oblică inversă, pe care nu toate shellurile o citesc la fel între ghilimele. Puneți întreaga comandă în câmpul `command` al agentului, care este tastat exact cum este scris."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аргумент «%1$@» параметра запуска «%2$@» содержит обратную косую черту, а не все оболочки читают ее в кавычках одинаково. Поместите всю команду в поле `command` агента — оно вводится в точности так, как написано."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "“%2$@” தொடக்க விருப்பத்தின் “%1$@” என்ற வாதத்தில் பின்சாய்வுக்கோடு உள்ளது; மேற்கோள் குறிகளுக்குள் உள்ள பின்சாய்வுக்கோட்டை எல்லா shell-களும் ஒரே விதமாகப் படிப்பதில்லை. முழுக் கட்டளையையும் முகவரின் `command` இல் வைக்கவும்; அது எழுதியபடியே தட்டச்சு செய்யப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "“%2$@” ప్రారంభ ఎంపికలోని “%1$@” ఆర్గ్యుమెంట్‌లో బ్యాక్‌స్లాష్ ఉంది; కోట్స్ లోపల ఉన్న బ్యాక్‌స్లాష్‌ను అన్ని shell లు ఒకే విధంగా చదవవు. మొత్తం ఆదేశాన్ని ఏజెంట్ యొక్క `command` లో ఉంచండి; అది రాసినట్లే టైప్ చేయబడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อาร์กิวเมนต์ “%1$@” ของตัวเลือกการเริ่มต้น “%2$@” มีแบ็กสแลช ซึ่งเชลล์แต่ละตัวอ่านแบ็กสแลชในเครื่องหมายคำพูดไม่เหมือนกัน ให้ใส่คำสั่งทั้งหมดไว้ใน `command` ของเอเจนต์ ซึ่งจะถูกพิมพ์ตามที่เขียนไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%2$@” adlı başlatma seçeneğinin “%1$@” argümanında ters eğik çizgi var; kabuklar tırnak içindeki ters eğik çizgiyi aynı biçimde okumaz. Komutun tamamını ajanın `command` alanına yazın; orası yazıldığı gibi girilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аргумент «%1$@» параметра запуску «%2$@» містить зворотну скісну риску, а оболонки не однаково читають її в лапках. Запишіть усю команду в `command` агента — її вводять так, як написано."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شروع کرنے کے اختیار “%2$@” کے آرگیومنٹ “%1$@” میں بیک سلیش ہے، اور تمام شیلز واوین کے اندر بیک سلیش کو ایک ہی طرح نہیں پڑھتیں۔ پوری کمانڈ ایجنٹ کی `command` میں لکھیں، جو جیسی لکھی ہو ویسی ہی ٹائپ کی جاتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đối số “%1$@” của tùy chọn khởi chạy “%2$@” có dấu gạch chéo ngược, mà các shell không đọc giống nhau khi nó nằm trong dấu nháy. Hãy đặt toàn bộ lệnh vào `command` của tác tử, phần này được gõ đúng như đã viết."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动选项“%2$@”的参数“%1$@”中有反斜杠，而各种 shell 对引号内反斜杠的解读并不一致。请把整条命令写进该智能体的 `command`，它会按原样输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟動選項「%2$@」的引數「%1$@」中有反斜線，而各種 shell 對引號內反斜線的解讀並不一致。請把整條指令寫進該代理程式的 `command`，它會按原樣輸入。"
          }
        }
      }
    },
    "refusal.agent.variantNotDesktop": {
      "comment": "Why an action did nothing, shown in the alert after a click in Finder (and, in English, by the command line). A variant is a named set of options of an AI agent.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضيف خيار التشغيل خيارات لسطر الأوامر، لذا لا يمكن تشغيله إلا في وحدة طرفية، وليس عبر تطبيق سطح المكتب."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুরুর বিকল্প কমান্ড-লাইন অপশন যোগ করে, তাই এটি কেবল টার্মিনালে শুরু হতে পারে, ডেস্কটপ অ্যাপের মাধ্যমে নয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Startoption fügt Befehlszeilenoptionen hinzu und kann daher nur in einem Terminal starten, nicht über die Desktop-App."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια επιλογή εκκίνησης προσθέτει επιλογές γραμμής εντολών, οπότε μπορεί να ξεκινήσει μόνο σε τερματικό, όχι μέσω της εφαρμογής υπολογιστή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A variant adds command-line options, so it can only start in a terminal, not through the desktop app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una opción de inicio añade opciones de línea de comandos, así que solo puede iniciarse en una terminal, no mediante la app de escritorio."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "گزینهٔ شروع، گزینه‌های خط فرمان اضافه می‌کند، بنابراین فقط در ترمینال اجرا می‌شود، نه از طریق برنامهٔ دسکتاپ."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une option de démarrage ajoute des options de ligne de commande ; elle ne peut donc démarrer que dans un terminal, pas par l’app de bureau."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשרות הפעלה מוסיפה אפשרויות של שורת הפקודה, ולכן היא יכולה לפעול רק במסוף, לא דרך יישום שולחן העבודה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शुरू करने का विकल्प कमांड-लाइन विकल्प जोड़ता है, इसलिए एजेंट सिर्फ़ टर्मिनल में शुरू हो सकता है, डेस्कटॉप ऐप से नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Opsi mulai menambahkan opsi baris perintah, jadi hanya dapat dimulai di terminal, bukan melalui app desktop."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’opzione di avvio aggiunge opzioni alla riga di comando, quindi con essa l’agente si avvia solo in un terminale, non tramite l’app desktop."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起動オプションはコマンドラインオプションを追加するため、デスクトップアプリ経由ではなく、ターミナルでしか起動できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작 옵션은 명령줄 옵션을 추가하므로 데스크탑 앱이 아니라 터미널에서만 시작할 수 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सुरुवातीचा पर्याय कमांड-लाइन पर्याय जोडतो, त्यामुळे एजंट त्यासह फक्त टर्मिनलमध्ये सुरू होऊ शकतो, डेस्कटॉप ॲपमधून नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilihan permulaan menambah pilihan garis perintah, jadi dengannya ejen hanya boleh dimulakan dalam terminal, bukan melalui aplikasi desktop."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een startoptie voegt commandoregelopties toe, dus daarmee kan de agent alleen in een terminal starten, niet via de bureaubladapp."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcja uruchamiania dodaje opcje wiersza poleceń, więc agenta można z nią uruchomić tylko w terminalu, a nie przez aplikację na komputer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma opção de início adiciona opções de linha de comando, então com ela o agente só pode iniciar em um terminal, não pelo app para desktop."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O opțiune de pornire adaugă opțiuni de linie de comandă, deci agentul poate porni cu ea doar într-un terminal, nu prin aplicația desktop."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Параметр запуска добавляет параметры командной строки, поэтому с ним агент запускается только в терминале, а не через приложение для компьютера."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தொடக்க விருப்பம் கட்டளை வரி விருப்பங்களைச் சேர்க்கிறது, எனவே அதை டெர்மினலில் மட்டுமே தொடங்க முடியும், டெஸ்க்டாப் செயலி வழியாக அல்ல."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రారంభ ఎంపిక కమాండ్-లైన్ ఆప్షన్‌లను జోడిస్తుంది, కాబట్టి అది టెర్మినల్‌లో మాత్రమే ప్రారంభం కాగలదు, డెస్క్‌టాప్ యాప్ ద్వారా కాదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวเลือกการเริ่มต้นจะเพิ่มตัวเลือกบรรทัดคำสั่ง จึงเริ่มได้เฉพาะในเทอร์มินัล ไม่ใช่ผ่านแอปเดสก์ท็อป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir başlatma seçeneği komut satırı seçenekleri ekler, bu yüzden yalnızca bir terminalde başlayabilir, masaüstü uygulaması üzerinden başlayamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Параметр запуску додає параметри командного рядка, тому агента з ним можна запустити лише в терміналі, а не через програму для компʼютера."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شروع کرنے کا اختیار کمانڈ لائن آپشنز شامل کرتا ہے، اس لیے یہ صرف ٹرمینل میں شروع ہو سکتا ہے، ڈیسک ٹاپ ایپ کے ذریعے نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tùy chọn khởi chạy thêm các tùy chọn dòng lệnh, nên chỉ có thể khởi chạy trong terminal, không qua ứng dụng máy tính."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动选项会添加命令行选项，因此只能在终端中启动，不能通过桌面 App 启动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟動選項會加入指令列選項，因此只能在終端機中啟動，不能透過桌面 App 啟動。"
          }
        }
      }
    },
