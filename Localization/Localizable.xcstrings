    "app.aiPromptBody": {
      "comment": "Text under the heading app.aiPromptTitle, next to the button that copies the prompt. 'config file' as in app.checkConfig.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ينسخ موجِّهاً يطلب من مساعدك تشغيل الفحوصات وتكييف ملف الإعدادات مع طريقة عملك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "একটি প্রম্পট কপি করে, যা আপনার সহকারীকে চেকগুলো চালাতে এবং আপনার কাজের ধরন অনুযায়ী কনফিগারেশন ফাইল মানিয়ে নিতে বলে."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kopiert einen Prompt, der Ihren Assistenten bittet, die Prüfungen auszuführen und die Konfigurationsdatei an Ihre Arbeitsweise anzupassen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Αντιγράφει μια προτροπή που ζητά από τον βοηθό σας να εκτελέσει τους ελέγχους και να προσαρμόσει το αρχείο ρυθμίσεων στον τρόπο που εργάζεστε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies a prompt that asks your assistant to run the checks and tailor the config file to how you work."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Copia un prompt que pide a su asistente que ejecute las comprobaciones y ajuste el archivo de configuración a su forma de trabajar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "یک پرامپت را کپی می‌کند که از دستیار شما می‌خواهد بررسی‌ها را اجرا کند و فایل پیکربندی را مطابق روش کار شما تنظیم کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Copie une invite qui demande à votre assistant d’exécuter les vérifications et d’adapter le fichier de configuration à votre façon de travailler."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "מעתיק הנחיה שמבקשת מהעוזר שלכם להריץ את הבדיקות ולהתאים את קובץ הגדרות לאופן שבו אתם עובדים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "एक ऐसा प्रॉम्प्ट कॉपी करता है जो आपके असिस्टेंट से जाँच चलाने और कॉन्फ़िगरेशन फ़ाइल को आपके काम करने के तरीके के अनुसार ढालने के लिए कहता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Menyalin prompt yang meminta asisten Anda menjalankan pemeriksaan dan menyesuaikan berkas konfigurasi dengan cara Anda bekerja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Copia un prompt che chiede al tuo assistente di eseguire i controlli e di adattare il file di configurazione al tuo modo di lavorare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "AIアシスタントに、確認を実行して設定ファイルを作業の進め方に合わせて調整するよう頼むプロンプトをコピーします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "AI 어시스턴트에게 확인 항목을 실행하고 설정 파일을 사용 방식에 맞게 조정하도록 요청하는 프롬프트를 복사합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुमच्या असिस्टंटला तपासण्या चालवण्यास आणि कॉन्फिगरेशन फाइल तुमच्या कामाच्या पद्धतीनुसार जुळवण्यास सांगणारा प्रॉम्प्ट कॉपी करतो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Menyalin gesaan yang meminta pembantu anda menjalankan semakan dan menyesuaikan fail konfigurasi mengikut cara anda bekerja."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kopieert een prompt waarmee je assistent de controles uitvoert en het configuratiebestand afstemt op de manier waarop je werkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kopiuje prompt, który prosi asystenta o uruchomienie kontroli i dostosowanie pliku konfiguracyjnego do sposobu pracy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Copia um prompt que pede ao seu assistente para executar as verificações e ajustar o arquivo de configuração ao seu modo de trabalho."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Copiază un prompt care îi cere asistentului să ruleze verificările și să adapteze fișierul de configurare la modul de lucru."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Копирует промпт с просьбой к ассистенту выполнить проверки и подстроить файл конфигурации под ваш стиль работы."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "உங்கள் உதவியாளரிடம் சோதனைகளை இயக்கவும், உள்ளமைவுக் கோப்பை நீங்கள் பணிபுரியும் விதத்திற்கு ஏற்ப மாற்றவும் கேட்கும் ப்ராம்ப்டை நகலெடுக்கிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "needs_review",
            "value": "మీ సహాయకుడిని తనిఖీలను రన్ చేయమని, కాన్ఫిగరేషన్ ఫైల్ను మీరు పనిచేసే విధానానికి అనుగుణంగా మార్చమని అడిగే ప్రాంప్ట్ను కాపీ చేస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "คัดลอกพรอมต์ที่ขอให้ผู้ช่วยของคุณเรียกใช้การตรวจสอบ และปรับไฟล์ตั้งค่าให้เข้ากับวิธีที่คุณทำงาน."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Asistanınızdan denetimleri çalıştırmasını ve yapılandırma dosyasını çalışma biçiminize uyacak şekilde düzenlemesini isteyen bir istemi kopyalar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Копіює промпт, який просить вашого асистента виконати перевірки та налаштувати файл конфігурації відповідно до вашого способу роботи."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ایک پرامپٹ کاپی کرتا ہے جو آپ کے اسسٹنٹ سے کہتا ہے کہ چیکس چلائے اور کنفیگ فائل کو آپ کے کام کرنے کے طریقے کے مطابق بنائے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sao chép một lời nhắc yêu cầu trợ lý chạy các kiểm tra và điều chỉnh tệp cấu hình theo cách bạn làm việc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "拷贝一段提示词，请助手运行检查，并根据你的工作方式调整配置文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "拷貝一段提示詞，請助理執行檢查，並依你的工作方式調整設定檔。"
          }
        }
      }
    },
