    "app.repairDone": {
      "comment": "Shown under the window's header when the Install or Repair button has finished and changed something. A list of the parts it changed follows on the next line (Runner script, Quick Actions, …). Use the existing translation of the button title Install or Repair exactly (key app.installOrRepair).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهى «تثبيت أو إصلاح». أنشأ أو حدّث ما يلي:"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "“ইনস্টল বা মেরামত করুন” শেষ হয়েছে। এটি যা তৈরি বা আপডেট করেছে:"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Installieren oder reparieren“ ist fertig. Erstellt oder aktualisiert:"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η «Εγκατάσταση ή επισκευή» ολοκληρώθηκε. Δημιούργησε ή ενημέρωσε:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install or Repair is done. It made or updated:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Instalar o reparar» ha terminado. Creó o actualizó:"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "«نصب یا تعمیر» تمام شد. این موارد را ساخت یا به‌روزرسانی کرد:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Installer ou réparer » est terminé. Éléments créés ou mis à jour :"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעולה ״התקנה או תיקון״ הסתיימה. נוצרו או עודכנו:"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“इंस्टॉल या मरम्मत करें” पूरा हो गया। इसने ये बनाए या अपडेट किए:"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "“Instal atau Perbaiki” selesai. Yang dibuat atau diperbarui:"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“Installa o ripara” ha terminato. Ha creato o aggiornato:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「インストールまたは修復」が完了しました。作成または更新した項目："
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“설치 또는 복구”가 완료되었습니다. 만들거나 업데이트한 항목:"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "“इन्स्टॉल किंवा दुरुस्त करा” पूर्ण झाले. याने हे तयार किंवा अपडेट केले:"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "“Pasang atau Baiki” selesai. Item yang dicipta atau dikemas kini:"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Installeer of repareer” is klaar. Gemaakt of bijgewerkt:"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Działanie „Zainstaluj lub napraw” zostało zakończone. Utworzono lub zaktualizowano:"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“Instalar ou Reparar” terminou. Criou ou atualizou:"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "„Instalați sau reparați” s-a încheiat. A creat sau actualizat:"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операция «Установить или восстановить» завершена. Созданы или обновлены:"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "“நிறுவு அல்லது சரிசெய்” முடிந்தது. இது உருவாக்கியவை அல்லது புதுப்பித்தவை:"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "“ఇన్‌స్టాల్ లేదా మరమ్మతు చేయండి” పూర్తయింది. ఇది సృష్టించినవి లేదా అప్‌డేట్ చేసినవి:"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "“ติดตั้งหรือซ่อมแซม” เสร็จแล้ว สิ่งที่สร้างหรืออัปเดต:"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Yükle veya Onar” tamamlandı. Oluşturulanlar veya güncellenenler:"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Інсталювати або полагодити» завершено. Створено або оновлено:"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "“انسٹال یا مرمت کریں” مکمل ہو گیا۔ اس نے یہ بنائے یا اپ ڈیٹ کیے:"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“Cài đặt hoặc sửa chữa” đã xong. Đã tạo hoặc cập nhật:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“安装或修复”已完成。已创建或更新："
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「安裝或修復」已完成。已建立或更新："
          }
        }
      }
    },
    "app.repairDoneUnchanged": {
      "comment": "Shown under the window's header when the Install or Repair button has finished and nothing needed a change. Use the existing translation of the button title Install or Repair exactly (key app.installOrRepair).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهى «تثبيت أو إصلاح». كان كل شيء في مكانه بالفعل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "“ইনস্টল বা মেরামত করুন” শেষ হয়েছে। সবকিছু আগে থেকেই ঠিক ছিল।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Installieren oder reparieren“ ist fertig. Alles war schon eingerichtet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η «Εγκατάσταση ή επισκευή» ολοκληρώθηκε. Όλα ήταν ήδη στη θέση τους."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install or Repair is done. Everything was already in place."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Instalar o reparar» ha terminado. Todo ya estaba en su sitio."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "«نصب یا تعمیر» تمام شد. همه‌چیز از قبل سر جایش بود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Installer ou réparer » est terminé. Tout était déjà en place."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעולה ״התקנה או תיקון״ הסתיימה. הכול כבר היה במקום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“इंस्टॉल या मरम्मत करें” पूरा हो गया। सब कुछ पहले से ठीक था।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "“Instal atau Perbaiki” selesai. Semuanya sudah siap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“Installa o ripara” ha terminato. Era già tutto a posto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「インストールまたは修復」が完了しました。すべてすでに整っていました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“설치 또는 복구”가 완료되었습니다. 모든 항목이 이미 준비되어 있었습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "“इन्स्टॉल किंवा दुरुस्त करा” पूर्ण झाले. सर्व काही आधीच जागेवर होते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "“Pasang atau Baiki” selesai. Semuanya sudah tersedia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Installeer of repareer” is klaar. Alles was al in orde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Działanie „Zainstaluj lub napraw” zostało zakończone. Wszystko było już na miejscu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“Instalar ou Reparar” terminou. Tudo já estava no lugar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "„Instalați sau reparați” s-a încheiat. Totul era deja la locul lui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операция «Установить или восстановить» завершена. Все уже было на месте."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "“நிறுவு அல்லது சரிசெய்” முடிந்தது. அனைத்தும் ஏற்கனவே தயாராக இருந்தன."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "“ఇన్‌స్టాల్ లేదా మరమ్మతు చేయండి” పూర్తయింది. అన్నీ ఇప్పటికే సిద్ధంగా ఉన్నాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "“ติดตั้งหรือซ่อมแซม” เสร็จแล้ว ทุกอย่างพร้อมอยู่แล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Yükle veya Onar” tamamlandı. Her şey zaten yerindeydi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Інсталювати або полагодити» завершено. Усе вже було на місці."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "“انسٹال یا مرمت کریں” مکمل ہو گیا۔ سب کچھ پہلے سے اپنی جگہ پر تھا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“Cài đặt hoặc sửa chữa” đã xong. Mọi thứ đã sẵn sàng từ trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“安装或修复”已完成。一切均已就绪。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「安裝或修復」已完成。一切均已就緒。"
          }
        }
      }
    },
    "app.repairLeft": {
      "comment": "Under the window's header after Install or Repair ran, when checks that it should have put right still ask for it (a copy of the app on disk that macOS keeps registering, for example). %@ is the list of the checks' titles, separated by commas. Keep the %@.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتمل «تثبيت أو إصلاح»، لكن هذه الفحوصات لا تزال تطلبه: %@. توضّح صفحة «الفحوصات» ما الخطأ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "“ইনস্টল বা মেরামত করুন” শেষ হয়েছে, কিন্তু এই চেকগুলো এখনো এটি চাইছে: %@। কী সমস্যা, তা “চেক” পৃষ্ঠায় বলা আছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Installieren oder reparieren“ ist fertig, aber diese Prüfungen verlangen es noch: %@. Auf der Seite „Prüfungen“ steht, was nicht stimmt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η «Εγκατάσταση ή επισκευή» ολοκληρώθηκε, αλλά αυτοί οι έλεγχοι τη ζητούν ακόμη: %@. Η σελίδα «Έλεγχοι» λέει τι δεν πάει καλά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install or Repair is done, but these checks still ask for it: %@. The Checks page says what is wrong."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Instalar o reparar» ha terminado, pero estas comprobaciones aún lo piden: %@. La página Comprobaciones dice qué falla."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "«نصب یا تعمیر» تمام شد، اما این بررسی‌ها هنوز آن را می‌خواهند: %@. صفحهٔ بررسی‌ها می‌گوید چه چیزی درست نیست."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Installer ou réparer » est terminé, mais ces vérifications le demandent encore : %@. La page « Vérifications » indique ce qui ne va pas."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "״התקנה או תיקון״ הסתיים, אך הבדיקות האלה עדיין מבקשות אותו: %@. בעמוד ״בדיקות״ מוסבר מה לא תקין."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“इंस्टॉल या मरम्मत करें” पूरा हुआ, लेकिन ये जाँचें अभी भी इसे माँग रही हैं: %@। क्या गड़बड़ है, यह “जाँच” पेज पर बताया गया है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "“Instal atau Perbaiki” sudah selesai, tetapi pemeriksaan ini masih memintanya: %@. Halaman “Pemeriksaan” menjelaskan masalahnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“Installa o ripara” è terminato, ma questi controlli lo richiedono ancora: %@. La pagina “Controlli” spiega cosa non va."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「インストールまたは修復」は完了しましたが、次の項目がまだそれを求めています: %@。問題の内容は「確認」ページに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치 또는 복구가 완료되었지만 다음 항목에서 여전히 필요하다고 표시됩니다: %@. 무엇이 문제인지는 ‘확인 항목’ 페이지에 표시됩니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "“इन्स्टॉल किंवा दुरुस्त करा” पूर्ण झाले, पण या तपासण्या अजूनही ते मागत आहेत: %@. काय चुकले आहे ते “तपासण्या” पृष्ठावर दिले आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "“Pasang atau Baiki” sudah selesai, tetapi semakan ini masih memintanya: %@. Halaman “Semakan” menerangkan masalahnya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Installeer of repareer” is klaar, maar deze controles vragen er nog om: %@. Op de pagina „Controles” staat wat er mis is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Zainstaluj lub napraw” zakończyło działanie, ale te kontrole nadal tego wymagają: %@. Na stronie „Kontrole” opisano, co jest nie tak."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“Instalar ou Reparar” terminou, mas estas verificações ainda pedem isso: %@. A página “Verificações” diz o que está errado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "„Instalați sau reparați” s-a încheiat, dar aceste verificări o cer în continuare: %@. Pagina „Verificări” arată ce nu este în regulă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Установить или восстановить» завершено, но эти проверки по-прежнему этого требуют: %@. Что не так, указано на странице «Проверки»."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "“நிறுவு அல்லது சரிசெய்” முடிந்தது, ஆனால் இந்தச் சோதனைகள் இன்னும் அதைக் கேட்கின்றன: %@. என்ன தவறு என்பதை “சோதனைகள்” பக்கம் சொல்கிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "“ఇన్‌స్టాల్ లేదా మరమ్మతు చేయండి” పూర్తయింది, కానీ ఈ తనిఖీలు ఇంకా దాన్ని అడుగుతున్నాయి: %@. ఏమి తప్పో “తనిఖీలు” పేజీ చెబుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "“ติดตั้งหรือซ่อมแซม” เสร็จแล้ว แต่การตรวจสอบเหล่านี้ยังขอให้ทำอยู่: %@ หน้า “การตรวจสอบ” จะบอกว่ามีอะไรผิดปกติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Yükle veya Onar” tamamlandı ancak şu denetimler hâlâ bunu istiyor: %@. Neyin yanlış olduğunu “Denetimler” sayfası söylüyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інсталяцію або полагодження завершено, але ці перевірки досі цього вимагають: %@. Що не так, сказано на сторінці «Перевірки»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "“انسٹال یا مرمت کریں” مکمل ہو گیا، لیکن یہ چیکس اب بھی مرمت کا تقاضا کر رہے ہیں: %@۔ چیکس صفحہ بتاتا ہے کہ کیا خرابی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“Cài đặt hoặc sửa chữa” đã xong, nhưng các mục kiểm tra này vẫn yêu cầu: %@. Trang “Kiểm tra” cho biết điều gì chưa ổn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“安装或修复”已完成，但以下检查仍需要它：%@。“检查”页面会说明问题所在。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「安裝或修復」已完成，但以下檢查仍需要它：%@。「檢查」頁面會說明問題所在。"
          }
        }
      }
    },
