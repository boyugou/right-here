    "doctor.fix.claudeLink": {
      "comment": "Fix line under a check in the setup window's Details list: what the person should do. A sentence.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "شغّل `claude` مرة واحدة وأرسل رسالة؛ يسجّل Claude Code المعالِج."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "`claude` একবার চালু করুন এবং একটি প্রম্পট পাঠান; Claude Code হ্যান্ডলারটি নিবন্ধন করে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Starte `claude` einmal und sende eine Eingabe; Claude Code registriert den Handler."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Εκκινήστε το `claude` μία φορά και στείλτε ένα μήνυμα· το Claude Code καταχωρίζει τον χειριστή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start `claude` once and send a prompt; Claude Code registers the handler."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inicia `claude` una vez y envía un mensaje; Claude Code registra el manejador."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "‏`claude` را یک بار اجرا کنید و یک پرامپت ارسال کنید؛ Claude Code کنترل‌کننده را ثبت می‌کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lancez `claude` une fois et envoyez une invite ; Claude Code enregistre le gestionnaire."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "הפעילו את `claude` פעם אחת ושלחו הנחיה; Claude Code רושם את המטפל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "`claude` एक बार चलाएँ और कोई प्रॉम्प्ट भेजें; Claude Code हैंडलर पंजीकृत करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jalankan `claude` sekali dan kirim prompt; Claude Code mendaftarkan handler."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Avvia `claude` una volta e invia un prompt; Claude Code registra il gestore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "`claude` を一度起動してプロンプトを送信してください。Claude Code がハンドラを登録します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "`claude` 명령을 한 번 실행하고 프롬프트를 보내세요. 그러면 Claude Code가 핸들러를 등록합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "`claude` एकदा सुरू करा आणि एक प्रॉम्प्ट पाठवा; Claude Code हँडलर नोंदवते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mulakan `claude` sekali dan hantar satu gesaan; Claude Code mendaftarkan pengendali."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Start `claude` eenmaal en stuur een prompt; Claude Code registreert de handler."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uruchom `claude` raz i wyślij prompt; Claude Code zarejestruje handler."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inicie `claude` uma vez e envie um prompt; o Claude Code registra o manipulador."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Porniți `claude` o dată și trimiteți un prompt; Claude Code înregistrează handler-ul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Один раз запустите `claude` и отправьте запрос; Claude Code зарегистрирует обработчик."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "`claude` ஐ ஒருமுறை தொடங்கி ஒரு prompt ஐ அனுப்பவும்; Claude Code handler ஐப் பதிவு செய்யும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "needs_review",
            "value": "`claude` ను ఒకసారి ప్రారంభించి ఒక prompt పంపండి; Claude Code handler ను రిజిస్టర్ చేస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เรียกใช้ `claude` สักครั้งแล้วส่ง prompt หนึ่งครั้ง; Claude Code จะลงทะเบียน handler."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "`claude` komutunu bir kez başlatın ve bir istem gönderin; Claude Code handler’ı kaydeder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Запустіть `claude` один раз і надішліть запит; Claude Code зареєструє обробник."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "‏`claude` ایک بار شروع کریں اور کوئی پرامپٹ بھیجیں؛ Claude Code ہینڈلر رجسٹر کر دے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Khởi động `claude` một lần và gửi một lời nhắc; Claude Code sẽ đăng ký trình xử lý."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "启动一次 `claude` 并发送一条提示；Claude Code 会注册处理程序。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "啟動一次 `claude` 並傳送一則提示；Claude Code 會註冊處理程式。"
          }
        }
      }
