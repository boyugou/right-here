    "app.variantArgumentsHelp": {
      "comment": "Caption under the list of arguments of a start option (like the caption under the list of an agent's arguments, app.agentArgumentsHelp: use the same wording).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُكتب بعد أمر الوكيل بهذا الترتيب. ويُوضع بين علامتي اقتباس أي وسيط يحتاج إلى ذلك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এজেন্টের কমান্ডের পরে এই ক্রমে টাইপ করা হয়। যে আর্গুমেন্টে উদ্ধৃতি-চিহ্ন লাগে, সেটি উদ্ধৃতি-চিহ্নের ভেতরে রাখা হয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werden in dieser Reihenfolge nach dem Befehl des Agenten eingegeben. Ein Argument, das Anführungszeichen braucht, wird in Anführungszeichen gesetzt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πληκτρολογούνται μετά την εντολή του πράκτορα, με αυτή τη σειρά. Όπου χρειάζεται, ένα όρισμα μπαίνει σε εισαγωγικά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Typed after the agent's command, in this order. An argument that needs it is put in quotes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se escriben después del comando del agente, en este orden. Un argumento que lo necesite va entre comillas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پس از دستور عامل، به همین ترتیب تایپ می‌شوند. آرگومانی که نیاز به گیومه دارد، داخل گیومه گذاشته می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisis après la commande de l’agent, dans cet ordre. Si nécessaire, un argument est mis entre guillemets."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מוקלדים אחרי פקודת הסוכן, לפי הסדר הזה. ארגומנט שצריך מירכאות נכתב בין מירכאות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एजेंट की कमांड के बाद इसी क्रम में टाइप किए जाते हैं। जिस आर्ग्युमेंट को उद्धरण चिह्नों की ज़रूरत हो, उसे उद्धरण चिह्नों में रखा जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diketik setelah perintah agen, sesuai urutan ini. Argumen yang memerlukan tanda kutip diberi tanda kutip."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Digitati dopo il comando dell’agente, in quest’ordine. Un argomento che ne ha bisogno viene messo tra virgolette."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントのコマンドの後に、この順番で入力されます。必要な場合、引数は引用符で囲まれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트 명령 뒤에 이 순서대로 입력됩니다. 필요한 경우 인수는 따옴표로 묶입니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एजंटच्या कमांडनंतर याच क्रमाने टाइप केले जाते. गरज असलेल्या आर्ग्युमेंटला अवतरणचिन्हांमध्ये ठेवले जाते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditaip selepas perintah ejen, mengikut susunan ini. Argumen yang memerlukannya diletakkan dalam tanda petikan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Worden na het commando getypt, in deze volgorde. Een argument dat het nodig heeft, krijgt aanhalingstekens."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisywane po poleceniu agenta, w tej kolejności. Argument, który tego wymaga, zostaje ujęty w cudzysłów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digitados depois do comando, nesta ordem. Um argumento que precise disso vai entre aspas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se scriu după comanda agentului, în această ordine. Un argument este pus între ghilimele când este nevoie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вводятся после команды агента в указанном порядке. При необходимости аргумент заключается в кавычки."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முகவரின் கட்டளைக்குப் பின் இந்த வரிசையில் தட்டச்சு செய்யப்படும். தேவைப்பட்டால் வாதம் மேற்கோள் குறிகளுக்குள் வைக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఏజెంట్ ఆదేశం తర్వాత ఈ క్రమంలో టైప్ చేయబడతాయి. అవసరమైతే ఆర్గ్యుమెంట్‌లు కోట్స్‌లో ఉంచబడతాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จะพิมพ์ต่อท้ายคำสั่งของเอเจนต์ตามลำดับนี้ และอาร์กิวเมนต์ที่ต้องใช้เครื่องหมายคำพูดจะถูกครอบด้วยเครื่องหมายคำพูด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Komuttan sonra bu sırayla yazılır. Gerektiğinde argüman tırnak içine alınır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вводяться після команди агента в такому порядку. Аргументи, які цього потребують, беруться в лапки."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کمانڈ کے بعد اس ترتیب سے ٹائپ کیے جاتے ہیں۔ جس آرگیومنٹ کو اس کی ضرورت ہو، وہ واوین میں لکھا جاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Được gõ sau lệnh của tác tử, theo thứ tự này. Đối số nào cần thì được đặt trong dấu ngoặc kép."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按此顺序接在命令后面。需要时，参数会加上引号。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依此順序接在指令後面。需要時，引數會加上引號。"
          }
        }
      }
    },
