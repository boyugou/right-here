            "value": "יש להריץ את `rh menu --explain` כדי לראות מדוע כל פריט לא נכלל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "`rh menu --explain` चलाएँ और देखें कि हर आइटम क्यों छोड़ा गया है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jalankan `rh menu --explain` untuk melihat alasan setiap item dikecualikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esegui `rh menu --explain` per vedere perché ogni voce viene esclusa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "`rh menu --explain` を実行して、各項目が除外された理由を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "`rh menu --explain` 명령을 실행하여 각 항목이 빠진 이유를 확인하십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "`rh menu --explain` चालवा, म्हणजे प्रत्येक आयटम का वगळला गेला आहे ते दिसेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jalankan `rh menu --explain` untuk melihat sebab setiap item tidak disertakan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Voer `rh menu --explain` uit om te zien waarom elk onderdeel wordt weggelaten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uruchom `rh menu --explain`, aby zobaczyć, dlaczego każda pozycja została pominięta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Execute `rh menu --explain` para ver por que cada item ficou de fora."
          }
        },
        "ro": {
          "stringUnit": {
