    "doctor.fix.configWarnings": {
      "comment": "Fix line under a check in the setup window's Details list: what the person should do. A sentence.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "شغّل `rh config validate`؛ التحذيرات غالبًا أخطاء كتابية، وما كان يُفترض ضبطه غير موجود."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "`rh config validate` চালান; সতর্কবার্তাগুলো সাধারণত টাইপের ভুল, আর যা সেট করার কথা ছিল তা নেই।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Führen Sie `rh config validate` aus; Warnungen sind meist Tippfehler, und was damit gesetzt werden sollte, fehlt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Εκτελέστε `rh config validate`· οι προειδοποιήσεις είναι συνήθως τυπογραφικά λάθη, και λείπει αυτό που έπρεπε να οριστεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run `rh config validate`; warnings are usually typos, and what they were meant to set is missing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ejecute `rh config validate`; las advertencias suelen ser errores tipográficos, y falta lo que se pretendía configurar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "‏`rh config validate` را اجرا کنید؛ هشدارها معمولاً غلط‌های تایپی هستند و مقداری که قرار بوده تنظیم شود، وجود ندارد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Exécutez `rh config validate` ; les avertissements viennent généralement de fautes de frappe, et il manque le réglage qu’ils devaient définir."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "הריצו את `rh config validate`; אזהרות הן בדרך כלל שגיאות הקלדה, וההגדרה שהן אמורות היו לקבוע חסרה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "`rh config validate` चलाएँ; चेतावनियाँ आमतौर पर टाइपिंग की गलतियाँ होती हैं, और जो सेटिंग होनी चाहिए थी, वह गायब है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jalankan `rh config validate`; peringatan biasanya berupa salah ketik, dan pengaturan yang seharusnya diatur belum ada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esegui `rh config validate`; gli avvisi sono di solito errori di digitazione, e manca quanto avrebbero dovuto impostare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "`rh config validate` を実行してください。警告の多くは入力ミスで、本来設定されるはずだった項目が欠けています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "`rh config validate` 명령을 실행하세요. 경고는 대개 오타이며, 설정하려던 항목이 빠져 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "`rh config validate` चालवा. चेतावणी सहसा टायपिंगच्या चुका असतात, आणि जे सेट करायचे होते ते गहाळ आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jalankan `rh config validate`. Amaran biasanya kesilapan menaip, dan tetapan yang sepatutnya ditetapkan itu tiada."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Voer `rh config validate` uit. Waarschuwingen zijn meestal typefouten, en de instelling die bedoeld was, ontbreekt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uruchom `rh config validate`. Ostrzeżenia są zwykle literówkami, a brakuje ustawienia, które miało być ustawione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Execute `rh config validate`. Os avisos costumam ser erros de digitação, e está faltando a configuração que deveria ter sido definida."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rulați `rh config validate`; avertismentele sunt de obicei greșeli de tastare, iar ceea ce trebuiau să seteze lipsește."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Выполните `rh config validate`; предупреждения обычно вызваны опечатками, и то, что они должны были задать, отсутствует."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "`rh config validate` ஐ இயக்கவும்; எச்சரிக்கைகள் பொதுவாகத் தட்டச்சுப் பிழைகளாக இருக்கும்; அவை அமைக்க வேண்டிய மதிப்பு விடுபட்டுள்ளது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "needs_review",
            "value": "`rh config validate` రన్ చేయండి; హెచ్చరికలు సాధారణంగా అక్షర దోషాలే, అవి సెట్ చేయాలనుకున్నది లేకుండా పోయింది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เรียกใช้ `rh config validate`; คำเตือนมักเกิดจากการพิมพ์ผิด และค่าที่ควรตั้งไว้จึงหายไป."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "`rh config validate` komutunu çalıştırın; uyarılar genellikle yazım hatalarıdır ve ayarlanması gereken değer eksiktir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Виконайте `rh config validate`; попередження зазвичай спричинені друкарськими помилками, і того параметра, який мали задати, немає."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "‏`rh config validate` چلائیں؛ انتباہات عموماً ٹائپنگ کی غلطیوں سے آتے ہیں، اور جو سیٹنگ مقصود تھی وہ غائب ہوتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chạy `rh config validate`; cảnh báo thường do gõ sai, và thiết lập lẽ ra phải đặt bị thiếu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "运行 `rh config validate`；警告通常是拼写错误，本应设置的配置项缺失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "執行 `rh config validate`；警告通常是打字錯誤，本應設定的項目卻缺少了。"
          }
        }
      }
    },
