    "doctor.fix.appCopies": {
      "comment": "What to do about several installed copies of the app. %1$@ is the path of the newest copy, such as /Applications/Right Here.app. 'Trash' is the macOS Trash: use the system's name for it in each language. Spotlight is a product name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احتفظ بـ %1$@ وانقل النسخ الأخرى إلى سلة المهملات. قد يفتح Spotlight أيًّا منها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ রাখুন এবং অন্য কপিগুলো Trash-এ সরান। Spotlight এগুলোর যেকোনোটি খুলতে পারে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalte %1$@ und lege die anderen Kopien in den Papierkorb. Spotlight kann jede davon öffnen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κρατήστε το %1$@ και μετακινήστε τα άλλα αντίγραφα στον Κάδο. Το Spotlight μπορεί να ανοίξει οποιοδήποτε από αυτά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep %1$@ and move the other copies to the Trash. Spotlight can open any of them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva %1$@ y mueve las demás copias a la Papelera. Spotlight puede abrir cualquiera de ellas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%1$@ را نگه دارید و نسخه‌های دیگر را به Trash ببرید. Spotlight ممکن است هر کدام از آن‌ها را باز کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservez %1$@ et placez les autres copies dans la Corbeille. Spotlight peut ouvrir n’importe laquelle d’entre elles."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להשאיר את %1$@ ולהעביר את שאר העותקים לפח. Spotlight עלול לפתוח כל אחד מהם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ रखें और बाकी प्रतियों को रद्दी में मूव करें। Spotlight इनमें से कोई भी खोल सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan %1$@ dan pindahkan salinan lainnya ke Tong Sampah. Spotlight dapat membuka salah satu dari salinan tersebut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni %1$@ e sposta le altre copie nel Cestino. Spotlight può aprirne una qualsiasi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ を残し、ほかのコピーをゴミ箱に入れてください。Spotlight は、そのどれを開くこともあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@은(는) 그대로 두고 다른 복사본은 휴지통으로 옮기십시오. Spotlight는 이 중 어느 것이든 열 수 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ठेवा आणि इतर प्रती Trash मध्ये हलवा. Spotlight या प्रतींपैकी कोणतीही प्रत उघडू शकतो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan %1$@ dan pindahkan salinan lain ke Sampah. Spotlight boleh membuka mana-mana salinan itu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar %1$@ en verplaats de andere kopieën naar de prullenmand. Spotlight kan elke kopie openen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowaj %1$@, a pozostałe kopie przenieś do Kosza. Spotlight może otworzyć dowolną z nich."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha %1$@ e mova as outras cópias para o Lixo. O Spotlight pode abrir qualquer uma delas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Păstrați %1$@ și mutați celelalte copii în Coș. Spotlight poate deschide oricare dintre ele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставьте %1$@, а остальные копии переместите в Корзину. Spotlight может открыть любую из них."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ஐ வைத்துக்கொண்டு, மற்ற நகல்களை Trash-க்கு நகர்த்தவும். Spotlight இவற்றில் எதையும் திறக்கக்கூடும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ను ఉంచి, మిగతా కాపీలను Trash కు తరలించండి. Spotlight వీటిలో దేనినైనా తెరవవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เก็บ %1$@ ไว้ แล้วย้ายสำเนาอื่นไปยังถังขยะ Spotlight อาจเปิดสำเนาใดก็ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kopyasını tutun ve diğer kopyaları Çöp Sepeti’ne taşıyın. Spotlight bunlardan herhangi birini açabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залиште %1$@, а інші копії перемістіть у Смітник. Spotlight може відкрити будь-яку з них."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%1$@ رکھیں اور باقی کاپیاں Trash میں منتقل کریں۔ Spotlight ان میں سے کوئی بھی کھول سکتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ lại %1$@ và chuyển các bản sao khác vào Thùng rác. Spotlight có thể mở bất kỳ bản sao nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留 %1$@，并将其他副本移到废纸篓。“聚焦”可能会打开其中任何一个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留 %1$@，並將其他副本移到垃圾桶。Spotlight 可能會打開其中任何一個。"
          }
        }
      }
    },
    "doctor.fix.claudeLink": {
      "comment": "Fix line under a check in the setup window's Details list: what the person should do. A sentence.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شغّل `claude` مرة واحدة وأرسل موجّهًا؛ يسجّل Claude Code المعالِج."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "`claude` একবার চালু করুন এবং একটি প্রম্পট পাঠান; Claude Code হ্যান্ডলারটি নিবন্ধন করে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte `claude` einmal und sende einen Prompt; Claude Code registriert den Handler."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ξεκινήστε το `claude` μία φορά και στείλτε μια προτροπή· το Claude Code καταχωρίζει τον χειριστή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start `claude` once and send a prompt; Claude Code registers the handler."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia `claude` una vez y envía un prompt; Claude Code registra el manejador."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "‏`claude` را یک بار اجرا کنید و یک پرامپت ارسال کنید؛ Claude Code کنترل‌کننده را ثبت می‌کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancez `claude` une fois et envoyez un prompt ; Claude Code enregistre alors le gestionnaire."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להפעיל את `claude` פעם אחת ולשלוח הנחיה; Claude Code ירשום את המטפל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "`claude` एक बार चलाएँ और कोई प्रॉम्प्ट भेजें; Claude Code हैंडलर पंजीकृत करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jalankan `claude` sekali dan kirim prompt; Claude Code mendaftarkan handler."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia `claude` una volta e invia un prompt; Claude Code registra il gestore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "`claude` を一度起動してプロンプトを送信してください。Claude Code がハンドラを登録します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "`claude` 명령을 한 번 실행하고 프롬프트를 보내십시오. 그러면 Claude Code가 핸들러를 등록합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "`claude` एकदा सुरू करा आणि एक प्रॉम्प्ट पाठवा; Claude Code हँडलर नोंदवते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulakan `claude` sekali dan hantar satu gesaan; Claude Code mendaftarkan pengendali."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Start `claude` eenmaal en stuur een prompt; Claude Code registreert de handler."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uruchom `claude` raz i wyślij prompt; Claude Code zarejestruje program obsługi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie `claude` uma vez e envie um prompt; o Claude Code registra o manipulador."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Porniți `claude` o dată și trimiteți un prompt; Claude Code înregistrează handlerul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один раз запустите `claude` и отправьте промпт; Claude Code зарегистрирует обработчик."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "`claude` ஐ ஒருமுறை தொடங்கி ஒரு ப்ராம்ப்ட்டை அனுப்பவும்; Claude Code handler ஐப் பதிவு செய்யும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "`claude` ను ఒకసారి ప్రారంభించి ఒక ప్రాంప్ట్ పంపండి; Claude Code handler ను రిజిస్టర్ చేస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่ม `claude` หนึ่งครั้งและส่งพรอมต์ จากนั้น Claude Code จะลงทะเบียน handler ให้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "`claude` komutunu bir kez başlatın ve bir istem gönderin; Claude Code handler’ı kaydeder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запустіть `claude` один раз і надішліть промпт; Claude Code зареєструє обробник."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "‏`claude` ایک بار شروع کریں اور کوئی پرامپٹ بھیجیں؛ Claude Code ہینڈلر رجسٹر کر دے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khởi chạy `claude` một lần và gửi một lời nhắc; Claude Code sẽ đăng ký trình xử lý."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动一次 `claude` 并发送一条提示词；Claude Code 会注册处理程序。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟動一次 `claude` 並傳送一則提示詞；Claude Code 會註冊處理程式。"
          }
        }
      }
    },
