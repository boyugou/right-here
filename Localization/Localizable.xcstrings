    "app.allSet": {
      "comment": "Summary line in the setup window when every check passed.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل شيء جاهز."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সবকিছু প্রস্তুত।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles ist eingerichtet."
          }
        },
        "el": {
