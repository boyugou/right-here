        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tout est configuré."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "הכול מוגדר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सब कुछ सेट अप है।"
          }
        },
        "id": {
          "stringUnit": {
