          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Виконайте `rh config sync push`, щоб перенести туди конфігурацію цього комп’ютера."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اس کمپیوٹر کی کنفیگ وہاں رکھنے کے لیے `rh config sync push` چلائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chạy `rh config sync push` để đưa cấu hình của máy này lên đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "运行 `rh config sync push`，将本机的配置放到那里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "執行 `rh config sync push`，將本機的設定放到那裡。"
          }
        }
      }
