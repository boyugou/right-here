    "app.noPinned": {
      "comment": "Text shown when the list of pinned folders is empty. The command between backticks stays exactly as it is, <folder> included.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا توجد مجلدات مثبّتة. ثبّت مجلداً باستخدام `rh pin <folder>`‎."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "কোনো পিন করা ফোল্ডার নেই. `rh pin <folder>` দিয়ে একটি পিন করুন."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Keine angehefteten Ordner. Heften Sie einen Ordner mit `rh pin <folder>` an."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Δεν υπάρχουν καρφιτσωμένοι φάκελοι. Καρφιτσώστε έναν με την εντολή `rh pin <folder>`."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No pinned folders. Pin one with `rh pin <folder>`."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No hay carpetas fijadas. Fije una con `rh pin <folder>`."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "هیچ پوشه‌ای سنجاق نشده است. با `rh pin <folder>`‎ یک پوشه را سنجاق کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aucun dossier épinglé. Épinglez-en un avec `rh pin <folder>`."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "אין תיקיות מוצמדות. הצמידו אחת עם `rh pin <folder>`‎."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कोई पिन किया गया फ़ोल्डर नहीं है। `rh pin <folder>` से कोई एक फ़ोल्डर पिन करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Belum ada folder yang disematkan. Sematkan satu dengan `rh pin <folder>`."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nessuna cartella fissata. Fissane una con `rh pin <folder>`."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "固定したフォルダはありません。`rh pin <folder>` で固定できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "고정된 폴더가 없습니다. `rh pin <folder>` 명령으로 고정하세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "पिन केलेले फोल्डर नाहीत. `rh pin <folder>` वापरून एक फोल्डर पिन करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tiada folder yang disemat. Semat satu dengan `rh pin <folder>`."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Geen vastgezette mappen. Zet er een vast met `rh pin <folder>`."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Brak przypiętych folderów. Przypnij folder poleceniem `rh pin <folder>`."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nenhuma pasta fixada. Fixe uma com `rh pin <folder>`."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Niciun dosar fixat. Fixați unul cu `rh pin <folder>`."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Закреплённых папок нет. Закрепите папку командой `rh pin <folder>`."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "பின் செய்யப்பட்ட கோப்புறைகள் எதுவும் இல்லை. `rh pin <folder>` மூலம் ஒன்றைப் பின் செய்யுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "needs_review",
            "value": "పిన్ చేసిన ఫోల్డర్లు ఏవీ లేవు. `rh pin <folder>` తో ఒకదాన్ని పిన్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ยังไม่มีโฟลเดอร์ที่ปักหมุดไว้ ปักหมุดโดยใช้คำสั่ง `rh pin <folder>`."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sabitlenmiş klasör yok. `rh pin <folder>` komutuyla bir klasörü sabitleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Закріплених папок немає. Закріпіть папку командою `rh pin <folder>`."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "کوئی پن کیا ہوا فولڈر نہیں ہے۔ `rh pin <folder>`‎ سے ایک فولڈر پن کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chưa có thư mục nào được ghim. Hãy ghim một thư mục bằng `rh pin <folder>`."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "没有已固定的文件夹。请使用 `rh pin <folder>` 固定一个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "沒有已釘選的資料夾。請使用 `rh pin <folder>` 釘選一個。"
          }
        }
      }
    },
    "app.noRecents": {
      "comment": "Text shown when the list of recent folders is empty.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا توجد مجلدات أخيرة حتى الآن. يعرض Right Here المجلدات التي أرسلها إلى جهة ما."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এখনো কোনো সাম্প্রতিক ফোল্ডার নেই. Right Here সেই ফোল্ডারগুলো তালিকায় দেখায়, যেগুলো এটি কোথাও পাঠিয়েছে."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Noch keine zuletzt verwendeten Ordner. Right Here listet die Ordner auf, die es irgendwohin gesendet hat."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Δεν υπάρχουν ακόμη πρόσφατοι φάκελοι. Το Right Here εμφανίζει τους φακέλους που έχει στείλει κάπου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No recent folders yet. Right Here lists the folders it has sent somewhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Todavía no hay carpetas recientes. Right Here muestra las carpetas que ha enviado a algún destino."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "هنوز پوشه‌ی اخیری وجود ندارد. Right Here پوشه‌هایی را فهرست می‌کند که جایی فرستاده است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aucun dossier récent pour l’instant. Right Here affiche les dossiers qu’il a envoyés quelque part."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "אין עדיין תיקיות אחרונות. Right Here מציג את התיקיות שהוא שלח למקום כלשהו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अभी तक कोई हाल का फ़ोल्डर नहीं है। Right Here उन फ़ोल्डरों की सूची दिखाता है जिन्हें उसने कहीं भेजा है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Belum ada folder terbaru. Right Here menampilkan folder yang pernah dikirimnya ke suatu tempat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nessuna cartella recente per ora. Right Here elenca le cartelle che ha inviato a un'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "最近使ったフォルダはまだありません。Right Here が送信したフォルダが一覧に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "최근 폴더가 아직 없습니다. Right Here는 보냈던 폴더를 여기에 나열합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अलीकडील फोल्डर अद्याप नाहीत. Right Here ने कुठेतरी पाठवलेले फोल्डर इथे सूचीबद्ध केले जातात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Belum ada folder terkini. Right Here menyenaraikan folder yang telah dihantarnya ke suatu tempat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nog geen recente mappen. Right Here toont de mappen die het ergens naartoe heeft gestuurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie ma jeszcze ostatnich folderów. Right Here wyświetla foldery, które zostały gdzieś wysłane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ainda não há pastas recentes. O Right Here lista as pastas que já enviou para algum lugar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Încă nu există dosare recente. Right Here afișează dosarele pe care le-a trimis undeva."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Недавних папок пока нет. Right Here показывает папки, которые были отправлены куда-либо."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இன்னும் சமீபத்திய கோப்புறைகள் இல்லை. Right Here எங்கோ அனுப்பிய கோப்புறைகளைப் பட்டியலிடுகிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ఇంకా ఇటీవలి ఫోల్డర్లు లేవు. Right Here ఎక్కడికో పంపిన ఫోల్డర్లను జాబితా చేస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ยังไม่มีโฟลเดอร์ล่าสุด Right Here แสดงรายการโฟลเดอร์ที่เคยส่งไปยังที่ใดที่หนึ่ง."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Henüz son klasör yok. Right Here, bir yere gönderdiği klasörleri listeler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Останніх папок ще немає. Right Here показує папки, які було надіслано кудись."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ابھی تک کوئی حالیہ فولڈر نہیں ہے۔ Right Here ان فولڈرز کی فہرست دکھاتا ہے جنہیں اس نے کہیں بھیجا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chưa có thư mục gần đây nào. Right Here sẽ liệt kê các thư mục mà nó đã gửi đi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "还没有最近的文件夹。Right Here 会列出它曾经发送过的文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "尚無最近的資料夾。Right Here 會列出它曾經傳送過的資料夾。"
          }
        }
      }
    },
