    "doctor.fix.syncPush": {
      "comment": "Fix line under a check in the setup window's Details list: what the person should do. A sentence. About the config sync feature.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شغّل `rh config sync push` لنسخ إعداد هذا الجهاز إلى هناك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই কম্পিউটারের কনফিগ সেখানে রাখতে `rh config sync push` চালান।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führe `rh config sync push` aus, um die Konfiguration dieses Rechners dorthin zu kopieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εκτελέστε `rh config sync push` για να αποθηκεύσετε εκεί το αρχείο ρυθμίσεων αυτού του υπολογιστή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run `rh config sync push` to put this machine's config there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecuta `rh config sync push` para copiar allí la configuración de este equipo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "‏`rh config sync push` را اجرا کنید تا پیکربندی این دستگاه در آنجا قرار گیرد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécutez `rh config sync push` pour y copier la configuration de cette machine."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להריץ את `rh config sync push` כדי להעתיק לשם את התצורה של מחשב זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस मशीन की कॉन्फ़िग वहाँ रखने के लिए `rh config sync push` चलाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jalankan `rh config sync push` untuk menyimpan konfigurasi mesin ini di sana."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esegui `rh config sync push` per salvarvi la configurazione di questo computer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "`rh config sync push` を実行して、このマシンの設定をそこに置いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "`rh config sync push` 명령을 실행하여 이 기기의 설정을 그곳에 저장하십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या मशीनचा कॉन्फिग तिथे ठेवण्यासाठी `rh config sync push` चालवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jalankan `rh config sync push` untuk meletakkan konfigurasi mesin ini di sana."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer `rh config sync push` uit om de configuratie van deze machine daar te zetten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uruchom `rh config sync push`, aby zapisać konfigurację tego komputera w tym miejscu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Execute `rh config sync push` para colocar a configuração deste computador lá."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rulați `rh config sync push` pentru a pune acolo configurația acestui calculator."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выполните `rh config sync push`, чтобы поместить туда конфигурацию этого компьютера."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தக் கணினியின் உள்ளமைவை அங்கே வைக்க `rh config sync push` ஐ இயக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ కంప్యూటర్ కాన్ఫిగరేషన్‌ను అక్కడ ఉంచడానికి `rh config sync push` రన్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เรียกใช้ `rh config sync push` เพื่อนำการกำหนดค่าของเครื่องนี้ไปเก็บไว้ที่นั่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bilgisayarın yapılandırmasını oraya koymak için `rh config sync push` komutunu çalıştırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виконайте `rh config sync push`, щоб перенести туди конфігурацію цього компʼютера."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس کمپیوٹر کی کنفیگ وہاں رکھنے کے لیے `rh config sync push` چلائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạy `rh config sync push` để đưa cấu hình của máy này lên đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行 `rh config sync push`，将本机的配置放到那里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "執行 `rh config sync push`，將本機的設定放到那裡。"
          }
        }
      }
    },
