    "trust.fileRuns": {
      "comment": "Same card, same form: the contents of a New File template.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يصبح ملفًا قد يشغّله شيء ما على هذا الـ Mac (برنامج نصي، عنصر دخول)"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এটি এমন একটি ফাইল হয়ে যায়, যা এই Mac-এ চালানো হতে পারে (একটি স্ক্রিপ্ট, একটি লগইন আইটেম)"
