    "app.removeIgnoredMessage": {
      "comment": "Message of that confirmation (app.removeIgnoredTitle). %@ is a list of the files and folders, such as .env, node_modules/.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إزالة هذا الـ worktree تحذف أيضًا هذه الملفات التي يتجاهلها git ولا توجد إلا فيه: %@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই worktree সরালে এই ফাইলগুলোও মুছে যাবে, যা git উপেক্ষা করে এবং যা কেবল সেখানেই আছে: %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Entfernen dieses Worktrees werden auch diese Dateien gelöscht, die git ignoriert und die es nur dort gibt: %@"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αφαίρεση αυτού του worktree διαγράφει και αυτά τα αρχεία, που τα αγνοεί το git και υπάρχουν μόνο εκεί: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removing this worktree also deletes these files, which git ignores and which exist only there: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitar este worktree también borra estos archivos, que git ignora y que solo existen ahí: %@"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف این worktree این فایل‌ها را هم پاک می‌کند که git نادیده می‌گیرد و فقط همان‌جا هستند: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer ce worktree efface aussi ces fichiers, que git ignore et qui n’existent que là : %@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסרת ה-worktree הזה מוחקת גם את הקבצים האלה, ש-git מתעלם מהם ושקיימים רק שם: %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस worktree को हटाने से ये फ़ाइलें भी मिट जाएँगी, जिन्हें git अनदेखा करता है और जो सिर्फ़ वहीं हैं: %@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghapus worktree ini juga menghapus file berikut, yang diabaikan git dan hanya ada di sana: %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovere questo worktree elimina anche questi file, che git ignora e che esistono solo lì: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このワークツリーを削除すると、git が無視していてそこにしかない次のファイルも削除されます: %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 워크트리를 제거하면 git이 무시하며 그곳에만 있는 다음 파일도 삭제됩니다: %@"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हे वर्कट्री काढल्यास git दुर्लक्ष करतो अशा आणि फक्त तिथेच असलेल्या या फाइलही हटवल्या जातील: %@"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengeluarkan worktree ini juga memadamkan fail berikut, yang diabaikan oleh git dan hanya wujud di situ: %@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze worktree verwijderen wist ook deze bestanden, die git negeert en die alleen daar bestaan: %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunięcie tego drzewa roboczego skasuje też te pliki, które git ignoruje i które istnieją tylko tam: %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover este worktree também apaga estes arquivos, que o git ignora e que só existem ali: %@"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminarea acestui worktree șterge și aceste fișiere, pe care git le ignoră și care există doar acolo: %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При удалении этого рабочего дерева будут удалены и эти файлы, которые git игнорирует и которые есть только там: %@"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த worktree-ஐ நீக்கினால், git புறக்கணிக்கும், அங்கு மட்டுமே உள்ள இந்தக் கோப்புகளும் அழியும்: %@"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ worktree ను తీసివేస్తే, git పట్టించుకోని, అక్కడ మాత్రమే ఉన్న ఈ ఫైల్‌లు కూడా తొలగిపోతాయి: %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเอา worktree นี้ออกจะลบไฟล์เหล่านี้ด้วย ซึ่ง git ละเว้นและมีอยู่ที่นั่นเท่านั้น: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu worktree’yi kaldırmak, git’in yok saydığı ve yalnızca orada bulunan şu dosyaları da siler: %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вилучення цього worktree видалить і ці файли, які git ігнорує і які є лише там: %@"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس ورک ٹری کو ہٹانے سے یہ فائلیں بھی حذف ہو جائیں گی، جنہیں git نظر انداز کرتا ہے اور جو صرف وہیں ہیں: %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa worktree này cũng sẽ xóa các tệp sau, mà git bỏ qua và chỉ có ở đó: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除此工作树也会删除以下文件，它们被 git 忽略，且只存在于那里：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移除此工作樹也會刪除以下檔案，它們被 git 忽略，且只存在於那裡：%@"
          }
        }
      }
    },
    "app.removeIgnoredTitle": {
      "comment": "Title of a confirmation after the person chose to remove a git worktree that holds files git ignores (for example a .env file), which exist nowhere else and which the removal deletes. A question.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد حذف ملفات غير موجودة في أي إيداع؟"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যে ফাইলগুলো কোনো কমিটে নেই সেগুলো মুছবেন?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien löschen, die in keinem Commit sind?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαγραφή αρχείων που δεν είναι σε κανένα commit;"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete Files That Are in No Commit?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Borrar archivos que no están en ningún commit?"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فایل‌هایی که در هیچ کامیتی نیستند پاک شوند؟"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effacer des fichiers qui ne sont dans aucun commit ?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "למחוק קבצים שאינם באף commit?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो फ़ाइलें किसी कमिट में नहीं हैं, उन्हें मिटाएँ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus file yang tidak ada di commit mana pun?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuoi eliminare i file che non sono in nessun commit?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのコミットにもないファイルを削除しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 커밋에도 없는 파일을 삭제하겠습니까?"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कोणत्याही कमिटमध्ये नसलेल्या फाइल हटवायच्या का?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Padamkan fail yang tiada dalam mana-mana komit?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestanden wissen die in geen enkele commit staan?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunąć pliki, których nie ma w żadnym commicie?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar arquivos que não estão em nenhum commit?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ștergeți fișiere care nu sunt în niciun commit?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить файлы, которых нет ни в одном коммите?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எந்த commit-இலும் இல்லாத கோப்புகளை நீக்கவா?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఏ కమిట్‌లోనూ లేని ఫైల్‌లను తొలగించాలా?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบไฟล์ที่ไม่อยู่ใน commit ใดเลยหรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir commit’te olmayan dosyalar silinsin mi?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалити файли, яких немає в жодному коміті?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وہ فائلیں حذف کریں جو کسی کمٹ میں نہیں؟"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa các tệp không có trong commit nào?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除不在任何提交中的文件？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除不在任何提交中的檔案？"
          }
        }
      }
    },
