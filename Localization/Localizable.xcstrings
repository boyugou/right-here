    "doctor.sync.commandsOwn": {
      "comment": "Detail line of a check in the setup window's Details list; it follows the check's title, so it is a fragment with no final period. About the config sync feature: this Mac's own config starts programs through settings of its own (a custom terminal or agent command). %1$@ is how many settings; %2$@ is the first few of them, written as they are in the config file (technical text, shown as it is).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملف إعداد هذا الجهاز يشغّل برامج خاصة به عبر %1$@ من الإعدادات: %2$@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই কনফিগ %1$@ সেটিংয়ের মাধ্যমে নিজস্ব প্রোগ্রাম চালায়: %2$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "die Konfiguration dieses Rechners startet eigene Programme über %1$@ Einstellung(en): %2$@"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "το αρχείο ρυθμίσεων αυτού του υπολογιστή ξεκινά δικά του προγράμματα μέσω ρυθμίσεων εκκίνησης (%1$@): %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "this config starts programs of its own through %1$@ setting(s): %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "la configuración de este equipo inicia programas propios mediante %1$@ ajuste(s): %2$@"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیکربندی این دستگاه از طریق %1$@ تنظیم، برنامه‌های خودش را اجرا می‌کند: %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "la configuration de cette machine lance ses propres programmes via %1$@ réglage(s) : %2$@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התצורה של מחשב זה מפעילה תוכניות משלה דרך הגדרות (%1$@): %2$@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस मशीन की कॉन्फ़िग %1$@ सेटिंग के ज़रिए अपने प्रोग्राम चलाती है: %2$@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "konfigurasi mesin ini menjalankan program sendiri melalui %1$@ pengaturan: %2$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "la configurazione di questo computer avvia programmi propri tramite %1$@ impostazione/i: %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このマシンの設定は、独自の起動設定 %1$@ 件でプログラムを起動します：%2$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기의 설정이 자체 실행 설정 %1$@개로 프로그램을 실행함: %2$@"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हा कॉन्फिग %1$@ सेटिंग्जद्वारे स्वतःचे प्रोग्राम सुरू करतो: %2$@"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "konfigurasi mesin ini menjalankan program sendiri melalui %1$@ seting: %2$@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "de configuratie van deze machine start eigen programma’s via %1$@ instelling(en): %2$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "konfiguracja tego komputera uruchamia własne programy przez ustawienia uruchamiania (%1$@): %2$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "a configuração deste computador inicia programas próprios por meio de %1$@ ajuste(s) de abertura: %2$@"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "configurația acestui calculator pornește programe proprii prin setări de lansare (%1$@): %2$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "конфигурация этого компьютера запускает собственные программы через настройки запуска (%1$@): %2$@"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த உள்ளமைவு %1$@ அமைப்புகள் மூலம் அதன் சொந்த நிரல்களைத் தொடங்குகிறது: %2$@"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ కాన్ఫిగరేషన్ %1$@ సెట్టింగ్‌ల ద్వారా తన సొంత ప్రోగ్రామ్‌లను ప్రారంభిస్తుంది: %2$@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การกำหนดค่านี้เปิดโปรแกรมของตัวเองผ่านการตั้งค่า %1$@ รายการ: %2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "bu bilgisayarın yapılandırması, %1$@ ayar aracılığıyla kendi programlarını başlatır: %2$@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "конфігурація цього компʼютера запускає власні програми через налаштування запуску (%1$@): %2$@"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس کمپیوٹر کی کنفیگ اپنی سیٹنگز (تعداد: %1$@) کے ذریعے اپنے پروگرام شروع کرتی ہے: %2$@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "cấu hình trên máy này khởi chạy các chương trình riêng qua %1$@ mục cài đặt: %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机配置通过 %1$@ 项自定义启动设置来启动程序：%2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本機設定以 %1$@ 項自訂的啟動設定啟動程式：%2$@"
          }
        }
      }
    },
    "doctor.sync.commandsPending": {
      "comment": "Detail line of a check in the setup window's Details list; it follows the check's title, so it is a fragment with no final period. About the config sync feature: the copy of the config in the sync folder would add or change settings that start programs on this Mac. %1$@ is how many settings; %2$@ is the first few of them, written as they are in the config file (technical text, shown as it is).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستضيف نسخة المجلد أو تغيّر %1$@ من إعدادات التشغيل: %2$@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফোল্ডারের কপি %1$@ চালু করার সেটিং যোগ করবে বা বদলাবে: %2$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "die Kopie im Ordner würde %1$@ Startbefehl-Einstellung(en) hinzufügen oder ändern: %2$@"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "το αντίγραφο στον φάκελο θα πρόσθετε ή θα άλλαζε ρυθμίσεις εκκίνησης (%1$@): %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the folder's copy would add or change %1$@ launch setting(s): %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "la copia de la carpeta añadiría o cambiaría %1$@ ajuste(s) de inicio: %2$@"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نسخهٔ موجود در پوشه، %1$@ تنظیم اجرا را اضافه یا تغییر می‌دهد: %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "la copie du dossier ajouterait ou modifierait %1$@ réglage(s) de lancement : %2$@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העותק שבתיקיה יוסיף או ישנה הגדרות הפעלה (%1$@): %2$@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोल्डर वाली कॉन्फ़िग %1$@ लॉन्च सेटिंग जोड़ या बदल देगी: %2$@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "salinan di folder akan menambah atau mengubah %1$@ pengaturan peluncuran: %2$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "la copia nella cartella aggiungerebbe o modificherebbe %1$@ impostazione/i di avvio: %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダ内のコピーを採用すると、起動設定 %1$@ 件が追加または変更されます：%2$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더의 사본을 가져오면 실행 설정 %1$@개가 추가되거나 변경됨: %2$@"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फोल्डरमधील प्रत %1$@ लाँच सेटिंग्ज जोडेल किंवा बदलेल: %2$@"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "salinan dalam folder akan menambah atau mengubah %1$@ seting pelancaran: %2$@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "de kopie in de map zou %1$@ startinstelling(en) toevoegen of wijzigen: %2$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "kopia konfiguracji w folderze dodałaby lub zmieniła ustawienia uruchamiania (%1$@): %2$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "a configuração na pasta adicionaria ou alteraria %1$@ ajuste(s) de abertura: %2$@"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "configurația din dosar ar adăuga sau modifica setări de lansare (%1$@): %2$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "конфигурация в папке добавила бы или изменила настройки запуска (%1$@): %2$@"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கோப்புறையிலுள்ள நகல் %1$@ தொடக்க அமைப்புகளைச் சேர்க்கும் அல்லது மாற்றும்: %2$@"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫోల్డర్‌లో ఉన్న కాపీ %1$@ ప్రారంభ సెట్టింగ్‌లను జోడిస్తుంది లేదా మారుస్తుంది: %2$@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สำเนาในโฟลเดอร์จะเพิ่มหรือเปลี่ยนการตั้งค่าการเปิดโปรแกรม %1$@ รายการ: %2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "klasördeki kopya %1$@ başlatma ayarını ekleyecek veya değiştirecek: %2$@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "конфігурація в папці додала б або змінила налаштування запуску (%1$@): %2$@"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فولڈر کی کنفیگ لانچ سیٹنگز (تعداد: %1$@) شامل یا تبدیل کرے گی: %2$@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "bản sao trong thư mục sẽ thêm hoặc thay đổi %1$@ mục cài đặt khởi chạy: %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "采用文件夹中的副本会新增或更改 %1$@ 项启动设置：%2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "採用檔案夾中的副本會新增或變更 %1$@ 項啟動設定：%2$@"
          }
        }
      }
    },
