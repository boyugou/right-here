    "app.fixFallbackWindow": {
      "comment": "Checks page: the terminal or editor the config names is not installed, so another one is used. 'it' = that app. 'Overview' = app.tabOverview. Window form of doctor.fix.terminalFallback.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثبّته، أو اختر غيره في صفحة «نظرة عامة»."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি ইনস্টল করুন, অথবা “সারসংক্ষেপ” পৃষ্ঠায় অন্য একটি বেছে নিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiere die App, oder wähle auf der Seite „Übersicht“ eine andere."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εγκαταστήστε την εφαρμογή ή επιλέξτε άλλη στη σελίδα «Επισκόπηση»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install it, or choose another one on the Overview."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala esa app o elige otra en la página Resumen."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آن را نصب کنید، یا در صفحهٔ «نمای کلی» یکی دیگر را انتخاب کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez cette app, ou choisissez-en une autre dans la page Vue d’ensemble."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להתקין את היישום, או לבחור יישום אחר בעמוד ״סקירה כללית״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे इंस्टॉल करें, या “ओवरव्यू” पेज पर कोई दूसरा चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Instal app tersebut, atau pilih yang lain di halaman Ringkasan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installa quell’app, oppure scegline un’altra nella pagina Panoramica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのアプリをインストールするか、「概要」ページで別のものを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 앱을 설치하거나 개요 페이지에서 다른 앱을 선택하십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ते इन्स्टॉल करा, किंवा “आढावा” पृष्ठावर दुसरे निवडा."
          }
        },
        "ms": {
          "stringUnit": {
