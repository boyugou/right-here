    "app.appNotFound": {
      "comment": "Message in the setup window after the person chose an application whose Info.plist has no bundle identifier. %1$@ is the name of the app. 'bundle identifier' as in app.appBundleID. Keep the quotation marks of the language around the name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "‏«%1$@» ليس تطبيقًا يستطيع Right Here العثور عليه، فليس له معرّف حزمة صالح للاستخدام."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%1$@” এমন অ্যাপ নয় যেটি Right Here খুঁজে পেতে পারে: এর কোনো ব্যবহারযোগ্য বান্ডল আইডেন্টিফায়ার নেই।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„%1$@“ ist keine App, die Right Here finden kann, denn sie hat keine verwendbare Bundle-ID."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Το «%1$@» δεν είναι εφαρμογή που το Right Here μπορεί να βρει: δεν έχει χρησιμοποιήσιμο αναγνωριστικό δέσμης."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” is not an app that Right Here can find: it has no usable bundle identifier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«%1$@» no es una app que Right Here pueda encontrar: no tiene un identificador del paquete utilizable."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "‏«%1$@» برنامه‌ای نیست که Right Here بتواند آن را پیدا کند: شناسهٔ باندل قابل‌استفاده ندارد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "« %1$@ » n’est pas une app que Right Here peut trouver : elle n’a pas d’identifiant de bundle utilisable."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "‏Right Here לא יכול למצוא את היישום ״%1$@״: אין לו מזהה חבילה שמיש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%1$@” एक ऐसा ऐप नहीं है जिसे Right Here ढूँढ सके: इसमें कोई उपयोग योग्य बंडल आइडेंटिफ़ायर नहीं है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%1$@” bukan app yang bisa ditemukan oleh Right Here karena tidak memiliki pengenal bundel yang bisa digunakan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%1$@” non è un’app che Right Here può trovare: non ha un identificatore bundle utilizzabile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「%1$@」は、Right Here が見つけられる App ではありません。利用可能なバンドル ID がないためです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here가 “%1$@” 앱을 찾을 수 없습니다. 사용할 수 있는 번들 식별자가 없습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%1$@” हे असे ॲप नाही जे Right Here शोधू शकेल: त्याला वापरण्यायोग्य बंडल आयडेंटिफायर नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%1$@” bukan aplikasi yang boleh ditemui oleh Right Here: ia tidak mempunyai pengecam pakej yang boleh digunakan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„%1$@” is geen app die Right Here kan vinden: hij heeft geen bruikbare bundel-ID."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here nie może znaleźć aplikacji „%1$@”: nie ma ona prawidłowego identyfikatora pakietu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%1$@” não é um app que o Right Here consegue encontrar: ele não tem identificador do pacote utilizável."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„%1$@” nu este o aplicație pe care Right Here o poate găsi: nu are identificator de pachet utilizabil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here не может найти приложение «%1$@»: у него нет пригодного идентификатора пакета."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%1$@” என்பது Right Here கண்டறியக்கூடிய செயலி அல்ல: அதற்கு பயன்படுத்தக்கூடிய பண்டில் அடையாளங்காட்டி இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%1$@” అనేది Right Here కనుగొనగల యాప్ కాదు: దానికి ఉపయోగించదగిన బండిల్ ఐడెంటిఫైయర్ లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%1$@” ไม่ใช่แอปที่ Right Here ค้นหาได้: แอปนี้ไม่มี Bundle identifier ที่ใช้งานได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%1$@”, Right Here’in bulabileceği bir uygulama değil: kullanılabilir bir paket tanıtıcısı yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here не може знайти програму «%1$@»: вона не має придатного ідентифікатора пакета."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "‏“%1$@” ایسی ایپ نہیں ہے جسے Right Here ڈھونڈ سکے: اس میں قابلِ استعمال بنڈل شناخت کنندہ نہیں ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%1$@” không phải là ứng dụng mà Right Here có thể tìm thấy: ứng dụng này không có mã định danh gói dùng được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%1$@”不是 Right Here 能找到的 App：它没有可用的 Bundle 标识符。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「%1$@」不是 Right Here 能找到的 App：它沒有可用的 Bundle 識別碼。"
          }
        }
      }
    },
    "app.appRemove": {
