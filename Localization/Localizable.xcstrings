        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pliku konfiguracji %1$@ nie można użyć: %2$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível usar o arquivo de configuração %1$@: %2$@"
