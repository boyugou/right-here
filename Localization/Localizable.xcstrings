            "value": "Remover “%1$@” das Ações Rápidas"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminați „%1$@” din Acțiunile rapide"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить «%1$@» из быстрых действий"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” ஐ Quick Actions-இலிருந்து அகற்று"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” ను Quick Actions నుండి తీసివేయండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอา “%1$@” ออกจากการทำงานด่วน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” öğesini Hızlı Eylemler’den kaldır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вилучити «%1$@» зі швидких дій"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "‏“%1$@” کو Quick Actions سے ہٹائیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa “%1$@” khỏi Tác vụ nhanh"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从快速操作中移除“%1$@”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從快速動作中移除「%1$@」"
          }
        }
      }
    },
