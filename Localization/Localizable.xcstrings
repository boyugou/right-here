    "app.menuEditCaption": {
      "comment": "Caption above the list while the Finder menu is being edited. 'Config file' is the app's settings file (config.toml).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اسحب سطرًا لنقله. يُحفظ كل تغيير في ملف الإعداد فورًا. ويعرضه فايندر في المرة التالية التي تفتح فيها القائمة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "সরাতে একটি লাইন টেনে আনুন। প্রতিটি পরিবর্তন সঙ্গে সঙ্গে কনফিগারেশন ফাইলে সংরক্ষিত হয়। মেনু পরের বার খুললে Finder তা দেখায়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ziehe eine Zeile, um sie zu verschieben. Jede Änderung wird sofort in deiner Konfigurationsdatei gespeichert. Der Finder zeigt sie beim nächsten Öffnen des Menüs an."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Σύρετε μια γραμμή για να τη μετακινήσετε. Κάθε αλλαγή αποθηκεύεται αμέσως στο αρχείο ρυθμίσεων. Το Finder την εμφανίζει την επόμενη φορά που ανοίγετε το μενού."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag a line to move it. Each change is saved to your config file at once. Finder shows it the next time you open the menu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Arrastra una línea para moverla. Cada cambio se guarda de inmediato en tu archivo de configuración. El Finder lo muestra la próxima vez que abras el menú."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "برای جابه‌جا کردن، یک سطر را بکشید. هر تغییر بلافاصله در فایل پیکربندی شما ذخیره می‌شود. Finder آن را دفعهٔ بعد که منو را باز کنید نشان می‌دهد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Faites glisser une ligne pour la déplacer. Chaque modification est enregistrée immédiatement dans votre fichier de configuration. Le Finder l’affiche la prochaine fois que vous ouvrez le menu."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "כדי להזיז שורה, יש לגרור אותה. כל שינוי נשמר מיד בקובץ התצורה. Finder מציג אותו בפעם הבאה שהתפריט נפתח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "किसी पंक्ति की जगह बदलने के लिए उसे ड्रैग करें। हर बदलाव तुरंत आपकी कॉन्फ़िगरेशन फ़ाइल में सहेजा जाता है। अगली बार जब आप मेन्यू खोलेंगे तो Finder उसे दिखाएगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seret baris untuk memindahkannya. Setiap perubahan langsung disimpan ke file konfigurasi Anda. Finder menampilkannya saat Anda membuka menu lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trascina una riga per spostarla. Ogni modifica viene salvata subito nel file di configurazione. Il Finder la mostra la prossima volta che apri il menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "行をドラッグして移動します。変更はそのたびにすぐ設定ファイルへ保存されます。Finder には、次にメニューを開いたときに反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "항목을 끌어서 옮기십시오. 변경할 때마다 바로 설정 파일에 저장됩니다. Finder에는 다음에 메뉴를 열 때 반영됩니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ओळ ड्रॅग करून हलवा. प्रत्येक बदल लगेच कॉन्फिगरेशन फाइलमध्ये जतन होतो. तुम्ही पुढच्या वेळी मेनू उघडाल तेव्हा Finder तो दाखवतो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seret baris untuk mengalihkannya. Setiap perubahan disimpan dalam fail konfigurasi anda serta-merta. Finder menunjukkannya kali seterusnya anda membuka menu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sleep een regel om hem te verplaatsen. Elke wijziging wordt meteen in het configuratiebestand opgeslagen. Finder toont die de volgende keer dat het menu wordt geopend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przeciągnij wiersz, aby go przenieść. Każda zmiana jest od razu zapisywana w pliku konfiguracji. Finder pokaże ją przy następnym otwarciu menu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Arraste uma linha para movê-la. Cada alteração é salva no arquivo de configuração imediatamente. O Finder a mostra na próxima vez que o menu for aberto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trageți o linie pentru a o muta. Fiecare modificare se salvează imediat în fișierul de configurare. Finder o arată data viitoare când se deschide meniul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Перетащите строку, чтобы переместить ее. Каждое изменение сразу сохраняется в файле конфигурации. Finder покажет его при следующем открытии меню."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "நகர்த்த ஒரு வரியை இழுக்கவும். ஒவ்வொரு மாற்றமும் உடனடியாக உங்கள் உள்ளமைவுக் கோப்பில் சேமிக்கப்படும். நீங்கள் அடுத்த முறை மெனுவைத் திறக்கும்போது Finder அதைக் காட்டும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "needs_review",
            "value": "వరుసను తరలించడానికి దానిని లాగండి. ప్రతి మార్పు వెంటనే మీ కాన్ఫిగరేషన్ ఫైల్‌లో సేవ్ అవుతుంది. మీరు మెనూని తదుపరిసారి తెరిచినప్పుడు Finder దానిని చూపిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ลากบรรทัดเพื่อย้าย การเปลี่ยนแปลงแต่ละครั้งจะถูกบันทึกลงไฟล์การกำหนดค่าของคุณทันที Finder จะแสดงในครั้งถัดไปที่คุณเปิดเมนู"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Taşımak için bir satırı sürükleyin. Her değişiklik hemen yapılandırma dosyanıza kaydedilir. Finder bunu menüyü bir sonraki açışınızda gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Перетягніть рядок, щоб перемістити його. Кожна зміна одразу зберігається у вашому файлі конфігурації. Finder покаже її наступного разу, коли ви відкриєте меню."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "کسی آئٹم کو منتقل کرنے کے لیے اسے گھسیٹیں۔ ہر تبدیلی فوراً آپ کی کنفیگریشن فائل میں محفوظ ہو جاتی ہے۔ اگلی بار جب آپ مینو کھولیں گے تو Finder اسے دکھائے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kéo một mục để di chuyển nó. Mỗi thay đổi được lưu ngay vào tệp cấu hình của bạn. Finder sẽ hiển thị nó khi bạn mở menu lần sau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "拖动一项即可移动它。每项更改都会立即保存到配置文件中。下次打开菜单时访达便会显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "拖移一項即可移動它。每項變更都會立即儲存到設定檔中。下次開啟選單時 Finder 便會顯示。"
          }
        }
      }
    },
