    "app.fixAgentLauncherWindow": {
      "comment": "Checks page: the agent cannot start in the terminal that is used. 'Agents' = app.tabAgents. Window form of doctor.fix.agentLauncher.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اختر وحدة طرفية أخرى أو طريقة أخرى لتشغيله في صفحة الوكيل (الوكلاء)."
          }
        },
        "bn": {
