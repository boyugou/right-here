    "app.appUsesTemplates": {
      "comment": "Caption on the page of a terminal that the config starts through its own command templates (open_args and run_args, which are config keys and are not shown here). 'Config page' is the existing translation of the page's name (glossary entry app.tabConfig).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تُشغَّل هذه الوحدة الطرفية بقوالب في ملف الإعداد. غيّرها كنص في صفحة ملف الإعداد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এই টার্মিনাল কনফিগারেশন ফাইলের টেমপ্লেট দিয়ে চালু হয়। কনফিগ পৃষ্ঠায় টেক্সট হিসেবে সেগুলো বদলান।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieses Terminal wird durch Vorlagen in der Konfigurationsdatei gestartet. Ändere sie als Text auf der Seite „Konfiguration“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Αυτό το τερματικό εκκινείται από πρότυπα στο αρχείο ρυθμίσεων. Αλλάξτε τα ως κείμενο στη σελίδα «Ρυθμίσεις»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This terminal is started by templates in the config file. Change them as text on the Config page."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta terminal se inicia con plantillas del archivo de configuración. Cámbialas como texto en la página Configuración."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "این ترمینال با الگوهای موجود در فایل پیکربندی راه‌اندازی می‌شود. آن‌ها را به‌صورت متن در صفحهٔ پیکربندی تغییر دهید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce terminal est lancé par des modèles du fichier de configuration. Modifiez-les sous forme de texte dans la page Configuration."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "מסוף זה מופעל לפי תבניות בקובץ התצורה. יש לשנות אותן כטקסט בעמוד ״תצורה״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यह टर्मिनल कॉन्फ़िगरेशन फ़ाइल के टेम्पलेटों से शुरू किया जाता है। इन्हें कॉन्फ़िग पेज पर टेक्स्ट के रूप में बदलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terminal ini dijalankan oleh templat di file konfigurasi. Ubah templat tersebut sebagai teks di halaman Konfigurasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questo terminale viene avviato dai modelli nel file di configurazione. Modificali come testo nella pagina Configurazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このターミナルは、設定ファイルのテンプレートによって起動されます。設定ページでテキストとして変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 터미널은 설정 파일의 템플릿에 따라 실행됩니다. 설정 페이지에서 텍스트로 바꾸십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "हे टर्मिनल कॉन्फिगरेशन फाइलमधील टेम्प्लेट्सनुसार सुरू होते. ते कॉन्फिग पृष्ठावर मजकूर म्हणून बदला."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terminal ini dimulakan oleh templat dalam fail konfigurasi. Ubah templat tersebut sebagai teks pada halaman Konfigurasi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deze terminal wordt gestart door sjablonen in het configuratiebestand. Wijzig ze als tekst op de pagina Configuratie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ten terminal jest uruchamiany przez szablony w pliku konfiguracji. Zmień je jako tekst na stronie Konfiguracja."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este terminal é iniciado por modelos no arquivo de configuração. Altere-os como texto na página Configuração."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Acest terminal este pornit de șabloane din fișierul de configurare. Modificați-le ca text pe pagina Configurație."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Этот терминал запускается шаблонами из файла конфигурации. Измените их в виде текста на странице «Конфигурация»."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இந்த டெர்மினல் உள்ளமைவுக் கோப்பிலுள்ள வார்ப்புருக்களால் தொடங்கப்படுகிறது. அவற்றை உரையாக உள்ளமைவுப் பக்கத்தில் மாற்றுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ఈ టెర్మినల్ కాన్ఫిగరేషన్ ఫైల్‌లోని టెంప్లేట్‌ల ద్వారా ప్రారంభమవుతుంది. వాటిని కాన్ఫిగరేషన్ పేజీలో టెక్స్ట్‌గా మార్చండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เทอร์มินัลนี้ถูกเริ่มทำงานโดยเทมเพลตในไฟล์การกำหนดค่า คุณเปลี่ยนแปลงเทมเพลตเหล่านั้นเป็นข้อความได้ในหน้าการกำหนดค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu terminal, yapılandırma dosyasındaki şablonlarla başlatılır. Bunları Yapılandırma sayfasında metin olarak değiştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Цей термінал запускається шаблонами з файлу конфігурації. Змініть їх як текст на сторінці «Конфігурація»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "یہ ٹرمینل کنفیگریشن فائل میں موجود ٹیمپلیٹس سے شروع ہوتا ہے۔ انہیں کنفیگ صفحے پر متن کے طور پر تبدیل کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terminal này được khởi chạy bằng các mẫu lệnh trong tệp cấu hình. Hãy thay đổi chúng dưới dạng văn bản trên trang Cấu hình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此终端由配置文件中的模板启动。请在“配置”页面以文本形式更改它们。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此終端機由設定檔中的範本啟動。請在「設定檔」頁面以文字形式變更這些範本。"
          }
        }
      }
    },
    "app.appsAdd": {
