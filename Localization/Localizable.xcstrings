    "app.appReplacesBuiltIn": {
      "comment": "Caption on the page of an app whose entry in the config has the same id as an app that comes with Right Here, so that it replaces that one. 'entry' is one item of the config file; 'id' is the short name of an item.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستبدل هذا الإدخال التطبيق المضمّن الذي يحمل المعرّف نفسه. أزِله لاستعادة التطبيق المضمّن."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই এন্ট্রি একই আইডির বিল্ট-ইন অ্যাপের জায়গা নেয়। বিল্ট-ইনটি ফিরিয়ে আনতে এটি সরান।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Eintrag ersetzt die eingebaute App mit derselben ID. Entferne ihn, damit die eingebaute App wieder verwendet wird."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η καταχώριση αντικαθιστά την ενσωματωμένη εφαρμογή με το ίδιο αναγνωριστικό. Αφαιρέστε την για να επανέλθει η ενσωματωμένη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This entry replaces the built-in app that has the same id. Remove it to bring the built-in one back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta entrada sustituye a la app integrada que tiene el mismo id. Quítala para recuperar la integrada."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این ورودی جای برنامهٔ داخلی‌ای را می‌گیرد که شناسهٔ یکسان دارد. برای بازگرداندن برنامهٔ داخلی، آن را حذف کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette entrée remplace l’app intégrée qui a le même identifiant. Retirez-la pour rétablir l’app intégrée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רשומה זו מחליפה את היישום המובנה בעל אותו מזהה. כדי להחזיר את היישום המובנה, יש להסיר אותה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह एंट्री उसी आईडी वाले बिल्टइन ऐप की जगह लेती है। बिल्टइन ऐप वापस लाने के लिए इसे हटा दें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Entri ini menggantikan app bawaan yang memiliki ID yang sama. Hapus entri ini untuk mengembalikan app bawaan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa voce sostituisce l’app integrata che ha lo stesso id. Rimuovila per ripristinare quella integrata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この項目は、同じ ID を持つ組み込みの App を置き換えます。組み込みの App を元に戻すには、この項目を削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 항목은 같은 ID를 가진 기본 제공 앱을 대체합니다. 기본 제공 앱을 되돌리려면 이 항목을 제거하십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ही नोंद त्याच आयडीच्या अंगभूत ॲपची जागा घेते. अंगभूत ॲप परत मिळवण्यासाठी ती काढून टाका."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Entri ini menggantikan aplikasi terbina dalam yang mempunyai id yang sama. Keluarkan entri ini untuk mengembalikan aplikasi terbina dalam."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit item vervangt de ingebouwde app met dezelfde id. Verwijder het om de ingebouwde app weer terug te krijgen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten wpis zastępuje wbudowaną aplikację o tym samym identyfikatorze. Usuń go, aby przywrócić wbudowaną aplikację."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta entrada substitui o app integrado que tem o mesmo id. Remova-a para restaurar o app integrado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această intrare înlocuiește aplicația integrată cu același id. Eliminați-o pentru a reveni la cea integrată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта запись заменяет встроенное приложение с тем же идентификатором. Удалите ее, чтобы вернуть встроенное приложение."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அதே id கொண்ட உள்ளமைந்த செயலியை இந்த உள்ளீடு மாற்றுகிறது. அதை மீண்டும் கொண்டுவர இதை அகற்றுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ఎంట్రీ, అదే id ఉన్న అంతర్నిర్మిత యాప్‌ను భర్తీ చేస్తుంది. అంతర్నిర్మిత యాప్‌ను తిరిగి తీసుకురావడానికి దీన్ని తీసివేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการนี้แทนที่แอปในตัวที่มี id เดียวกัน เอารายการนี้ออกเพื่อให้แอปในตัวกลับมาใช้งานได้อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu öğe, aynı id’ye sahip yerleşik uygulamanın yerini alır. Yerleşik uygulamayı geri getirmek için bunu kaldırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей запис замінює вбудовану програму з тим самим id. Вилучіть його, щоб повернути вбудовану програму."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ اندراج اسی id والی بلٹ ان ایپ کی جگہ لیتا ہے۔ بلٹ ان ایپ واپس لانے کے لیے اسے ہٹا دیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mục này thay thế ứng dụng tích hợp có cùng id. Xóa mục này để khôi phục ứng dụng tích hợp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此条目会替换具有相同 id 的内置 App。移除此条目即可恢复内置 App。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此項目會取代具有相同 id 的內建 App。移除此項目即可恢復內建 App。"
          }
        }
      }
    },
