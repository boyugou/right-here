        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסרת ״%1$@״ מהפעולות המהירות"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” को त्वरित क्रिया मेन्यू से हटाएँ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
