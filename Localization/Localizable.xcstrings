    "doctor.services.differ": {
      "comment": "Detail line of a check in the setup window's Details list; it follows the check's title, so it is a fragment with no final period. %1$@ is the number of installed Finder Services; %2$@ how many the config asks for that are not installed; %3$@ how many installed ones the config no longer asks for. Use wording that works for any number.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "المثبَّتة: %1$@، لكنها تختلف عن ملف الإعداد (المفقودة: %2$@، القديمة: %3$@)"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ইনস্টল করা আছে: %1$@, কিন্তু কনফিগের সঙ্গে মিলছে না (অনুপস্থিত: %2$@, পুরোনো: %3$@)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ installiert, aber abweichend von der Konfiguration (fehlend: %2$@, veraltet: %3$@)"
