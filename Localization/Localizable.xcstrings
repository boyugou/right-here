        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "அதை நிறுவவும், அல்லது general.terminal ஐ மாற்றவும் (முதலில் நிறுவப்பட்ட டெர்மினலைப் பயன்படுத்த அமைப்பை நீக்கவும்)."
          }
