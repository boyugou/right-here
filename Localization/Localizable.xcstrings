            "state": "translated",
            "value": "Vuoi avviare %@ senza chiedere?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認せずに%@を起動しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "묻지 않고 %@ 에이전트를 시작하겠습니까?"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ विचारल्याशिवाय सुरू करायचे का?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
