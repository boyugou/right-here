    "doctor.activity.none": {
      "comment": "Detail line of a check in the setup window's Details list; it follows the check's title, so it is a fragment with no final period. No action has been started from Finder yet.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا شيء بعد؛ انقر بالزر الأيمن على مجلد في فايندر واختر إجراءً، ثم شغّل `rh doctor` مرة أخرى"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এখনো কিছু নেই; Finder-এ কোনো ফোল্ডারে ডান-ক্লিক করে একটি অ্যাকশন বেছে নিন, তারপর আবার `rh doctor` চালান"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "noch keine; im Finder einen Ordner mit der rechten Maustaste anklicken, eine Aktion wählen und dann `rh doctor` erneut ausführen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "καμία ακόμη· κάντε δεξί κλικ σε φάκελο στο Finder, επιλέξτε μια ενέργεια και μετά εκτελέστε ξανά το `rh doctor`"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "none yet; right-click a folder in Finder and choose an action, then run `rh doctor` again"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ninguna todavía; haz clic con el botón derecho en una carpeta del Finder, elige una acción y vuelve a ejecutar `rh doctor`"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "هنوز موردی نیست؛ روی پوشه‌ای در Finder کلیک راست کنید و یک کنش را انتخاب کنید، سپس `rh doctor` را دوباره اجرا کنید"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "aucune pour l’instant ; faites un clic droit sur un dossier dans le Finder, choisissez une action, puis relancez `rh doctor`"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "עדיין אין; יש ללחוץ לחיצה ימנית על תיקיה ב-Finder, לבחור פעולה ואז להריץ שוב את `rh doctor`"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अभी तक कोई नहीं; Finder में किसी फ़ोल्डर पर राइट-क्लिक करें और कोई क्रिया चुनें, फिर `rh doctor` दोबारा चलाएँ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "belum ada; klik kanan folder di Finder dan pilih tindakan, lalu jalankan `rh doctor` lagi"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ancora nessuna; fai clic destro su una cartella nel Finder e scegli un’azione, poi esegui di nuovo `rh doctor`"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "まだありません；Finder でフォルダを右クリックして操作を選び、`rh doctor` を再実行"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "아직 없음; Finder에서 폴더를 오른쪽 클릭해 동작을 선택한 다음 `rh doctor` 명령을 다시 실행"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अजून काही नाही; Finder मध्ये फोल्डरवर उजवे-क्लिक करा आणि कृती निवडा, मग `rh doctor` पुन्हा चालवा"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "belum ada; klik kanan pada folder dalam Finder dan pilih tindakan, kemudian jalankan `rh doctor` semula"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "nog niets; klik met de rechtermuisknop op een map in Finder, kies een actie en voer daarna `rh doctor` opnieuw uit"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "jeszcze brak; kliknij folder prawym przyciskiem myszy w Finderze, wybierz czynność, a następnie uruchom ponownie `rh doctor`"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "nenhum ainda; clique com o botão direito em uma pasta no Finder, escolha uma ação e execute `rh doctor` novamente"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "nimic încă; faceți clic dreapta pe un dosar în Finder și alegeți o acțiune, apoi rulați din nou `rh doctor`"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "пока нет; щелкните папку в Finder правой кнопкой мыши, выберите действие и снова выполните `rh doctor`"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இன்னும் இல்லை; Finder இல் ஒரு கோப்புறையில் வலது கிளிக் செய்து ஒரு செயலைத் தேர்ந்தெடுத்து, பிறகு `rh doctor` ஐ மீண்டும் இயக்கவும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ఇంకా ఏదీ లేదు; Finderలో ఫోల్డర్‌పై రైట్-క్లిక్ చేసి ఒక చర్యను ఎంచుకోండి, తర్వాత `rh doctor` ను మళ్లీ రన్ చేయండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ยังไม่มี คลิกขวาที่โฟลเดอร์ใน Finder แล้วเลือกการดำเนินการ จากนั้นเรียกใช้ `rh doctor` อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "henüz yok; Finder’da bir klasöre sağ tıklayıp bir eylem seçin, ardından `rh doctor` komutunu yeniden çalıştırın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ще немає; клацніть папку правою кнопкою миші у Finder, виберіть дію, а потім знову виконайте `rh doctor`"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ابھی تک کوئی نہیں؛ Finder میں کسی فولڈر پر دائیں کلک کریں، کوئی کارروائی منتخب کریں، پھر `rh doctor` دوبارہ چلائیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "chưa có; bấm chuột phải vào một thư mục trong Finder, chọn một tác vụ, rồi chạy lại `rh doctor`"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "尚无；在访达中右键点击文件夹并选择一个操作，然后再次运行 `rh doctor`"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "尚無；在 Finder 中的檔案夾上按右鍵並選擇一個動作，然後再次執行 `rh doctor`"
          }
        }
      }
    },
    "doctor.activity.recent": {
      "comment": "Detail line of a check in the setup window's Details list; it follows the check's title, so it is a fragment with no final period. The latest action started from Finder. %1$@ is an action id such as agent.claude (keep it); %2$@ is the kind of menu it came from, one of items, container, sidebar, toolbar, services: a technical word that stays in English, in quotes if that is natural; %3$@ says how long ago, for example 5 minutes ago.",
