    "doctor.gitMissing": {
      "comment": "Checks page, git row, a warning. git comes with Apple's Command Line Tools or Xcode.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتوي القائمة على روابط المستودع، وبرنامج git غير مثبَّت، لذا سيفشل كل منها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মেনুতে রিপোজিটরি লিংক আছে, এবং git ইনস্টল করা নেই, তাই সেগুলোর প্রতিটি ব্যর্থ হবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Menü enthält Repository-Links, und git ist nicht installiert, daher würde jeder davon fehlschlagen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το μενού έχει συνδέσμους αποθετηρίου, και το git δεν είναι εγκατεστημένο, οπότε καθένας τους θα αποτύγχανε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The menu has repository links, and git is not installed, so each of them would fail."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El menú tiene enlaces del repositorio, y git no está instalado, así que cada uno de ellos fallaría."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "منو پیوندهای مخزن دارد و git نصب نشده است، پس هر کدام از آن‌ها ناموفق خواهد بود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le menu contient des liens du dépôt, et git n’est pas installé, donc chacun d’eux échouerait."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בתפריט יש קישורי מאגר, ו-git אינו מותקן, ולכן כל אחד מהם ייכשל."
