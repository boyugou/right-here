    "app.allSetHint": {
      "comment": "Text under 'Everything is set up.' in the setup window: what to do next. Finder keeps its macOS name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر بالزر الأيمن على مجلد في فايندر لإرساله إلى الوحدة الطرفية أو المحرر أو وكيل الذكاء الاصطناعي لديك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder-এ একটি ফোল্ডারে ডান-ক্লিক করে সেটি আপনার টার্মিনাল, এডিটর বা AI এজেন্টে পাঠান।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke im Finder mit der rechten Maustaste auf einen Ordner, um ihn an dein Terminal, deinen Editor oder deinen KI-Agenten zu senden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάντε δεξί κλικ σε έναν φάκελο στο Finder για να τον στείλετε στο τερματικό, στον επεξεργαστή σας ή στον πράκτορα AI σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Right-click a folder in Finder to send it to your terminal, editor or AI agent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic con el botón derecho en una carpeta del Finder para enviarla a tu terminal, editor o agente de IA."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در Finder روی یک پوشه کلیک راست کنید تا آن را به ترمینال، ویرایشگر یا عامل هوش مصنوعی خود بفرستید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites un clic droit sur un dossier dans le Finder pour l’envoyer à votre terminal, à votre éditeur ou à votre agent IA."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי לשלוח תיקיה למסוף, לעורך או לסוכן AI, יש ללחוץ עליה לחיצה ימנית ב-Finder."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder में किसी फ़ोल्डर पर राइट-क्लिक करके उसे अपने टर्मिनल, एडिटर या AI एजेंट को भेजें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik kanan folder di Finder untuk mengirimnya ke terminal, editor, atau agen AI Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic destro su una cartella nel Finder per inviarla al terminale, all’editor o all’agente IA."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder でフォルダを右クリックすると、ターミナル、エディタ、AIエージェントに送れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder에서 폴더를 오른쪽 클릭하면 터미널, 편집기 또는 AI 에이전트로 보낼 수 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder मधील फोल्डरवर उजवे-क्लिक करून ते तुमच्या टर्मिनल, एडिटर किंवा AI एजंटकडे पाठवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik kanan pada folder dalam Finder untuk menghantarnya ke terminal, editor atau ejen AI anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik met de rechtermuisknop op een map in Finder om die naar je terminal, editor of AI-agent te sturen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij folder prawym przyciskiem myszy w Finderze, aby wysłać go do terminala, edytora lub agenta AI."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique com o botão direito em uma pasta no Finder para enviá-la ao seu terminal, editor ou agente de IA."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Faceți clic dreapta pe un dosar în Finder, pentru a-l trimite în terminal, în editor sau la agentul AI."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Щелкните правой кнопкой мыши по папке в Finder, чтобы отправить ее в терминал, редактор или ИИ-агент."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder-இல் ஒரு கோப்புறையின் மீது வலது கிளிக் செய்து, அதை உங்கள் டெர்மினல், எடிட்டர் அல்லது AI முகவருக்கு அனுப்புங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder లో ఫోల్డర్పై రైట్-క్లిక్ చేసి, దాన్ని మీ టెర్మినల్, ఎడిటర్ లేదా AI ఏజెంట్కు పంపండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลิกขวาที่โฟลเดอร์ใน Finder เพื่อส่งไปยังเทอร์มินัล โปรแกรมแก้ไข หรือเอเจนต์ AI ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder’da bir klasöre sağ tıklayarak onu terminalinize, düzenleyicinize veya YZ ajanınıza gönderin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клацніть папку правою кнопкою миші у Finder, щоб надіслати її до термінала, редактора або ШІ-агента."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کسی فولڈر پر Finder میں دائیں کلک کریں تاکہ اسے اپنے ٹرمینل، ایڈیٹر یا AI ایجنٹ کو بھیجا جا سکے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bấm chuột phải vào một thư mục trong Finder để gửi nó đến terminal, trình soạn thảo hoặc tác tử AI."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在访达中右键点击文件夹，即可将其发送到终端、编辑器或 AI 智能体。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Finder 中的檔案夾上按右鍵，即可將其傳送到終端機、編輯器或 AI 代理程式。"
          }
        }
      }
    },
