          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کنفیگریشن فائل %1$@ استعمال نہیں کی جا سکتی: %2$@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể dùng tệp cấu hình %1$@: %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置文件 %1$@ 无法使用：%2$@"
