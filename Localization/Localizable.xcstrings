    "app.stepTwoBody": {
      "comment": "Step 2 text; a button opens System Settings.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "فعّل Right Here ضمن فايندر في القائمة. تتحدّث هذه الصفحة تلقائيًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "তালিকায় Finder-এর অধীনে Right Here চালু করুন। এই পৃষ্ঠা নিজে থেকে আপডেট হবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aktiviere Right Here unter Finder in der Liste. Diese Seite aktualisiert sich automatisch."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ενεργοποιήστε το Right Here στη λίστα, κάτω από το «Finder». Αυτή η σελίδα ενημερώνεται αυτόματα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch on Right Here under Finder in the list. This page updates by itself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Activa Right Here en la sección Finder de la lista. Esta página se actualiza sola."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "‏Right Here را در فهرست، زیر Finder روشن کنید. این صفحه خودبه‌خود به‌روز می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Activez Right Here dans la liste sous Finder. Cette page se met à jour automatiquement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "יש להפעיל את Right Here תחת Finder ברשימה. עמוד זה מתעדכן מעצמו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सूची में Finder के अंतर्गत Right Here चालू करें। यह पेज अपने आप अपडेट होता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aktifkan Right Here di bawah Finder dalam daftar. Halaman ini diperbarui otomatis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Attiva Right Here alla voce Finder nell’elenco. Questa pagina si aggiorna da sola."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "リストで Finder の Right Here をオンにしてください。このページは自動的に更新されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "목록의 Finder 항목에서 Right Here를 켜십시오. 이 페이지는 자동으로 업데이트됩니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यादीत Finder अंतर्गत Right Here सुरू करा. हे पृष्ठ आपोआप अपडेट होते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aktifkan Right Here di bawah Finder dalam senarai. Halaman ini dikemas kini secara automatik."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schakel Right Here in onder Finder in de lijst. Deze pagina wordt automatisch bijgewerkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Włącz Right Here w sekcji Finder na liście. Ta strona aktualizuje się sama."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ative o Right Here na seção Finder da lista. Esta página é atualizada sozinha."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Activați Right Here în secțiunea Finder din listă. Această pagină se actualizează singură."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Включите Right Here в списке Finder. Эта страница обновляется автоматически."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "பட்டியலில் Finder-இன் கீழ் Right Here-ஐ இயக்கவும். இந்தப் பக்கம் தானாகவே புதுப்பிக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "needs_review",
            "value": "జాబితాలో Finder కింద Right Here ను ఆన్ చేయండి. ఈ పేజీ దానంతట అదే అప్‌డేట్ అవుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เปิดสวิตช์ Right Here ใต้ Finder ในรายการ หน้านี้จะอัปเดตเองโดยอัตโนมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Listede Finder altında Right Here’i açın. Bu sayfa kendiliğinden güncellenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Увімкніть Right Here у списку Finder. Ця сторінка оновлюватиметься автоматично."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "فہرست میں Finder کے تحت Right Here آن کریں۔ یہ صفحہ خود بخود اپ ڈیٹ ہوتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bật Right Here ở mục Finder trong danh sách. Trang này sẽ tự cập nhật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在列表中打开访达下的 Right Here 开关。此页面会自动更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在清單中開啟 Finder 下的 Right Here。此頁面會自動更新。"
          }
        }
      }
    },
    "app.stepTwoTitle": {
      "comment": "Step 2 heading.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "فعّل ملحق فايندر"
          }
