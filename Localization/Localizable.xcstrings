          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "la configuration de cette machine est plus récente que celle du dossier"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התצורה של מחשב זה חדשה יותר מזו שבתיקיה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस मशीन की कॉन्फ़िग फ़ोल्डर वाली से नई है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "konfigurasi mesin ini lebih baru daripada folder"
