    "app.removeWorktreeMessage": {
      "comment": "Text of the confirmation dialog for removing a worktree. %@ is the worktree's folder. 'git' stays as it is.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُحذف %@ من القرص. يبقى فرعه محفوظاً، ويرفض git الحذف إذا كانت في worktree تغييرات لم يتم عمل commit لها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ আপনার ডিস্ক থেকে মুছে ফেলা হবে। এর ব্রাঞ্চ রাখা হবে, এবং worktree-তে commit করা হয়নি এমন পরিবর্তন থাকলে git তা সরাতে দেবে না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird von deiner Festplatte gelöscht. Der Branch bleibt erhalten, und git verweigert das Entfernen, wenn im Worktree Änderungen liegen, die nicht committet sind."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο φάκελος %@ διαγράφεται από τον δίσκο σας. Ο κλάδος του διατηρείται, και το git αρνείται τη διαγραφή αν το worktree έχει αλλαγές που δεν έχουν γίνει commit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is deleted from your disk. Its branch is kept, and git refuses if the worktree has changes that are not committed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se elimina del disco. Su rama se conserva, y git rechaza la operación si el worktree tiene cambios sin confirmar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%@ از دیسک شما حذف می‌شود. شاخهٔ آن نگه داشته می‌شود، اما اگر worktree تغییرهای ثبت‌نشده داشته باشد، git حذف را رد می‌کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sera supprimé de votre disque. Sa branche sera conservée, mais git refusera la suppression si le worktree contient des modifications non validées."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏התיקיה %@ תימחק מהדיסק. הענף של ה-worktree יישמר, ו-git יסרב אם יש ב-worktree שינויים שלא בוצע להם commit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ आपकी डिस्क से हटा दिया जाएगा। उसकी ब्रांच रखी जाएगी, और अगर worktree में बिना commit किए बदलाव हैं, तो git मना कर देगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ akan dihapus dari disk Anda. Branch-nya tetap disimpan, dan git menolak jika worktree memiliki perubahan yang belum di-commit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ viene eliminato dal disco. Il suo branch viene conservato e git rifiuta l’operazione se nel worktree ci sono modifiche non committate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はディスクから削除されます。ブランチは残りますが、ワークツリーにコミットされていない変更があると、git が削除を拒否します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 폴더가 디스크에서 삭제됩니다. 브랜치는 남고, 워크트리에 커밋되지 않은 변경 사항이 있으면 git이 삭제를 거부합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ तुमच्या डिस्कवरून हटवले जाईल. त्याची ब्रांच ठेवली जाईल, आणि वर्कट्रीमध्ये कमिट न केलेले बदल असतील तर git नकार देईल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ akan dipadam daripada cakera anda. Cawangannya dikekalkan, dan git menolak jika worktree mempunyai perubahan yang belum dikomit."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De map %@ wordt van je schijf verwijderd. De branch blijft bewaard, en git weigert als de worktree wijzigingen bevat die niet zijn gecommit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder %@ zostanie usunięty z dysku. Gałąź zostanie zachowana, a git odmówi, jeśli w drzewie roboczym są niezatwierdzone zmiany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pasta %@ será apagada do seu disco. A branch é mantida, e o git se recusa a remover o worktree se ele tiver alterações que não foram commitadas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosarul %@ va fi șters de pe disc. Ramura se păstrează, iar git refuză dacă worktree-ul are modificări care nu sunt în commit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папка %@ будет удалена с диска. Ветка сохранится, но git откажется удалять рабочее дерево, если в нем есть незакоммиченные изменения."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ உங்கள் வட்டிலிருந்து நீக்கப்படும். அதன் branch வைக்கப்படும்; worktree-இல் commit செய்யப்படாத மாற்றங்கள் இருந்தால் git அதை நீக்க மறுக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ మీ డిస్క్ నుండి తొలగించబడుతుంది. దాని బ్రాంచ్ ఉంచబడుతుంది, కమిట్ కాని మార్పులు worktree లో ఉంటే git తిరస్కరిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ จะถูกลบออกจากดิสก์ของคุณ แต่ branch ของ worktree นี้จะยังคงอยู่ และ git จะไม่ยอมลบหาก worktree มีการเปลี่ยนแปลงที่ยังไม่ได้ commit"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ diskinizden silinir. Dalı korunur; worktree’de commit edilmemiş değişiklikler varsa git silmeyi reddeder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ буде видалено з диска. Гілку буде збережено, а git відмовиться видаляти, якщо в worktree є незакомічені зміни."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ فولڈر %@ آپ کی ڈسک سے حذف ہو جائے گا۔ اس کی برانچ برقرار رہے گی، اور اگر ورک ٹری میں ایسی تبدیلیاں ہیں جو کمٹ نہیں ہوئیں تو git انکار کر دے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sẽ bị xóa khỏi ổ đĩa. Nhánh của nó vẫn được giữ lại, còn git sẽ từ chối nếu worktree có thay đổi chưa commit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 将从磁盘中删除。其分支会保留；如果工作树有未提交的更改，git 会拒绝删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 將從磁碟中刪除。其分支會保留；如果工作樹有尚未提交的變更，git 會拒絕刪除。"
          }
        }
      }
    },
