    "app.aiMCPBody": {
      "comment": "Text under the heading app.aiMCPTitle, above a JSON snippet. Claude Desktop and Cursor are app names and stay as they are; 'MCP' stays as it is.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أضِف هذا إلى إعدادات MCP لمساعد AI مثل Claude Desktop أو Cursor، ليتمكن من استخدام Right Here."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Claude Desktop বা Cursor-এর মতো কোনো AI সহকারীর MCP সেটিংসে এটি যোগ করুন, যাতে সে Right Here ব্যবহার করতে পারে."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fügen Sie dies zu den MCP-Einstellungen eines AI-Assistenten wie Claude Desktop oder Cursor hinzu, damit er Right Here verwenden kann."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Προσθέστε αυτό στις ρυθμίσεις MCP ενός βοηθού AI, όπως το Claude Desktop ή το Cursor, ώστε να μπορεί να χρησιμοποιεί το Right Here."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add this to the MCP settings of an AI assistant such as Claude Desktop or Cursor, so that it can use Right Here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Añada esto a los ajustes de MCP de un asistente de AI, como Claude Desktop o Cursor, para que pueda usar Right Here."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "این را به تنظیمات MCP یک دستیار AI مانند Claude Desktop یا Cursor اضافه کنید تا بتواند از Right Here استفاده کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ajoutez ceci aux réglages MCP d’un assistant AI, comme Claude Desktop ou Cursor, afin qu’il puisse utiliser Right Here."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "הוסיפו את זה להגדרות MCP של עוזר AI כמו Claude Desktop או Cursor, כדי שיוכל להשתמש ב-Right Here."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इसे किसी AI असिस्टेंट, जैसे Claude Desktop या Cursor, की MCP सेटिंग में जोड़ें, ताकि वह Right Here का उपयोग कर सके।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tambahkan ini ke pengaturan MCP asisten AI, seperti Claude Desktop atau Cursor, agar asisten tersebut dapat menggunakan Right Here."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aggiungilo alle impostazioni MCP di un assistente AI come Claude Desktop o Cursor, così che possa usare Right Here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Claude Desktop や Cursor などの AIアシスタントの MCP 設定にこれを追加すると、アシスタントが Right Here を使えるようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Claude Desktop이나 Cursor 같은 AI 어시스턴트의 MCP 설정에 이것을 추가하면 어시스턴트가 Right Here를 사용할 수 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Claude Desktop किंवा Cursor सारख्या AI असिस्टंटच्या MCP सेटिंग्जमध्ये हे जोडा, जेणेकरून तो Right Here वापरू शकेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tambahkan ini pada tetapan MCP pembantu AI seperti Claude Desktop atau Cursor supaya ia boleh menggunakan Right Here."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Voeg dit toe aan de MCP-instellingen van een AI-assistent zoals Claude Desktop of Cursor, zodat die Right Here kan gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dodaj to do ustawień MCP asystenta AI, na przykład Claude Desktop lub Cursor, aby mógł korzystać z Right Here."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Adicione isto às configurações MCP de um assistente de AI, como o Claude Desktop ou o Cursor, para que ele possa usar o Right Here."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Adăugați aceasta în setările MCP ale unui asistent AI, precum Claude Desktop sau Cursor, pentru ca acesta să poată folosi Right Here."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Добавьте это в настройки MCP AI-ассистента, например Claude Desktop или Cursor, чтобы он мог использовать Right Here."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Claude Desktop அல்லது Cursor போன்ற AI உதவியாளரின் MCP அமைப்புகளில் இதைச் சேர்க்கவும், அதனால் அது Right Here-ஐப் பயன்படுத்த முடியும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Claude Desktop లేదా Cursor వంటి AI సహాయకుడి MCP సెట్టింగ్లకు దీన్ని జోడించండి, తద్వారా అది Right Here ను ఉపయోగించగలదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เพิ่มข้อความนี้ในการตั้งค่า MCP ของผู้ช่วย AI เช่น Claude Desktop หรือ Cursor เพื่อให้สามารถใช้ Right Here ได้."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bunu, Claude Desktop veya Cursor gibi bir AI asistanının MCP ayarlarına ekleyin; böylece Right Here’ı kullanabilsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Додайте це в налаштування MCP AI-асистента, наприклад Claude Desktop або Cursor, щоб він міг використовувати Right Here."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اسے Claude Desktop یا Cursor جیسے AI اسسٹنٹ کی MCP سیٹنگز میں شامل کریں تاکہ وہ Right Here استعمال کر سکے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Thêm nội dung này vào phần cài đặt MCP của một trợ lý AI như Claude Desktop hoặc Cursor để trợ lý đó có thể dùng Right Here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "将此内容添加到 Claude Desktop 或 Cursor 等 AI 助手的 MCP 设置中，以便其使用 Right Here。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "將此內容加入 Claude Desktop 或 Cursor 等 AI 助理的 MCP 設定中，讓它能使用 Right Here。"
          }
        }
      }
    },
