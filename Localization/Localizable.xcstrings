    "app.stepOneBody": {
      "comment": "Text of step 1 of the first-run card, under the title app.stepOneTitle; below it the terminal and the editor are named. 'config file' as in app.checkConfig.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح Right Here هذين افتراضيًا. لتغييرهما، استخدم القوائم أدناه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here এগুলি ডিফল্টভাবে খোলে। এগুলি বদলাতে নিচের মেনুগুলো ব্যবহার করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here öffnet diese standardmäßig. Um sie zu ändern, nutze die Menüs unten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτά ανοίγει το Right Here από προεπιλογή. Για να τα αλλάξετε, χρησιμοποιήστε τα μενού παρακάτω."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here opens these by default. To change them, use the menus below."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here abre estos de forma predeterminada. Para cambiarlos, usa los menús de abajo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "‏Right Here این‌ها را به‌طور پیش‌فرض باز می‌کند. برای تغییر آن‌ها، از منوهای زیر استفاده کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here les ouvre par défaut. Pour les changer, utilisez les menus ci-dessous."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏Right Here פותח אותם כברירת מחדל. כדי לשנות אותם, יש להשתמש בתפריטים שלמטה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here इन्हें डिफ़ॉल्ट रूप से खोलता है। इन्हें बदलने के लिए, नीचे दिए गए मेन्यू का उपयोग करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here membuka keduanya secara default. Untuk mengubahnya, gunakan menu di bawah ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here apre queste app per impostazione predefinita. Per cambiarle, usa i menu qui sotto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here は既定でこれらを開きます。変更するには、下のメニューで選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here는 기본적으로 이 두 앱을 사용합니다. 바꾸려면 아래 메뉴에서 선택하십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here डीफॉल्टनुसार हे दोन्ही उघडतो. ते बदलण्यासाठी खालील मेनू वापरा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here membuka ini secara lalai. Untuk menukarnya, gunakan menu di bawah."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here opent deze standaard. Om ze te wijzigen, gebruik je de menu's hieronder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Domyślnie Right Here otwiera te aplikacje. Aby je zmienić, skorzystaj z poniższych menu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Right Here abre estes por padrão. Para alterá-los, use os menus abaixo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here folosește aceste aplicații în mod implicit. Pentru a le schimba, folosiți meniurile de mai jos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here открывает их по умолчанию. Чтобы изменить их, используйте меню ниже."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here இவற்றை இயல்புநிலையில் திறக்கும். அவற்றை மாற்ற, கீழே உள்ள மெனுக்களைப் பயன்படுத்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here వీటిని డిఫాల్ట్‌గా తెరుస్తుంది. వాటిని మార్చడానికి, కింద ఉన్న మెనూలను ఉపయోగించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here จะเปิดสิ่งเหล่านี้โดยค่าเริ่มต้น หากต้องการเปลี่ยน ให้ใช้เมนูด้านล่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here bunları saptanmış olarak açar. Değiştirmek için aşağıdaki menüleri kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here типово відкриває саме їх. Щоб змінити їх, скористайтеся меню нижче."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "‏Right Here انہیں ڈیفالٹ طور پر کھولتا ہے۔ انہیں بدلنے کے لیے نیچے دیے گئے مینو استعمال کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here mở chúng theo mặc định. Để thay đổi, dùng các menu bên dưới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here 默认会打开这些应用。如需更改，请使用下方的菜单。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here 預設會開啟這些應用程式。如需變更，請使用下方的選單。"
          }
        }
      }
    },
    "app.stepOneTitle": {
      "comment": "Step 1 heading.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
