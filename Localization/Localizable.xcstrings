          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalați-l sau modificați general.terminal (eliminați setarea pentru a folosi primul terminal instalat)."
          }
        },
        "ru": {
          "stringUnit": {
