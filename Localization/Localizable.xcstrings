    "app.configProposalExplain": {
      "comment": "Explanation on the card of a proposed change.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يحدّد هذا التغيير أيّ برنامج يُشغَّل، أو ما إذا كان الوكيل يسأل قبل أن يتصرف، لذلك ينتظر قرارك. اطّلع على ما يغيّره، ثم طبّقه أو تجاهله."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এটি বদলায় কোন প্রোগ্রাম চালু হবে, অথবা কোনো এজেন্ট কাজ করার আগে জিজ্ঞেস করবে কি না। তাই এটি আপনার সিদ্ধান্তের অপেক্ষায় আছে। এটি কী বদলাচ্ছে দেখুন, তারপর প্রয়োগ বা খারিজ করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diese Änderung betrifft, welches Programm startet oder ob ein Agent nachfragt, bevor er handelt. Deshalb wartet sie auf deine Entscheidung. Prüfe, was sie ändert, und wende sie dann an oder verwirf sie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Αυτή η αλλαγή αφορά το ποιο πρόγραμμα ξεκινά ή το αν ένας πράκτορας ζητά άδεια πριν ενεργήσει. Γι’ αυτό περιμένει την απόφασή σας. Δείτε τι αλλάζει και, στη συνέχεια, εφαρμόστε την ή απορρίψτε την."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This changes which program starts, or whether an agent asks before it acts. So it waits for you. Look at what it changes, then apply it or dismiss it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este cambio afecta a qué programa se abre, o a si un agente pide permiso antes de actuar. Por eso espera tu decisión. Revisa qué cambia y, después, aplícalo o descártalo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "این تغییر بر این اثر می‌گذارد که کدام برنامه باز شود، یا اینکه عامل پیش از اقدام از شما بپرسد یا نه. پس منتظر تصمیم شما می‌ماند. آنچه را عوض می‌کند ببینید، سپس آن را اعمال کنید یا از آن صرف‌نظر کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cette modification change le programme qui se lance, ou détermine si un agent demande confirmation avant d’agir. Elle attend donc votre décision. Examinez ce qu’elle change, puis appliquez-la ou ignorez-la."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "שינוי זה קובע איזו תוכנה מופעלת, או אם סוכן שואל לפני שהוא פועל, ולכן הוא ממתין לאישור. יש לבדוק מה הוא משנה, ואז להחיל או לדחות אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यह बदलाव तय करता है कि कौन-सा प्रोग्राम खुले, या कोई एजेंट कार्रवाई से पहले पूछे या नहीं। इसलिए यह आपके फ़ैसले का इंतज़ार करता है। देखें कि यह क्या बदलता है, फिर इसे लागू करें या ख़ारिज करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ini mengubah program mana yang dibuka atau apakah agen meminta izin sebelum bertindak. Karena itu, perubahan ini menunggu keputusan Anda. Periksa apa yang diubahnya, lalu terapkan atau abaikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questa modifica cambia quale programma si avvia, oppure se un agente chiede conferma prima di agire. Per questo aspetta la tua decisione. Guarda cosa cambia, poi applicala o ignorala."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この変更は、どのプログラムが起動するか、またはエージェントが実行前に確認を求めるかどうかを変えます。そのため、判断を待っています。変更内容を確認してから、適用するか却下してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 변경은 어떤 프로그램이 시작될지, 또는 에이전트가 작업하기 전에 확인을 요청할지를 바꿉니다. 따라서 사용자의 결정을 기다립니다. 변경 내용을 살펴본 다음 적용하거나 무시하십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "हा बदल कोणता प्रोग्राम सुरू होईल, किंवा एजंट कृती करण्यापूर्वी परवानगी विचारेल का, ते बदलतो. म्हणून तो तुमच्या निर्णयाची वाट पाहतो. तो काय बदलतो ते पाहा, मग तो लागू करा किंवा नाकारा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Perubahan ini menukar program mana yang dimulakan, atau sama ada ejen bertanya sebelum bertindak. Jadi ia menunggu keputusan anda. Lihat apa yang diubahnya, kemudian guna atau ketepikan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dit bepaalt welk programma er start, of het bepaalt of een agent eerst vraagt voordat hij iets doet. Daarom wacht het op jou. Bekijk wat er verandert en pas het daarna toe of negeer het."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ta zmiana wpływa na to, który program się uruchamia, albo czy agent pyta, zanim zacznie działać. Dlatego czeka na decyzję. Sprawdź, co zmienia, a potem ją zastosuj albo odrzuć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta alteração muda qual programa é iniciado, ou se um agente pergunta antes de agir. Por isso, ela aguarda sua decisão. Veja o que ela muda e depois aplique-a ou descarte-a."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aceasta modifică ce program pornește sau dacă un agent întreabă înainte să acționeze. De aceea așteaptă o decizie. Uitați-vă la ce modifică și apoi aplicați-o sau ignorați-o."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Это изменение влияет на то, какая программа запускается, или на то, спрашивает ли агент перед действием. Поэтому оно ждет Вашего решения. Посмотрите, что оно меняет, и примените или отклоните его."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இது எந்த நிரல் தொடங்கும் என்பதை, அல்லது ஒரு முகவர் செயல்படுவதற்கு முன் கேட்குமா என்பதை மாற்றுகிறது. எனவே இது உங்கள் முடிவுக்காகக் காத்திருக்கும். இது எதை மாற்றுகிறது என்று பார்த்து, பின்னர் இதைப் பயன்படுத்தவும் அல்லது நிராகரிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ఇది ఏ ప్రోగ్రామ్ ప్రారంభం కావాలో, లేదా ఏజెంట్ చర్య తీసుకునే ముందు అడగాలా వద్దా అనేదాన్ని మారుస్తుంది. కాబట్టి ఇది మీ నిర్ణయం కోసం వేచి ఉంటుంది. ఇది ఏమి మారుస్తుందో చూడండి, ఆపై దీన్ని వర్తింపజేయండి లేదా విస్మరించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การเปลี่ยนแปลงนี้เปลี่ยนว่าโปรแกรมใดจะเริ่มทำงาน หรือว่าเอเจนต์จะถามก่อนลงมือทำหรือไม่ จึงต้องรอคุณ ดูว่าการเปลี่ยนแปลงนี้ทำอะไรบ้าง แล้วจึงปรับใช้หรือปิดทิ้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu, hangi programın başlatılacağını ya da bir ajanın işlem yapmadan önce soru sorup sormayacağını değiştirir. Bu yüzden onayınızı bekler. Neyi değiştirdiğine bakın, sonra uygulayın ya da yoksayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ця зміна стосується того, яка програма запускається, або чи запитує агент дозвіл перед дією. Тому вона чекає на ваше рішення. Перегляньте, що саме вона змінює, а потім застосуйте її або відхиліть."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "یہ تبدیلی طے کرتی ہے کہ کون سا پروگرام شروع ہوگا، یا کوئی ایجنٹ کام کرنے سے پہلے پوچھے گا یا نہیں۔ اس لیے یہ آپ کی منظوری کی منتظر ہے۔ دیکھیں کہ یہ کیا بدلتی ہے، پھر اسے لاگو کریں یا نظر انداز کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Thay đổi này tác động đến việc chương trình nào được khởi chạy, hoặc việc tác tử có hỏi trước khi hành động hay không. Vì vậy nó sẽ chờ bạn. Hãy xem nó thay đổi gì, rồi áp dụng hoặc bỏ qua."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "这会改变启动哪个程序，或智能体行动前是否先询问。所以需要你来确认。请先看看它改了什么，再选择应用或忽略。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "這會改變要啟動哪個程式，或代理程式行動前是否先詢問。所以需要你來確認。請先看看它改了什麼，再選擇套用或忽略。"
          }
        }
      }
    },
