            "value": "شروع عامل‌ها بدون پرسیدن"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrer les agents sans demander"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להפעיל סוכנים בלי לשאול"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एजेंट बिना पूछे शुरू करें"
          }
        },
        "id": {
