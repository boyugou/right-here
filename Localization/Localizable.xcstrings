    "app.menuCaption": {
      "comment": "Caption under the title of the Finder menu preview in the setup window: it shows the menu for a folder, and Finder adds items for selected files when files are selected. Two short sentences at most.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه قائمة المجلد. تظهر العناصر الخاصة بالملفات المحددة عند تحديد ملفات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি একটি ফোল্ডারের মেনু। আপনি ফাইল নির্বাচন করলে নির্বাচিত ফাইলের জন্য আইটেমগুলো দেখা যায়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist das Menü für einen Ordner. Befehle für ausgewählte Dateien erscheinen, wenn du Dateien auswählst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό είναι το μενού για έναν φάκελο. Τα στοιχεία για επιλεγμένα αρχεία εμφανίζονται όταν επιλέξετε αρχεία."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the menu for a folder. Items for selected files appear when you select files."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este es el menú para una carpeta. Los comandos para los archivos seleccionados aparecen cuando seleccionas archivos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این منوی یک پوشه است. گزینه‌های مربوط به فایل‌های انتخاب‌شده وقتی فایل انتخاب می‌کنید ظاهر می‌شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voici le menu d’un dossier. Les commandes pour les fichiers sélectionnés apparaissent lorsque vous sélectionnez des fichiers."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זהו התפריט של תיקיה. כשבוחרים קבצים, מופיעים גם פריטים עבורם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह एक फ़ोल्डर का मेन्यू है। चयनित फ़ाइलों के आइटम तभी दिखते हैं, जब आप फ़ाइलें चुनते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini adalah menu untuk folder. Item untuk file yang dipilih muncul saat Anda memilih file."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo è il menu per una cartella. Le voci per i file selezionati compaiono quando selezioni dei file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはフォルダ用のメニューです。選択したファイル向けの項目は、ファイルを選択したときに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이것은 폴더용 메뉴입니다. 선택한 파일에 해당하는 항목은 파일을 선택하면 나타납니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हा एका फोल्डरचा मेनू आहे. निवडलेल्या फाइल्ससाठीचे आयटम्स तुम्ही फाइल्स निवडता तेव्हा दिसतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini ialah menu untuk folder. Item untuk fail yang dipilih muncul apabila anda memilih fail."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is het menu voor een map. Onderdelen voor geselecteerde bestanden verschijnen wanneer je bestanden selecteert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To jest menu dla folderu. Pozycje dotyczące plików pojawiają się dopiero po ich zaznaczeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este é o menu para uma pasta. Os itens para arquivos aparecem somente quando arquivos são selecionados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acesta este meniul pentru un dosar. Articolele pentru fișiere apar când selectați fișiere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это меню для папки. Пункты для выбранных файлов появляются только при выборе файлов."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது ஒரு கோப்புறைக்கான மெனு. நீங்கள் கோப்புகளைத் தேர்ந்தெடுக்கும்போது, தேர்ந்தெடுத்த கோப்புகளுக்கான உருப்படிகள் தோன்றும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇది ఫోల్డర్ కోసం మెనూ. మీరు ఫైల్స్ ఎంచుకున్నప్పుడు, ఎంచుకున్న ఫైల్స్ కోసం అంశాలు కనిపిస్తాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่คือเมนูสำหรับโฟลเดอร์ รายการสำหรับไฟล์ที่เลือกจะปรากฏขึ้นเมื่อคุณเลือกไฟล์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, bir klasör için menüdür. Seçili dosyalara yönelik öğeler, dosya seçtiğinizde görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це меню для папки. Пункти для вибраних файлів зʼявляються, коли ви вибираєте файли."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ فولڈر کا مینو ہے۔ منتخب فائلوں سے متعلق آئٹمز اس وقت ظاہر ہوتے ہیں جب آپ فائلیں منتخب کرتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là menu cho một thư mục. Các mục dành cho tệp đã chọn chỉ xuất hiện khi bạn chọn tệp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是文件夹的菜单。选中文件时，针对所选文件的项目才会出现。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是檔案夾的選單。選取檔案時，針對所選檔案的項目才會出現。"
          }
        }
      }
    },
    "app.menuDefaultNote": {
      "comment": "Note above the menu editor when the config file does not list the menu yet. 'Config file' is the app's settings file (config.toml).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه هي القائمة الافتراضية. عند أول تغيير تُكتب قائمة الأسطر في ملف الإعداد، ومن ذلك الحين يحدد الملف ما تعرضه القائمة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি ডিফল্ট মেনু। প্রথম পরিবর্তনের সময় লাইনের তালিকা কনফিগারেশন ফাইলে লেখা হয়, এরপর থেকে ফাইলটিই সিদ্ধান্ত নেয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist das Standardmenü. Die erste Änderung schreibt die Liste der Zeilen in die Konfigurationsdatei, und von da an entscheidet die Datei."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό είναι το προεπιλεγμένο μενού. Η πρώτη αλλαγή γράφει τη λίστα των γραμμών στο αρχείο ρυθμίσεων, και από τότε και στο εξής αποφασίζει το αρχείο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the default menu. Your first change writes the list of lines to your config file, and from then on the file decides."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este es el menú predeterminado. El primer cambio escribe la lista de líneas en el archivo de configuración, y a partir de entonces decide el archivo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این منوی پیش‌فرض است. اولین تغییر شما فهرست سطرها را در فایل پیکربندی می‌نویسد و از آن پس، همان فایل تعیین می‌کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voici le menu par défaut. Votre première modification écrit la liste des lignes dans votre fichier de configuration ; à partir de là, c’est ce fichier qui décide."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זהו תפריט ברירת המחדל. השינוי הראשון יכתוב את רשימת השורות לקובץ התצורה, ומאותו רגע הקובץ הוא שקובע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह डिफ़ॉल्ट मेन्यू है। आपका पहला बदलाव पंक्तियों की सूची आपकी कॉन्फ़िगरेशन फ़ाइल में लिख देगा, और उसके बाद से वही फ़ाइल तय करेगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini adalah menu default. Perubahan pertama Anda akan menuliskan daftar baris ke file konfigurasi, dan sejak itu file itulah yang menentukan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo è il menu predefinito. La prima modifica scrive l’elenco delle righe nel file di configurazione, e da quel momento decide il file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは既定のメニューです。最初に変更すると、行の一覧が設定ファイルに書き込まれ、それ以降は設定ファイルの内容で決まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이것은 기본 메뉴입니다. 처음 변경하면 항목 목록이 설정 파일에 기록되고, 그 후로는 설정 파일에 따라 메뉴가 정해집니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हा डीफॉल्ट मेनू आहे. तुमचा पहिला बदल ओळींची यादी कॉन्फिगरेशन फाइलमध्ये लिहितो, आणि तेव्हापासून फाइलच ठरवते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini ialah menu lalai. Perubahan pertama anda menulis senarai baris ke dalam fail konfigurasi, dan selepas itu fail tersebutlah yang menentukan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is het standaardmenu. De eerste wijziging schrijft de lijst met regels naar het configuratiebestand, en van dan af beslist dat bestand."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To jest domyślne menu. Pierwsza zmiana zapisuje listę wierszy w pliku konfiguracji, a od tej pory decyduje ten plik."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este é o menu padrão. A primeira alteração grava a lista de linhas no arquivo de configuração, e a partir daí o arquivo decide."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acesta este meniul implicit. Prima modificare scrie lista de linii în fișierul de configurare, iar de atunci înainte decide fișierul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это меню по умолчанию. Первое изменение записывает список строк в файл конфигурации, и с этого момента решает именно он."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது இயல்புநிலை மெனு. உங்கள் முதல் மாற்றம் வரிகளின் பட்டியலை உங்கள் உள்ளமைவுக் கோப்பில் எழுதும்; அதன் பிறகு கோப்பே முடிவு செய்யும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇది డిఫాల్ట్ మెనూ. మీ మొదటి మార్పు వరుసల జాబితాను మీ కాన్ఫిగరేషన్ ఫైల్‌లో రాస్తుంది; ఆ తర్వాత ఫైలే నిర్ణయిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่คือเมนูค่าเริ่มต้น การเปลี่ยนแปลงครั้งแรกของคุณจะเขียนรายการบรรทัดลงในไฟล์การกำหนดค่า และหลังจากนั้นไฟล์จะเป็นตัวกำหนด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, saptanmış menüdür. İlk değişikliğiniz satırların listesini yapılandırma dosyanıza yazar; bundan sonra belirleyici olan dosyadır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це стандартне меню. Ваша перша зміна записує список рядків у файл конфігурації, і відтоді вирішує саме файл."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ ڈیفالٹ مینو ہے۔ آپ کی پہلی تبدیلی آئٹمز کی فہرست کو کنفیگریشن فائل میں لکھ دیتی ہے، اور اس کے بعد سے فائل ہی فیصلہ کرتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là menu mặc định. Lần thay đổi đầu tiên sẽ ghi danh sách các mục vào tệp cấu hình của bạn, và từ đó trở đi tệp này quyết định."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是默认菜单。首次更改时会把菜单项目列表写入配置文件，此后以配置文件为准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是預設選單。第一次變更時會把選單項目清單寫入設定檔，此後以設定檔為準。"
          }
        }
      }
    },
    "app.menuEdit": {
      "comment": "Button on the Finder menu page of the setup window. It turns the preview of the Finder menu into a list whose lines can be dragged, removed and added to. A short imperative or noun phrase for a button.",
