    "app.aiPromptBody": {
      "comment": "Text under the heading app.aiPromptTitle, next to the button that copies the prompt.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينسخ موجِّهاً يجعل مساعدك يسأل عمّا تستخدمه، ثم يُعِدّ Right Here باستخدام `rh setup`."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি প্রম্পট কপি করে, যাতে আপনার AI সহকারী জিজ্ঞেস করে আপনি কী ব্যবহার করেন এবং তারপর `rh setup` দিয়ে Right Here সেটআপ করে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiert einen Prompt, mit dem dein Assistent fragt, was du verwendest, und Right Here dann mit `rh setup` einrichtet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αντιγράφει μια προτροπή που κάνει τον βοηθό σας να ρωτήσει τι χρησιμοποιείτε και μετά να ρυθμίσει το Right Here με `rh setup`."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies a prompt that has your assistant ask what you use and then set Right Here up with `rh setup`."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia un prompt que hace que tu asistente te pregunte qué usas y después configure Right Here con `rh setup`."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک پرامپت را کپی می‌کند که باعث می‌شود دستیار شما بپرسد از چه چیزهایی استفاده می‌کنید و سپس Right Here را با `rh setup` راه‌اندازی کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie un prompt qui amène votre assistant à demander ce que vous utilisez, puis à configurer Right Here avec `rh setup`."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מעתיק הנחיה שגורמת לעוזר לברר באילו כלים נעשה שימוש, ואז להגדיר את Right Here באמצעות `rh setup`."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक ऐसा प्रॉम्प्ट कॉपी करता है जिससे आपका असिस्टेंट पूछे कि आप क्या इस्तेमाल करते हैं, और फिर `rh setup` से Right Here सेट अप कर दे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyalin prompt yang membuat asisten Anda menanyakan apa yang Anda gunakan, lalu menyiapkan Right Here dengan `rh setup`."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia un prompt che chiede al tuo assistente di domandarti cosa usi e poi di configurare Right Here con `rh setup`."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIアシスタントに、何を使っているかを尋ねてから `rh setup` で Right Here をセットアップするよう頼むプロンプトをコピーします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 어시스턴트가 사용자에게 무엇을 쓰는지 묻고, `rh setup` 명령으로 Right Here를 설정하도록 요청하는 프롬프트를 복사합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या असिस्टंटला तुम्ही काय वापरता ते विचारण्यास आणि नंतर `rh setup` वापरून Right Here सेटअप करण्यास सांगणारा प्रॉम्प्ट कॉपी करतो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyalin gesaan yang meminta pembantu anda bertanya apa yang anda gunakan dan kemudian menyediakan Right Here dengan `rh setup`."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopieert een prompt waarmee je assistent eerst vraagt wat je gebruikt en Right Here daarna met `rh setup` instelt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiuje prompt, który każe asystentowi zapytać, czego używasz, a potem skonfigurować Right Here za pomocą polecenia `rh setup`."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia um prompt que faz o seu assistente perguntar o que você usa e depois configurar o Right Here com `rh setup`."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiază un prompt care îi cere asistentului să vă întrebe ce folosiți și apoi să configureze Right Here cu `rh setup`."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копирует промпт с просьбой к ассистенту спросить, чем Вы пользуетесь, а затем настроить Right Here командой `rh setup`."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் உதவியாளர் நீங்கள் எதைப் பயன்படுத்துகிறீர்கள் என்று கேட்டு, பின்னர் `rh setup` மூலம் Right Here-ஐ அமைக்கும் ப்ராம்ப்ட்டை நகலெடுக்கிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ సహాయకుడిని మీరు ఏమి ఉపయోగిస్తారో మిమ్మల్ని అడగమని, ఆపై `rh setup` తో Right Here ను సెటప్ చేయమని అడిగే ప్రాంప్ట్ను కాపీ చేస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คัดลอกพรอมต์ที่ขอให้ผู้ช่วยของคุณถามว่าคุณใช้อะไรบ้าง แล้วตั้งค่า Right Here ด้วย `rh setup`"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Asistanınızdan ne kullandığınızı sormasını ve ardından `rh setup` ile Right Here’i kurmasını isteyen bir istemi kopyalar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Копіює промпт, який просить вашого асистента запитати, що ви використовуєте, а потім налаштувати Right Here командою `rh setup`."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک پرامپٹ کاپی کرتا ہے جو آپ کے اسسٹنٹ سے کہتا ہے کہ آپ سے پوچھے کہ آپ کیا استعمال کرتے ہیں، پھر `rh setup` سے Right Here سیٹ اپ کرے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sao chép một lời nhắc yêu cầu trợ lý hỏi bạn đang dùng những gì, rồi thiết lập Right Here bằng `rh setup`."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拷贝一段提示词，请助手询问你使用哪些工具，然后用 `rh setup` 设置 Right Here。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拷貝一段提示詞，請助理詢問你使用哪些工具，然後用 `rh setup` 設定 Right Here。"
          }
        }
      }
    },
    "app.aiPromptTitle": {
      "comment": "Heading of a block in the AI Assistants section of the setup window: a prompt to copy and paste into an AI assistant.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
