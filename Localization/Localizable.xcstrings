    "doctor.sync.localAhead": {
      "comment": "Detail line of a check in the setup window's Details list; it follows the check's title, so it is a fragment with no final period. About the config sync feature: this machine's config changed since the last sync.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملف إعداد هذا الجهاز أحدث من المجلد"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই কম্পিউটারের কনফিগ ফোল্ডারের চেয়ে নতুন"
