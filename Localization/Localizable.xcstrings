    "doctor.runner.missing": {
      "comment": "Detail line of a check in the setup window's Details list; it follows the check's title, so it is a fragment with no final period. The runner script that the Finder extension uses is not installed.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غير مثبَّت؛ لا تستطيع قائمة فايندر تشغيل الإجراءات"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ইনস্টল করা নেই; Finder মেনু অ্যাকশন চালাতে পারে না"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "nicht installiert; das Finder-Menü kann keine Aktionen ausführen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "δεν είναι εγκατεστημένο· το μενού του Finder δεν μπορεί να εκτελέσει ενέργειες"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "not installed; the Finder menu cannot run actions"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "no instalado; el menú del Finder no puede ejecutar acciones"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نصب نشده؛ منوی Finder نمی‌تواند کنش‌ها را اجرا کند"
          }
        },
        "fr": {
          "stringUnit": {
