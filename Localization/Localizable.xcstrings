          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У промпті є розрив рядка або інший керівний символ."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پرامپٹ میں لائن بریک یا کوئی اور کنٹرول کیریکٹر ہے۔"
          }
