    "refusal.presetsAdd": {
      "comment": "Why an action did nothing, shown in the alert after a click in Finder (and, in English, by the command line). Follows the sentence about an unknown preset. %@ is [[preset]] between backticks, a table of the config.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضيف %@ في ملف الإعداد إعدادًا مسبقًا للوكيل أو يستبدل إعدادًا موجودًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কনফিগে একটি %@ একটি এজেন্ট প্রিসেট যোগ করে, অথবা একটি বিদ্যমান প্রিসেট বদলে দেয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein %@ in der Konfiguration fügt eine Agent-Voreinstellung hinzu oder ersetzt eine."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα %@ στο αρχείο ρυθμίσεων προσθέτει ή αντικαθιστά μια προεπιλογή πράκτορα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A %@ in the config adds or replaces one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un %@ en la configuración añade o reemplaza un preajuste de agente."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک %@ در پیکربندی یک پیش‌تنظیم عامل اضافه می‌کند یا پیش‌تنظیمی موجود را جایگزین می‌کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un %@ dans la configuration ajoute ou remplace un préréglage d’agent."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רשומת %@ בקובץ התצורה מוסיפה הגדרה מוכנה לסוכן או מחליפה הגדרה קיימת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कॉन्फ़िग में %@ एक एजेंट प्रीसेट जोड़ता है या किसी मौजूदा प्रीसेट को बदल देता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ di konfigurasi menambahkan atau menggantikan preset agen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una voce %@ nel file di configurazione aggiunge un preset o ne sostituisce uno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定ファイルの %@ で、プリセットを追加したり置き換えたりできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 파일의 %@ 항목으로 프리셋을 추가하거나 대체할 수 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कॉन्फिगरेशन फाइलमधील %@ एखादा प्रीसेट जोडतो किंवा बदलतो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Entri %@ dalam fail konfigurasi menambah atau menggantikan praset ejen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een %@ in het configuratiebestand voegt een agentvoorinstelling toe of vervangt er een."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpis %@ w pliku konfiguracji dodaje lub zastępuje gotowy prompt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um %@ no arquivo de configuração adiciona ou substitui uma predefinição de agente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O intrare %@ din fișierul de configurare adaugă sau înlocuiește o presetare pentru agent."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись %@ в файле конфигурации добавляет или заменяет пресет агента."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உள்ளமைவுக் கோப்பில் உள்ள %@ ஒரு முன்னமைவைச் சேர்க்கும் அல்லது ஏற்கெனவே உள்ள முன்னமைவை மாற்றும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కాన్ఫిగరేషన్ ఫైల్‌లోని %@ ఒక ప్రీసెట్‌ను జోడిస్తుంది లేదా ఉన్న ప్రీసెట్‌ను భర్తీ చేస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ในไฟล์การกำหนดค่าจะเพิ่มพรีเซ็ตใหม่หรือแทนที่พรีเซ็ตที่มีอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapılandırmadaki bir %@ yeni bir ön ayar ekler veya var olan bir ön ayarın yerini alır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розділ %@ у конфігурації додає пресет агента або замінює наявний пресет."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کنفیگریشن فائل میں موجود %@ ایک پری سیٹ شامل کرتا ہے یا کسی موجودہ پری سیٹ کی جگہ لیتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một mục %@ trong tệp cấu hình sẽ thêm một mẫu lời nhắc hoặc thay thế mẫu lời nhắc đã có."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置中的 %@ 可添加一个预设，或替换已有的预设。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定檔中的 %@ 可加入一個預設組，或取代既有的預設組。"
          }
        }
      }
    },
    "refusal.prompt.backslash": {
      "comment": "Why an action did nothing, shown in the alert after a click in Finder (and, in English, by the command line). Follows refusal.presetPrompt; It is the prompt.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتوي الموجّه على شرطة مائلة عكسية، ولا تقرؤها كل برامج Shell بالطريقة نفسها داخل علامات الاقتباس."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রম্পটে একটি ব্যাকস্ল্যাশ আছে, যা উদ্ধৃতিচিহ্নের ভেতরে সব শেল একইভাবে পড়ে না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Prompt enthält einen Backslash, den nicht alle Shells in Anführungszeichen gleich lesen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η προτροπή περιέχει ανάστροφη κάθετο, την οποία δεν διαβάζουν όλα τα κελύφη με τον ίδιο τρόπο μέσα σε εισαγωγικά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It has a backslash, which shells do not all read the same way inside quotes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El prompt tiene una barra invertida, que no todos los shells leen igual dentro de comillas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پرامپت یک بک‌اسلش دارد که همهٔ پوسته‌ها آن را داخل گیومه یکسان نمی‌خوانند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le prompt contient une barre oblique inverse, que les shells ne lisent pas tous de la même façon entre guillemets."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההנחיה מכילה לוכסן הפוך, ולא כל המעטפות קוראות אותו באותו אופן בתוך מירכאות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रॉम्प्ट में बैकस्लैश है, जिसे सभी शेल उद्धरण चिह्नों के अंदर एक ही तरह से नहीं पढ़ते।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Prompt berisi garis miring terbalik, yang tidak dibaca dengan cara yang sama oleh semua shell di dalam tanda kutip."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il prompt contiene una barra rovesciata, che le shell non leggono tutte allo stesso modo tra virgolette."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロンプトにバックスラッシュが含まれています。引用符の中のバックスラッシュの解釈はシェルによって異なります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프롬프트에 백슬래시가 있습니다. 따옴표 안의 백슬래시는 셸마다 다르게 읽습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रॉम्प्टमध्ये बॅकस्लॅश आहे, आणि अवतरणचिन्हांच्या आतील बॅकस्लॅश सर्व शेल सारखा वाचत नाहीत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesaan itu mengandungi garis condong terbalik, yang tidak dibaca dengan cara yang sama oleh semua cangkerang di dalam tanda petikan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De prompt bevat een backslash, en niet alle shells lezen een backslash binnen aanhalingstekens op dezelfde manier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Treść zawiera ukośnik wsteczny, a nie wszystkie powłoki odczytują go w cudzysłowie tak samo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O prompt tem uma barra invertida, que nem todos os shells leem da mesma forma entre aspas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Promptul conține o bară oblică inversă, pe care nu toate shellurile o citesc la fel între ghilimele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В промпте есть обратная косая черта, а не все оболочки читают ее в кавычках одинаково."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ப்ராம்ப்ட்டில் பின்சாய்வுக்கோடு உள்ளது; மேற்கோள் குறிகளுக்குள் உள்ள பின்சாய்வுக்கோட்டை எல்லா shell-களும் ஒரே விதமாகப் படிப்பதில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రాంప్ట్‌లో బ్యాక్‌స్లాష్ ఉంది; కోట్స్ లోపల ఉన్న బ్యాక్‌స్లాష్‌ను అన్ని shell లు ఒకే విధంగా చదవవు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พรอมต์มีแบ็กสแลช ซึ่งเชลล์แต่ละตัวอ่านแบ็กสแลชในเครื่องหมายคำพูดไม่เหมือนกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstemde ters eğik çizgi var; kabuklar tırnak içindeki ters eğik çizgiyi aynı biçimde okumaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У промпті є зворотна скісна риска, а оболонки не однаково читають її в лапках."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پرامپٹ میں بیک سلیش ہے، اور تمام شیلز واوین کے اندر بیک سلیش کو ایک ہی طرح نہیں پڑھتیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lời nhắc có dấu gạch chéo ngược, mà các shell không đọc giống nhau khi nó nằm trong dấu nháy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提示词中有反斜杠，而各种 shell 对引号内反斜杠的解读并不一致。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提示詞中有反斜線，而各種 shell 對引號內反斜線的解讀並不一致。"
          }
        }
      }
    },
    "refusal.prompt.controlCharacter": {
      "comment": "Why an action did nothing, shown in the alert after a click in Finder (and, in English, by the command line). Follows refusal.presetPrompt; It is the prompt.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتوي الموجّه على فاصل أسطر أو حرف تحكم آخر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রম্পটে একটি লাইন ব্রেক বা অন্য কোনো কন্ট্রোল ক্যারেক্টার আছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Prompt enthält einen Zeilenumbruch oder ein anderes Steuerzeichen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η προτροπή περιέχει αλλαγή γραμμής ή άλλον χαρακτήρα ελέγχου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It has a line break or another control character."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El prompt tiene un salto de línea u otro carácter de control."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پرامپت یک شکست خط یا نویسهٔ کنترلی دیگری دارد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le prompt contient un saut de ligne ou un autre caractère de contrôle."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההנחיה מכילה מעבר שורה או תו בקרה אחר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रॉम्प्ट में लाइन ब्रेक या कोई दूसरा कंट्रोल कैरेक्टर है।"
