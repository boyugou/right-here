        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "git 無法讀取 %1$@ 所在的儲存庫：%2$@"
          }
        }
      }
    },
    "refusal.repository.gitFailed": {
      "comment": "Why an action did nothing, shown in the alert after a click in Finder (and, in English, by the command line). %@ is a file or folder name. Said when git failed without a message; refusal.repository.gitError is the same with git's message.",
      "extractionState": "manual",
