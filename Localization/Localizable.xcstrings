        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मेन्यू में रिपॉज़िटरी लिंक हैं, और git इंस्टॉल नहीं है, इसलिए उनमें से हर एक विफल हो जाएगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu memiliki tautan repositori, dan git tidak diinstal, jadi setiap tautan itu akan gagal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il menu contiene link del repository e git non è installato, quindi ognuno di essi fallirebbe."
          }
        },
        "ja": {
