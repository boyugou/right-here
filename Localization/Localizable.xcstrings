        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%1$@ یک ترمینال است، نه ویرایشگر. برای باز کردن پوشه در آن از %2$@ استفاده کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ est un terminal, pas un éditeur. Utilisez %2$@ pour y ouvrir un dossier."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%1$@ הוא מסוף, לא עורך. כדי לפתוח בו תיקיה יש להשתמש ב-%2$@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ एक टर्मिनल है, एडिटर नहीं। इसमें फ़ोल्डर खोलने के लिए %2$@ इस्तेमाल करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ adalah terminal, bukan editor. Gunakan %2$@ untuk membuka folder di dalamnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ è un terminale, non un editor. Usa %2$@ per aprirvi una cartella."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@はエディタではなくターミナルです。このアプリでフォルダを開くには%2$@を使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 앱은 편집기가 아니라 터미널입니다. 이 앱에서 폴더를 열려면 %2$@ 동작을 사용하십시오."
