        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ఒక టెర్మినల్, ఎడిటర్ కాదు. అందులో ఫోల్డర్‌ను తెరవడానికి %2$@ ను ఉపయోగించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ เป็นเทอร์มินัล ไม่ใช่โปรแกรมแก้ไข ใช้ %2$@ เพื่อเปิดโฟลเดอร์ในแอปนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ bir terminaldir, düzenleyici değildir. İçinde bir klasör açmak için %2$@ eylemini kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — це термінал, а не редактор. Щоб відкрити в ньому папку, використайте дію %2$@."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%1$@ ٹرمینل ہے، ایڈیٹر نہیں۔ اس میں فولڈر کھولنے کے لیے %2$@ استعمال کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ là terminal, không phải trình soạn thảo. Hãy dùng %2$@ để mở một thư mục trong đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 是终端，不是编辑器。要在其中打开文件夹，请使用 %2$@。"
          }
