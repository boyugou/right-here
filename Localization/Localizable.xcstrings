        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचे टर्मिनल आणि एडिटर"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal dan editor anda"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jouw terminal en editor"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój terminal i edytor"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu terminal e editor"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminalul și editorul dvs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш терминал и редактор"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் டெர்மினலும் எடிட்டரும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ టెర్మినల్ మరియు ఎడిటర్"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เทอร์มินัลและโปรแกรมแก้ไขของคุณ"
          }
        },
        "tr": {
