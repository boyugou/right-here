    "app.templateContentsHelp": {
      "comment": "Caption under the field for the contents of a new-file template.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما يحويه الملف الجديد عند إنشائه. اتركه فارغًا لإنشاء ملف فارغ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তৈরি হওয়ার সময় নতুন ফাইলে যা থাকবে। খালি ফাইলের জন্য এটি ফাঁকা রাখুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was die neue Datei beim Erstellen enthält. Lass das Feld leer für eine leere Datei."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τι περιέχει το νέο αρχείο όταν δημιουργείται. Αφήστε το κενό για κενό αρχείο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What the new file holds when it is made. Leave it empty for an empty file."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que contiene el archivo nuevo al crearse. Déjalo vacío para un archivo vacío."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "محتوای فایل جدید هنگام ساخته شدن. برای فایل خالی، آن را خالی بگذارید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que contient le nouveau fichier à sa création. Laissez ce champ vide pour un fichier vide."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מה שהקובץ החדש מכיל כשהוא נוצר. ליצירת קובץ ריק, יש להשאיר את השדה ריק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बनने पर नई फ़ाइल में क्या होगा। खाली फ़ाइल के लिए इसे खाली छोड़ दें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Isi file baru saat dibuat. Biarkan kosong untuk file kosong."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò che contiene il nuovo file al momento della creazione. Lascialo vuoto per un file vuoto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作成時に新しいファイルに入れる内容です。空のファイルにする場合は空欄のままにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "만들어질 때 새 파일에 들어갈 내용입니다. 빈 파일을 원하면 비워 두십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "नवीन फाइल तयार होताना तिच्यात काय असेल. रिकामी फाइल हवी असल्यास हे रिकामे ठेवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kandungan fail baharu semasa ia dicipta. Biarkan kosong untuk fail kosong."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De inhoud van het nieuwe bestand bij het aanmaken. Laat dit veld leeg voor een leeg bestand."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zawartość nowego pliku po jego utworzeniu. Zostaw puste, aby plik był pusty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que o arquivo novo contém quando é criado. Deixe em branco para um arquivo vazio."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce conține fișierul nou atunci când este creat. Lăsați câmpul gol pentru un fișier gol."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что будет в новом файле после создания. Оставьте поле пустым, чтобы создать пустой файл."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கோப்பு உருவாக்கப்படும்போது புதிய கோப்பில் இருக்கும் உள்ளடக்கம். வெற்றுக் கோப்புக்கு இதைக் காலியாக விடுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫైల్ సృష్టించినప్పుడు కొత్త ఫైల్‌లో ఉండే కంటెంట్. ఖాళీ ఫైల్ కావాలంటే దీన్ని ఖాళీగా ఉంచండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เนื้อหาที่ไฟล์ใหม่จะมีเมื่อสร้างแล้ว เว้นว่างไว้สำหรับไฟล์เปล่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni dosya oluşturulduğunda içereceği metin. Boş bir dosya için boş bırakın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вміст нового файлу після створення. Залиште порожнім, щоб створити порожній файл."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فائل بننے پر اس میں جو مواد ہوگا۔ خالی فائل کے لیے اسے خالی چھوڑیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nội dung của tệp mới khi được tạo. Để trống nếu muốn tệp rỗng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新文件创建时包含的内容。留空则创建空文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建立時新檔案所含的內容。留空即為空白檔案。"
          }
        }
      }
    },
