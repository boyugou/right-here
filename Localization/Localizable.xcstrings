          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی کنفیگریشن فائل میں محفوظ ہو گیا"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
