    "app.agentArgumentsHelp": {
      "comment": "Caption under the list of arguments.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُكتب بعد الأمر بهذا الترتيب. ويُوضع بين علامتي اقتباس أي وسيط يحتاج إلى ذلك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কমান্ডের পরে এই ক্রমে টাইপ করা হয়। যে আর্গুমেন্টে উদ্ধৃতি-চিহ্ন লাগে, সেটি উদ্ধৃতি-চিহ্নের ভেতরে রাখা হয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werden in dieser Reihenfolge nach dem Befehl eingegeben. Ein Argument, das Anführungszeichen braucht, wird in Anführungszeichen gesetzt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πληκτρολογούνται μετά την εντολή, με αυτή τη σειρά. Όπου χρειάζεται, ένα όρισμα μπαίνει σε εισαγωγικά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Typed after the command, in this order. An argument that needs it is put in quotes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se escriben después del comando, en este orden. Un argumento que lo necesite va entre comillas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پس از دستور، به همین ترتیب تایپ می‌شوند. آرگومانی که نیاز به گیومه دارد، داخل گیومه گذاشته می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisis après la commande, dans cet ordre. Si nécessaire, un argument est mis entre guillemets."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מוקלדים אחרי הפקודה, לפי הסדר הזה. ארגומנט שצריך מירכאות נכתב בין מירכאות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कमांड के बाद इसी क्रम में टाइप किए जाते हैं। जिस आर्ग्युमेंट को उद्धरण चिह्नों की ज़रूरत हो, उसे उद्धरण चिह्नों में रखा जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diketik setelah perintah, sesuai urutan ini. Argumen yang memerlukan tanda kutip diberi tanda kutip."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Digitati dopo il comando, in quest’ordine. Un argomento che ne ha bisogno viene messo tra virgolette."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンドの後に、この順番で入力されます。必要な場合、引数は引用符で囲まれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명령 뒤에 이 순서대로 입력됩니다. 필요한 경우 인수는 따옴표로 묶입니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कमांडनंतर याच क्रमाने टाइप केले जाते. गरज असलेल्या आर्ग्युमेंटला अवतरणचिन्हांमध्ये ठेवले जाते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditaip selepas perintah, mengikut susunan ini. Argumen yang memerlukannya diletakkan dalam tanda petikan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Worden na het commando getypt, in deze volgorde. Een argument dat het nodig heeft, krijgt aanhalingstekens."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisywane po poleceniu, w tej kolejności. Argument, który tego wymaga, zostaje ujęty w cudzysłów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digitados depois do comando, nesta ordem. Um argumento que precise disso vai entre aspas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se scriu după comandă, în această ordine. Un argument este pus între ghilimele când este nevoie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вводятся после команды в указанном порядке. При необходимости аргумент заключается в кавычки."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கட்டளைக்குப் பின் இந்த வரிசையில் தட்டச்சு செய்யப்படும். தேவைப்பட்டால் வாதம் மேற்கோள் குறிகளுக்குள் வைக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆదేశం తర్వాత ఈ క్రమంలో టైప్ చేయబడతాయి. అవసరమైతే ఆర్గ్యుమెంట్‌లు కోట్స్‌లో ఉంచబడతాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จะพิมพ์ต่อท้ายคำสั่งตามลำดับนี้ และอาร์กิวเมนต์ที่ต้องใช้เครื่องหมายคำพูดจะถูกครอบด้วยเครื่องหมายคำพูด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Komuttan sonra bu sırayla yazılır. Gerektiğinde argüman tırnak içine alınır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вводяться після команди в такому порядку. Аргументи, які цього потребують, беруться в лапки."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کمانڈ کے بعد اس ترتیب سے ٹائپ کیے جاتے ہیں۔ جس آرگیومنٹ کو اس کی ضرورت ہو، وہ واوین میں لکھا جاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Được gõ sau lệnh, theo thứ tự này. Đối số nào cần thì được đặt trong dấu ngoặc kép."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按此顺序接在命令后面。需要时，参数会加上引号。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依此順序接在指令後面。需要時，引數會加上引號。"
          }
        }
      }
    },
    "app.agentArgumentsInexactNote": {
      "comment": "Orange note under the list of an agent's extra command-line arguments, shown only when the config file writes the list in an unusual way. The Config page is a section of the app (glossary entry app.tabConfig) where the config file is edited as text.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كُتبت الوسيطات في ملف الإعداد بطريقة لا تسمح لهذه القائمة بتغييرها واحدةً تلو الأخرى. عدِّلها كنص في صفحة ملف الإعداد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আর্গুমেন্টগুলো কনফিগারেশন ফাইলে এমনভাবে লেখা আছে যে এই তালিকা সেগুলো একটি একটি করে বদলাতে পারে না। কনফিগ পৃষ্ঠায় টেক্সট হিসেবে সেগুলো বদলান।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Argumente sind so in deiner Konfigurationsdatei geschrieben, dass diese Liste sie nicht einzeln ändern kann. Ändere sie als Text auf der Seite „Konfiguration“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα ορίσματα είναι γραμμένα στο αρχείο ρυθμίσεων με τρόπο που αυτή η λίστα δεν μπορεί να τα αλλάξει ένα ένα. Αλλάξτε τα ως κείμενο στη σελίδα «Ρυθμίσεις»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The arguments are written in your config file in a way this list cannot change one by one. Change them as text on the Config page."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los argumentos están escritos en tu archivo de configuración de una forma que esta lista no puede cambiar uno por uno. Cámbialos como texto en la página Configuración."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آرگومان‌ها در فایل پیکربندی شما به شکلی نوشته شده‌اند که این فهرست نمی‌تواند آن‌ها را یکی‌یکی تغییر دهد. آن‌ها را به‌صورت متن در صفحهٔ پیکربندی تغییر دهید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les arguments sont écrits dans votre fichier de configuration d’une façon qui ne permet pas à cette liste de les modifier un par un. Modifiez-les sous forme de texte dans la page Configuration."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הארגומנטים כתובים בקובץ התצורה באופן שרשימה זו לא יכולה לשנות כל אחד מהם בנפרד. יש לשנות אותם כטקסט בעמוד ״תצורה״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आर्ग्युमेंट आपकी कॉन्फ़िगरेशन फ़ाइल में इस तरह लिखे गए हैं कि यह सूची उन्हें एक-एक करके नहीं बदल सकती। उन्हें कॉन्फ़िग पेज पर टेक्स्ट के रूप में बदलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Argumen ditulis di file konfigurasi Anda dengan cara yang tidak dapat diubah satu per satu oleh daftar ini. Ubahlah sebagai teks di halaman Konfigurasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli argomenti sono scritti nel file di configurazione in un modo che questo elenco non può modificare uno alla volta. Modificali come testo nella pagina Configurazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "引数は、この一覧では一つずつ変更できない形で設定ファイルに書かれています。設定ページでテキストとして変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인수는 이 목록에서 한 개씩 바꿀 수 없는 방식으로 설정 파일에 적혀 있습니다. 설정 페이지에서 텍스트로 바꾸십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आर्ग्युमेंट्स कॉन्फिगरेशन फाइलमध्ये अशा प्रकारे लिहिलेले आहेत की ही यादी त्यांना एकेक करून बदलू शकत नाही. कॉन्फिग पृष्ठावर मजकूर म्हणून ते बदला."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Argumen ditulis dalam fail konfigurasi anda dengan cara yang senarai ini tidak dapat mengubahnya satu demi satu. Ubahlah sebagai teks pada halaman Konfigurasi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De argumenten staan in het configuratiebestand op een manier die deze lijst niet één voor één kan wijzigen. Wijzig ze als tekst op de pagina Configuratie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Argumenty są zapisane w pliku konfiguracji w taki sposób, że nie można ich zmieniać pojedynczo na tej liście. Zmień je jako tekst na stronie Konfiguracja."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os argumentos estão escritos no arquivo de configuração de uma forma que esta lista não consegue alterar um por um. Altere-os como texto na página Configuração."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Argumentele sunt scrise în fișierul de configurare într-un mod în care această listă nu le poate modifica unul câte unul. Modificați-le ca text pe pagina Configurație."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аргументы записаны в файле конфигурации таким образом, что этот список не может изменять их по одному. Измените их в виде текста на странице «Конфигурация»."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வாதங்கள் உங்கள் உள்ளமைவுக் கோப்பில், இந்தப் பட்டியலால் ஒவ்வொன்றாக மாற்ற முடியாத விதத்தில் எழுதப்பட்டுள்ளன. உரையாக, உள்ளமைவுப் பக்கத்தில் அவற்றை மாற்றவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆర్గ్యుమెంట్‌లు మీ కాన్ఫిగరేషన్ ఫైల్‌లో ఈ జాబితా ఒక్కొక్కటిగా మార్చలేని విధంగా రాయబడ్డాయి. కాన్ఫిగరేషన్ పేజీలో వాటిని టెక్స్ట్‌గా మార్చండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อาร์กิวเมนต์ถูกเขียนไว้ในไฟล์การกำหนดค่าของคุณในลักษณะที่รายการนี้ไม่สามารถเปลี่ยนทีละรายการได้ แก้ไขเป็นข้อความในหน้าการกำหนดค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Argümanlar yapılandırma dosyanızda, bu listenin tek tek değiştiremeyeceği bir biçimde yazılmış. Bunları Yapılandırma sayfasında metin olarak değiştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аргументи записані у вашому файлі конфігурації так, що цей список не може змінювати їх по одному. Змініть їх у вигляді тексту на сторінці «Конфігурація»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آرگیومنٹس آپ کی کنفیگریشن فائل میں اس طرح لکھے گئے ہیں کہ یہ فہرست انہیں ایک ایک کر کے تبدیل نہیں کر سکتی۔ انہیں کنفیگ صفحے پر متن کے طور پر تبدیل کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đối số được viết trong tệp cấu hình của bạn theo cách danh sách này không thể thay đổi từng cái một. Chỉnh sửa chúng dưới dạng văn bản trên trang Cấu hình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置文件中参数的写法使此列表无法逐个更改它们。请在“配置”页面以文本形式更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定檔中引數的寫法讓這份清單無法逐一變更。請在「設定檔」頁面以文字形式變更。"
          }
        }
      }
    },
    "app.agentBypassConfirmMessage": {
      "comment": "Message of that confirmation. %1$@ is the agent's name and %2$@ the command-line flag it is started with (for example --dangerously-skip-permissions; never translate it). Keep both placeholders (they may change order in a language that needs it) and the two line breaks (\\n\\n) as they are. It matches app.bypassConfirmMessage.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيبدأ %1$@ مع إيقاف طلبات الإذن الخاصة به. وبعدها يستطيع تنفيذ الأوامر وتغيير الملفات دون أن يسألك أولًا. ويُشغَّل بالخيار %2$@.\n\nيمكنك تغيير هذا من هنا في أي وقت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ অনুমতি চাওয়ার প্রশ্ন বন্ধ রেখে শুরু হবে। তখন এটি আগে আপনাকে জিজ্ঞাসা না করেই কমান্ড চালাতে ও ফাইল বদলাতে পারবে। এটি %2$@ দিয়ে শুরু হয়।\n\nআপনি যেকোনো সময় এখান থেকে এটি পরিবর্তন করতে পারবেন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ startet mit abgeschalteten Berechtigungsabfragen. Der Agent kann dann Befehle ausführen und Dateien ändern, ohne dich vorher zu fragen. Er wird mit %2$@ gestartet.\n\nDu kannst das hier jederzeit ändern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο πράκτορας %1$@ θα ξεκινά με απενεργοποιημένες τις ερωτήσεις για άδειες. Τότε μπορεί να εκτελεί εντολές και να αλλάζει αρχεία χωρίς να σας ρωτά πρώτα. Εκκινείται με %2$@.\n\nΜπορείτε να το αλλάξετε εδώ ανά πάσα στιγμή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ will start with its permission prompts switched off. It can then run commands and change files without asking you first. It is started with %2$@.\n\nYou can change this here at any time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ se iniciará con sus solicitudes de permiso desactivadas. Entonces podrá ejecutar comandos y cambiar archivos sin preguntarte antes. Se iniciará con %2$@.\n\nPuedes cambiar esto aquí en cualquier momento."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%1$@ در حالی شروع می‌شود که درخواست‌های مجوزش خاموش است. سپس می‌تواند بدون پرسیدن از شما دستور اجرا کند و فایل‌ها را تغییر دهد. این عامل با %2$@ اجرا می‌شود.\n\nهر زمان که بخواهید می‌توانید این را همین‌جا تغییر دهید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ démarrera avec ses demandes d’autorisation désactivées. Il pourra alors exécuter des commandes et modifier des fichiers sans rien vous demander au préalable. Il est démarré avec %2$@.\n\nVous pouvez modifier cette option ici à tout moment."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏הסוכן %1$@ יופעל כשבקשות ההרשאה שלו כבויות. כך הוא יוכל להריץ פקודות ולשנות קבצים בלי לבקש אישור קודם. הוא מופעל עם %2$@.\n\nניתן לשנות זאת כאן בכל עת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ अपने अनुमति वाले सवाल बंद करके शुरू होगा। तब वह आपसे पूछे बिना कमांड चला सकता है और फ़ाइलें बदल सकता है। यह %2$@ के साथ शुरू होता है।\n\nआप इसे यहाँ कभी भी बदल सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ akan dimulai dengan permintaan izinnya dimatikan. Setelah itu, agen tersebut dapat menjalankan perintah dan mengubah file tanpa bertanya kepada Anda terlebih dahulu. Agen ini dimulai dengan %2$@.\n\nAnda dapat mengubahnya di sini kapan saja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ si avvierà con le richieste di permesso disattivate. Potrà quindi eseguire comandi e modificare file senza chiederti prima. Viene avviato con %2$@.\n\nPuoi modificare questa impostazione qui in qualsiasi momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@は、許可の確認をオフにした状態で起動します。その後は、確認せずにコマンドを実行したりファイルを変更したりできます。%2$@を付けて起動します。\n\nこの設定は、ここからいつでも変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 에이전트는 권한 요청이 꺼진 상태로 시작됩니다. 그러면 먼저 묻지 않고도 명령을 실행하고 파일을 바꿀 수 있습니다. 이 에이전트는 %2$@ 옵션을 붙여 시작됩니다.\n\n이 설정은 여기서 언제든지 바꿀 수 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ एजंट त्याची परवानगी विचारणा बंद करून सुरू होईल. मग तो तुम्हाला आधी न विचारता कमांड चालवू शकेल आणि फाइल बदलू शकेल. तो %2$@ सह सुरू होतो.\n\nहा पर्याय तुम्ही इथे कधीही बदलू शकता."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ akan dimulakan dengan gesaan kebenarannya dinyahaktifkan. Ia kemudian boleh menjalankan perintah dan menukar fail tanpa bertanya kepada anda dahulu. Ia dimulakan dengan %2$@.\n\nAnda boleh menukar seting ini di sini pada bila-bila masa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ start met uitgeschakelde toestemmingsvragen. De agent kan dan zonder eerst te vragen commando’s uitvoeren en bestanden wijzigen. Hij wordt gestart met de vlag %2$@.\n\nJe kunt dit hier altijd wijzigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent %1$@ będzie uruchamiany z wyłączonymi pytaniami o uprawnienia. Może wtedy uruchamiać polecenia i zmieniać pliki bez wcześniejszego pytania. Jest uruchamiany z flagą %2$@.\n\nTo ustawienie można w każdej chwili zmienić tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ vai iniciar com os pedidos de permissão desativados. Ele poderá então executar comandos e alterar arquivos sem perguntar antes. Ele é iniciado com a flag %2$@.\n\nIsso pode ser alterado aqui a qualquer momento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ va porni cu solicitările de permisiune dezactivate. Poate apoi să ruleze comenzi și să modifice fișiere fără să vă întrebe mai întâi. Se pornește cu opțiunea %2$@.\n\nPuteți modifica oricând această setare aici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Агент %1$@ будет запускаться с отключенными запросами разрешений. Тогда он сможет выполнять команды и менять файлы, не спрашивая Вас. Флаг запуска: %2$@.\n\nЭту настройку можно в любой момент изменить здесь."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ அதன் அனுமதிக் கேள்விகள் அணைக்கப்பட்ட நிலையில் தொடங்கும். அதன் பிறகு உங்களிடம் முதலில் கேட்காமல் அது கட்டளைகளை இயக்கவும் கோப்புகளை மாற்றவும் முடியும். அது %2$@ கொடியுடன் தொடங்கப்படுகிறது.\n\nஇதை இங்கே எந்த நேரத்திலும் மாற்றலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ దాని అనుమతి ప్రశ్నలు ఆఫ్ చేయబడిన స్థితిలో ప్రారంభమవుతుంది. ఆ తర్వాత అది మిమ్మల్ని ముందుగా అడగకుండానే ఆదేశాలను అమలు చేసి ఫైళ్లను మార్చగలదు. అది %2$@ తో ప్రారంభమవుతుంది.\n\nమీరు దీనిని ఇక్కడ ఎప్పుడైనా మార్చవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ จะเริ่มทำงานโดยปิดการถามขออนุญาตของตัวเองไว้ จากนั้นจะรันคำสั่งและเปลี่ยนแปลงไฟล์ได้โดยไม่ต้องถามคุณก่อน จะถูกเรียกใช้พร้อม %2$@\n\nคุณสามารถเปลี่ยนการตั้งค่านี้ได้ที่นี่เมื่อใดก็ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, izin istemleri kapalı olarak başlayacak. Bu durumda size önce sormadan komut çalıştırabilir ve dosyaları değiştirebilir. %2$@ ile başlatılır.\n\nBunu istediğiniz zaman buradan değiştirebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Агент %1$@ запускатиметься з вимкненими запитами на дозвіл. Тоді він зможе виконувати команди та змінювати файли, не питаючи вас. Для цього використовується параметр %2$@.\n\nВи можете змінити це тут у будь-який час."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%1$@ اپنے اجازت کے پرامپٹ بند کر کے شروع ہوگا۔ اس کے بعد وہ آپ سے پہلے پوچھے بغیر کمانڈز چلا سکتا ہے اور فائلیں بدل سکتا ہے۔ اسے %2$@ کے ساتھ شروع کیا جاتا ہے۔\n\nآپ اسے یہاں کسی بھی وقت بدل سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sẽ khởi chạy với lời nhắc xin phép đã được tắt. Khi đó, nó có thể chạy lệnh và thay đổi tệp mà không hỏi bạn trước. Nó được khởi chạy kèm %2$@.\n\nBạn có thể thay đổi điều này ở đây bất cứ lúc nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 将在关闭其权限提示的状态下启动。此后它可以在不先询问你的情况下运行命令、更改文件。它是以 %2$@ 启动的。\n\n你随时可以在此处更改此设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 將在關閉其權限提示的狀態下啟動。此後它可以在不先詢問你的情況下執行指令、變更檔案。它是以 %2$@ 啟動的。\n\n你隨時可以在這裡變更此設定。"
          }
        }
      }
    },
    "app.agentBypassConfirmTitle": {
      "comment": "Title of the confirmation that comes before one agent is set to start with its permission prompts off. %@ is the agent's name. It matches app.bypassConfirmTitle, which is about all agents.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد تشغيل %@ دون استئذان؟"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ জিজ্ঞাসা না করে শুরু করবেন?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ohne Nachfrage starten?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εκκίνηση του %@ χωρίς ερωτήσεις;"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start %@ without asking?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Iniciar %@ sin preguntar?"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%@ بدون پرسیدن شروع شود؟"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrer %@ sans demander ?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להפעיל את %@ בלי לשאול?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या %@ बिना पूछे शुरू करें?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai %@ tanpa bertanya?"
          }
        },
        "it": {
