          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускать агентов без вопросов"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கேட்காமல் முகவர்களைத் தொடங்கு"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అడగకుండా ఏజెంట్లను ప్రారంభించండి"
