          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "दो मशीनों ने एक ही समय पर config.toml लिखी। प्रतियों की तुलना करें, config.toml में सही कॉन्टेंट रखें, और बाकी प्रतियाँ ख़ुद डिलीट करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dua mesin menulis config.toml sekaligus. Bandingkan salinannya, simpan isi yang benar di config.toml, dan hapus yang lain secara manual."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Due computer hanno scritto config.toml nello stesso momento. Confronta le copie, mantieni il contenuto giusto in config.toml ed elimina le altre a mano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "2 台のマシンが同時に config.toml を書き込みました。コピーを比較して正しい内容を config.toml に残し、ほかのコピーは手作業で削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "두 기기가 config.toml을 동시에 기록했습니다. 사본들을 비교하고, 올바른 내용을 config.toml에 남긴 다음, 나머지는 직접 삭제하십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "दोन मशीननी एकाच वेळी config.toml लिहिले. प्रतींची तुलना करा, config.toml मध्ये योग्य मजकूर ठेवा आणि इतर हाताने हटवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
