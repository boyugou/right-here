        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "εγκατεστημένες: %1$@, αλλά διαφέρουν από το αρχείο ρυθμίσεων (λείπουν: %2$@, ξεπερασμένες: %3$@)"
          }
        },
        "en": {
