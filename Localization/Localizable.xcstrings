    "app.bypassTitle": {
      "comment": "Title of a switch on the Agents page. When it is on, AI agents are started with the command-line flag that switches off their own permission prompts (the questions they ask before running a command or changing a file).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تشغيل الوكلاء دون استئذان"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "জিজ্ঞাসা না করে এজেন্ট শুরু করুন"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Agenten ohne Nachfrage starten"
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Εκκίνηση πρακτόρων χωρίς ερωτήσεις"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start agents without asking"
          }
        },
        "es": {
          "stringUnit": {
