    "refusal.agent.argumentBackslash": {
      "comment": "Why an action did nothing, shown in the alert after a click in Finder (and, in English, by the command line). %1$@ is a command-line argument, %2$@ a section of the config. args is a word of the config: keep it.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتوي الوسيط «%1$@» في args الخاصة بـ %2$@ على شرطة مائلة عكسية، ولا تقرؤها كل برامج Shell بالطريقة نفسها داخل علامات الاقتباس. ضع الأمر كاملًا في `command` الخاص بالوكيل، والذي يُكتب كما هو."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@-এর args-এ থাকা আর্গুমেন্ট “%1$@”-এ একটি ব্যাকস্ল্যাশ আছে, যা উদ্ধৃতিচিহ্নের ভেতরে সব শেল একইভাবে পড়ে না। পুরো কমান্ডটি এজেন্টের `command`-এ রাখুন, যা যেমন লেখা আছে তেমনই টাইপ করা হয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Argument „%1$@“ in den args von %2$@ enthält einen Backslash, den nicht alle Shells in Anführungszeichen gleich lesen. Schreibe den ganzen Befehl in den `command` des Agenten, der so eingegeben wird, wie er dasteht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το όρισμα «%1$@» στα args του %2$@ περιέχει ανάστροφη κάθετο, την οποία δεν διαβάζουν όλα τα κελύφη με τον ίδιο τρόπο μέσα σε εισαγωγικά. Βάλτε ολόκληρη την εντολή στο `command` του πράκτορα, που πληκτρολογείται όπως είναι γραμμένο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The argument \"%1$@\" in the args of %2$@ has a backslash, which shells do not all read the same way inside quotes. Put the whole command in the agent's `command`, which is typed as written."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El argumento «%1$@» en los args de %2$@ tiene una barra invertida, que no todos los shells leen igual dentro de comillas. Pon el comando completo en el `command` del agente, que se escribe tal cual."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آرگومان «%1$@» در args مربوط به %2$@ یک بک‌اسلش دارد که همهٔ پوسته‌ها آن را داخل گیومه یکسان نمی‌خوانند. کل دستور را در `command` عامل بگذارید که همان‌طور که نوشته شده تایپ می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’argument « %1$@ » dans les args de %2$@ contient une barre oblique inverse, que les shells ne lisent pas tous de la même façon entre guillemets. Mettez toute la commande dans le `command` de l’agent, qui est saisi tel quel."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הארגומנט ״%1$@״ ב-args של %2$@ מכיל לוכסן הפוך, ולא כל המעטפות קוראות אותו באותו אופן בתוך מירכאות. יש לשים את הפקודה כולה ב-`command` של הסוכן, שמוקלד כפי שהוא כתוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ के args में आर्ग्युमेंट “%1$@” में बैकस्लैश है, जिसे सभी शेल उद्धरण चिह्नों के अंदर एक ही तरह से नहीं पढ़ते। पूरी कमांड एजेंट के `command` में रखें, जो जैसा लिखा है वैसा ही टाइप किया जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Argumen “%1$@” di args %2$@ berisi garis miring terbalik, yang tidak dibaca dengan cara yang sama oleh semua shell di dalam tanda kutip. Masukkan seluruh perintah ke `command` agen, yang diketik persis seperti tertulis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’argomento “%1$@” negli args di %2$@ contiene una barra rovesciata, che le shell non leggono tutte allo stesso modo tra virgolette. Metti l’intero comando nel `command` dell’agente, che viene digitato così com’è scritto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@のargsにある引数「%1$@」にバックスラッシュが含まれています。引用符の中のバックスラッシュの解釈はシェルによって異なります。コマンド全体をエージェントの `command` に記述してください。この値は書かれたとおりに入力されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ 섹션의 args에 있는 인수 “%1$@”에 백슬래시가 있습니다. 따옴표 안의 백슬래시는 셸마다 다르게 읽습니다. 명령 전체를 에이전트의 `command`에 넣으십시오. 이 값은 적힌 그대로 입력됩니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ च्या args मधील आर्ग्युमेंट “%1$@” मध्ये बॅकस्लॅश आहे, आणि अवतरणचिन्हांच्या आतील बॅकस्लॅश सर्व शेल सारखा वाचत नाहीत. संपूर्ण कमांड एजंटच्या `command` मध्ये ठेवा, जी लिहिल्याप्रमाणेच टाइप केली जाते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Argumen “%1$@” dalam args bagi %2$@ mengandungi garis condong terbalik, yang tidak dibaca dengan cara yang sama oleh semua cangkerang di dalam tanda petikan. Letakkan seluruh perintah dalam `command` ejen, yang ditaip tepat seperti yang ditulis."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het argument „%1$@” in de args van %2$@ bevat een backslash, en niet alle shells lezen een backslash binnen aanhalingstekens op dezelfde manier. Zet het hele commando in `command` van de agent, dat wordt getypt zoals het er staat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Argument „%1$@” w args sekcji %2$@ zawiera ukośnik wsteczny, a nie wszystkie powłoki odczytują go w cudzysłowie tak samo. Umieść całe polecenie w polu `command` agenta, które jest wpisywane dokładnie tak, jak je zapisano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O argumento “%1$@” nos args de %2$@ tem uma barra invertida, que nem todos os shells leem da mesma forma entre aspas. Coloque o comando inteiro no `command` do agente, que é digitado exatamente como está escrito."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Argumentul „%1$@” din args pentru %2$@ conține o bară oblică inversă, pe care nu toate shellurile o citesc la fel între ghilimele. Puneți întreaga comandă în câmpul `command` al agentului, care este tastat exact cum este scris."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аргумент «%1$@» в args раздела %2$@ содержит обратную косую черту, а не все оболочки читают ее в кавычках одинаково. Поместите всю команду в поле `command` агента — оно вводится в точности так, как написано."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ இன் args இல் உள்ள “%1$@” என்ற வாதத்தில் பின்சாய்வுக்கோடு உள்ளது; மேற்கோள் குறிகளுக்குள் உள்ள பின்சாய்வுக்கோட்டை எல்லா shell-களும் ஒரே விதமாகப் படிப்பதில்லை. முழுக் கட்டளையையும் முகவரின் `command` இல் வைக்கவும்; அது எழுதியபடியே தட்டச்சு செய்யப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ లోని args లో ఉన్న “%1$@” ఆర్గ్యుమెంట్‌లో బ్యాక్‌స్లాష్ ఉంది; కోట్స్ లోపల ఉన్న బ్యాక్‌స్లాష్‌ను అన్ని shell లు ఒకే విధంగా చదవవు. మొత్తం ఆదేశాన్ని ఏజెంట్ యొక్క `command` లో ఉంచండి; అది రాసినట్లే టైప్ చేయబడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อาร์กิวเมนต์ “%1$@” ใน args ของ %2$@ มีแบ็กสแลช ซึ่งเชลล์แต่ละตัวอ่านแบ็กสแลชในเครื่องหมายคำพูดไม่เหมือนกัน ให้ใส่คำสั่งทั้งหมดไว้ใน `command` ของเอเจนต์ ซึ่งจะถูกพิมพ์ตามที่เขียนไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ bölümündeki args içinde bulunan “%1$@” argümanında ters eğik çizgi var; kabuklar tırnak içindeki ters eğik çizgiyi aynı biçimde okumaz. Komutun tamamını ajanın `command` alanına yazın; orası yazıldığı gibi girilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аргумент «%1$@» в args розділу %2$@ містить зворотну скісну риску, а оболонки не однаково читають її в лапках. Запишіть усю команду в `command` агента — її вводять так, як написано."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%2$@ کے args میں موجود آرگیومنٹ “%1$@” میں بیک سلیش ہے، اور تمام شیلز واوین کے اندر بیک سلیش کو ایک ہی طرح نہیں پڑھتیں۔ پوری کمانڈ ایجنٹ کی `command` میں لکھیں، جو جیسی لکھی ہو ویسی ہی ٹائپ کی جاتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đối số “%1$@” trong args của %2$@ có dấu gạch chéo ngược, mà các shell không đọc giống nhau khi nó nằm trong dấu nháy. Hãy đặt toàn bộ lệnh vào `command` của tác tử, phần này được gõ đúng như đã viết."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ 的 args 中的参数“%1$@”含有反斜杠，而各种 shell 对引号内反斜杠的解读并不一致。请把整条命令写进该智能体的 `command`，它会按原样输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ 的 args 中的引數「%1$@」含有反斜線，而各種 shell 對引號內反斜線的解讀並不一致。請把整條指令寫進該代理程式的 `command`，它會按原樣輸入。"
          }
        }
      }
    },
    "refusal.agent.desktopAppNotInstalled": {
      "comment": "Why an action did nothing, shown in the alert after a click in Finder (and, in English, by the command line). %@ is an AI agent's name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تطبيق سطح المكتب الخاص بـ %@ غير مثبّت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-এর ডেস্কটপ অ্যাপ ইনস্টল করা নেই।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Desktop-App von %@ ist nicht installiert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εφαρμογή υπολογιστή του %@ δεν είναι εγκατεστημένη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The %@ desktop app is not installed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app de escritorio de %@ no está instalada."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامهٔ دسکتاپ %@ نصب نیست."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app de bureau de %@ n’est pas installée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יישום שולחן העבודה של %@ אינו מותקן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ का डेस्कटॉप ऐप इंस्टॉल नहीं है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "App desktop %@ tidak diinstal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app desktop di %@ non è installata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@のデスクトップアプリがインストールされていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 데스크탑 앱이 설치되어 있지 않습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ चे डेस्कटॉप ॲप इन्स्टॉल नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi desktop %@ tidak dipasang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bureaubladapp van %@ is niet geïnstalleerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja %@ na komputer nie jest zainstalowana."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app para desktop do %@ não está instalado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicația desktop %@ nu este instalată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение «%@» для компьютера не установлено."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ டெஸ்க்டாப் செயலி நிறுவப்படவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ డెస్క్‌టాప్ యాప్ ఇన్‌స్టాల్ చేయబడలేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้ติดตั้งแอปเดสก์ท็อป %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ masaüstü uygulaması yüklü değil."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Програму %@ для компʼютера не інстальовано."
          }
        },
        "ur": {
