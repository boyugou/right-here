        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "bu bilgisayarın yapılandırması, %1$@ ayar aracılığıyla kendi programlarını başlatır: %2$@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "конфігурація цього комп’ютера запускає власні програми через налаштування запуску (%1$@): %2$@"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اس کمپیوٹر کی کنفیگ %1$@ سیٹنگ کے ذریعے اپنے پروگرام لانچ کرتی ہے: %2$@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cấu hình trên máy này khởi chạy các chương trình riêng qua %1$@ mục cài đặt: %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "本机配置通过 %1$@ 项自定义启动设置来启动程序：%2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
