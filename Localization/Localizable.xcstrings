          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Запускать агентов без вопросов?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "கேட்காமல் முகவர்களைத் தொடங்கவா?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "needs_review",
            "value": "అడగకుండా ఏజెంట్లను ప్రారంభించాలా?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เริ่มเอเจนต์โดยไม่ต้องถามหรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ajanlar sormadan başlatılsın mı?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Запускати агентів без запитань?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ایجنٹس بغیر پوچھے شروع کریں؟"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Khởi chạy tác tử mà không hỏi?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "无需询问即可启动智能体？"
          }
        },
        "zh-Hant": {
