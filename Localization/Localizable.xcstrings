    "refusal.launchFirstArgument": {
      "comment": "Why an action did nothing, shown in the alert after a click in Finder (and, in English, by the command line). %1$@ is a terminal app from the config, %2$@ is {app}/.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن يكون وسيط التشغيل الأول لـ %1$@ مسارًا مطلقًا أو أن يبدأ بـ %2$@."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-এর প্রথম লঞ্চ আর্গুমেন্টকে একটি অ্যাবসলিউট পাথ হতে হবে, অথবা %2$@ দিয়ে শুরু হতে হবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das erste Startargument von %1$@ muss ein absoluter Pfad sein oder mit %2$@ beginnen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το πρώτο όρισμα εκκίνησης του %1$@ πρέπει να είναι απόλυτη διαδρομή ή να ξεκινά με %2$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first launch argument of %1$@ must be an absolute path or start with %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El primer argumento de inicio de %1$@ debe ser una ruta absoluta o empezar por %2$@."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نخستین آرگومان اجرای %1$@ باید یک مسیر مطلق باشد یا با %2$@ شروع شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le premier argument de lancement de %1$@ doit être un chemin absolu ou commencer par %2$@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ארגומנט ההפעלה הראשון של %1$@ חייב להיות נתיב מוחלט או להתחיל ב-%2$@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ का पहला लॉन्च आर्ग्युमेंट एक ऐब्सोल्यूट पाथ होना चाहिए या %2$@ से शुरू होना चाहिए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Argumen peluncuran pertama dari %1$@ harus berupa jalur absolut atau diawali %2$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il primo argomento di avvio di %1$@ deve essere un percorso assoluto o iniziare con %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@の最初の起動引数は、絶対パスにするか、%2$@で始める必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 앱의 첫 번째 실행 인수는 절대 경로이거나 %2$@(으)로 시작해야 합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ चा पहिला लाँच आर्ग्युमेंट ॲब्सोल्यूट पाथ असला पाहिजे किंवा %2$@ ने सुरू झाला पाहिजे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Argumen pelancaran pertama %1$@ mestilah laluan mutlak atau bermula dengan %2$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het eerste startargument van %1$@ moet een absoluut pad zijn of met %2$@ beginnen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierwszy argument uruchamiania aplikacji %1$@ musi być ścieżką bezwzględną lub zaczynać się od %2$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O primeiro argumento de abertura de %1$@ deve ser um caminho absoluto ou começar com %2$@."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Primul argument de lansare al aplicației %1$@ trebuie să fie o cale absolută sau să înceapă cu %2$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Первый аргумент запуска приложения «%1$@» должен быть абсолютным путем или начинаться с %2$@."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ இன் முதல் தொடக்க வாதம் ஒரு முழுமையான பாதையாக இருக்க வேண்டும், அல்லது %2$@ உடன் தொடங்க வேண்டும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ యొక్క మొదటి లాంచ్ ఆర్గ్యుమెంట్ సంపూర్ణ పాత్ అయి ఉండాలి, లేదా %2$@ తో ప్రారంభం కావాలి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อาร์กิวเมนต์แรกในการเปิด %1$@ ต้องเป็นเส้นทางแบบเต็ม หรือขึ้นต้นด้วย %2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ uygulamasının ilk başlatma argümanı mutlak bir yol olmalı veya %2$@ ile başlamalıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перший аргумент запуску програми %1$@ має бути абсолютним шляхом або починатися з %2$@."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%1$@ کا پہلا لانچ آرگیومنٹ مکمل پاتھ ہونا چاہیے یا %2$@ سے شروع ہونا چاہیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đối số khởi chạy đầu tiên của %1$@ phải là đường dẫn tuyệt đối hoặc bắt đầu bằng %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 的第一个启动参数必须是绝对路径，或以 %2$@ 开头。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 的第一個啟動引數必須是絕對路徑，或以 %2$@ 開頭。"
          }
        }
      }
    },
    "refusal.name.backslash": {
      "comment": "Why an action did nothing, shown in the alert after a click in Finder (and, in English, by the command line). Follows refusal.presetFileName (or Folder, Item).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ذكر هذا الاسم سيضع شرطة مائلة عكسية في الموجّه (لأن الاسم يحتوي على واحدة، أو على علامة اقتباس ومسافة)، ولا تقرأ كل برامج Shell الشرطة المائلة العكسية بالطريقة نفسها داخل علامات الاقتباس."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নামটি উল্লেখ করলে প্রম্পটে একটি ব্যাকস্ল্যাশ ঢুকবে (নামটিতে একটি ব্যাকস্ল্যাশ আছে, অথবা একটি উদ্ধৃতিচিহ্ন ও একটি স্পেস আছে), আর উদ্ধৃতিচিহ্নের ভেতরের ব্যাকস্ল্যাশ সব শেল একইভাবে পড়ে না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Namen zu nennen, würde einen Backslash in den Prompt bringen (der Name enthält selbst einen oder ein Anführungszeichen und ein Leerzeichen), und nicht alle Shells lesen einen Backslash in Anführungszeichen gleich."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αναφορά αυτού του ονόματος θα έβαζε ανάστροφη κάθετο στην προτροπή (το όνομα περιέχει μία, ή ένα εισαγωγικό και ένα κενό), και δεν διαβάζουν όλα τα κελύφη με τον ίδιο τρόπο μια ανάστροφη κάθετο μέσα σε εισαγωγικά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Naming it would put a backslash in the prompt (its name has one, or a quote and a space), which shells do not all read the same way inside quotes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluir ese nombre pondría una barra invertida en el prompt (el nombre tiene una, o bien una comilla y un espacio), y no todos los shells leen igual una barra invertida dentro de comillas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آوردن این نام یک بک‌اسلش در پرامپت قرار می‌دهد (نام خودش بک‌اسلش دارد، یا یک گیومه و یک فاصله دارد)، و همهٔ پوسته‌ها بک‌اسلش را داخل گیومه یکسان نمی‌خوانند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Citer ce nom mettrait une barre oblique inverse dans le prompt (le nom en contient une, ou bien un guillemet et une espace), et les shells ne lisent pas tous de la même façon une barre oblique inverse entre guillemets."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ציון השם יכניס להנחיה לוכסן הפוך (יש בשם לוכסן הפוך, או מירכאה ורווח), ולא כל המעטפות קוראות לוכסן הפוך באותו אופן בתוך מירכאות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह नाम लेने से प्रॉम्प्ट में बैकस्लैश आ जाएगा (नाम में बैकस्लैश है, या एक उद्धरण चिह्न और एक स्पेस है), और सभी शेल उद्धरण चिह्नों के अंदर बैकस्लैश को एक ही तरह से नहीं पढ़ते।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyebut nama tersebut akan memasukkan garis miring terbalik ke prompt (nama itu berisi garis miring terbalik, atau tanda kutip dan spasi), sedangkan garis miring terbalik di dalam tanda kutip tidak dibaca dengan cara yang sama oleh semua shell."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nominarlo metterebbe una barra rovesciata nel prompt (il nome ne contiene una, oppure una virgoletta e uno spazio), e le shell non leggono tutte allo stesso modo una barra rovesciata tra virgolette."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その名前を含めると、プロンプトにバックスラッシュが入ります（名前にバックスラッシュがあるか、引用符と空白があるためです）。引用符の中のバックスラッシュの解釈はシェルによって異なります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 이름을 지정하면 프롬프트에 백슬래시가 들어갑니다(이름에 백슬래시가 있거나, 따옴표와 공백이 있기 때문입니다). 따옴표 안의 백슬래시는 셸마다 다르게 읽습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "त्याचे नाव दिल्यास प्रॉम्प्टमध्ये बॅकस्लॅश येईल (त्याच्या नावात बॅकस्लॅश आहे, किंवा अवतरणचिन्ह आणि स्पेस आहे), आणि अवतरणचिन्हांच्या आतील बॅकस्लॅश सर्व शेल सारखा वाचत नाहीत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menamakannya akan meletakkan garis condong terbalik dalam gesaan (namanya mengandunginya, atau mengandungi tanda petikan dan ruang), dan tidak semua cangkerang membaca garis condong terbalik di dalam tanda petikan dengan cara yang sama."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als de naam wordt genoemd, komt er een backslash in de prompt (de naam bevat er een, of een aanhalingsteken en een spatie), en niet alle shells lezen een backslash binnen aanhalingstekens op dezelfde manier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wymienienie tej nazwy umieściłoby w prompcie ukośnik wsteczny (nazwa go zawiera albo zawiera cudzysłów i spację), a nie wszystkie powłoki odczytują ukośnik wsteczny w cudzysłowie tak samo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Citar o nome colocaria uma barra invertida no prompt (o nome tem uma, ou tem aspas e um espaço), e nem todos os shells leem uma barra invertida da mesma forma entre aspas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Numirea lui ar pune o bară oblică inversă în prompt (numele lui conține una, sau ghilimele și un spațiu), iar nu toate shellurile citesc la fel o bară oblică inversă între ghilimele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если упомянуть это имя, в промпт попадет обратная косая черта (она есть в имени или в нем есть кавычка и пробел), а не все оболочки читают обратную косую черту в кавычках одинаково."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அதன் பெயரைக் குறிப்பிட்டால் ப்ராம்ப்ட்டில் பின்சாய்வுக்கோடு சேரும் (பெயரில் பின்சாய்வுக்கோடு உள்ளது, அல்லது மேற்கோள் குறியும் இடைவெளியும் உள்ளன); மேற்கோள் குறிகளுக்குள் உள்ள பின்சாய்வுக்கோட்டை எல்லா shell-களும் ஒரே விதமாகப் படிப்பதில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దాని పేరును పేర్కొంటే ప్రాంప్ట్‌లో బ్యాక్‌స్లాష్ వస్తుంది (పేరులో బ్యాక్‌స్లాష్ ఉంది, లేదా కోట్ మరియు ఖాళీ రెండూ ఉన్నాయి); కోట్స్ లోపల ఉన్న బ్యాక్‌స్లాష్‌ను అన్ని shell లు ఒకే విధంగా చదవవు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การระบุชื่อนี้จะทำให้มีแบ็กสแลชในพรอมต์ (ชื่อมีแบ็กสแลช หรือมีทั้งเครื่องหมายคำพูดและช่องว่าง) ซึ่งเชลล์แต่ละตัวอ่านแบ็กสแลชในเครื่องหมายคำพูดไม่เหมือนกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adını isteme yazmak, istemin içine bir ters eğik çizgi ekler (adında ters eğik çizgi ya da hem tırnak hem boşluk var); kabuklar tırnak içindeki ters eğik çizgiyi aynı biçimde okumaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо назвати цей елемент, у промпті зʼявиться зворотна скісна риска (вона є в назві або назва містить лапки й пробіл), а оболонки не однаково читають її в лапках."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس کا نام لینے سے پرامپٹ میں بیک سلیش آ جائے گا (اس کے نام میں بیک سلیش ہے، یا واوین اور خالی جگہ دونوں ہیں)، اور تمام شیلز واوین کے اندر بیک سلیش کو ایک ہی طرح نہیں پڑھتیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi tên của nó sẽ đưa dấu gạch chéo ngược vào lời nhắc (tên có dấu gạch chéo ngược, hoặc có cả dấu nháy lẫn dấu cách), mà các shell không đọc giống nhau khi nó nằm trong dấu nháy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写入该名称会在提示词中加入反斜杠（名称本身含有反斜杠，或同时含有引号和空格），而各种 shell 对引号内反斜杠的解读并不一致。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "寫入該名稱會在提示詞中加入反斜線（名稱本身含有反斜線，或同時含有引號和空格），而各種 shell 對引號內反斜線的解讀並不一致。"
          }
        }
      }
    },
    "refusal.name.controlCharacter": {
      "comment": "Why an action did nothing, shown in the alert after a click in Finder (and, in English, by the command line). Follows refusal.presetFileName (or Folder, Item); Its is that file's or folder's.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتوي الاسم على فاصل أسطر أو حرف تحكم آخر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নামটিতে একটি লাইন ব্রেক বা অন্য কোনো কন্ট্রোল ক্যারেক্টার আছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Name enthält einen Zeilenumbruch oder ein anderes Steuerzeichen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το όνομα περιέχει αλλαγή γραμμής ή άλλον χαρακτήρα ελέγχου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its name has a line break or another control character."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre tiene un salto de línea u otro carácter de control."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نام یک شکست خط یا نویسهٔ کنترلی دیگری دارد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom contient un saut de ligne ou un autre caractère de contrôle."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השם מכיל מעבר שורה או תו בקרה אחר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नाम में लाइन ब्रेक या कोई दूसरा कंट्रोल कैरेक्टर है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama tersebut berisi jeda baris atau karakter kontrol lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il suo nome contiene un a capo o un altro carattere di controllo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その名前に改行またはその他の制御文字が含まれています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름에 줄바꿈 또는 다른 제어 문자가 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "त्याच्या नावात लाइन ब्रेक किंवा दुसरे कंट्रोल कॅरेक्टर आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Namanya mengandungi pemisah baris atau aksara kawalan lain."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De naam bevat een regeleinde of een ander stuurteken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazwa zawiera znak końca wiersza lub inny znak sterujący."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome tem uma quebra de linha ou outro caractere de controle."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Numele lui conține un salt de linie sau alt caracter de control."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В имени есть перенос строки или другой управляющий символ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அதன் பெயரில் வரி முறிவு அல்லது வேறொரு கட்டுப்பாட்டு எழுத்து உள்ளது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దాని పేరులో లైన్ బ్రేక్ లేదా మరో కంట్రోల్ క్యారెక్టర్ ఉంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อนี้มีการขึ้นบรรทัดใหม่หรืออักขระควบคุมอื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adında bir satır sonu veya başka bir denetim karakteri var."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Назва містить розрив рядка або інший керівний символ."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس کے نام میں لائن بریک یا کوئی اور کنٹرول کیریکٹر ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên của nó có dấu xuống dòng hoặc một ký tự điều khiển khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该名称中有换行符或其他控制字符。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該名稱中有換行字元或其他控制字元。"
          }
        }
      }
    },
    "refusal.name.leadingDash": {
      "comment": "Why an action did nothing, shown in the alert after a click in Finder (and, in English, by the command line). Follows refusal.presetFileName (or Folder, Item).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بهذا الاسم سيبدأ الموجّه بشرطة، وسيقرؤها الوكيل على أنها خيار."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই নামের কারণে প্রম্পটটি একটি ড্যাশ দিয়ে শুরু হবে, যা এজেন্ট একটি অপশন হিসেবে পড়বে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit diesem Namen würde der Prompt mit einem Bindestrich beginnen, den der Agent als Option lesen würde."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Με αυτό το όνομα η προτροπή θα ξεκινούσε με παύλα, την οποία ο πράκτορας θα διάβαζε ως επιλογή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its name would start the prompt with a dash, which the agent would read as an option."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con ese nombre, el prompt empezaría con un guion, que el agente leería como una opción."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با این نام، پرامپت با خط تیره شروع می‌شود و عامل آن را یک گزینه می‌خواند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec ce nom, le prompt commencerait par un tiret, que l’agent lirait comme une option."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בגלל השם, ההנחיה תתחיל במקף, שהסוכן יקרא כאפשרות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस नाम से प्रॉम्प्ट डैश से शुरू होगा, जिसे एजेंट एक विकल्प के रूप में पढ़ेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan nama tersebut, prompt akan diawali tanda hubung, yang akan dibaca agen sebagai opsi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il suo nome farebbe iniziare il prompt con un trattino, che l’agente leggerebbe come un’opzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その名前を含めるとプロンプトがダッシュで始まり、エージェントはこれをオプションとして解釈してしまいます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 이름 때문에 프롬프트가 대시로 시작하게 되며, 에이전트는 이를 옵션으로 읽게 됩니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "त्याच्या नावामुळे प्रॉम्प्ट डॅशने सुरू होईल, आणि एजंट तो पर्याय म्हणून वाचेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Namanya akan menjadikan gesaan bermula dengan sengkang, yang akan dibaca oleh ejen sebagai pilihan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Door de naam zou de prompt met een streepje beginnen, dat de agent als optie zou lezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przez tę nazwę prompt zaczynałby się od myślnika, który agent odczytałby jako opcję."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome faria o prompt começar com um hífen, que o agente leria como uma opção."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Numele lui ar face ca promptul să înceapă cu o liniuță, pe care agentul ar citi-o ca pe o opțiune."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Из-за этого имени промпт начинался бы с дефиса, который агент воспринял бы как опцию."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அதன் பெயர் ப்ராம்ப்ட்டை ஒரு சிறுகோட்டுடன் தொடங்க வைக்கும்; முகவர் அதை ஒரு கட்டளை விருப்பமாகப் படித்துவிடும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దాని పేరు వల్ల ప్రాంప్ట్ డాష్‌తో ప్రారంభమవుతుంది; ఏజెంట్ దాన్ని ఒక ఆప్షన్‌గా చదువుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อนี้จะทำให้พรอมต์ขึ้นต้นด้วยขีด ซึ่งเอเจนต์จะอ่านเป็นตัวเลือกของคำสั่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adı, istemin bir tireyle başlamasına yol açar; ajan bunu bir seçenek olarak okur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Через цю назву промпт починався б із дефіса, і агент сприйняв би його як параметр."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس کے نام سے پرامپٹ ڈیش سے شروع ہوگا، جسے ایجنٹ ایک آپشن سمجھے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên của nó sẽ khiến lời nhắc bắt đầu bằng dấu gạch ngang, mà tác tử sẽ hiểu là một tùy chọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该名称会使提示词以短横线开头，智能体会将其视为一个选项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該名稱會使提示詞以短橫線開頭，代理程式會將其視為一個選項。"
          }
        }
      }
    },
    "refusal.name.misleadingCharacter": {
      "comment": "Why an action did nothing, shown in the alert after a click in Finder (and, in English, by the command line). Follows refusal.presetFileName (or Folder, Item).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتوي الاسم على حرف لا يُظهر شيئًا أو يغيّر طريقة قراءته (حرف لفرض الاتجاه، أو مسافة بعرض صفري، أو حرف وسم)، وسيقرأ الوكيل ما لا يستطيع الشخص رؤيته."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নামটিতে এমন একটি ক্যারেক্টার আছে যা কিছু দেখায় না বা নামটি কীভাবে পড়া হবে তা বদলে দেয় (দিক বদলানোর ক্যারেক্টার, শূন্য-প্রস্থের স্পেস, ট্যাগ ক্যারেক্টার), আর এজেন্ট এমন কিছু পড়বে যা মানুষ দেখতে পায় না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Name enthält ein Zeichen, das nichts anzeigt oder verändert, wie er zu lesen ist (eine Überschreibung der Schreibrichtung, ein Leerzeichen ohne Breite, ein Tag-Zeichen), und der Agent würde lesen, was man selbst nicht sehen kann."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το όνομα περιέχει χαρακτήρα που δεν εμφανίζει τίποτα ή αλλάζει τον τρόπο που διαβάζεται (παράκαμψη κατεύθυνσης, κενό μηδενικού πλάτους, χαρακτήρα ετικέτας), και ο πράκτορας θα διάβαζε κάτι που ο χρήστης δεν μπορεί να δει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its name has a character that shows nothing or changes how it reads (a direction override, a zero-width space, a tag character), and the agent would read what the person cannot see."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre tiene un carácter que no muestra nada o que cambia cómo se lee (un cambio forzado de dirección, un espacio de ancho cero, un carácter de etiqueta), y el agente leería lo que la persona no puede ver."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نام نویسه‌ای دارد که چیزی نشان نمی‌دهد یا نحوهٔ خوانده شدن نام را تغییر می‌دهد (نویسهٔ تغییر اجباری جهت، فاصلهٔ بدون پهنا، نویسهٔ برچسب)، و عامل چیزی را می‌خواند که کاربر نمی‌تواند ببیند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom contient un caractère qui n’affiche rien ou qui change la façon dont il se lit (un forçage de direction, une espace sans chasse, un caractère d’étiquette), et l’agent lirait ce que la personne ne peut pas voir."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השם מכיל תו שאינו מציג דבר או שמשנה את אופן הקריאה שלו (תו לכפיית כיוון, רווח ברוחב אפס, תו תגית), והסוכן יקרא את מה שאי אפשר לראות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नाम में ऐसा कैरेक्टर है जो कुछ नहीं दिखाता या नाम के पढ़े जाने का तरीका बदल देता है (दिशा बदलने वाला कैरेक्टर, शून्य-चौड़ाई वाली स्पेस, टैग कैरेक्टर), और एजेंट वह पढ़ेगा जो व्यक्ति देख नहीं सकता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama tersebut berisi karakter yang tidak menampilkan apa pun atau mengubah cara nama itu dibaca (penimpaan arah, spasi lebar nol, karakter tag), dan agen akan membaca apa yang tidak dapat dilihat orang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il suo nome contiene un carattere che non mostra nulla o che cambia il modo in cui si legge (un override di direzione, uno spazio a larghezza zero, un carattere tag), e l’agente leggerebbe qualcosa che una persona non può vedere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その名前に、何も表示されない文字や、読まれ方を変える文字（方向オーバーライド、ゼロ幅スペース、タグ文字）が含まれており、人には見えない内容をエージェントが読み取ってしまいます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름에 아무것도 표시하지 않거나 읽히는 방식을 바꾸는 문자(방향 재정의 문자, 폭 없는 공백, 태그 문자)가 있어, 사람이 볼 수 없는 내용을 에이전트가 읽게 됩니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "त्याच्या नावात असे कॅरेक्टर आहे जे काहीही दाखवत नाही किंवा नाव कसे वाचले जाते ते बदलते (दिशा बदलणारे ओव्हरराइड, शून्य रुंदीची स्पेस, टॅग कॅरेक्टर), आणि माणसाला जे दिसत नाही ते एजंट वाचेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Namanya mengandungi aksara yang tidak memaparkan apa-apa atau mengubah cara nama itu dibaca (penggantian arah, ruang lebar sifar, aksara tag), dan ejen akan membaca apa yang tidak dapat dilihat oleh orang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De naam bevat een teken dat niets toont of verandert hoe de naam wordt gelezen (een richtingsoverschrijving, een spatie zonder breedte, een tagteken), en de agent zou lezen wat een mens niet kan zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazwa zawiera znak, który nic nie wyświetla lub zmienia sposób jej odczytu (wymuszenie kierunku, spację o zerowej szerokości, znak tagu), a agent odczytałby to, czego człowiek nie widzi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome tem um caractere que não mostra nada ou que muda como o nome é lido (uma substituição de direção, um espaço de largura zero, um caractere de tag), e o agente leria o que uma pessoa não consegue ver."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Numele lui conține un caracter care nu afișează nimic sau schimbă modul în care se citește numele (o suprascriere de direcție, un spațiu de lățime zero, un caracter etichetă), iar agentul ar citi ceea ce un om nu poate vedea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В имени есть символ, который ничего не показывает или меняет то, как читается имя (переопределение направления, пробел нулевой ширины, символ тега), и агент прочитал бы то, чего человек не видит."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அதன் பெயரில் எதையும் காட்டாத அல்லது அது படிக்கப்படும் விதத்தை மாற்றும் ஓர் எழுத்து உள்ளது (திசை மேலெழுதல் குறி, பூஜ்ஜிய அகல இடைவெளி, டேக் எழுத்து); நீங்கள் காண முடியாததை முகவர் படித்துவிடும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దాని పేరులో ఏమీ చూపించని లేదా అది చదివే విధానాన్ని మార్చే అక్షరం ఉంది (దిశ ఓవర్‌రైడ్, సున్నా-వెడల్పు ఖాళీ, ట్యాగ్ అక్షరం), కాబట్టి మీరు చూడలేనిదాన్ని ఏజెంట్ చదువుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อนี้มีอักขระที่ไม่แสดงอะไรเลยหรือเปลี่ยนวิธีอ่านชื่อ (เช่น อักขระบังคับทิศทาง ช่องว่างความกว้างศูนย์ หรืออักขระแท็ก) และเอเจนต์จะอ่านสิ่งที่คุณมองไม่เห็น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adında hiçbir şey göstermeyen ya da adın okunuşunu değiştiren bir karakter var (yön geçersiz kılma karakteri, sıfır genişlikli boşluk, etiket karakteri); ajan, sizin göremediğiniz şeyi okur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Назва містить символ, який нічого не показує або змінює те, як вона читається (зміна напрямку тексту, пробіл нульової ширини, символ-тег), і агент прочитає те, чого ви не бачите."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس کے نام میں ایسا کیریکٹر ہے جو کچھ نہیں دکھاتا یا نام کے پڑھے جانے کا انداز بدل دیتا ہے (سمت بدلنے والا نشان، صفر چوڑائی والی جگہ، ٹیگ کیریکٹر)، اور ایجنٹ وہ پڑھے گا جو آپ نہیں دیکھ سکتے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên của nó có một ký tự không hiển thị gì hoặc thay đổi cách đọc tên (ký tự ghi đè hướng, khoảng trắng độ rộng bằng không, ký tự thẻ), và tác tử sẽ đọc được những gì bạn không nhìn thấy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该名称中有不显示任何内容或会改变其阅读方式的字符（方向覆盖符、零宽空格、标签字符），智能体会读到你看不见的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該名稱中有不顯示任何內容或會改變其閱讀方式的字元（方向覆寫字元、零寬空格、標籤字元），代理程式會讀到你看不見的內容。"
          }
        }
      }
    },
    "refusal.nameExhausted": {
      "comment": "Why an action did nothing, shown in the alert after a click in Finder (and, in English, by the command line). Creating a new file: every name tried is taken.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُعثر على اسم ملف متاح."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফাইলের জন্য কোনো অব্যবহৃত নাম পাওয়া যায়নি।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde kein freier Dateiname gefunden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν βρέθηκε ελεύθερο όνομα αρχείου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No free file name was found."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró ningún nombre de archivo libre."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هیچ نام فایل آزادی پیدا نشد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun nom de fichier libre n’a été trouvé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא נמצא שם קובץ פנוי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई उपलब्ध फ़ाइल नाम नहीं मिला।"
          }
        },
        "id": {
          "stringUnit": {
