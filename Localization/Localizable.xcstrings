    "app.allSetHint": {
      "comment": "Text under 'Everything is set up.' in the setup window: what to do next. Finder keeps its macOS name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "انقر بالزر الأيمن على مجلد في Finder لإرساله إلى الطرفية أو المحرر أو وكيل AI لديك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Finder-এ একটি ফোল্ডারে রাইট-ক্লিক করে সেটি আপনার টার্মিনাল, এডিটর বা AI এজেন্টে পাঠান."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Klicken Sie im Finder mit der rechten Maustaste auf einen Ordner, um ihn an Ihr Terminal, Ihren Editor oder Ihren AI-Agenten zu senden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Κάντε δεξί κλικ σε έναν φάκελο στο Finder για να τον στείλετε στο τερματικό, στον επεξεργαστή σας ή στον πράκτορα AI σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Right-click a folder in Finder to send it to your terminal, editor or AI agent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Haga clic con el botón derecho en una carpeta del Finder para enviarla a su terminal, editor o agente de AI."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "در Finder روی یک پوشه کلیک راست کنید تا آن را به ترمینال، ویرایشگر یا عامل AI خود بفرستید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Faites un clic droit sur un dossier dans le Finder pour l’envoyer à votre terminal, à votre éditeur ou à votre agent AI."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "לחצו לחיצה ימנית על תיקייה ב-Finder כדי לשלוח אותה למסוף, לעורך או לסוכן ה-AI שלכם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Finder में किसी फ़ोल्डर पर राइट-क्लिक करके उसे अपने टर्मिनल, एडिटर या AI एजेंट को भेजें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Klik kanan folder di Finder untuk mengirimnya ke terminal, editor, atau agen AI Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fai clic destro su una cartella nel Finder per inviarla al terminale, all'editor o all'agente AI."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Finder でフォルダを右クリックすると、ターミナル、エディタ、AIエージェントに送れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Finder에서 폴더를 우클릭하면 터미널, 편집기 또는 AI 에이전트로 보낼 수 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Finder मधील फोल्डरवर उजवे-क्लिक करून ते तुमच्या टर्मिनल, एडिटर किंवा AI एजंटकडे पाठवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Klik kanan pada folder dalam Finder untuk menghantarnya ke terminal, editor atau ejen AI anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Klik met de rechtermuisknop op een map in Finder om die naar je terminal, editor of AI-agent te sturen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kliknij folder prawym przyciskiem myszy w Finderze, aby wysłać go do terminala, edytora lub agenta AI."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Clique com o botão direito em uma pasta no Finder para enviá-la ao seu terminal, editor ou agente de AI."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Faceți clic dreapta pe un dosar în Finder, pentru a-l trimite în terminal, în editor sau la agentul AI."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Щёлкните правой кнопкой мыши по папке в Finder, чтобы отправить её в терминал, редактор или AI-агент."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Finder-இல் ஒரு கோப்புறையின் மீது வலது கிளிக் செய்து, அதை உங்கள் டெர்மினல், எடிட்டர் அல்லது AI முகவருக்கு அனுப்புங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Finder లో ఫోల్డర్పై రైట్-క్లిక్ చేసి, దాన్ని మీ టెర్మినల్, ఎడిటర్ లేదా AI ఏజెంట్కు పంపండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "คลิกขวาที่โฟลเดอร์ใน Finder เพื่อส่งไปยังเทอร์มินัล ตัวแก้ไข หรือเอเจนต์ AI ของคุณ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Finder’da bir klasöre sağ tıklayarak onu terminalinize, düzenleyicinize veya AI ajanınıza gönderin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Клацніть папку правою кнопкою миші у Finder, щоб надіслати її у термінал, редактор або AI-агент."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "کسی فولڈر پر Finder میں دائیں کلک کریں تاکہ اسے اپنے ٹرمینل، ایڈیٹر یا AI ایجنٹ کو بھیجا جا سکے۔"
          }
        },
        "vi": {
