            "value": "`%@` не знайдено у вашій оболонці входу"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "‏`%@` آپ کی لاگ ان شیل میں نہیں ملا"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "không tìm thấy `%@` trong shell đăng nhập của bạn"
          }
        },
        "zh-Hans": {
