    "app.editBusy": {
      "comment": "Said under the Undo note of a page of settings when a change that the person made was not written because the window stayed busy (an install or repair was running) for more than two seconds.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كان Right Here مشغولًا بعملية أخرى، فلم يُجرَ هذا التغيير. حاول مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here অন্য কাজে ব্যস্ত ছিল, তাই এই পরিবর্তনটি করা হয়নি। আবার চেষ্টা করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here war mit etwas anderem beschäftigt, deshalb wurde diese Änderung nicht vorgenommen. Versuche es noch einmal."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Right Here ήταν απασχολημένο με κάτι άλλο, γι’ αυτό η αλλαγή δεν πραγματοποιήθηκε. Δοκιμάστε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here was busy with something else, so this change was not made. Try it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here estaba ocupado con otra cosa, así que este cambio no se realizó. Inténtalo de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "‏Right Here با کار دیگری مشغول بود، پس این تغییر انجام نشد. دوباره امتحان کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here était occupé par une autre tâche, si bien que cette modification n’a pas été effectuée. Réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏Right Here היה עסוק במשהו אחר, ולכן השינוי לא בוצע. יש לנסות שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here किसी और काम में व्यस्त था, इसलिए यह बदलाव नहीं किया गया। कृपया फिर से कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here sedang sibuk dengan hal lain, jadi perubahan ini tidak dilakukan. Coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here era occupato con altre cose, quindi questa modifica non è stata effettuata. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here は別の作業中だったため、この変更は行われませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here가 다른 작업으로 바빠서 이 변경은 적용되지 않았습니다. 다시 시도하십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here दुसऱ्या कामात व्यस्त होता, म्हणून हा बदल केला गेला नाही. पुन्हा प्रयत्न करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here sedang sibuk dengan perkara lain, jadi perubahan ini tidak dibuat. Cuba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here was met iets anders bezig, dus deze wijziging is niet doorgevoerd. Probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here był zajęty czymś innym, więc tej zmiany nie wprowadzono. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Right Here estava ocupado com outra coisa, então esta alteração não foi feita. Tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here era ocupat cu altceva, așa că această modificare nu a fost făcută. Încercați din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here был занят другим, поэтому это изменение не было внесено. Попробуйте еще раз."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here வேறொன்றில் மும்முரமாக இருந்ததால் இந்த மாற்றம் செய்யப்படவில்லை. மீண்டும் முயற்சிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here వేరే పనిలో బిజీగా ఉన్నందున ఈ మార్పు చేయబడలేదు. మళ్లీ ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here กำลังยุ่งอยู่กับงานอื่น จึงยังไม่ได้ทำการเปลี่ยนแปลงนี้ ลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here başka bir işle meşguldü, bu nedenle bu değişiklik yapılamadı. Lütfen tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here був зайнятий чимось іншим, тож цю зміну не внесено. Спробуйте ще раз."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "‏Right Here کسی اور کام میں مصروف تھا، اس لیے یہ تبدیلی نہیں کی گئی۔ دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here đang bận việc khác nên thay đổi này chưa được thực hiện. Hãy thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here 正忙于其他事情，因此未能进行此更改。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here 正忙於其他事情，因此未能進行此變更。請再試一次。"
          }
        }
      }
    },
