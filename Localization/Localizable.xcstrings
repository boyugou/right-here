    "app.menuInexactNote": {
      "comment": "Note on the Finder menu page when the list of menu lines in the config file cannot be changed by dragging and checking. 'Config page' is the section of the window named by the glossary entry app.tabConfig.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قائمة الأسطر في ملف الإعداد لديك لا تطابق الأسطر المعروضة هنا، لأن هذا الـ Mac يوقف شيئًا. غيّر القائمة كنصٍّ في صفحة ملف الإعداد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কনফিগারেশন ফাইলের তালিকা এখানে দেখানো লাইনগুলোর সঙ্গে মেলে না, কারণ এই Mac কিছু একটা বন্ধ করে রেখেছে। তালিকাটি কনফিগ পৃষ্ঠায় টেক্সট হিসেবে বদলান।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Liste in deiner Konfigurationsdatei stimmt nicht mit den hier gezeigten Zeilen überein, weil dieser Mac etwas ausschaltet. Ändere die Liste als Text auf der Seite „Konfiguration“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η λίστα στο αρχείο ρυθμίσεων δεν ταιριάζει με τις γραμμές που εμφανίζονται εδώ, επειδή αυτό το Mac απενεργοποιεί κάτι. Αλλάξτε τη λίστα ως κείμενο στη σελίδα «Ρυθμίσεις»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The list in your config file does not match the lines shown here, because this Mac turns something off. Change the list as text on the Config page."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista de tu archivo de configuración no coincide con las líneas que se muestran aquí, porque este Mac desactiva algo. Cambia la lista como texto en la página Configuración."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فهرست موجود در فایل پیکربندی شما با سطرهایی که اینجا نشان داده می‌شوند مطابقت ندارد، چون این مک چیزی را خاموش کرده است. فهرست را به‌صورت متن در صفحهٔ پیکربندی تغییر دهید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste de votre fichier de configuration ne correspond pas aux lignes affichées ici, car ce Mac désactive quelque chose. Modifiez la liste sous forme de texte dans la page Configuration."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הרשימה בקובץ התצורה אינה תואמת לשורות המוצגות כאן, כי Mac זה מכבה משהו. יש לשנות את הרשימה כטקסט בעמוד ״תצורה״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी कॉन्फ़िगरेशन फ़ाइल की सूची यहाँ दिखाई गई पंक्तियों से मेल नहीं खाती, क्योंकि यह Mac कुछ बंद कर देता है। सूची को कॉन्फ़िग पेज पर टेक्स्ट के रूप में बदलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Daftar di file konfigurasi Anda tidak cocok dengan baris yang ditampilkan di sini, karena Mac ini mematikan sesuatu. Ubah daftar itu sebagai teks di halaman Konfigurasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’elenco nel tuo file di configurazione non corrisponde alle righe mostrate qui, perché questo Mac disattiva qualcosa. Modifica l’elenco come testo nella pagina Configurazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定ファイルの一覧が、ここに表示されている行と一致しません。この Mac で一部の項目が無効になっているためです。一覧は「設定」ページでテキストとして変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 파일의 목록이 여기에 표시된 항목과 일치하지 않습니다. 이 Mac에서 일부 항목을 껐기 때문입니다. 목록은 설정 페이지에서 텍스트로 변경하십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या कॉन्फिगरेशन फाइलमधील यादी इथे दाखवलेल्या ओळींशी जुळत नाही, कारण या Mac वर काहीतरी बंद केलेले आहे. यादी कॉन्फिग पृष्ठावर मजकूर म्हणून बदला."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Senarai dalam fail konfigurasi anda tidak sepadan dengan baris yang dipaparkan di sini, kerana Mac ini menyahaktifkan sesuatu. Ubah senarai itu sebagai teks pada halaman Konfigurasi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De lijst in het configuratiebestand komt niet overeen met de regels die hier worden getoond, omdat op deze Mac iets is uitgeschakeld. Wijzig de lijst als tekst op de pagina Configuratie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista w pliku konfiguracji nie zgadza się z wierszami pokazanymi tutaj, ponieważ ten Mac coś wyłącza. Zmień listę jako tekst na stronie Konfiguracja."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A lista no arquivo de configuração não corresponde às linhas mostradas aqui, porque este Mac desativa alguma coisa. Altere a lista como texto na página Configuração."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista din fișierul de configurare nu corespunde liniilor afișate aici, deoarece acest Mac dezactivează ceva. Modificați lista ca text, pe pagina Configurație."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Список в файле конфигурации не совпадает со строками меню, которые показаны здесь, потому что на этом Mac что-то отключено. Измените список в виде текста на странице «Конфигурация»."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் உள்ளமைவுக் கோப்பிலுள்ள பட்டியல் இங்கே காட்டப்படும் வரிகளுடன் பொருந்தவில்லை, ஏனெனில் இந்த Mac ஏதோ ஒன்றை முடக்கியுள்ளது. பட்டியலை உள்ளமைவுப் பக்கத்தில் உரையாக மாற்றவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ కాన్ఫిగరేషన్ ఫైల్‌లోని జాబితా ఇక్కడ చూపిన వరుసలతో సరిపోలడం లేదు, ఎందుకంటే ఈ Mac ఏదో ఒకదాన్ని ఆఫ్ చేస్తుంది. జాబితాను కాన్ఫిగరేషన్ పేజీలో టెక్స్ట్‌గా మార్చండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการในไฟล์การกำหนดค่าของคุณไม่ตรงกับบรรทัดที่แสดงอยู่ที่นี่ เพราะ Mac เครื่องนี้ปิดใช้งานบางอย่างไว้ ให้แก้ไขรายการเป็นข้อความในหน้าการกำหนดค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapılandırma dosyanızdaki liste, burada gösterilen satırlarla eşleşmiyor, çünkü bu Mac bir şeyi kapatıyor. Listeyi Yapılandırma sayfasında metin olarak değiştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Список у вашому файлі конфігурації не збігається з рядками, які показано тут, бо на цьому Mac дещо вимкнено. Змініть список як текст на сторінці «Конфігурація»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی کنفیگریشن فائل میں موجود فہرست یہاں دکھائے گئے آئٹمز سے میل نہیں کھاتی، کیونکہ یہ Mac کوئی چیز بند رکھتا ہے۔ فہرست کو کنفیگ صفحے پر متن کے طور پر تبدیل کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Danh sách trong tệp cấu hình của bạn không khớp với các mục menu hiển thị ở đây, vì máy Mac này đang tắt một thứ gì đó. Hãy thay đổi danh sách dưới dạng văn bản trên trang Cấu hình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置文件中的列表与此处显示的菜单项不一致，因为这台 Mac 关闭了某一项。请在“配置”页面以文本形式修改列表。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定檔中的清單與這裡顯示的選單項目不一致，因為這台 Mac 關閉了某一項。請在「設定檔」頁面以文字形式修改清單。"
          }
        }
      }
    },
    "app.menuMachineNote": {
      "comment": "Note above the menu editor. config.local.toml is a file name: keep it exactly as it is. It is the file with this Mac's own settings, next to the shared config file.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملف الإعداد الخاص بهذا الـ Mac، config.local.toml، يتضمّن القائمة، لذلك تُجرى التغييرات فيه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই Mac-এর নিজস্ব কনফিগারেশন ফাইল, config.local.toml, মেনুর তালিকা ধারণ করে, তাই পরিবর্তন সেখানেই করা হয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die eigene Konfigurationsdatei dieses Macs, config.local.toml, enthält die Liste des Menüs, daher werden Änderungen dort vorgenommen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το αρχείο ρυθμίσεων αυτού του Mac, config.local.toml, περιέχει τη λίστα του μενού, γι’ αυτό οι αλλαγές γίνονται εκεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac's own config file, config.local.toml, lists the menu, so changes are made there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo de configuración propio de este Mac, config.local.toml, contiene la lista del menú, así que los cambios se hacen ahí."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فایل پیکربندی ویژهٔ این مک، config.local.toml، فهرست منو را در خود دارد، پس تغییرات در همان فایل انجام می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier de configuration propre à ce Mac, config.local.toml, contient le menu : c’est donc là que les modifications sont faites."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קובץ התצורה של Mac זה, config.local.toml, מכיל את התפריט, ולכן השינויים נעשים בו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस Mac की अपनी कॉन्फ़िगरेशन फ़ाइल, config.local.toml, मेन्यू की सूची रखती है, इसलिए बदलाव वहीं किए जाते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File konfigurasi milik Mac ini, config.local.toml, memuat daftar menu, jadi perubahan dilakukan di sana."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file di configurazione di questo Mac, config.local.toml, elenca il menu, quindi le modifiche si fanno lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac 専用の設定ファイル config.local.toml にメニューが記載されているため、変更はそのファイルで行います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac 전용 설정 파일인 config.local.toml에 메뉴가 나열되어 있으므로 변경은 그 파일에서 합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या Mac ची स्वतःची कॉन्फिगरेशन फाइल config.local.toml मध्ये मेनूची यादी आहे, म्हणून बदल तिथे केले जातात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fail konfigurasi Mac ini sendiri, config.local.toml, menyenaraikan menu, jadi perubahan dibuat di sana."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het eigen configuratiebestand van deze Mac, config.local.toml, bevat het menu, dus wijzigingen worden daar aangebracht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Własny plik konfiguracji tego Maca, config.local.toml, zawiera menu, dlatego zmiany wprowadza się właśnie tam."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo de configuração próprio deste Mac, config.local.toml, lista o menu, então as alterações são feitas lá."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fișierul de configurare propriu acestui Mac, config.local.toml, conține meniul, așa că modificările se fac acolo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Собственный файл конфигурации этого Mac, config.local.toml, содержит меню, поэтому изменения вносятся именно в него."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த Mac-இன் சொந்த உள்ளமைவுக் கோப்பான config.local.toml மெனுவைப் பட்டியலிடுகிறது, எனவே மாற்றங்கள் அங்கே செய்யப்படுகின்றன."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ Mac యొక్క సొంత కాన్ఫిగరేషన్ ఫైల్ config.local.toml లో మెనూ జాబితా ఉంది, కాబట్టి మార్పులు అక్కడే చేయబడతాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์ config.local.toml ซึ่งเป็นไฟล์การกำหนดค่าของ Mac เครื่องนี้เอง มีรายการเมนูอยู่ จึงต้องทำการเปลี่ยนแปลงที่ไฟล์นั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac’in kendi yapılandırma dosyası config.local.toml, menüyü listeler; bu nedenle değişiklikler orada yapılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Власний файл конфігурації цього Mac — config.local.toml — містить меню, тому зміни вносяться саме туди."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس Mac کی اپنی کنفیگریشن فائل، config.local.toml، مینو کی فہرست رکھتی ہے، اس لیے تبدیلیاں وہیں کی جاتی ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp cấu hình riêng của máy Mac này, config.local.toml, liệt kê menu, nên mọi thay đổi được thực hiện ở đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 自己的配置文件 config.local.toml 列出了菜单，因此更改在该文件中进行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台 Mac 自己的設定檔 config.local.toml 列出了選單，因此變更會在該檔案中進行。"
          }
        }
      }
    },
