          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Installeer die app, of kies een andere op de pagina Overzicht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zainstaluj tę aplikację albo wybierz inną na stronie Przegląd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale esse app ou escolha outro na página Visão geral."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalați aplicația sau alegeți alta pe pagina Privire de ansamblu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установите это приложение или выберите другое на странице «Обзор»."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அதை நிறுவவும், அல்லது மேலோட்டம் பக்கத்தில் வேறொன்றைத் தேர்ந்தெடுக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దాన్ని ఇన్‌స్టాల్ చేయండి, లేదా అవలోకనం పేజీలో మరొకదాన్ని ఎంచుకోండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ติดตั้งแอปนั้น หรือเลือกแอปอื่นในหน้าภาพรวม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yükleyin veya Genel Bakış sayfasında başka birini seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інсталюйте цю програму або виберіть іншу на сторінці «Огляд»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسے انسٹال کریں، یا جائزہ صفحے پر کوئی اور منتخب کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài đặt ứng dụng đó, hoặc chọn ứng dụng khác trên trang Tổng quan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装它，或在“概览”页面中选择其他的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安裝它，或在「概覽」頁面中選擇其他的。"
          }
        }
      }
    },
