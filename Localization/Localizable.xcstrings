    "app.needsAttention": {
      "comment": "Summary line in the setup window when a check failed or needs the person.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعض الفحوصات تحتاج إلى انتباهك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কিছু চেকে আপনার মনোযোগ প্রয়োজন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Prüfungen brauchen deine Aufmerksamkeit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ορισμένοι έλεγχοι χρειάζονται την προσοχή σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some checks need your attention."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunas comprobaciones requieren tu atención."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برخی بررسی‌ها به توجه شما نیاز دارند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines vérifications demandent votre attention."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חלק מהבדיקות דורשות תשומת לב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ जाँचों पर आपका ध्यान चाहिए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beberapa pemeriksaan perlu perhatian Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcuni controlli richiedono la tua attenzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認が必要な項目があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인이 필요한 항목이 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "काही तपासण्यांकडे तुमचे लक्ष हवे आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Beberapa semakan memerlukan perhatian anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommige controles vragen je aandacht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niektóre kontrole wymagają Twojej uwagi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas verificações precisam da sua atenção."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Unele verificări necesită atenția dvs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторые проверки требуют внимания."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சில சோதனைகளுக்கு உங்கள் கவனம் தேவை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కొన్ని తనిఖీలకు మీ దృష్టి అవసరం."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตรวจสอบบางรายการต้องให้คุณดำเนินการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı denetimler dikkatinizi gerektiriyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Деякі перевірки потребують вашої уваги."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کچھ جانچوں پر آپ کی توجہ درکار ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một số mục kiểm tra cần bạn xem xét."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有些检查项需要你处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有些檢查項目需要你處理。"
          }
        }
      }
    },
    "app.newFileBuiltInNote2": {
      "comment": "Note under the built-in New File templates on the Finder menu page. Replaces app.newFileBuiltInNote: reuse its first sentence. 'Customize Templates' is the button (key app.newFileCustomize): use its translation exactly.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأتي هذه القوالب مع التطبيق. لتغييرها، اضغط «تخصيص القوالب»: عندها تُكتب في ملف الإعداد، حيث يمكنك تغييرها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই টেমপ্লেটগুলো অ্যাপের সঙ্গেই আসে। এগুলো বদলাতে “টেমপ্লেট কাস্টমাইজ করুন” চাপ দিন: তখন এগুলো আপনার কনফিগারেশন ফাইলে লেখা হয়, যেখানে আপনি এগুলো বদলাতে পারেন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Vorlagen sind in der App enthalten. Um sie zu ändern, drücke „Vorlagen anpassen“: Dann werden sie in deine Konfigurationsdatei geschrieben, wo du sie ändern kannst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτά τα πρότυπα είναι ενσωματωμένα στην εφαρμογή. Για να τα αλλάξετε, πατήστε «Προσαρμογή προτύπων»: τότε γράφονται στο αρχείο ρυθμίσεων, όπου μπορείτε να τα αλλάξετε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These templates come with the app. To change them, press Customize Templates: they are then written to your config file, where you can change them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas plantillas vienen con la app. Para cambiarlas, pulsa «Personalizar plantillas»: entonces se escriben en tu archivo de configuración, donde puedes cambiarlas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این الگوها همراه برنامه‌اند. برای تغییرشان، «سفارشی‌سازی الگوها» را بزنید: آن‌گاه در فایل پیکربندی شما نوشته می‌شوند و می‌توانید آنجا تغییرشان دهید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces modèles sont fournis avec l’app. Pour les changer, appuyez sur Personnaliser les modèles : ils sont alors écrits dans votre fichier de configuration, où vous pourrez les modifier."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תבניות אלה מגיעות עם היישום. כדי לשנות אותן, יש ללחוץ על ״התאמה אישית של התבניות״: הן ייכתבו לקובץ התצורה, ושם ניתן לשנות אותן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये टेम्पलेट ऐप के साथ आते हैं। इन्हें बदलने के लिए टेम्पलेट कस्टमाइज़ करें बटन दबाएँ: तब ये आपकी कॉन्फ़िगरेशन फ़ाइल में लिख दिए जाते हैं, जहाँ आप इन्हें बदल सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Templat ini disertakan dengan app. Untuk mengubahnya, tekan Sesuaikan Templat: templat akan ditulis ke file konfigurasi Anda, tempat Anda dapat mengubahnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi modelli sono forniti con l’app. Per modificarli, premi Personalizza modelli: verranno scritti nel tuo file di configurazione, dove potrai modificarli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのテンプレートはアプリに付属しています。変更するには「テンプレートをカスタマイズ」を押してください。テンプレートが設定ファイルに書き込まれ、そこで変更できるようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 템플릿은 앱과 함께 제공됩니다. 바꾸려면 템플릿 사용자화를 누르십시오. 그러면 템플릿이 설정 파일에 기록되며, 그곳에서 바꿀 수 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हे टेम्प्लेट ॲपसोबत येतात. ते बदलण्यासाठी “टेम्प्लेट सानुकूल करा” दाबा: मग ते तुमच्या कॉन्फिगरेशन फाइलमध्ये लिहिले जातात, जिथे तुम्ही ते बदलू शकता."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Templat ini disertakan bersama aplikasi. Untuk mengubahnya, tekan Sesuaikan Templat: templat itu kemudian ditulis ke fail konfigurasi anda, tempat anda boleh mengubahnya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze sjablonen worden met de app meegeleverd. Klik op „Pas sjablonen aan” om ze te wijzigen: ze worden dan in je configuratiebestand geschreven, waar je ze kunt wijzigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te szablony są dołączone do aplikacji. Aby je zmienić, kliknij w Dostosuj szablony: zostaną wtedy zapisane w pliku konfiguracji, gdzie można je zmienić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estes modelos vêm com o app. Para alterá-los, clique em Personalizar Modelos: eles são então gravados no seu arquivo de configuração, onde você pode alterá-los."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceste șabloane vin împreună cu aplicația. Pentru a le modifica, faceți clic pe Personalizați șabloanele: ele sunt apoi scrise în fișierul de configurare, unde le puteți modifica."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти шаблоны входят в состав приложения. Чтобы изменить их, нажмите «Настроить шаблоны»: тогда они будут записаны в файл конфигурации, где их можно изменить."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த வார்ப்புருக்கள் செயலியுடன் வருகின்றன. அவற்றை மாற்ற, வார்ப்புருக்களைத் தனிப்பயனாக்கு பொத்தானை அழுத்தவும்: பின்னர் அவை உங்கள் உள்ளமைவுக் கோப்பில் எழுதப்படும், அங்கே அவற்றை மாற்றலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ టెంప్లేట్‌లు యాప్‌తో వస్తాయి. వాటిని మార్చడానికి టెంప్లేట్‌లను అనుకూలీకరించండి బటన్‌ను నొక్కండి: అప్పుడు అవి మీ కాన్ఫిగరేషన్ ఫైల్‌లో రాయబడతాయి, అక్కడ మీరు వాటిని మార్చవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เทมเพลตเหล่านี้มาพร้อมแอป หากต้องการเปลี่ยน ให้กดปุ่มกำหนดเทมเพลตเอง จากนั้นเทมเพลตจะถูกเขียนลงในไฟล์การกำหนดค่าของคุณ ซึ่งคุณเปลี่ยนแปลงได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu şablonlar uygulamayla birlikte gelir. Bunları değiştirmek için Şablonları Özelleştir düğmesine basın: Şablonlar o zaman yapılandırma dosyanıza yazılır ve orada değiştirebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ці шаблони входять до складу програми. Щоб змінити їх, натисніть «Налаштувати шаблони»: тоді їх буде записано у ваш файл конфігурації, де їх можна змінити."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ ٹیمپلیٹس ایپ کے ساتھ آتے ہیں۔ انہیں تبدیل کرنے کے لیے “ٹیمپلیٹس حسبِ ضرورت بنائیں” دبائیں: پھر یہ آپ کی کنفیگریشن فائل میں لکھ دیے جاتے ہیں، جہاں آپ انہیں تبدیل کر سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các mẫu tệp này đi kèm với ứng dụng. Để thay đổi, hãy nhấn Tùy chỉnh mẫu tệp: khi đó chúng được ghi vào tệp cấu hình của bạn, nơi bạn có thể thay đổi chúng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些模板随 App 提供。要更改它们，请点按“自定义模板”：它们随后会写入你的配置文件，你可以在那里更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些範本隨 App 附帶。要變更它們，請按一下「自訂範本」：它們隨後會寫入你的設定檔，你可以在那裡變更。"
          }
        }
      }
    },
    "app.newFileCaption": {
      "comment": "Caption under the heading 'New File' (glossary entry group.newFile, the title of that Finder submenu: use its existing translation) on the Finder menu page of the setup window. A template is one kind of file the menu can make, for example a Python script.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنواع الملفات التي ينشئها «ملف جديد» في قائمة فايندر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder মেনুর “নতুন ফাইল” যেসব ধরনের ফাইল তৈরি করে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dateitypen, die „Neue Datei“ im Finder-Menü erstellt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι τύποι αρχείων που δημιουργεί το «Νέο αρχείο» στο μενού του Finder."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The kinds of file that “New File” in the Finder menu makes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tipos de archivo que crea «Nuevo archivo» en el menú del Finder."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "انواع فایل‌هایی که «فایل جدید» در منوی Finder ایجاد می‌کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les types de fichiers que crée « Nouveau fichier » dans le menu du Finder."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סוגי הקבצים שתפריט המשנה ״קובץ חדש״ בתפריט Finder יוצר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder मेन्यू में “नई फ़ाइल” से बनने वाली फ़ाइलों के प्रकार।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jenis file yang dibuat oleh “File Baru” di menu Finder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tipi di file creati da “Nuovo file” nel menu del Finder."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder のメニューにある「新規ファイル」で作成されるファイルの種類です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder 메뉴의 “새로운 파일”이 만드는 파일의 종류입니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder मेनूमधील “नवीन फाइल” द्वारे तयार होणाऱ्या फाइलींचे प्रकार."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jenis fail yang dicipta oleh “Fail Baharu” dalam menu Finder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De soorten bestanden die „Nieuw bestand” in het Finder-menu aanmaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rodzaje plików tworzonych przez pozycję „Nowy plik” w menu Findera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os tipos de arquivo que a opção “Novo Arquivo” do menu do Finder cria."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipurile de fișiere create de opțiunea „Fișier nou” din meniul Finder."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Типы файлов, которые создает пункт «Новый файл» в меню Finder."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder மெனுவில் உள்ள “புதிய கோப்பு” உருவாக்கும் கோப்பு வகைகள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder మెనూలో ఉన్న “కొత్త ఫైల్” సృష్టించే ఫైల్ రకాలు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ประเภทของไฟล์ที่ “ไฟล์ใหม่” ในเมนูของ Finder สร้าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder menüsündeki “Yeni Dosya” komutunun oluşturduğu dosya türleri."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Типи файлів, які створює пункт «Новий файл» у меню Finder."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "‏Finder کے مینو میں “نئی فائل” سے بننے والی فائلوں کی اقسام۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các loại tệp mà mục “Tệp mới” trong menu Finder tạo ra."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "访达菜单中“新建文件”会创建的文件类型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder 選單中「新增檔案」會建立的檔案類型。"
          }
        }
      }
    },
