          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %1$@ είναι τερματικό, όχι επεξεργαστής. Χρησιμοποιήστε το %2$@ για να ανοίξετε έναν φάκελο σε αυτό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is a terminal, not an editor. Use %2$@ to open a folder in it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ es una terminal, no un editor. Usa %2$@ para abrir una carpeta en ella."
