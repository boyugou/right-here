          "stringUnit": {
            "state": "translated",
            "value": "%@ என்ற பாதை இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ఉనికిలో లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ไม่มีอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ mevcut değil."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не існує."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%@ موجود نہیں ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ không tồn tại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不存在。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不存在。"
          }
        }
      }
    },
    "refusal.preset.launcher": {
      "comment": "Why an action did nothing, shown in the alert after a click in Finder (and, in English, by the command line). %1$@ is @link or @desktop; %2$@ shows the form of an action id.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُكتب الإعداد المسبق للوكيل في وحدة طرفية، لذا لا ينطبق %1$@ هنا. اذكر وحدة طرفية من `rh apps` (%2$@) أو احذف اللاحقة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এজেন্ট প্রিসেট টার্মিনালে টাইপ করা হয়, তাই %1$@ এখানে খাটে না। `rh apps` থেকে একটি টার্মিনালের নাম দিন (%2$@), অথবা প্রত্যয়টি বাদ দিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Agent-Voreinstellung wird in ein Terminal eingegeben, daher gilt %1$@ hier nicht. Nenne ein Terminal aus `rh apps` (%2$@) oder lass den Zusatz weg."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια προεπιλογή πράκτορα πληκτρολογείται σε τερματικό, οπότε το %1$@ δεν ισχύει. Ορίστε ένα τερματικό από το `rh apps` (%2$@) ή παραλείψτε την κατάληξη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A preset is typed into a terminal, so %1$@ does not apply. Name a terminal from `rh apps` (%2$@) or leave the suffix out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un preajuste de agente se escribe en una terminal, así que %1$@ no se aplica. Indica una terminal de `rh apps` (%2$@) o quita el sufijo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیش‌تنظیم عامل در ترمینال تایپ می‌شود، بنابراین %1$@ اینجا کاربرد ندارد. یک ترمینال از `rh apps` نام ببرید (%2$@) یا پسوند را حذف کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un préréglage d’agent est saisi dans un terminal, donc %1$@ ne s’applique pas. Indiquez un terminal de `rh apps` (%2$@) ou retirez le suffixe."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגדרה מוכנה לסוכן מוקלדת במסוף, ולכן %1$@ לא חל כאן. יש לציין מסוף מתוך `rh apps` (%2$@) או להשמיט את הסיומת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एजेंट प्रीसेट टर्मिनल में टाइप किया जाता है, इसलिए %1$@ यहाँ लागू नहीं होता। `rh apps` में से कोई टर्मिनल बताएँ (%2$@) या यह सफ़िक्स हटा दें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Preset agen diketik ke terminal, jadi %1$@ tidak berlaku. Sebutkan terminal dari `rh apps` (%2$@) atau hapus akhiran tersebut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un preset viene digitato in un terminale, quindi %1$@ non si applica. Indica un terminale tra quelli di `rh apps` (%2$@) oppure togli il suffisso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プリセットはターミナルに入力されるため、%1$@は適用されません。`rh apps` に表示されるターミナルを指定する（%2$@）か、この接尾辞を省いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프리셋은 터미널에 입력되므로 %1$@ 접미사는 적용되지 않습니다. `rh apps` 목록의 터미널을 지정하거나(%2$@) 접미사를 빼십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रीसेट टर्मिनलमध्ये टाइप केला जातो, त्यामुळे %1$@ लागू होत नाही. `rh apps` मधील एखादे टर्मिनल द्या (%2$@) किंवा हा प्रत्यय काढून टाका."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Praset ejen ditaip ke dalam terminal, jadi %1$@ tidak terpakai. Namakan terminal daripada `rh apps` (%2$@) atau buang akhiran itu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een agentvoorinstelling wordt in een terminal getypt, dus %1$@ is niet van toepassing. Noem een terminal uit `rh apps` (%2$@) of laat het achtervoegsel weg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gotowy prompt jest wpisywany do terminala, więc %1$@ nie ma zastosowania. Podaj terminal z `rh apps` (%2$@) albo pomiń przyrostek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma predefinição de agente é digitada em um terminal, então %1$@ não se aplica. Indique um terminal de `rh apps` (%2$@) ou remova o sufixo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O presetare pentru agent este tastată într-un terminal, deci %1$@ nu se aplică. Indicați un terminal din `rh apps` (%2$@) sau omiteți sufixul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пресет агента вводится в терминал, поэтому %1$@ здесь не действует. Укажите терминал из `rh apps` (%2$@) или уберите суффикс."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முன்னமைவு ஒரு டெர்மினலில் தட்டச்சு செய்யப்படும், எனவே %1$@ இங்கே பொருந்தாது. `rh apps` பட்டியலிலிருந்து ஒரு டெர்மினலைக் குறிப்பிடவும் (%2$@), அல்லது அந்தப் பின்னொட்டை விட்டுவிடவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రీసెట్ టెర్మినల్‌లో టైప్ చేయబడుతుంది, కాబట్టి %1$@ ఇక్కడ వర్తించదు. `rh apps` లోని ఒక టెర్మినల్ పేరును ఇవ్వండి (%2$@), లేదా ఆ ప్రత్యయాన్ని తీసివేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พรีเซ็ตจะถูกพิมพ์ลงในเทอร์มินัล ดังนั้น %1$@ จึงใช้ไม่ได้ ระบุเทอร์มินัลจาก `rh apps` (%2$@) หรือตัดส่วนต่อท้ายนี้ออก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir ön ayar bir terminale yazılır, bu yüzden %1$@ burada geçerli değil. `rh apps` listesinden bir terminal belirtin (%2$@) ya da son eki kaldırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пресет агента вводиться в термінал, тому %1$@ тут не застосовується. Укажіть термінал зі списку `rh apps` (%2$@) або приберіть суфікс."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پری سیٹ ٹرمینل میں ٹائپ کیا جاتا ہے، اس لیے %1$@ یہاں لاگو نہیں ہوتا۔ `rh apps` میں سے کسی ٹرمینل کا نام دیں (%2$@)، یا یہ لاحقہ ہٹا دیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mẫu lời nhắc được gõ vào terminal, nên %1$@ không áp dụng. Hãy chỉ định một terminal trong `rh apps` (%2$@) hoặc bỏ phần hậu tố."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预设会被输入到终端中，因此 %1$@ 不适用。请指定 `rh apps` 中的一个终端（%2$@），或去掉该后缀。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設組會被輸入到終端機中，因此 %1$@ 不適用。請指定 `rh apps` 中的一個終端機（%2$@），或去掉該後綴。"
          }
        }
      }
    },
    "refusal.preset.needsFiles": {
      "comment": "Why an action did nothing, shown in the alert after a click in Finder (and, in English, by the command line).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل هذا الإعداد المسبق للوكيل على الملفات المحددة؛ حدّد ملفًا واحدًا أو أكثر (المجلدات لا تُحتسب)."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই এজেন্ট প্রিসেট নির্বাচিত ফাইলে কাজ করে; এক বা একাধিক ফাইল নির্বাচন করুন (ফোল্ডার গণ্য হয় না)।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Agent-Voreinstellung arbeitet mit ausgewählten Dateien; wähle eine oder mehrere Dateien aus (Ordner zählen nicht)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η προεπιλογή πράκτορα λειτουργεί με επιλεγμένα αρχεία· επιλέξτε ένα ή περισσότερα αρχεία (οι φάκελοι δεν μετράνε)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This preset works on selected files; select one or more files (folders do not count)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este preajuste de agente funciona con archivos seleccionados; selecciona uno o más archivos (las carpetas no cuentan)."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این پیش‌تنظیم عامل روی فایل‌های انتخاب‌شده کار می‌کند؛ یک یا چند فایل انتخاب کنید (پوشه‌ها حساب نمی‌شوند)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce préréglage d’agent agit sur des fichiers sélectionnés ; sélectionnez un ou plusieurs fichiers (les dossiers ne comptent pas)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגדרה מוכנה זו פועלת על קבצים שנבחרו; יש לבחור קובץ אחד או יותר (תיקיות לא נספרות)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह एजेंट प्रीसेट चुनी गई फ़ाइलों पर काम करता है; एक या अधिक फ़ाइलें चुनें (फ़ोल्डर नहीं गिने जाते)।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Preset agen ini bekerja pada file yang dipilih; pilih satu file atau lebih (folder tidak dihitung)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo preset lavora sui file selezionati; seleziona uno o più file (le cartelle non contano)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプリセットは選択したファイルに対して動作します。1つ以上のファイルを選択してください（フォルダは対象外です）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 프리셋은 선택한 파일에 대해 동작합니다. 파일을 하나 이상 선택하십시오(폴더는 포함되지 않습니다)."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हा प्रीसेट निवडलेल्या फाइलवर काम करतो; एक किंवा अधिक फाइल निवडा (फोल्डर मोजले जात नाहीत)."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Praset ini berfungsi pada fail yang dipilih; pilih satu atau lebih fail (folder tidak dikira)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze agentvoorinstelling werkt op geselecteerde bestanden; selecteer een of meer bestanden (mappen tellen niet mee)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten gotowy prompt działa na zaznaczonych plikach; zaznacz co najmniej jeden plik (foldery się nie liczą)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta predefinição de agente funciona com arquivos selecionados; selecione um ou mais arquivos (pastas não contam)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această presetare lucrează cu fișierele selectate; selectați unul sau mai multe fișiere (dosarele nu contează)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот пресет работает с выбранными файлами; выберите один или несколько файлов (папки не считаются)."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த முன்னமைவு தேர்ந்தெடுத்த கோப்புகளில் செயல்படும்; ஒன்று அல்லது அதற்கு மேற்பட்ட கோப்புகளைத் தேர்ந்தெடுக்கவும் (கோப்புறைகள் கணக்கில் வராது)."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ప్రీసెట్ ఎంచుకున్న ఫైళ్లపై పనిచేస్తుంది; ఒకటి లేదా అంతకంటే ఎక్కువ ఫైళ్లను ఎంచుకోండి (ఫోల్డర్‌లు లెక్కలోకి రావు)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พรีเซ็ตนี้ทำงานกับไฟล์ที่เลือก เลือกไฟล์อย่างน้อยหนึ่งไฟล์ (ไม่นับโฟลเดอร์)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ön ayar seçili dosyalarla çalışır; bir veya daha fazla dosya seçin (klasörler sayılmaz)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей пресет агента працює з вибраними файлами; виберіть один або кілька файлів (папки не враховуються)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ پری سیٹ منتخب فائلوں پر کام کرتا ہے؛ ایک یا زیادہ فائلیں منتخب کریں (فولڈر شمار نہیں ہوتے)۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mẫu lời nhắc này hoạt động trên các tệp được chọn; hãy chọn một hoặc nhiều tệp (thư mục không được tính)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此预设作用于所选文件；请选择一个或多个文件（文件夹不算）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此預設組作用於所選檔案；請選擇一個或多個檔案（檔案夾不算）。"
          }
        }
      }
    },
    "refusal.preset.noAgent": {
      "comment": "Why an action did nothing, shown in the alert after a click in Finder (and, in English, by the command line). general.agents is a word of the config: keep it.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد وكيل مفعّل؛ أضف وكيلًا إلى general.agents، أو حدّد وكيلًا في الإعداد المسبق للوكيل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো এজেন্ট চালু নেই; general.agents-এ একটি যোগ করুন, অথবা এজেন্ট প্রিসেটে একটি এজেন্টের নাম দিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Agent ist aktiviert; trage einen in general.agents ein oder nenne einen Agenten in der Agent-Voreinstellung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν είναι ενεργοποιημένος κανένας πράκτορας· προσθέστε έναν στο general.agents ή ορίστε έναν πράκτορα στην προεπιλογή πράκτορα."
          }
        },
        "en": {
