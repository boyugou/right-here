    "doctor.fix.menuEmpty": {
      "comment": "Fix line under a check in the setup window's Details list: what the person should do. A sentence. Keep the command in backticks exactly.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شغّل `rh menu --explain` لمعرفة سبب استبعاد كل عنصر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "`rh menu --explain` চালান, প্রতিটি আইটেম কেন বাদ পড়ছে তা দেখতে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führe `rh menu --explain` aus, um für jeden Eintrag zu sehen, warum er weggelassen wird."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εκτελέστε `rh menu --explain` για να δείτε γιατί παραλείπεται κάθε στοιχείο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run `rh menu --explain` to see why each entry is left out."
          }
        },
        "es": {
