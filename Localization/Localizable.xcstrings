    "trust.promptsOff": {
      "comment": "Same card, same form. Use the catalog's existing term for permission prompts (see app.bypass*). A list of agents and flags may follow after a colon.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوقف طلبات الإذن الخاصة بالوكيل"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি এজেন্টের অনুমতি চাওয়ার প্রশ্ন বন্ধ করে"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "schaltet die Berechtigungsabfragen des Agenten ab"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "απενεργοποιεί τις ερωτήσεις για άδειες του πράκτορα"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "it switches the agent's permission prompts off"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "desactiva las solicitudes de permiso del agente"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "درخواست‌های مجوز عامل را خاموش می‌کند"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "désactive les demandes d’autorisation de l’agent"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מכבה את בקשות ההרשאה של הסוכן"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह एजेंट के अनुमति वाले सवाल बंद कर देती है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "mematikan permintaan izin agen"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "disattiva le richieste di permesso dell’agente"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントの許可の確認を無効にします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트의 권한 요청을 끕니다"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एजंटची परवानगी विचारणा बंद करते"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "menyahaktifkan gesaan kebenaran ejen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "schakelt de toestemmingsvragen van de agent uit"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "wyłącza pytania agenta o uprawnienia"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "desliga os pedidos de permissão do agente"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "dezactivează solicitările de permisiune ale agentului"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "отключает запросы разрешений агента"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது முகவரின் அனுமதிக் கேள்விகளை அணைக்கும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇది ఏజెంట్ అనుమతి ప్రశ్నలను ఆఫ్ చేస్తుంది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิดการถามขออนุญาตของเอเจนต์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ajanın izin istemlerini kapatır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "вимикає запити на дозвіл агента"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ ایجنٹ کے اجازت کے پرامپٹ بند کر دیتی ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "tắt các lời nhắc xin phép của tác tử"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它会关闭智能体的权限提示"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它會關閉代理程式的權限提示"
          }
        }
      }
    },
