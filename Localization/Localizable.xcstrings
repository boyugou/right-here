            "value": "Installiere ihn, oder entferne auf der Seite „Agenten“ das Häkchen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Εγκαταστήστε τον πράκτορα ή αποεπιλέξτε τον στη σελίδα «Πράκτορες»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install it, or uncheck it on the Agents page."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Instálalo o desmárcalo en la página Agentes."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "آن را نصب کنید، یا در صفحهٔ «عامل‌ها» علامتش را بردارید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Installez-le, ou décochez-le dans la page Agents."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "יש להתקין אותו, או להסיר את הסימון שלו בעמוד ״סוכנים״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इसे इंस्टॉल करें, या “एजेंट” पेज पर इसका चयन हटाएँ।"
