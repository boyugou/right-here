            "value": "`%@` не найден в оболочке входа"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "`%@` உங்கள் login shell இல் கிடைக்கவில்லை"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "`%@` మీ login shell లో కనుగొనబడలేదు"
