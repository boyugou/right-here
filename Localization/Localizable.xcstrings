    "app.subtitle": {
      "comment": "One-line description under the app name in the setup window.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أرسل مجلدًا أو تحديدًا إلى الوحدات الطرفية والمحررات ووكلاء الذكاء الاصطناعي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "একটি ফোল্ডার বা নির্বাচন আপনার টার্মিনাল, এডিটর ও AI এজেন্টে পাঠান।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sende einen Ordner oder eine Auswahl an deine Terminals, Editoren und KI-Agenten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Στείλτε έναν φάκελο ή μια επιλογή στα τερματικά, στους επεξεργαστές και στους πράκτορες AI σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send a folder or selection to your terminals, editors and AI agents."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Envía una carpeta o una selección a tus terminales, editores y agentes de IA."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "یک پوشه یا موارد انتخاب‌شده را به ترمینال‌ها، ویرایشگرها و عامل‌های هوش مصنوعی خود بفرستید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Envoyez un dossier ou une sélection vers vos terminaux, éditeurs et agents IA."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "שליחת תיקיה או בחירה אל המסופים, העורכים וסוכני ה-AI שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "किसी फ़ोल्डर या चयन को अपने टर्मिनल, एडिटर और AI एजेंट तक भेजें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kirim folder atau pilihan ke terminal, editor, dan agen AI Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Invia una cartella o una selezione ai tuoi terminali, editor e agenti IA."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "フォルダや選択項目を、ターミナル、エディタ、AIエージェントに送ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "폴더나 선택 항목을 터미널, 편집기, AI 에이전트로 보냅니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "फोल्डर किंवा निवड तुमच्या टर्मिनल, एडिटर आणि AI एजंटकडे पाठवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hantar folder atau pilihan ke terminal, editor dan ejen AI anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stuur een map of selectie naar je terminals, editors en AI-agenten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wyślij folder lub zaznaczenie do swoich terminali, edytorów i agentów AI."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Envie uma pasta ou seleção para seus terminais, editores e agentes de IA."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trimiteți un dosar sau o selecție către terminalele, editoarele și agenții dvs. AI."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Отправка папки или выбранных объектов в терминалы, редакторы и ИИ-агенты."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ஒரு கோப்புறை அல்லது தேர்வை உங்கள் டெர்மினல்கள், எடிட்டர்கள் மற்றும் AI முகவர்களுக்கு அனுப்புங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ఫోల్డర్ లేదా ఎంపికను మీ టెర్మినల్స్, ఎడిటర్లు మరియు AI ఏజెంట్లకు పంపండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ส่งโฟลเดอร์หรือรายการที่เลือกไปยังเทอร์มินัล โปรแกรมแก้ไข และเอเจนต์ AI ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bir klasörü veya seçimi terminallerinize, düzenleyicilerinize ve YZ ajanlarınıza gönderin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Надсилайте папку або вибране до своїх терміналів, редакторів і ШІ-агентів."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "کوئی فولڈر یا انتخاب اپنے ٹرمینلز، ایڈیٹرز اور AI ایجنٹس کو بھیجیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gửi một thư mục hoặc các mục đã chọn tới terminal, trình soạn thảo và tác tử AI của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "将文件夹或所选项目发送到你的终端、编辑器和 AI 智能体。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "將檔案夾或所選項目傳送到你的終端機、編輯器和 AI 代理程式。"
          }
        }
      }
    },
