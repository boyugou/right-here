    "app.presetPlaceholders": {
      "comment": "Caption under the field for the text of a prompt preset. {files}, {folder} and {name} are placeholders that are replaced when the preset is used. The placeholders {files}, {folder} and {name} are written exactly like that in every language and are never translated.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يمثّل {files} الملفات المحددة. ويمثّل {folder} المجلد الذي توجد فيه، و{name} اسم ما تم تحديده. يُكتب الموجّه في سطر واحد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{files} মানে নির্বাচিত ফাইলগুলো। {folder} মানে সেগুলো যে ফোল্ডারে আছে, আর {name} মানে নির্বাচিত আইটেমের নাম। প্রম্পট এক লাইনে লেখা হয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{files} steht für die ausgewählten Dateien. {folder} steht für den Ordner, in dem sie liegen, und {name} für den Namen des Ausgewählten. Der Prompt wird in einer einzigen Zeile eingegeben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Το {files} αντιπροσωπεύει τα επιλεγμένα αρχεία. Το {folder} αντιπροσωπεύει τον φάκελο στον οποίο βρίσκονται και το {name} το όνομα του επιλεγμένου στοιχείου. Η προτροπή πληκτρολογείται σε μία γραμμή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{files} stands for the selected files. {folder} stands for the folder they are in, and {name} for the name of what is selected. The prompt is typed as one line."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{files} representa los archivos seleccionados. {folder} representa la carpeta en la que están, y {name} el nombre de lo que está seleccionado. El prompt se escribe en una sola línea."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "‏{files} معادل فایل‌های انتخاب‌شده است. {folder} معادل پوشه‌ای است که آن‌ها در آن هستند و {name} معادل نام چیزی است که انتخاب شده. پرامپت در یک خط تایپ می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{files} représente les fichiers sélectionnés. {folder} représente le dossier qui les contient, et {name} le nom de l’élément sélectionné. Le prompt se saisit sur une seule ligne."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "‏{files} מייצג את הקבצים שנבחרו. {folder} מייצג את התיקיה שבה הם נמצאים, ו-{name} את שמו של מה שנבחר. ההנחיה מוקלדת בשורה אחת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{files} चुनी गई फ़ाइलों के लिए है। {folder} उस फ़ोल्डर के लिए है जिसमें वे हैं, और {name} चुनी गई चीज़ के नाम के लिए। प्रॉम्प्ट एक पंक्ति में टाइप किया जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{files} mewakili file yang dipilih. {folder} mewakili folder tempat file itu berada, dan {name} mewakili nama item yang dipilih. Prompt ditulis dalam satu baris."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{files} indica i file selezionati. {folder} indica la cartella in cui si trovano e {name} il nome dell’elemento selezionato. Il prompt viene digitato su una sola riga."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{files} は選択したファイルを表します。{folder} はそのファイルがあるフォルダ、{name} は選択した項目の名前を表します。プロンプトは1行で入力します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{files} 자리에는 선택한 파일이 들어갑니다. {folder} 자리에는 그 파일이 있는 폴더가, {name} 자리에는 선택한 항목의 이름이 들어갑니다. 프롬프트는 한 줄로 입력합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{files} म्हणजे निवडलेल्या फाइली. {folder} म्हणजे त्या फाइली असलेला फोल्डर आणि {name} म्हणजे निवडलेल्या वस्तूचे नाव. प्रॉम्प्ट एका ओळीत टाइप केला जातो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{files} mewakili fail yang dipilih. {folder} mewakili folder tempat fail itu berada dan {name} mewakili nama item yang dipilih. Gesaan ditaip dalam satu baris."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{files} staat voor de geselecteerde bestanden. {folder} staat voor de map waarin ze staan en {name} voor de naam van wat is geselecteerd. De prompt wordt in één regel getypt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{files} oznacza zaznaczone pliki. {folder} oznacza folder, w którym się znajdują, a {name} – nazwę zaznaczonej pozycji. Prompt wpisuje się w jednym wierszu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{files} representa os arquivos selecionados. {folder} representa a pasta em que eles estão e {name} o nome do item selecionado. O prompt é digitado em uma única linha."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{files} înseamnă fișierele selectate. {folder} înseamnă dosarul în care se află acestea și {name} numele articolului selectat. Promptul se introduce pe un singur rând."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{files} обозначает выбранные файлы. {folder} — папку, в которой они находятся, а {name} — имя выбранного объекта. Промпт вводится в одну строку."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{files} என்பது தேர்ந்தெடுக்கப்பட்ட கோப்புகளைக் குறிக்கும். {folder} அவை உள்ள கோப்புறையையும், {name} தேர்ந்தெடுக்கப்பட்டதன் பெயரையும் குறிக்கும். ப்ராம்ப்ட் ஒரே வரியில் தட்டச்சு செய்யப்படுகிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{files} అంటే ఎంచుకున్న ఫైల్‌లు. {folder} అంటే అవి ఉన్న ఫోల్డర్, {name} అంటే ఎంచుకున్నదాని పేరు. ప్రాంప్ట్ ఒకే వరుసలో టైప్ చేయబడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{files} แทนไฟล์ที่เลือก {folder} แทนโฟลเดอร์ที่ไฟล์เหล่านั้นอยู่ และ {name} แทนชื่อของสิ่งที่เลือก พรอมต์จะถูกพิมพ์เป็นบรรทัดเดียว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{files} seçili dosyaları temsil eder. {folder} bu dosyaların bulunduğu klasörü, {name} ise seçilenin adını temsil eder. İstem tek satır olarak yazılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{files} означає вибрані файли. {folder} — папку, у якій вони розташовані, а {name} — назву вибраного обʼєкта. Промпт вводиться в один рядок."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "‏{files} منتخب فائلوں کو ظاہر کرتا ہے۔ {folder} اُس فولڈر کو ظاہر کرتا ہے جس میں وہ ہیں، اور {name} منتخب شے کے نام کو۔ پرامپٹ ایک ہی سطر میں ٹائپ کیا جاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{files} là các tệp đã chọn. {folder} là thư mục chứa chúng, còn {name} là tên của mục đã chọn. Lời nhắc được nhập thành một dòng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{files} 代表所选文件。{folder} 代表这些文件所在的文件夹，{name} 代表所选项目的名称。提示词以单行形式输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{files} 代表所選的檔案。{folder} 代表檔案所在的檔案夾，{name} 代表所選項目的名稱。提示詞會以單行輸入。"
          }
        }
      }
    },
