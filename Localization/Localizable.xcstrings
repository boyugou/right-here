          "stringUnit": {
            "state": "translated",
            "value": "Item terpilih %1$@ tidak dapat disebut dalam prompt preset agen “%2$@”."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’elemento selezionato %1$@ non può essere nominato nel prompt del preset “%2$@”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した項目%1$@の名前は、プリセット「%2$@」のプロンプトに含めることができません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 %1$@ 항목은 “%2$@” 프리셋의 프롬프트에서 이름으로 지정할 수 없습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "निवडलेल्या आयटम %1$@ चे नाव प्रीसेट “%2$@” च्या प्रॉम्प्टमध्ये देता येत नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Item terpilih %1$@ tidak boleh dinamakan dalam gesaan praset “%2$@”."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het geselecteerde onderdeel %1$@ kan niet worden genoemd in de prompt van agentvoorinstelling „%2$@”."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznaczonego elementu %1$@ nie można wymienić w treści gotowego promptu „%2$@”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O item selecionado %1$@ não pode ser citado no prompt da predefinição de agente “%2$@”."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Articolul selectat %1$@ nu poate fi numit în promptul presetării „%2$@”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранный объект %1$@ нельзя упомянуть в промпте пресета «%2$@»."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "“%2$@” முன்னமைவின் ப்ராம்ப்ட்டில், தேர்ந்தெடுத்த %1$@ என்ற உருப்படியைக் குறிப்பிட முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "“%2$@” ప్రీసెట్ ప్రాంప్ట్‌లో ఎంచుకున్న %1$@ అంశాన్ని పేర్కొనలేము."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระบุรายการที่เลือก %1$@ ในพรอมต์ของพรีเซ็ต “%2$@” ไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçili %1$@ öğesinin adı “%2$@” adlı ön ayarın istemine yazılamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибраний елемент %1$@ не можна назвати в промпті пресету «%2$@»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "منتخب آئٹم %1$@ کا نام پری سیٹ “%2$@” کے پرامپٹ میں نہیں لیا جا سکتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể ghi tên mục đã chọn %1$@ vào lời nhắc của mẫu “%2$@”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法在预设“%2$@”的提示词中写入所选项目 %1$@ 的名称。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法在預設組「%2$@」的提示詞中寫入所選項目 %1$@ 的名稱。"
          }
        }
      }
    },
    "refusal.presetPrompt": {
      "comment": "Why an action did nothing, shown in the alert after a click in Finder (and, in English, by the command line). %@ is a preset id. One of the refusal.prompt.* sentences follows and says why.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن كتابة موجّه الإعداد المسبق للوكيل «%@» في وحدة طرفية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এজেন্ট প্রিসেট “%@”-এর প্রম্পট টার্মিনালে টাইপ করা যায় না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Prompt der Agent-Voreinstellung „%@“ kann nicht in ein Terminal eingegeben werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η προτροπή της προεπιλογής πράκτορα «%@» δεν μπορεί να πληκτρολογηθεί σε τερματικό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The prompt of preset \"%@\" cannot be typed into a terminal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El prompt del preajuste de agente «%@» no se puede escribir en una terminal."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پرامپت پیش‌تنظیم عامل «%@» را نمی‌توان در ترمینال تایپ کرد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le prompt du préréglage d’agent « %@ » ne peut pas être saisi dans un terminal."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אי אפשר להקליד במסוף את ההנחיה של ההגדרה המוכנה לסוכן ״%@״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एजेंट प्रीसेट “%@” का प्रॉम्प्ट टर्मिनल में टाइप नहीं किया जा सकता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Prompt dari preset agen “%@” tidak dapat diketik ke terminal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il prompt del preset “%@” non può essere digitato in un terminale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プリセット「%@」のプロンプトはターミナルに入力できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” 프리셋의 프롬프트는 터미널에 입력할 수 없습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रीसेट “%@” चा प्रॉम्प्ट टर्मिनलमध्ये टाइप करता येत नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesaan praset “%@” tidak boleh ditaip ke dalam terminal."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De prompt van agentvoorinstelling „%@” kan niet in een terminal worden getypt."
          }
        },
        "pl": {
          "stringUnit": {
