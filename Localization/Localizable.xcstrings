    "doctor.agent.bypass": {
      "comment": "Detail line of a check in the setup window's Details list; it follows the check's title, so it is a fragment with no final period. %1$@ is the command of an AI agent. %2$@ is the title of a Finder menu item in English, for example Claude Code Here: keep it as it is, in quotes if that is natural. %3$@ is a command-line flag that switches the agent's own permission prompts off, for example --dangerously-skip-permissions: keep it exactly.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تم العثور على `%1$@`؛ يبدأ من «%2$@» ومطالبات الأذونات الخاصة به معطَّلة بالخيار `%3$@`"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "`%1$@` পাওয়া গেছে; “%2$@” দিয়ে শুরু হয় এবং অনুমতির প্রম্পট বন্ধ আছে (`%3$@`)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "`%1$@` gefunden; startet mit „%2$@“ und mit ausgeschalteten Berechtigungsabfragen (`%3$@`)"
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "βρέθηκε το `%1$@`· ξεκινά με «%2$@» και με τις προτροπές δικαιωμάτων απενεργοποιημένες (`%3$@`)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "`%1$@` found; starts with %2$@ and its permission prompts switched off (`%3$@`)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "`%1$@` encontrado; se inicia con «%2$@» y con las solicitudes de permiso desactivadas (`%3$@`)"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "‏`%1$@` پیدا شد؛ با «%2$@» شروع می‌شود و پرامپت‌های اجازه‌اش خاموش است (`%3$@`)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "`%1$@` trouvé ; démarre avec « %2$@ » et ses invites d’autorisation désactivées (`%3$@`)"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "‏`%1$@` נמצא; מופעל מהפריט “%2$@” והנחיות האישור שלו כבויות (`%3$@`)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "`%1$@` मिला; “%2$@” से शुरू होता है और इसके अनुमति प्रॉम्प्ट बंद हैं (`%3$@`)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "`%1$@` ditemukan; dimulai dengan “%2$@” dan prompt izinnya dinonaktifkan (`%3$@`)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "`%1$@` trovato; si avvia con «%2$@» e con le proprie richieste di permesso disattivate (`%3$@`)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "`%1$@` が見つかりました；「%2$@」で起動し、自身の許可の確認はオフ（`%3$@`）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "`%1$@` 찾음; 실행 항목: “%2$@”, 자체 권한 요청 꺼져 있음 (`%3$@`)"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "`%1$@` सापडले; सुरू करणारा मेनू: “%2$@”, त्याची परवानगी विचारणा बंद (`%3$@`)"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "`%1$@` ditemui; dimulakan dengan “%2$@” dan gesaan kebenarannya dimatikan (`%3$@`)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "`%1$@` gevonden; start met „%2$@” en met uitgeschakelde toestemmingsvragen (`%3$@`)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "znaleziono `%1$@`; start z pozycji „%2$@”, pytania o zgodę wyłączone (`%3$@`)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "`%1$@` encontrado; inicia com “%2$@” e com as solicitações de permissão desativadas (`%3$@`)"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "`%1$@` găsit; pornește cu „%2$@” și cu solicitările de permisiune dezactivate (`%3$@`)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "`%1$@` найден; запускается пунктом «%2$@», запросы разрешений отключены (`%3$@`)"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "`%1$@` கண்டறியப்பட்டது; “%2$@” மூலம் தொடங்கும், அனுமதிக் கேள்விகள் முடக்கப்பட்டிருக்கும் (`%3$@`)"
          }
        },
        "te": {
          "stringUnit": {
            "state": "needs_review",
            "value": "`%1$@` కనుగొనబడింది; “%2$@” ద్వారా ప్రారంభమవుతుంది, అనుమతి ప్రశ్నలు నిలిపివేయబడతాయి (`%3$@`)"
          }
        },
        "th": {
