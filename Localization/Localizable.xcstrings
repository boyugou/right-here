    "refusal.repository.gitError": {
      "comment": "Why an action did nothing, shown in the alert after a click in Finder (and, in English, by the command line). %1$@ is a file or folder name; %2$@ is what git said, in its own words.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على git قراءة مستودع %1$@: %2$@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "git %1$@-এর রিপোজিটরি পড়তে পারেনি: %2$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "git konnte das Repository von %1$@ nicht lesen: %2$@"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το git δεν μπόρεσε να διαβάσει το αποθετήριο του %1$@: %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "git could not read the repository of %1$@: %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "git no pudo leer el repositorio de %1$@: %2$@"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "‏git نتوانست مخزن %1$@ را بخواند: %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "git n’a pas pu lire le dépôt de %1$@ : %2$@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏git לא הצליח לקרוא את המאגר של %1$@: %2$@"
