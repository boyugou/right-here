        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "`%1$@` знайдено; запускається з пункту «%2$@» із вимкненими запитами на дозвіл (`%3$@`)"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "‏`%1$@` مل گیا؛ “%2$@” سے شروع ہوتا ہے، اور اس کے اجازت کے پرامپٹ بند ہیں: `%3$@`"
          }
        },
        "vi": {
          "stringUnit": {
