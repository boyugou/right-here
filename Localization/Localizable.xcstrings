            "value": "A configuração não foi concluída."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurarea nu s-a încheiat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройка не завершена."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அமைப்பு முடிவடையவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సెటప్ పూర్తి కాలేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตั้งค่าไม่เสร็จสมบูรณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurulum tamamlanmadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Налаштування не завершено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سیٹ اپ مکمل نہیں ہوا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quá trình thiết lập chưa hoàn tất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置未完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定未完成。"
          }
        }
      }
    },
    "setup.noConfigToRepair": {
      "comment": "The detail of a setup step, shown after the step's name (Config file, Quick Actions) in the setup window; it starts in lower case as the doctor's details do, unless the language has no case. %@ is the config file's name. Set Up is the button app.setupButton: write it as that button is called in this language.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد ملف %@؛ يُنشئه زر «إعداد» في التشغيل الأول من اختياراتك"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ফাইলটি নেই; প্রথমবার চালানোর সময় “সেটআপ করুন” আপনার বেছে নেওয়া বিকল্প থেকে ফাইলটি তৈরি করে"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "keine Datei %@ vorhanden; „Einrichten“ beim ersten Start erstellt sie aus deiner Auswahl"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "δεν υπάρχει αρχείο %@· η «Ρύθμιση» της πρώτης εκτέλεσης το δημιουργεί από τις επιλογές σας"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "there is no %@; the first run's Set Up makes it from your choices"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "no hay ningún archivo %@; «Configurar» en el primer inicio lo crea a partir de lo que elijas"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فایل %@ وجود ندارد؛ «راه‌اندازی» در اولین اجرا آن را از انتخاب‌های شما می‌سازد"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "aucun fichier %@ ; « Configurer », au premier lancement, le crée à partir de vos choix"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין קובץ %@; ״הגדרה״ בהפעלה הראשונה יוצרת אותו לפי הבחירות"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ फ़ाइल नहीं है; पहली बार चलाने पर “सेट अप करें” यह फ़ाइल आपके चुनावों से बनाता है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "file %@ tidak ada; “Siapkan” pada penggunaan pertama membuat file itu dari pilihan Anda"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "nessun file %@; “Configura” al primo avvio lo crea in base alle tue scelte"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ファイルはありません；初回起動時の「セットアップ」で、選んだ内容からファイルが作られます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 파일 없음; 처음 실행할 때 “설정하기”를 누르면 선택한 내용으로 파일이 만들어짐"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ फाइल नाही; पहिल्या रनमधील “सेटअप करा” तुमच्या निवडींवरून ही फाइल तयार करते"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "tiada fail %@; “Sediakan” pada larian pertama mencipta fail itu daripada pilihan anda"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "geen bestand %@; „Stel in” bij de eerste start maakt het bestand op basis van je keuzes"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "brak pliku %@; przycisk „Skonfiguruj” przy pierwszym uruchomieniu tworzy ten plik na podstawie Twoich wyborów"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "não há arquivo %@; “Configurar” na primeira execução cria o arquivo a partir das suas escolhas"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "nu există fișierul %@; „Configurați” la prima rulare îl creează din alegerile dvs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "файла %@ нет; кнопка «Настроить» при первом запуске создаст его по Вашему выбору"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ கோப்பு இல்லை; முதல் இயக்கத்தில் “அமை” உங்கள் தேர்வுகளிலிருந்து அந்தக் கோப்பை உருவாக்கும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ఫైల్ లేదు; మొదటి రన్‌లో “సెటప్ చేయండి” మీ ఎంపికల నుండి ఆ ఫైల్‌ను తయారు చేస్తుంది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีไฟล์ %@ ปุ่ม “ตั้งค่า” ในการเรียกใช้ครั้งแรกจะสร้างไฟล์จากตัวเลือกของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dosyası yok; ilk çalıştırmadaki “Kur” düğmesi dosyayı seçimlerinize göre oluşturur"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "файлу %@ немає; кнопка «Налаштувати» під час першого запуску створює його на основі вашого вибору"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فائل %@ موجود نہیں؛ پہلی بار چلانے پر “سیٹ اپ کریں” یہ فائل آپ کے انتخاب سے بناتا ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "không có tệp %@; nút “Thiết lập” trong lần chạy đầu tiên sẽ tạo tệp từ các lựa chọn của bạn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有 %@；首次运行时点按“设置”会根据你的选择生成该文件"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有 %@；首次執行時按一下「設定」會根據你的選擇產生該檔案"
          }
        }
      }
    },
    "setup.noConfigYet": {
      "comment": "Shown in the setup window. Set Up is the button app.setupButton: write it as that button is called in this language.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد ملف إعداد بعد. اختر ما تستخدمه واضغط «إعداد»: يُنشأ الملف من اختياراتك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনো কোনো কনফিগারেশন ফাইল নেই। আপনি যা ব্যবহার করেন তা বেছে নিন এবং “সেটআপ করুন” চাপ দিন: আপনার বেছে নেওয়া বিকল্প থেকে ফাইলটি তৈরি হবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt noch keine Konfigurationsdatei. Wähle aus, was du verwendest, und drücke „Einrichten“: Die Datei wird aus deiner Auswahl erstellt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχει ακόμα αρχείο ρυθμίσεων. Επιλέξτε όσα χρησιμοποιείτε και πατήστε «Ρύθμιση»: το αρχείο δημιουργείται από τις επιλογές σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no config file yet. Choose what you use and press Set Up: the file is made from your choices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay ningún archivo de configuración. Elige lo que usas y pulsa «Configurar»: el archivo se crea a partir de lo que elijas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنوز فایل پیکربندی وجود ندارد. ابزارهایی را که از آن‌ها استفاده می‌کنید انتخاب کنید و «راه‌اندازی» را بزنید: فایل از انتخاب‌های شما ساخته می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n’y a pas encore de fichier de configuration. Choisissez ce que vous utilisez et appuyez sur « Configurer » : le fichier est créé à partir de vos choix."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדיין אין קובץ תצורה. יש לבחור את הכלים שבהם נעשה שימוש וללחוץ על ״הגדרה״: הקובץ ייווצר לפי הבחירות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई कॉन्फ़िगरेशन फ़ाइल नहीं है। आप जो इस्तेमाल करते हैं, वह चुनें और “सेट अप करें” दबाएँ: फ़ाइल आपके चुनावों से बनती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada file konfigurasi. Pilih yang Anda gunakan dan tekan “Siapkan”: file dibuat dari pilihan Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c’è ancora alcun file di configurazione. Scegli ciò che usi e premi “Configura”: il file viene creato in base alle tue scelte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定ファイルはまだありません。使うものを選んで「セットアップ」を押してください。選んだ内容から設定ファイルが作られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 설정 파일이 없습니다. 사용하는 항목을 선택하고 “설정하기”를 누르십시오. 선택한 내용으로 파일이 만들어집니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अजून कॉन्फिगरेशन फाइल नाही. तुम्ही वापरता ते निवडा आणि “सेटअप करा” दाबा: तुमच्या निवडींवरून फाइल तयार होते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada fail konfigurasi. Pilih apa yang anda gunakan dan tekan “Sediakan”: fail dibuat berdasarkan pilihan anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is nog geen configuratiebestand. Kies wat je gebruikt en klik op „Stel in”: het bestand wordt op basis van je keuzes gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma jeszcze pliku konfiguracji. Wybierz, czego używasz, i kliknij przycisk „Skonfiguruj”: plik zostanie utworzony na podstawie Twoich wyborów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há arquivo de configuração. Escolha o que você usa e clique em “Configurar”: o arquivo é criado a partir das suas escolhas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu există încă un fișier de configurare. Alegeți ce folosiți și faceți clic pe „Configurați”: fișierul este creat din alegerile dvs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файла конфигурации еще нет. Выберите, чем Вы пользуетесь, и нажмите «Настроить»: файл будет создан по Вашему выбору."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இன்னும் உள்ளமைவுக் கோப்பு இல்லை. நீங்கள் பயன்படுத்துவதைத் தேர்ந்தெடுத்து, “அமை” பொத்தானை அழுத்தவும்: உங்கள் தேர்வுகளிலிருந்து கோப்பு உருவாக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇంకా కాన్ఫిగరేషన్ ఫైల్ లేదు. మీరు ఉపయోగించేవి ఎంచుకుని, “సెటప్ చేయండి” బటన్‌ను నొక్కండి: మీ ఎంపికల నుండి ఫైల్ తయారవుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีไฟล์การกำหนดค่า เลือกสิ่งที่คุณใช้แล้วกดปุ่ม “ตั้งค่า” ไฟล์จะถูกสร้างจากตัวเลือกของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz yapılandırma dosyası yok. Kullandıklarınızı seçin ve “Kur” düğmesine basın: dosya seçimlerinize göre oluşturulur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлу конфігурації ще немає. Оберіть те, чим користуєтеся, і натисніть «Налаштувати»: файл буде створено на основі вашого вибору."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھی کوئی کنفیگریشن فائل نہیں ہے۔ آپ جو استعمال کرتے ہیں، وہ منتخب کریں اور “سیٹ اپ کریں” دبائیں: فائل آپ کے انتخاب سے بنتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có tệp cấu hình nào. Hãy chọn những gì bạn dùng và nhấn “Thiết lập”: tệp sẽ được tạo từ các lựa chọn của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前还没有配置文件。请选择你使用的工具，然后点按“设置”：配置文件会根据你的选择生成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前還沒有設定檔。請選擇你使用的工具，然後按一下「設定」：設定檔會根據你的選擇產生。"
          }
        }
      }
    },
    "setup.servicesConfigUnusable": {
      "comment": "The detail of a setup step, shown after the step's name (Config file, Quick Actions) in the setup window; it starts in lower case as the doctor's details do, unless the language has no case. They are the Quick Actions. %1$@ is the path of a config file, %2$@ what is wrong with it, in the config check's English.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُنشأ من ملف الإعداد، والملف %1$@ غير قابل للاستخدام (%2$@)؛ وتُركت الإجراءات الموجودة كما هي"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এগুলো কনফিগ থেকে তৈরি হয়, আর %1$@ ব্যবহার করা যাচ্ছে না (%2$@); যেগুলো আছে সেগুলো যেমন ছিল তেমনই রাখা হয়েছে"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "sie werden aus der Konfiguration erstellt, und %1$@ kann nicht verwendet werden (%2$@); die vorhandenen wurden unverändert gelassen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "δημιουργούνται από το αρχείο ρυθμίσεων, και το %1$@ δεν μπορεί να χρησιμοποιηθεί (%2$@)· όσες υπάρχουν έμειναν ως είχαν"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "they are made from the config, and %1$@ cannot be used (%2$@); the ones that are there were left as they are"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "se crean a partir de la configuración, y %1$@ no se puede usar (%2$@); las que ya hay se dejaron como estaban"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "از پیکربندی ساخته می‌شوند، و %1$@ قابل استفاده نیست (%2$@)؛ آن‌هایی که هستند همان‌طور که بودند ماندند"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "elles sont créées à partir de la configuration, et %1$@ est inutilisable (%2$@) ; celles qui existent ont été laissées telles quelles"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הן נוצרות מהתצורה, ולא ניתן להשתמש ב-%1$@ (%2$@); אלה שקיימות נשארו כפי שהן"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये कॉन्फ़िग से बनती हैं, और %1$@ का इस्तेमाल नहीं किया जा सकता (%2$@); जो पहले से हैं, उन्हें जैसा था वैसा ही छोड़ दिया गया"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "tindakan ini dibuat dari konfigurasi, dan %1$@ tidak dapat digunakan (%2$@); yang sudah ada dibiarkan apa adanya"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "vengono create dalla configurazione, e il file %1$@ non può essere usato (%2$@); quelle presenti sono state lasciate come sono"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定から作られますが、%1$@ は使用できません（%2$@）；既存のものはそのままにしました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 만들어지는데 %1$@ 파일을 사용할 수 없음(%2$@); 이미 있는 항목은 그대로 둠"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "त्या कॉन्फिगरेशनमधून तयार होतात, आणि %1$@ वापरता येत नाही (%2$@); ज्या आधीपासून आहेत त्या जशा होत्या तशाच ठेवल्या"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "tindakan ini dibuat daripada konfigurasi, dan %1$@ tidak dapat digunakan (%2$@); yang sedia ada dibiarkan seperti asal"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "ze worden gemaakt op basis van de configuratie, en %1$@ is niet bruikbaar (%2$@); de bestaande zijn gelaten zoals ze zijn"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "są tworzone na podstawie konfiguracji, a pliku %1$@ nie można użyć (%2$@); istniejące pozostawiono bez zmian"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "elas são criadas a partir da configuração, e não é possível usar %1$@ (%2$@); as que já existem foram deixadas como estão"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "sunt create din configurație, iar fișierul %1$@ nu poate fi folosit (%2$@); cele existente au fost lăsate așa cum sunt"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "они создаются из конфигурации, а файл %1$@ нельзя использовать (%2$@); существующие оставлены как есть"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இவை உள்ளமைவிலிருந்து உருவாக்கப்படுகின்றன, ஆனால் %1$@ ஐப் பயன்படுத்த முடியாது (%2$@); ஏற்கெனவே உள்ளவை அப்படியே விடப்பட்டன"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇవి కాన్ఫిగరేషన్ నుండి తయారవుతాయి, కానీ %1$@ ను ఉపయోగించలేము (%2$@); ఇప్పటికే ఉన్నవాటిని అలాగే ఉంచారు"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การทำงานด่วนสร้างจากการกำหนดค่า และใช้ %1$@ ไม่ได้ (%2$@) รายการที่มีอยู่จึงยังคงเดิม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "bunlar yapılandırmadan oluşturulur ve %1$@ kullanılamıyor (%2$@); mevcut olanlar olduğu gibi bırakıldı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "вони створюються з конфігурації, а файл %1$@ не можна використати (%2$@); наявні залишено як є"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ کنفیگ سے بنتی ہیں، اور فائل %1$@ استعمال نہیں کی جا سکتی (%2$@)؛ جو پہلے سے موجود ہیں انہیں ویسے ہی رہنے دیا گیا"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "các tác vụ này được tạo từ cấu hình, và không thể dùng %1$@ (%2$@); những tác vụ hiện có được giữ nguyên"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它们根据配置生成，而 %1$@ 无法使用（%2$@）；现有的快速操作保持不变"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它們根據設定產生，而 %1$@ 無法使用（%2$@）；現有的快速動作維持不變"
          }
        }
      }
    },
    "setup.servicesSkipped": {
      "comment": "The detail of a setup step, shown after the step's name (Config file, Quick Actions) in the setup window; it starts in lower case as the doctor's details do, unless the language has no case. They are the Quick Actions.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُنشأ من ملف الإعداد، وهو غير قابل للاستخدام (انظر «ملف الإعداد» أعلاه)؛ وتُركت الإجراءات الموجودة كما هي"
