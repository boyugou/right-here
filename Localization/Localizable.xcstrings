    "doctor.fix.syncCommands": {
      "comment": "Fix line under a check in the setup window's Details list: what the person should do. Sentences. About the config sync feature: \"them\" are the launch settings listed above; the folder's copy is the config in the sync folder. Keep the commands in backticks exactly.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "راجعها بالأمر `rh config sync status`. إذا كانت لك، فشغّل `rh config sync pull --allow-commands` لاعتماد نسخة المجلد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "`rh config sync status` দিয়ে এগুলো দেখুন। এগুলো আপনারই হলে ফোল্ডারের কপিটি নিতে `rh config sync pull --allow-commands` চালান।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prüfe sie mit `rh config sync status`. Wenn sie von dir stammen, führe `rh config sync pull --allow-commands` aus, um die Kopie aus dem Ordner zu übernehmen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ελέγξτε τις ρυθμίσεις με το `rh config sync status`. Αν είναι δικές σας, το `rh config sync pull --allow-commands` παίρνει το αντίγραφο από τον φάκελο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read them with `rh config sync status`. If they are yours, `rh config sync pull --allow-commands` takes the copy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Revísalos con `rh config sync status`. Si son tuyos, ejecuta `rh config sync pull --allow-commands` para quedarte con la copia de la carpeta."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "آن‌ها را با `rh config sync status` بررسی کنید. اگر متعلق به شما هستند، برای گرفتن نسخهٔ پوشه `rh config sync pull --allow-commands` را اجرا کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Consultez-les avec `rh config sync status`. Si ce sont les vôtres, exécutez `rh config sync pull --allow-commands` pour prendre la copie du dossier."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "יש לבדוק אותן באמצעות `rh config sync status`. אם הן שלך, יש להריץ את `rh config sync pull --allow-commands` כדי לקחת את העותק שבתיקיה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इन्हें `rh config sync status` से जाँचें। अगर ये आपकी हैं, तो फ़ोल्डर वाली कॉन्फ़िग लेने के लिए `rh config sync pull --allow-commands` चलाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Periksa pengaturan tersebut dengan `rh config sync status`. Jika memang milik Anda, `rh config sync pull --allow-commands` mengambil salinan dari folder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Controllale con `rh config sync status`. Se sono tue, esegui `rh config sync pull --allow-commands` per usare la copia della cartella."
