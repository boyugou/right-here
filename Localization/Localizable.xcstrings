    "app.agentEdited": {
      "comment": "Note at the bottom of the Agents page after a change of one agent's options; an Undo button stands next to it. It matches app.menuEditedAdded ('Added “%@”'). %@ is the agent's name. Use the same kind of quotation marks as the translation of app.menuEditedAdded.",
