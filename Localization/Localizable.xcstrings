            "state": "translated",
            "value": "Rimuovi “%1$@” dalle Azioni rapide"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」をクイックアクションから削除"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빠른 동작에서 “%1$@” 제거"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quick Actions मधून “%1$@” काढा"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Keluarkan “%1$@” daripada Tindakan Cepat"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijder „%1$@” uit de snelle taken"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuń „%1$@” z Szybkich czynności"
          }
        },
        "pt-BR": {
          "stringUnit": {
