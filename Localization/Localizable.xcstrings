          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il prompt contiene un a capo o un altro carattere di controllo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロンプトに改行またはその他の制御文字が含まれています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프롬프트에 줄바꿈 또는 다른 제어 문자가 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रॉम्प्टमध्ये लाइन ब्रेक किंवा दुसरे कंट्रोल कॅरेक्टर आहे."
          }
        },
        "ms": {
          "stringUnit": {
