    "doctor.sync.diverged": {
      "comment": "Detail line of a check in the setup window's Details list; it follows the check's title, so it is a fragment with no final period. About the config sync feature: both the local config and the synced copy changed.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّر هذا الجهاز والمجلد كلاهما منذ آخر مزامنة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শেষ সিঙ্কের পর এই কম্পিউটার ও ফোল্ডার দুটোই বদলেছে"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "dieser Rechner und der Ordner haben sich seit der letzten Synchronisierung beide geändert"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "τόσο αυτός ο υπολογιστής όσο και ο φάκελος άλλαξαν από τον τελευταίο συγχρονισμό"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "this machine and the folder both changed since the last sync"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "este equipo y la carpeta han cambiado desde la última sincronización"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "از آخرین همگام‌سازی، هم این دستگاه و هم پوشه تغییر کرده‌اند"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cette machine et le dossier ont tous deux changé depuis la dernière synchronisation"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גם מחשב זה וגם התיקיה השתנו מאז הסנכרון האחרון"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछले सिंक के बाद से इस मशीन और फ़ोल्डर, दोनों में बदलाव हुए हैं"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "mesin ini dan folder sama-sama berubah sejak sinkronisasi terakhir"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "questo computer e la cartella sono entrambi cambiati dall’ultima sincronizzazione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回の同期以降、このマシンとフォルダの両方が変更されています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기와 폴더 모두 마지막 동기화 이후 변경됨"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मागील सिंकनंतर हे मशीन आणि फोल्डर दोन्ही बदलले"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "mesin ini dan folder kedua-duanya berubah sejak penyelarasan terakhir"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "deze machine en de map zijn allebei gewijzigd sinds de laatste synchronisatie"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "od ostatniej synchronizacji zmieniono konfigurację zarówno na tym komputerze, jak i w folderze"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "este computador e a pasta foram alterados desde a última sincronização"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "atât acest calculator, cât și dosarul s-au modificat de la ultima sincronizare"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "с последней синхронизации изменились и этот компьютер, и папка"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கடைசி ஒத்திசைவுக்குப் பின் இந்தக் கணினியும் கோப்புறையும் இரண்டுமே மாறியுள்ளன"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చివరి సింక్ నుండి ఈ కంప్యూటర్, ఫోల్డర్ రెండూ మారాయి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทั้งเครื่องนี้และโฟลเดอร์มีการเปลี่ยนแปลงตั้งแต่การเชื่อมข้อมูลครั้งล่าสุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "son eşzamanlamadan beri hem bu bilgisayar hem de klasör değişti"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "з останньої синхронізації змінилися і цей компʼютер, і папка"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پچھلی سنک کے بعد یہ کمپیوٹر اور فولڈر دونوں بدل گئے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "cả máy này và thư mục đều đã thay đổi từ lần đồng bộ trước"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自上次同步以来，本机和文件夹都有改动"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自上次同步以來，本機與檔案夾都有變更"
          }
        }
      }
    },
    "doctor.sync.folderUnreachable": {
