    "doctor.fix.syncConflict": {
      "comment": "Fix line under a check in the setup window's Details list: what the person should do. A sentence. About the config sync feature.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "كتب جهازان config.toml في الوقت نفسه. قارن النسخ، واحتفظ بالمحتوى الصحيح في config.toml، واحذف النسخ الأخرى يدويًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "দুটি কম্পিউটার একসঙ্গে config.toml লিখেছে। কপিগুলো তুলনা করুন, config.toml-এ সঠিক বিষয়বস্তু রাখুন, এবং বাকিগুলো হাতে মুছে ফেলুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zwei Rechner haben config.toml gleichzeitig geschrieben. Vergleiche die Kopien, behalte den richtigen Inhalt in config.toml und lösche die übrigen von Hand."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Δύο υπολογιστές έγραψαν το config.toml ταυτόχρονα. Συγκρίνετε τα αντίγραφα, διατηρήστε το σωστό περιεχόμενο στο config.toml και διαγράψτε χειροκίνητα τα υπόλοιπα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two machines wrote config.toml at once. Compare the copies, keep the right content in config.toml, and delete the others by hand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
