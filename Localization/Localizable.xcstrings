    "app.listChanged": {
      "comment": "Said when the person drags or removes a line in a list and the config file had been changed by something else (an AI assistant, the command line) after the window showed it, so the change was not made. 'The window' is this app's setup window.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "غيّر شيءٌ آخر هذه القائمة أثناء اطلاعك عليها. تعرض النافذة القائمة كما هي الآن، فحاول مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনি যখন দেখছিলেন, তখন অন্য কিছু এই তালিকাটি বদলে দিয়েছে। উইন্ডো এটি এখন যেভাবে আছে সেভাবে দেখাচ্ছে; আবার চেষ্টা করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Während du die Liste angesehen hast, hat etwas anderes sie geändert. Das Fenster zeigt sie jetzt so, wie sie ist; versuche es noch einmal."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Κάτι άλλο άλλαξε αυτή τη λίστα ενώ τη βλέπατε. Το παράθυρο την εμφανίζει όπως είναι τώρα. Δοκιμάστε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something else changed this list while you were looking at it. The window shows it as it is now; try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otra cosa cambió esta lista mientras la mirabas. La ventana la muestra tal como está ahora; inténtalo de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "در حالی که به این فهرست نگاه می‌کردید، چیز دیگری آن را تغییر داد. پنجرهٔ برنامه اکنون وضعیت فعلی آن را نشان می‌دهد؛ دوباره امتحان کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cette liste a été modifiée ailleurs pendant que vous la consultiez. La fenêtre l’affiche maintenant dans son état actuel ; réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "גורם אחר שינה את הרשימה בזמן שהיא הוצגה. החלון מציג אותה כעת במצבה הנוכחי; יש לנסות שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपके देखते-देखते इस सूची को किसी और चीज़ ने बदल दिया। विंडो इसे अभी की स्थिति में दिखा रही है, फिर से कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Daftar ini diubah dari tempat lain saat Anda sedang melihatnya. Jendela kini menampilkannya sebagaimana adanya; coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Qualcos’altro ha modificato questo elenco mentre lo guardavi. La finestra lo mostra ora così com’è: riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "見ている間に、別の操作によってこの一覧が変更されました。ウインドウには現在の内容を表示しています。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "보고 있는 동안 다른 곳에서 이 목록을 변경했습니다. 윈도우에 현재 상태가 표시되어 있으니 다시 시도하십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुम्ही पाहत असताना ही यादी बाहेरून बदलली गेली. विंडो ती आता आहे तशी दाखवते; पुन्हा प्रयत्न करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sesuatu yang lain telah menukar senarai ini semasa anda melihatnya. Tetingkap kini memaparkannya seperti keadaan semasa; cuba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Iets anders heeft deze lijst gewijzigd terwijl hij op het scherm stond. Het venster toont nu de actuele lijst; probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ta lista została zmieniona z innego miejsca, gdy była wyświetlana. Okno pokazuje ją teraz w aktualnym stanie; spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Outra coisa alterou esta lista enquanto ela estava na tela. A janela mostra agora a lista atual; tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Altceva a modificat această listă cât timp o vedeați. Fereastra o afișează acum așa cum este; încercați din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Что-то другое изменило этот список, пока Вы на него смотрели. Окно показывает его в текущем виде; попробуйте еще раз."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "நீங்கள் பார்த்துக்கொண்டிருந்தபோது வேறொன்று இந்தப் பட்டியலை மாற்றிவிட்டது. சாளரம் இப்போதைய நிலையைக் காட்டுகிறது; மீண்டும் முயற்சிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "needs_review",
            "value": "మీరు చూస్తుండగానే వేరొకటి ఈ జాబితాను మార్చింది. విండో ఇప్పుడు ఉన్న స్థితిలోనే చూపిస్తోంది; మళ్లీ ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "มีสิ่งอื่นเปลี่ยนรายการนี้ขณะที่คุณกำลังดูอยู่ หน้าต่างแสดงสถานะปัจจุบันของรายการแล้ว ลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Siz bakarken bu listeyi başka bir şey değiştirdi. Pencere listeyi şimdi olduğu gibi gösteriyor; lütfen tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Поки ви дивилися, цей список змінило щось інше. Вікно показує його таким, яким він є зараз; спробуйте ще раз."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "آپ کے دیکھتے دیکھتے کسی اور ذریعے نے اس فہرست کو بدل دیا۔ ونڈو اب اسے جیسی ہے ویسی دکھا رہی ہے؛ دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Một nguồn khác đã thay đổi danh sách này trong lúc bạn đang xem. Cửa sổ hiển thị danh sách ở trạng thái hiện tại; hãy thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在你查看时，有其他来源更改了此列表。窗口已按当前状态显示，请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你在查看時，其他來源變更了這份清單。視窗已依目前狀態顯示，請再試一次。"
          }
        }
      }
    },
