    "app.placementNoSplits": {
      "comment": "Warning on the Overview page. %@ is the name of the terminal (for example Warp). That terminal can open windows and tabs but not splits, and the config file asks for a split, so a new window opens instead. Keep the %@.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "‏التطبيق %@ لا يدعم التقسيم، لذلك يفتح التقسيم المحدد في ملف الإعداد لديك نافذة جديدة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@-এ ভাগ করার সুবিধা নেই, তাই কনফিগারেশন ফাইলে থাকা ভাগের বদলে নতুন উইন্ডো খোলে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ kann Fenster nicht teilen, daher öffnet sich statt der Teilung aus deiner Konfigurationsdatei ein neues Fenster."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Το %@ δεν υποστηρίζει διαίρεση, γι’ αυτό η διαίρεση στο αρχείο ρυθμίσεων ανοίγει νέο παράθυρο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has no splits, so the split in your config opens a new window."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ no admite divisiones, así que la división de tu archivo de configuración abre una ventana nueva."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "‏%@ از تقسیم پنجره پشتیبانی نمی‌کند، پس تقسیمی که در پیکربندی شما تعیین شده، یک پنجرهٔ تازه باز می‌کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ ne sait pas diviser une fenêtre, si bien que la division définie dans votre configuration ouvre une nouvelle fenêtre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ל-%@ אין פיצולים, ולכן הפיצול שנקבע בקובץ התצורה פותח חלון חדש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ में स्प्लिट नहीं होते, इसलिए आपकी कॉन्फ़िगरेशन फ़ाइल के स्प्लिट की जगह एक नई विंडो खुलती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ tidak mendukung panel terpisah, sehingga panel terpisah dalam file konfigurasi Anda dibuka sebagai jendela baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ non supporta la divisione, quindi la divisione indicata nel file di configurazione apre una nuova finestra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ は分割に対応していないため、設定ファイルの分割の指定では新規ウインドウで開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 앱은 분할을 지원하지 않으므로 설정 파일의 분할 설정 대신 새로운 윈도우가 열립니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ मध्ये विभाजन नाही, त्यामुळे तुमच्या कॉन्फिगरेशन फाइलमधील विभाजनाऐवजी नवीन विंडो उघडते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ tidak menyokong pisahan, jadi pisahan dalam fail konfigurasi anda membuka tetingkap baharu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ kent geen gesplitste panelen, dus in plaats van het gesplitste paneel uit het configuratiebestand opent er een nieuw venster."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ nie obsługuje podziału okna, więc zamiast podziału ustawionego w pliku konfiguracji otwiera się nowe okno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ não oferece divisão de painéis, então a divisão no arquivo de configuração abre uma nova janela."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ nu poate împărți panouri, așa că împărțirea din fișierul de configurare deschide o fereastră nouă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ не поддерживает разделение окна, поэтому вместо разделения из файла конфигурации открывается новое окно."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ இல் பிரித்தல் இல்லை; அதனால் உங்கள் உள்ளமைவில் உள்ள பிரித்தல் புதிய சாளரத்தைத் திறக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ లో విభజనలు లేవు, కాబట్టి మీ కాన్ఫిగరేషన్ ఫైల్‌లోని విభజన కొత్త విండోను తెరుస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ ไม่มีหน้าต่างแยก หน้าต่างแยกที่ตั้งไว้ในไฟล์การกำหนดค่าของคุณจึงเปิดเป็นหน้าต่างใหม่แทน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ bölmeyi desteklemez, bu yüzden yapılandırma dosyanızdaki bölme yeni bir pencere açar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ не підтримує розділення, тож замість розділення з вашого файлу конфігурації відкривається нове вікно."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "‏%@ میں تقسیم کی سہولت نہیں ہے، اس لیے کنفیگریشن فائل میں درج تقسیم کے بجائے نئی ونڈو کھلتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ không hỗ trợ chia khung, nên khung chia trong tệp cấu hình của bạn sẽ mở thành cửa sổ mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 不支持分屏，因此配置文件中的分屏设置会打开新窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 不支援分割，因此設定檔中的分割設定會開啟新視窗。"
          }
        }
      }
    },
