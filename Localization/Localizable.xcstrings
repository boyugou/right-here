    "app.agentNewCaption": {
      "comment": "Caption of that form.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل أي برنامج يمكن كتابته في الوحدة الطرفية، مثل lazygit أو برنامج نصي خاص بك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "টার্মিনালে টাইপ করা যায় এমন যেকোনো প্রোগ্রাম কাজ করে, যেমন lazygit বা নিজের লেখা কোনো স্ক্রিপ্ট।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Programm, das sich im Terminal eingeben lässt, funktioniert, zum Beispiel lazygit oder ein eigenes Skript."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Λειτουργεί οποιοδήποτε πρόγραμμα εκτελείται από το τερματικό, για παράδειγμα το lazygit ή ένα δικό σας σκριπτ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Any program that can be typed into a terminal works, for example lazygit or a script of your own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona cualquier programa que se pueda escribir en la terminal, por ejemplo lazygit o un script propio."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر برنامه‌ای که بتوان آن را در ترمینال تایپ کرد کار می‌کند، برای مثال lazygit یا اسکریپتی از خودتان."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout programme qui se lance depuis un terminal convient, par exemple lazygit ou l’un de vos scripts."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל תוכנה שאפשר להקליד במסוף מתאימה, למשל lazygit או תסריט משלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टर्मिनल में टाइप किया जा सकने वाला कोई भी प्रोग्राम काम करता है, जैसे lazygit या आपकी अपनी कोई स्क्रिप्ट।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Program apa pun yang bisa diketik di terminal akan berfungsi, misalnya lazygit atau skrip milik Anda sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualsiasi programma che si può digitare nel terminale funziona, per esempio lazygit o uno script personale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルで入力して実行できるプログラムなら使えます。例えば lazygit や、自作のスクリプトなどです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널에 입력해서 실행할 수 있는 프로그램이면 모두 쓸 수 있습니다. 예: lazygit, 직접 만든 스크립트 등."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "टर्मिनलमध्ये टाइप करता येणारा कोणताही प्रोग्राम चालेल, उदाहरणार्थ lazygit किंवा तुमची स्वतःची स्क्रिप्ट."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mana-mana program yang boleh ditaip ke dalam terminal berfungsi, contohnya lazygit atau skrip anda sendiri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk programma dat in een terminal getypt kan worden, werkt, bijvoorbeeld lazygit of een eigen script."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada się każdy program, który można wywołać w terminalu, na przykład lazygit albo własny skrypt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer programa que possa ser digitado no terminal funciona, por exemplo o lazygit ou um script seu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Orice program care poate fi scris în terminal funcționează, de exemplu lazygit sau un script propriu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подойдет любая программа, которую можно ввести в терминал, например lazygit или собственный скрипт."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "டெர்மினலில் தட்டச்சு செய்யக்கூடிய எந்த நிரலும் வேலை செய்யும்; எடுத்துக்காட்டாக lazygit அல்லது உங்கள் சொந்த ஸ்கிரிப்ட்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "టెర్మినల్‌లో టైప్ చేయగల ఏ ప్రోగ్రామ్ అయినా పనిచేస్తుంది, ఉదాహరణకు lazygit లేదా మీ స్వంత స్క్రిప్ట్."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรแกรมใดก็ตามที่พิมพ์ลงในเทอร์มินัลได้ก็ใช้ได้ เช่น lazygit หรือสคริปต์ของคุณเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminale yazılabilen her program çalışır; örneğin lazygit ya da kendi betiğiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підійде будь-яка програма, яку можна ввести в термінал, наприклад lazygit або власний скрипт."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹرمینل میں ٹائپ کیا جا سکنے والا کوئی بھی پروگرام کام کرتا ہے، مثلاً lazygit یا آپ کا اپنا کوئی اسکرپٹ۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bất kỳ chương trình nào gõ được vào terminal đều dùng được, ví dụ lazygit hoặc một tập lệnh của riêng bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任何可以输入到终端中的程序都可以使用，例如 lazygit 或你自己的脚本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任何可以輸入到終端機中的程式都可以使用，例如 lazygit 或你自己的指令碼。"
          }
        }
      }
    },
    "app.agentNotChecked": {
      "comment": "Agents page, next to an agent's command: Right Here asked the login shell whether the command exists, and the shell did not finish (a startup file that exits or waits). Short.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُفحص: لم يستجب مكوّن Shell الخاص بالدخول لديك"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরীক্ষা করা হয়নি: আপনার লগইন শেল সাড়া দেয়নি"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht geprüft: Deine Login-Shell hat nicht geantwortet"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ελέγχθηκε: το κέλυφος εισόδου σας δεν απάντησε"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not checked: your login shell did not answer"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin comprobar: tu shell de inicio de sesión no respondió"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بررسی نشد: پوستهٔ ورود شما پاسخ نداد"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non vérifié : votre shell de connexion n’a pas répondu"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא נבדק: מעטפת ההתחברות לא ענתה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जाँच नहीं हुई: आपके लॉगइन शेल ने जवाब नहीं दिया"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak diperiksa: shell masuk Anda tidak menjawab"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non controllato: la tua shell di login non ha risposto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未確認：ログインシェルから応答がありませんでした"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인 안 됨: 로그인 셸이 응답하지 않음"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तपासले नाही: तुमच्या लॉगिन शेलने उत्तर दिले नाही"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak disemak: cangkerang log masuk anda tidak menjawab"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet gecontroleerd: je inlogshell gaf geen antwoord"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie sprawdzono: powłoka logowania nie odpowiedziała"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não verificado: seu shell de login não respondeu"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Neverificat: shellul de login nu a răspuns"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не проверено: оболочка входа не ответила"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சரிபார்க்கப்படவில்லை: உங்கள் login shell பதிலளிக்கவில்லை"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "తనిఖీ చేయబడలేదు: మీ login shell స్పందించలేదు"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ได้ตรวจสอบ: เชลล์เข้าสู่ระบบของคุณไม่ตอบกลับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Denetlenmedi: oturum açma kabuğunuz yanıt vermedi"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не перевірено: ваша оболонка входу не відповіла"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "چیک نہیں کیا گیا: آپ کی لاگ ان شیل نے جواب نہیں دیا"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa kiểm tra: shell đăng nhập của bạn không phản hồi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未检查：你的登录 shell 没有响应"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未檢查：你的登入 shell 沒有回應"
          }
        }
      }
    },
