    "app.quitUnsavedMessage": {
      "comment": "Message of the confirmation app.quitUnsavedTitle.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يحتوي نص ملف الإعداد على تغييرات غير محفوظة. إذا أنهيت الآن، فستضيع هذه التغييرات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "কনফিগারেশন ফাইলের লেখায় এমন পরিবর্তন আছে যা সংরক্ষণ করা হয়নি। এখন বন্ধ করলে সেগুলো হারিয়ে যাবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Text der Konfigurationsdatei enthält Änderungen, die nicht gespeichert sind. Wenn du die App jetzt beendest, gehen sie verloren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Το κείμενο του αρχείου ρυθμίσεων περιέχει αλλαγές που δεν έχουν αποθηκευτεί. Αν τερματίσετε τώρα, θα χαθούν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The text of the config file has changes that are not saved. If you quit now, they are lost."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El texto del archivo de configuración tiene cambios sin guardar. Si sales ahora, se perderán."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "متن فایل پیکربندی تغییراتی دارد که ذخیره نشده‌اند. اگر همین حالا خارج شوید، آن‌ها از بین می‌روند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le texte du fichier de configuration contient des modifications non enregistrées. Si vous quittez maintenant, elles seront perdues."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "בטקסט של קובץ התצורה יש שינויים שלא נשמרו. אם פעולת היישום תסתיים עכשיו, השינויים יאבדו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कॉन्फ़िगरेशन फ़ाइल के टेक्स्ट में ऐसे बदलाव हैं जो सहेजे नहीं गए हैं। अगर आप अभी बंद करेंगे, तो वे खो जाएँगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Teks file konfigurasi memiliki perubahan yang belum disimpan. Jika Anda menutup app sekarang, perubahan itu akan hilang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il testo del file di configurazione contiene modifiche non salvate. Se esci ora, andranno perse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "設定ファイルの本文に、保存されていない変更があります。このまま終了すると、その変更は失われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "설정 파일의 텍스트에 저장하지 않은 변경 사항이 있습니다. 지금 종료하면 그 변경 사항은 사라집니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कॉन्फिगरेशन फाइलच्या मजकुरात जतन न केलेले बदल आहेत. तुम्ही आता बाहेर पडलात तर ते बदल हरवतील."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Teks dalam fail konfigurasi mempunyai perubahan yang belum disimpan. Jika anda keluar sekarang, perubahan itu akan hilang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De tekst van het configuratiebestand heeft wijzigingen die niet bewaard zijn. Als je nu stopt, gaan ze verloren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tekst pliku konfiguracji zawiera zmiany, które nie zostały zapisane. Jeśli teraz zakończysz, zostaną one utracone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O texto do arquivo de configuração tem alterações que não foram salvas. Se você encerrar agora, elas serão perdidas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Textul fișierului de configurare are modificări care nu au fost salvate. Dacă închideți aplicația acum, acestea se vor pierde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "В тексте файла конфигурации есть несохраненные изменения. Если Вы сейчас завершите работу, они будут потеряны."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "உள்ளமைவுக் கோப்பின் உரையில் சேமிக்கப்படாத மாற்றங்கள் உள்ளன. இப்போது வெளியேறினால் அவை இழக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "needs_review",
            "value": "కాన్ఫిగరేషన్ ఫైల్ టెక్స్ట్‌లో సేవ్ చేయని మార్పులు ఉన్నాయి. ఇప్పుడు మీరు నిష్క్రమిస్తే అవి పోతాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ข้อความในไฟล์การกำหนดค่ามีการเปลี่ยนแปลงที่ยังไม่ได้บันทึก หากออกตอนนี้ การเปลี่ยนแปลงเหล่านั้นจะหายไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yapılandırma dosyasının metninde kaydedilmemiş değişiklikler var. Şimdi çıkarsanız bu değişiklikler kaybolur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "У тексті файлу конфігурації є незбережені зміни. Якщо завершити програму зараз, їх буде втрачено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "کنفیگریشن فائل کے متن میں ایسی تبدیلیاں ہیں جو محفوظ نہیں کی گئیں۔ اگر آپ ابھی بند کریں گے تو وہ ضائع ہو جائیں گی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nội dung tệp cấu hình có những thay đổi chưa được lưu. Nếu bạn thoát ngay bây giờ, chúng sẽ bị mất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "配置文件的文本中有未保存的更改。如果现在退出，这些更改就会丢失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "設定檔的文字中有未儲存的變更。如果現在結束，這些變更就會遺失。"
          }
        }
      }
    },
    "app.quitUnsavedTitle": {
