    "app.bypassOwnSetting": {
      "comment": "Line under the switch 'Start agents without asking' (app.bypassTitle) while the switch is off: it names an agent whose own setting still makes it start without its permission prompts. %@ is the agent's name (Claude Code, Codex). It is the counterpart of app.bypassKeepsAsking ('%@ keeps asking: its own setting says so.'): use the same wording and structure as the translation of that sentence.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "‏%@ يُشغَّل دون استئذان، فإعداده الخاص يقتضي ذلك."
