    "doctor.fix.extensionEnable": {
      "comment": "Fix line under a check in the setup window's Details list: what the person should do. A sentence. The Settings path is what macOS shows in the person's language: use exactly the path given in the glossary.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "شغّل `rh install --finder`، أو فعّل Right Here في إعدادات النظام › عام › عناصر الدخول والملحقات › Finder."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "`rh install --finder` চালান, অথবা System Settings › General › Login Items & Extensions › Finder-এর অধীনে Right Here চালু করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Führe `rh install --finder` aus, oder aktiviere Right Here unter Systemeinstellungen › Allgemein › Anmeldeobjekte & Erweiterungen › Finder."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Εκτελέστε `rh install --finder` ή ενεργοποιήστε το Right Here στις Ρυθμίσεις συστήματος › Γενικά › Στοιχεία εισόδου και επεκτάσεις › Finder."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run `rh install --finder`, or switch on Right Here in System Settings › General › Login Items & Extensions › Finder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ejecuta `rh install --finder` o activa Right Here en Ajustes del Sistema › General › Ítems de inicio y extensiones › Finder."
          }
        },
        "fa": {
          "stringUnit": {
