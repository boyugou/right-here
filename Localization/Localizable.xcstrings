    "app.menuEditHint": {
      "comment": "Finder menu page, under the caption of the menu preview: how to change the menu. 'Edit Menu' is the button next to it (key app.menuEdit): use its existing translation exactly.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لنقل الأسطر أو إضافتها أو إزالتها، اضغط «تعديل القائمة»."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লাইন সরাতে, যোগ করতে বা মুছতে “মেনু সম্পাদনা করুন” চাপ দিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um Zeilen zu verschieben, hinzuzufügen oder zu entfernen, drücke „Menü bearbeiten“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για να μετακινήσετε, να προσθέσετε ή να αφαιρέσετε γραμμές, πατήστε «Επεξεργασία μενού»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To move, add or remove lines, press Edit Menu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para mover, añadir o quitar líneas, pulsa «Editar menú»."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای جابه‌جا کردن، افزودن یا حذف سطرها، «ویرایش منو» را بزنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour déplacer, ajouter ou supprimer des lignes, appuyez sur Modifier le menu."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי להזיז, להוסיף או להסיר שורות, יש ללחוץ על ״עריכת התפריט״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पंक्तियाँ खिसकाने, जोड़ने या हटाने के लिए मेन्यू संपादित करें बटन दबाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk memindahkan, menambah, atau menghapus baris, tekan Edit Menu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per spostare, aggiungere o rimuovere righe, premi Modifica menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "行を移動、追加、削除するには、「メニューを編集」を押してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목을 옮기거나 추가하거나 제거하려면 메뉴 편집을 누르십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ओळी हलवण्यासाठी, जोडण्यासाठी किंवा काढण्यासाठी “मेनू संपादित करा” दाबा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk mengalihkan, menambah atau mengeluarkan baris, tekan Edit Menu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik op „Wijzig menu” om regels te verplaatsen, toe te voegen of te verwijderen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby przenieść, dodać lub usunąć wiersze, kliknij w Edytuj menu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para mover, adicionar ou remover linhas, clique em Editar Menu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a muta, adăuga sau elimina linii, faceți clic pe Editați meniul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы переместить, добавить или удалить строки, нажмите «Изменить меню»."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வரிகளை நகர்த்த, சேர்க்க அல்லது நீக்க மெனுவைத் திருத்து பொத்தானை அழுத்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వరుసలను తరలించడానికి, జోడించడానికి లేదా తొలగించడానికి మెనూను ఎడిట్ చేయండి బటన్‌ను నొక్కండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากต้องการย้าย เพิ่ม หรือเอาบรรทัดออก ให้กดปุ่มแก้ไขเมนู"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satırları taşımak, eklemek veya kaldırmak için Menüyü Düzenle düğmesine basın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб перемістити, додати або вилучити рядки, натисніть «Редагувати меню»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آئٹمز کو منتقل کرنے، شامل کرنے یا ہٹانے کے لیے “مینو میں ترمیم کریں” دبائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để di chuyển, thêm hoặc xóa các mục, hãy nhấn Sửa menu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要移动、添加或移除菜单项目，请点按“编辑菜单”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要移動、加入或移除選單項目，請按一下「編輯選單」。"
          }
        }
      }
    },
