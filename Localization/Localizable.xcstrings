    "refusal.repository.noCommit": {
      "comment": "Why an action did nothing, shown in the alert after a click in Finder (and, in English, by the command line).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يحتوي المستودع على أي إيداع (commit) بعد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রিপোজিটরিটিতে এখনও কোনো কমিট নেই।"
          }
        },
        "de": {
          "stringUnit": {
