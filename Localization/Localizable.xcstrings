    "app.presetBuiltInNote": {
      "comment": "Note on the page of a prompt preset that comes with the app and cannot be changed as it is. 'Customize' is the button app.presetCustomize.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "هذا الإعداد المسبق مضمّن في التطبيق. خصِّصه لتغيير عنوانه أو نصّه؛ ويعود الإعداد المسبق المضمّن عند إزالة نسختك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এই প্রিসেটটি বিল্ট-ইন। শিরোনাম বা শব্দ বদলাতে এটি কাস্টমাইজ করুন; আপনার কপি সরালে বিল্ট-ইন প্রিসেটটি আবার ফিরে আসে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diese Voreinstellung ist eingebaut. Passe sie an, um ihren Titel oder Wortlaut zu ändern; die eingebaute kehrt zurück, wenn du deine Kopie entfernst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Αυτή η προεπιλογή είναι ενσωματωμένη. Προσαρμόστε την για να αλλάξετε τον τίτλο ή το κείμενό της· η ενσωματωμένη επανέρχεται όταν αφαιρέσετε το αντίγραφό σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This preset is built in. Customize it to change its title or its words; the built-in one comes back when you remove your copy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este preajuste viene integrado en la app. Personalízalo para cambiar su título o su texto; al quitar tu copia, vuelve a usarse el preajuste integrado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "این پیش‌تنظیم داخلی است. برای تغییر عنوان یا متن آن، آن را سفارشی کنید؛ وقتی نسخهٔ خودتان را حذف کنید، پیش‌تنظیم داخلی دوباره برمی‌گردد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce préréglage est intégré. Personnalisez-le pour changer son titre ou son texte ; le préréglage intégré revient lorsque vous retirez votre copie."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "הגדרה מוכנה זו מובנית ביישום. כדי לשנות את הכותרת או את הנוסח שלה, יש ללחוץ על ״התאמה אישית״; ההגדרה המובנית חוזרת כשמסירים את העותק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यह प्रीसेट बिल्टइन है। इसका शीर्षक या शब्द बदलने के लिए इसे कस्टमाइज़ करें; आपकी प्रति हटाने पर बिल्टइन प्रीसेट फिर से लौट आता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Preset ini merupakan preset bawaan. Sesuaikan untuk mengubah judul atau teksnya; preset bawaan kembali saat salinan Anda dihapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questo preset è integrato nell’app. Personalizzalo per cambiarne il titolo o il testo; quando rimuovi la tua copia, torna quello integrato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このプリセットはアプリに組み込まれています。カスタマイズするとタイトルや文言を変更できます。コピーを削除すると、組み込みのプリセットに戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 프리셋은 앱에 기본 제공됩니다. 제목이나 내용을 바꾸려면 사용자화하십시오. 복사본을 제거하면 기본 제공 프리셋이 다시 사용됩니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "हा प्रीसेट अंगभूत आहे. त्याचे शीर्षक किंवा शब्द बदलण्यासाठी तो सानुकूल करा; तुमची प्रत काढून टाकल्यावर अंगभूत प्रीसेट परत येतो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Praset ini terbina dalam. Sesuaikan untuk mengubah tajuk atau teksnya; praset terbina dalam akan kembali apabila salinan anda dikeluarkan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deze voorinstelling is ingebouwd. Pas deze aan om de titel of de tekst te wijzigen; de ingebouwde komt terug zodra je je kopie verwijdert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ten gotowy prompt jest wbudowany. Dostosuj go, aby zmienić tytuł lub treść; po usunięciu Twojej kopii wróci wbudowana wersja."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta predefinição é integrada ao app. Personalize-a para mudar o título ou o texto; a original volta quando você remover sua cópia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Această presetare este integrată în aplicație. Personalizați-o pentru a-i schimba titlul sau textul; cea integrată revine când eliminați copia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Этот пресет встроен в приложение. Настройте его, чтобы изменить название или текст; встроенный пресет вернется, когда Вы удалите свою копию."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இந்த முன்னமைவு செயலியுடன் வருகிறது. அதன் தலைப்பையோ உரையையோ மாற்ற அதைத் தனிப்பயனாக்குங்கள்; உங்கள் நகலை நீக்கும்போது செயலியுடன் வந்த முன்னமைவு மீண்டும் வரும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ఈ ప్రీసెట్ యాప్‌లో అంతర్నిర్మితమైనది. దీని శీర్షిక లేదా పాఠ్యం మార్చడానికి దీన్ని అనుకూలీకరించండి; మీ కాపీని తీసివేసినప్పుడు అంతర్నిర్మిత ప్రీసెట్ మళ్లీ వస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "พรีเซ็ตนี้มาพร้อมแอป กดปุ่มกำหนดเองเพื่อเปลี่ยนชื่อหรือข้อความ พรีเซ็ตที่มาพร้อมแอปจะกลับมาเมื่อคุณเอาสำเนาของคุณออก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu ön ayar uygulamayla birlikte gelir. Başlığını veya metnini değiştirmek için özelleştirin; kendi kopyanızı kaldırdığınızda yerleşik olan geri gelir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Цей пресет вбудований у програму. Налаштуйте його, щоб змінити назву або текст; вбудований пресет повернеться, коли ви вилучите свою копію."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "یہ پری سیٹ ایپ کے ساتھ آتا ہے۔ اس کا عنوان یا متن بدلنے کے لیے اسے حسبِ ضرورت بنائیں؛ آپ کی کاپی ہٹانے پر بلٹ ان پری سیٹ واپس آ جاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mẫu này được tích hợp sẵn. Hãy tùy chỉnh để đổi tiêu đề hoặc nội dung; mẫu tích hợp sẵn sẽ trở lại khi bạn xóa bản sao của mình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此预设已内置于 App 中。自定义后可更改其标题或内容；移除副本后，内置版本会恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此預設組為內建項目。自訂後即可變更其標題或內容；移除你的副本後，內建的預設組便會恢復。"
          }
        }
      }
    },
