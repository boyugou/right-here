    "app.stepThreeBody": {
      "comment": "Step 3 text; a button runs a test.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يفتح نافذة طرفية في مجلد تجريبي ثم يغلقها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "একটি পরীক্ষার ফোল্ডারে টার্মিনাল উইন্ডো খোলে এবং আবার বন্ধ করে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Öffnet ein Terminalfenster in einem Testordner und schließt es wieder."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ανοίγει ένα παράθυρο Terminal σε έναν φάκελο δοκιμής και το κλείνει ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens a terminal window in a test folder and closes it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abre una ventana de Terminal en una carpeta de prueba y la vuelve a cerrar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "یک پنجره ترمینال را در یک پوشه آزمایشی باز و دوباره بسته می‌کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ouvre une fenêtre du Terminal dans un dossier de test, puis la referme."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "פותח חלון טרמינל בתיקיית בדיקה וסוגר אותו שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "एक परीक्षण फ़ोल्डर में टर्मिनल विंडो खोलता है और फिर बंद कर देता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Membuka jendela terminal di folder uji lalu menutupnya kembali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apre una finestra del Terminale in una cartella di prova e la chiude di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "テスト用フォルダでターミナルウィンドウを開き、すぐに閉じます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "테스트 폴더에서 터미널 창을 열었다가 다시 닫습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "एका चाचणी फोल्डरमध्ये टर्मिनल विंडो उघडते आणि पुन्हा बंद करते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Membuka tetingkap terminal dalam folder ujian dan menutupnya semula."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Opent een terminalvenster in een testmap en sluit het weer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otwiera okno terminala w folderze testowym i zamyka je ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abre uma janela de terminal em uma pasta de teste e a fecha novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deschide o fereastră de terminal într-un dosar de test și o închide din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Открывает окно терминала в тестовой папке и закрывает его."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ஒரு சோதனைக் கோப்புறையில் டெர்மினல் சாளரத்தைத் திறந்து மீண்டும் மூடும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ఒక టెస్ట్ ఫోల్డర్‌లో టెర్మినల్ విండోను తెరిచి, మళ్లీ మూసివేస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เปิดหน้าต่างเทอร์มินัลในโฟลเดอร์ทดสอบ แล้วปิดอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bir test klasöründe terminal penceresi açar ve sonra yeniden kapatır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Відкриває вікно терміналу в тестовій папці та закриває його."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ایک ٹیسٹ فولڈر میں ٹرمینل ونڈو کھولتا ہے اور پھر بند کر دیتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
