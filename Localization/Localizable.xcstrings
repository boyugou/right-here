            "value": "יש ללחוץ על ״הגדרה״ בעמוד ״סקירה כללית״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ओवरव्यू पेज पर सेट अप करें बटन दबाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan Siapkan di halaman Ringkasan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi Configura nella pagina Panoramica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「概要」ページで「セットアップ」を押してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개요 페이지에서 설정하기를 누르십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "“आढावा” पृष्ठावर “सेटअप करा” दाबा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan Sediakan pada halaman Gambaran Keseluruhan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik op de pagina Overzicht op „Stel in”."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij w Skonfiguruj na stronie Przegląd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique em Configurar na página Visão geral."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pe pagina Privire de ansamblu, faceți clic pe Configurați."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На странице «Обзор» нажмите «Настроить»."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மேலோட்டம் பக்கத்தில் அமை பொத்தானை அழுத்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అవలోకనం పేజీలో సెటప్ చేయండి బటన్‌ను నొక్కండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กดปุ่มตั้งค่าในหน้าภาพรวม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Genel Bakış sayfasındaki Kur düğmesine basın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть «Налаштувати» на сторінці «Огляд»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جائزہ صفحے پر “سیٹ اپ کریں” دبائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn Thiết lập trên trang Tổng quan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“概览”中点按“设置”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「概覽」中按一下「設定」。"
          }
        }
      }
    },
    "app.fixTerminalWindow": {
      "comment": "Checks page of the setup window: what to do when no terminal is installed. 'Overview' is the page (key app.tabOverview): use its translation. The window's form of doctor.fix.terminal, which names a config key instead.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثبّت وحدة طرفية، أو اختر واحدة في صفحة «نظرة عامة»."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি টার্মিনাল ইনস্টল করুন, অথবা “সারসংক্ষেপ” পৃষ্ঠায় একটি বেছে নিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiere ein Terminal oder wähle eines auf der Seite „Übersicht“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εγκαταστήστε ένα τερματικό ή επιλέξτε ένα στη σελίδα «Επισκόπηση»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install a terminal, or choose one on the Overview."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala una terminal o elige una en la página Resumen."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک ترمینال نصب کنید یا در صفحهٔ «نمای کلی» یکی را انتخاب کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez un terminal ou choisissez-en un dans la page Vue d’ensemble."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להתקין מסוף או לבחור מסוף בעמוד ״סקירה כללית״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई टर्मिनल इंस्टॉल करें या “ओवरव्यू” पेज पर कोई एक चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Instal terminal atau pilih salah satu di halaman Ringkasan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installa un terminale o scegline uno nella pagina Panoramica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルをインストールするか、「概要」ページで選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널을 설치하거나 개요 페이지에서 선택하십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "टर्मिनल इन्स्टॉल करा किंवा “आढावा” पृष्ठावर एक निवडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasang terminal atau pilih satu pada halaman Gambaran Keseluruhan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Installeer een terminal of kies er een op de pagina Overzicht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zainstaluj terminal albo wybierz terminal na stronie Przegląd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale um terminal ou escolha um na página Visão geral."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalați un terminal sau alegeți unul pe pagina Privire de ansamblu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установите терминал или выберите его на странице «Обзор»."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு டெர்மினலை நிறுவவும் அல்லது மேலோட்டம் பக்கத்தில் ஒன்றைத் தேர்ந்தெடுக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఒక టెర్మినల్‌ను ఇన్‌స్టాల్ చేయండి లేదా అవలోకనం పేజీలో ఒకదాన్ని ఎంచుకోండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ติดตั้งเทอร์มินัล หรือเลือกเทอร์มินัลในหน้าภาพรวม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir terminal yükleyin veya Genel Bakış sayfasında birini seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інсталюйте термінал або виберіть його на сторінці «Огляд»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی ٹرمینل انسٹال کریں یا جائزہ صفحے پر کوئی ایک منتخب کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài đặt một terminal hoặc chọn một terminal trên trang Tổng quan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装终端，或在“概览”页面中选择一个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安裝終端機，或在「概覽」頁面中選擇一個。"
          }
        }
      }
    },
    "app.foldersNote": {
      "comment": "Text at the top of the Folders section of the setup window: where the pinned and the recent folders are kept, and who can read them. 'MCP' stays as it is.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتفظ Right Here بهذه المجلدات على هذا الـ Mac فقط، في ملف بجانب ملف الإعداد الخاص بك. ويمكن لمساعد ذكاء اصطناعي متصل عبر MCP أن يقرأها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here এই ফোল্ডারগুলো শুধু এই Mac-এ, আপনার কনফিগারেশন ফাইলের পাশের একটি ফাইলে মনে রাখে। MCP দিয়ে আপনি যে AI সহকারী সংযুক্ত করেন, সেটি এগুলো পড়তে পারে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here merkt sich diese Ordner nur auf diesem Mac, und zwar in einer Datei neben deiner Konfigurationsdatei. Ein KI-Assistent, den du über MCP verbindest, kann sie lesen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Right Here θυμάται αυτούς τους φακέλους μόνο σε αυτό το Mac, σε ένα αρχείο δίπλα στο αρχείο ρυθμίσεών σας. Ένας βοηθός AI που συνδέετε μέσω MCP μπορεί να τους διαβάσει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here remembers these folders on this Mac only, in a file next to your config. An AI assistant that you connect through MCP can read them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here recuerda estas carpetas solo en este Mac, en un archivo junto a tu archivo de configuración. Un asistente de IA conectado a través de MCP puede leerlas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "‏Right Here این پوشه‌ها را فقط روی همین مک و در فایلی کنار فایل پیکربندی شما نگه می‌دارد. یک دستیار هوش مصنوعی که از طریق MCP وصلش می‌کنید می‌تواند آن‌ها را بخواند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here mémorise ces dossiers uniquement sur ce Mac, dans un fichier placé à côté de votre fichier de configuration. Un assistant IA que vous connectez via MCP peut les lire."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏Right Here זוכר את התיקיות האלה רק ב-Mac זה, בקובץ שנמצא לצד קובץ התצורה. עוזר AI שמחובר דרך MCP יכול לקרוא אותן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here इन फ़ोल्डरों को केवल इस Mac पर, आपकी कॉन्फ़िगरेशन फ़ाइल के बगल वाली एक फ़ाइल में याद रखता है। जो AI असिस्टेंट आप MCP के ज़रिए जोड़ते हैं, वह इन्हें पढ़ सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here menyimpan folder-folder ini hanya di Mac ini, dalam file di samping file konfigurasi Anda. Asisten AI yang Anda hubungkan melalui MCP dapat membacanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here ricorda queste cartelle solo su questo Mac, in un file accanto al file di configurazione. Un assistente IA collegato tramite MCP può leggerle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here は、これらのフォルダをこの Mac の中にだけ、設定ファイルの隣のファイルに保存します。MCP で接続した AIアシスタントは、それらを読み取れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here는 이 폴더들을 이 Mac에만, 설정 파일 옆의 파일에 저장합니다. MCP로 연결한 AI 어시스턴트가 이 폴더들을 읽을 수 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ही फोल्डर्स फक्त या Mac वर, तुमच्या कॉन्फिगरेशन फाइलजवळील एका फाइलमध्ये Right Here कडून जतन केली जातात. MCP द्वारे जोडलेला AI असिस्टंट त्यांना वाचू शकतो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here mengingati folder-folder ini pada Mac ini sahaja, dalam satu fail di sebelah fail konfigurasi anda. Pembantu AI yang anda sambungkan melalui MCP boleh membacanya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here onthoudt deze mappen alleen op deze Mac, in een bestand naast je configuratiebestand. Een AI-assistent die je via MCP verbindt, kan ze lezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here zapamiętuje te foldery tylko na tym Macu, w pliku obok konfiguracji. Asystent AI podłączony przez MCP może je odczytać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Right Here guarda estas pastas somente neste Mac, em um arquivo ao lado da sua configuração. Um assistente de IA conectado pelo MCP pode lê-las."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here reține aceste dosare doar pe acest Mac, într-un fișier lângă fișierul de configurare. Un asistent AI conectat prin MCP le poate citi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here запоминает эти папки только на этом Mac, в файле рядом с файлом конфигурации. ИИ-ассистент, подключенный через MCP, может их читать."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here இந்தக் கோப்புறைகளை இந்த Mac-இல் மட்டுமே, உங்கள் உள்ளமைவுக் கோப்புக்கு அடுத்துள்ள ஒரு கோப்பில் நினைவில் வைத்திருக்கிறது. நீங்கள் MCP மூலம் இணைக்கும் ஒரு AI உதவியாளர் இவற்றைப் படிக்க முடியும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here ఈ ఫోల్డర్లను ఈ Mac లో మాత్రమే, మీ కాన్ఫిగరేషన్ ఫైల్ పక్కనే ఉన్న ఫైల్లో గుర్తుంచుకుంటుంది. MCP ద్వారా మీరు కనెక్ట్ చేసే AI సహాయకుడు వాటిని చదవగలరు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here จดจำโฟลเดอร์เหล่านี้ไว้บน Mac เครื่องนี้เท่านั้น ในไฟล์ที่อยู่ถัดจากไฟล์การกำหนดค่าของคุณ ผู้ช่วย AI ที่คุณเชื่อมต่อผ่าน MCP สามารถอ่านโฟลเดอร์เหล่านี้ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here bu klasörleri yalnızca bu Mac’te, yapılandırma dosyanızın yanındaki bir dosyada saklar. MCP üzerinden bağladığınız bir YZ asistanı bunları okuyabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here зберігає ці папки лише на цьому Mac у файлі поруч із вашим файлом конфігурації. ШІ-асистент, якого ви підключаєте через MCP, може їх читати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "‏Right Here ان فولڈرز کو صرف اسی Mac پر یاد رکھتا ہے، کنفیگریشن فائل کے ساتھ والی ایک فائل میں۔ MCP کے ذریعے جڑا ہوا کوئی بھی AI اسسٹنٹ انہیں پڑھ سکتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here chỉ ghi nhớ các thư mục này trên máy Mac này, trong một tệp nằm cạnh cấu hình của bạn. Trợ lý AI mà bạn kết nối qua MCP có thể đọc chúng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here 只在这台 Mac 上记住这些文件夹，记录保存在你的配置文件旁边的一个文件中。你通过 MCP 连接的 AI 助手可以读取它们。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here 只會在這台 Mac 上記住這些檔案夾，記錄存放在你的設定檔旁邊的一個檔案中。你透過 MCP 連接的 AI 助理可以讀取這些資料。"
          }
        }
      }
    },
    "app.helpMenu": {
      "comment": "The item of the app's Help menu that opens the guide. %1$@ is the app's name, Right Here. Use the form macOS uses in each language for an app's own help item, e.g. de '%1$@ Hilfe', fr 'Aide %1$@'.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
