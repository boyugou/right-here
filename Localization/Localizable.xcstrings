    "app.olderCopyBody": {
      "comment": "Under the title of that card. %1$@ is the newer version (0.3.7), %2$@ its folder (/Applications). Both are values. 'Trash': the macOS Trash.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإصدار %1$@ مثبّت في %2$@. افتحه، وانقل هذه النسخة إلى سلة المهملات حتى يفتح Spotlight النسخة الجديدة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সংস্করণ %1$@ %2$@-এ ইনস্টল করা আছে। সেটি খুলুন, আর এই কপিটি Trash-এ সরান, যাতে Spotlight নতুনটি খোলে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %1$@ ist in %2$@ installiert. Öffne sie und lege diese Kopie in den Papierkorb, damit Spotlight die neue öffnet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η έκδοση %1$@ είναι εγκατεστημένη στο %2$@. Ανοίξτε την και μετακινήστε αυτό το αντίγραφο στον Κάδο, ώστε το Spotlight να ανοίγει το νέο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %1$@ is installed in %2$@. Open it, and move this copy to the Trash so that Spotlight opens the new one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión %1$@ está instalada en %2$@. Ábrela y mueve esta copia a la Papelera para que Spotlight abra la nueva."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نسخهٔ %1$@ در %2$@ نصب شده است. آن را باز کنید و این نسخه را به Trash ببرید تا Spotlight نسخهٔ جدید را باز کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version %1$@ est installée dans %2$@. Ouvrez-la et placez cette copie dans la Corbeille pour que Spotlight ouvre la nouvelle."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גירסה %1$@ מותקנת ב-%2$@. יש לפתוח אותה ולהעביר עותק זה לפח, כדי ש-Spotlight יפתח את הגירסה החדשה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संस्करण %1$@, %2$@ में इंस्टॉल है। उसे खोलें और इस प्रति को रद्दी में मूव करें, ताकि Spotlight नया संस्करण खोले।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Versi %1$@ diinstal di %2$@. Buka versi itu, lalu pindahkan salinan ini ke Tong Sampah agar Spotlight membuka yang baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La versione %1$@ è installata in %2$@. Aprila e sposta questa copia nel Cestino, così Spotlight aprirà quella nuova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バージョン %1$@ が %2$@ にインストールされています。それを開き、Spotlight で新しいほうが開くように、このコピーをゴミ箱に入れてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버전 %1$@이(가) %2$@에 설치되어 있습니다. 해당 버전을 열고, Spotlight가 새 버전을 열도록 이 복사본을 휴지통으로 옮기십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आवृत्ती %1$@ %2$@ मध्ये इन्स्टॉल केलेली आहे. ती उघडा, आणि Spotlight नवीन आवृत्ती उघडेल यासाठी ही प्रत Trash मध्ये हलवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Versi %1$@ dipasang dalam %2$@. Bukanya, dan pindahkan salinan ini ke Sampah supaya Spotlight membuka yang baharu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Versie %1$@ is geïnstalleerd in %2$@. Open die en verplaats deze kopie naar de prullenmand, zodat Spotlight de nieuwe opent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wersja %1$@ jest zainstalowana w %2$@. Otwórz ją, a tę kopię przenieś do Kosza, aby Spotlight otwierał nową."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A versão %1$@ está instalada em %2$@. Abra-a e mova esta cópia para o Lixo para que o Spotlight abra a nova."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Versiunea %1$@ este instalată în %2$@. Deschideți-o și mutați această copie în Coș, astfel încât Spotlight să o deschidă pe cea nouă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Версия %1$@ установлена в %2$@. Откройте ее, а эту копию переместите в Корзину, чтобы Spotlight открывал новую."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பதிப்பு %1$@, %2$@ இல் நிறுவப்பட்டுள்ளது. அதைத் திறந்து, Spotlight புதியதைத் திறக்கும்படி இந்த நகலை Trash-க்கு நகர்த்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వెర్షన్ %1$@, %2$@ లో ఇన్‌స్టాల్ చేయబడింది. దాన్ని తెరిచి, Spotlight కొత్తదాన్ని తెరిచేలా ఈ కాపీని Trash కు తరలించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวอร์ชั่น %1$@ ติดตั้งอยู่ใน %2$@ เปิดเวอร์ชั่นนั้น แล้วย้ายสำเนานี้ไปยังถังขยะ เพื่อให้ Spotlight เปิดเวอร์ชั่นใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sürümü %2$@ konumunda yüklü. Onu açın ve Spotlight’ın yenisini açması için bu kopyayı Çöp Sepeti’ne taşıyın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Версію %1$@ інстальовано в %2$@. Відкрийте її, а цю копію перемістіть у Смітник, щоб Spotlight відкривав нову."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ورژن %1$@، %2$@ میں انسٹال ہے۔ اسے کھولیں، اور اس کاپی کو Trash میں منتقل کریں تاکہ Spotlight نیا ورژن کھولے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên bản %1$@ đã được cài đặt trong %2$@. Hãy mở phiên bản đó và chuyển bản sao này vào Thùng rác để Spotlight mở bản mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "版本 %1$@ 已安装在 %2$@ 中。请打开它，并将此副本移到废纸篓，这样“聚焦”就会打开新版本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "版本 %1$@ 已安裝在 %2$@ 中。請打開它，並將此副本移到垃圾桶，這樣 Spotlight 就會打開新版本。"
          }
        }
      }
    },
