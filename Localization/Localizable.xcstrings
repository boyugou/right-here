          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 에이전트는 묻지 않고 시작됩니다"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एजंट आता विचारल्याशिवाय सुरू होतात"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejen kini dimulakan tanpa bertanya"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenten starten nu zonder te vragen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenci uruchamiają się teraz bez pytania"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os agentes agora iniciam sem perguntar"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenții pornesc acum fără întrebări"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Агенты теперь запускаются без вопросов"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முகவர்கள் இப்போது கேட்காமல் தொடங்கும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఏజెంట్లు ఇప్పుడు అడగకుండా ప్రారంభమవుతాయి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้เอเจนต์เริ่มทำงานโดยไม่ถามแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajanlar artık sormadan başlıyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Агенти тепер запускаються без запитань"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایجنٹس اب بغیر پوچھے شروع ہوں گے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tác tử giờ khởi chạy mà không hỏi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体现在无需询问即可启动"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代理程式現在無需詢問即可啟動"
          }
        }
      }
    },
    "app.bypassHelp": {
      "comment": "Explanation under the switch app.bypassTitle. 'Prompt presets' are ready-made prompts (such as 'Review') that the person can send to an agent from the Finder menu; they always keep the agent's questions on.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدأ كل وكيل بالخيار الذي يوقف طلبات الإذن الخاصة به. وبعدها يستطيع تنفيذ الأوامر وتغيير الملفات دون أن يسألك أولًا. أما الإعدادات المسبقة للموجّهات فتظل تسأل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি এজেন্ট এমন একটি ফ্ল্যাগ দিয়ে শুরু হয়, যা এর নিজের অনুমতি চাওয়ার প্রশ্ন বন্ধ করে দেয়। তখন এটি আগে আপনাকে জিজ্ঞাসা না করেই কমান্ড চালাতে ও ফাইল বদলাতে পারে। প্রম্পট প্রিসেট জিজ্ঞাসা করতেই থাকে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Agent startet mit dem Flag, das seine eigenen Berechtigungsabfragen abschaltet. Dann kann er Befehle ausführen und Dateien ändern, ohne dich vorher zu fragen. Prompt-Voreinstellungen fragen weiterhin nach."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε πράκτορας ξεκινά με τη σημαία που απενεργοποιεί τις δικές του ερωτήσεις για άδειες. Τότε μπορεί να εκτελεί εντολές και να αλλάζει αρχεία χωρίς να σας ρωτά πρώτα. Οι προεπιλογές προτροπών εξακολουθούν να ρωτούν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each agent starts with the flag that switches off its own permission prompts. It can then run commands and change files without asking you first. Prompt presets keep asking."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada agente se inicia con la opción que desactiva sus propias solicitudes de permiso. Entonces puede ejecutar comandos y cambiar archivos sin preguntarte antes. Los preajustes de prompt siguen preguntando."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر عامل با گزینهٔ خط فرمانی شروع می‌شود که درخواست‌های مجوز خودش را خاموش می‌کند. سپس می‌تواند بدون پرسیدن از شما دستور اجرا کند و فایل‌ها را تغییر دهد. پیش‌تنظیم‌های پرامپت همچنان می‌پرسند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque agent démarre avec l’option qui désactive ses propres demandes d’autorisation. Il peut alors exécuter des commandes et modifier des fichiers sans rien vous demander au préalable. Les préréglages de prompt continuent de demander confirmation."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל סוכן מופעל עם הדגל שמכבה את בקשות ההרשאה שלו. כך הוא יכול להריץ פקודות ולשנות קבצים בלי לבקש אישור קודם. בהגדרות מוכנות, הסוכנים ממשיכים לשאול."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर एजेंट ऐसे फ़्लैग के साथ शुरू होता है जो उसके अपने अनुमति वाले सवाल बंद कर देता है। तब वह आपसे पूछे बिना कमांड चला सकता है और फ़ाइलें बदल सकता है। प्रॉम्प्ट प्रीसेट में एजेंट फिर भी पूछते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap agen dimulai dengan opsi yang mematikan permintaan izinnya sendiri. Setelah itu, agen dapat menjalankan perintah dan mengubah file tanpa bertanya kepada Anda terlebih dahulu. Preset prompt tetap bertanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni agente si avvia con l’opzione che disattiva le sue richieste di permesso. Può quindi eseguire comandi e modificare file senza chiederti prima. I preset di prompt continuano a chiedere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各エージェントは、自身の許可の確認を無効にするオプションを付けて起動します。その後は、確認なしでコマンドを実行したりファイルを変更したりできます。プロンプトのプリセットは、引き続き確認を求めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 에이전트는 자체 권한 요청을 끄는 옵션을 붙여 시작합니다. 그러면 먼저 묻지 않고도 명령을 실행하고 파일을 바꿀 수 있습니다. 프롬프트 프리셋은 계속 묻습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक एजंट स्वतःची परवानगी विचारणा बंद करणारा फ्लॅग वापरून सुरू होतो. मग तो तुम्हाला आधी न विचारता कमांड चालवू शकतो आणि फाइल बदलू शकतो. प्रॉम्प्ट प्रीसेट मात्र विचारत राहतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap ejen dimulakan dengan bendera yang menyahaktifkan gesaan kebenarannya sendiri. Ia kemudian boleh menjalankan perintah dan menukar fail tanpa bertanya kepada anda dahulu. Praset gesaan tetap bertanya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke agent start met de vlag die zijn eigen toestemmingsvragen uitschakelt. Hij kan dan zonder eerst te vragen commando’s uitvoeren en bestanden wijzigen. Agentvoorinstellingen blijven vragen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy agent uruchamia się z flagą, która wyłącza jego własne pytania o uprawnienia. Może wtedy uruchamiać polecenia i zmieniać pliki bez wcześniejszego pytania. Gotowe prompty nadal pytają."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada agente inicia com a flag que desliga os próprios pedidos de permissão. Ele poderá então executar comandos e alterar arquivos sem perguntar antes. As predefinições de prompt continuam perguntando."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare agent pornește cu opțiunea care îi dezactivează solicitările proprii de permisiune. Poate apoi să ruleze comenzi și să modifice fișiere fără să vă întrebe mai întâi. Presetările pentru agent continuă să întrebe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый агент запускается с флагом, который отключает его собственные запросы разрешений. Тогда он может выполнять команды и менять файлы, не спрашивая Вас. С пресетами агента запросы разрешений остаются включенными."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒவ்வொரு முகவரும் அதன் சொந்த அனுமதிக் கேள்விகளை அணைக்கும் கொடியுடன் தொடங்கும். அதன் பிறகு உங்களிடம் முதலில் கேட்காமல் அது கட்டளைகளை இயக்கவும் கோப்புகளை மாற்றவும் முடியும். ப்ராம்ப்ட் முன்னமைவுகள் தொடர்ந்து கேட்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రతి ఏజెంట్ తన సొంత అనుమతి ప్రశ్నలను ఆఫ్ చేసే ఫ్లాగ్‌తో ప్రారంభమవుతుంది. ఆ తర్వాత అది మిమ్మల్ని ముందుగా అడగకుండానే ఆదేశాలను అమలు చేసి ఫైళ్లను మార్చగలదు. ప్రాంప్ట్ ప్రీసెట్‌లు అడుగుతూనే ఉంటాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอเจนต์แต่ละตัวจะเริ่มทำงานพร้อมแฟล็กที่ปิดการถามขออนุญาตของตัวเอง จากนั้นจะรันคำสั่งและเปลี่ยนแปลงไฟล์ได้โดยไม่ต้องถามคุณก่อน พรีเซ็ตพรอมต์จะยังคงถามต่อไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her ajan, kendi izin istemlerini kapatan bayrakla başlar. Bu durumda önce size sormadan komut çalıştırabilir ve dosyaları değiştirebilir. İstem ön ayarları sormaya devam eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен агент запускається з параметром, який вимикає його власні запити на дозвіл. Тоді він може виконувати команди та змінювати файли, не питаючи вас. Пресети агента й далі питатимуть."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر ایجنٹ اپنے اجازت کے پرامپٹ بند کرنے والے فلیگ کے ساتھ شروع ہوتا ہے۔ اس کے بعد وہ آپ سے پہلے پوچھے بغیر کمانڈز چلا سکتا ہے اور فائلیں بدل سکتا ہے۔ پرامپٹ پری سیٹس پوچھتے رہتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi tác tử khởi chạy với cờ tắt lời nhắc xin phép của chính nó. Khi đó, nó có thể chạy lệnh và thay đổi tệp mà không hỏi bạn trước. Các mẫu lời nhắc vẫn tiếp tục hỏi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个智能体都会带上关闭其自身权限提示的标志启动。此后它可以在不先询问你的情况下运行命令、更改文件。提示词预设仍会询问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個代理程式都會以關閉其自身權限提示的旗標啟動。此後它可以在不先詢問你的情況下執行指令、變更檔案。提示詞預設組仍會詢問。"
          }
        }
      }
    },
    "app.bypassKeepsAsking": {
      "comment": "A line in the same list: %@ is the name of an AI agent. The person set this one agent, in the config file, to keep its permission prompts on whatever the general switch says. Keep the %@.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%@ يظل يسأل، فإعداده الخاص يقتضي ذلك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ জিজ্ঞাসা করতেই থাকে: এর নিজের সেটিংয়ে তা-ই ঠিক করা আছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fragt weiterhin nach: Seine eigene Einstellung legt das fest."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο πράκτορας %@ συνεχίζει να ρωτά: αυτό ορίζει η δική του ρύθμιση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ keeps asking: its own setting says so."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sigue preguntando: así lo establece su propia configuración."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%@ همچنان می‌پرسد، زیرا تنظیم خود آن همین را می‌گوید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ continue de demander : son propre réglage l’indique."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%@ ממשיך לשאול, כי ההגדרה שלו עצמו קובעת כך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ पूछता रहता है: उसकी अपनी सेटिंग यही कहती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tetap bertanya: pengaturannya sendiri menyatakan demikian."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ continua a chiedere: lo stabilisce la sua impostazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は確認を求め続けます。エージェント自身の設定で、そう指定されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: 자체 설정에 따라 계속 묻습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ विचारत राहतो: त्याच्या स्वतःच्या सेटिंगमध्येच तसे ठरवलेले आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ terus bertanya: setingnya sendiri menyatakan demikian."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ blijft vragen: zo is deze agent zelf ingesteld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent %@ nadal pyta – tak wynika z jego własnego ustawienia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ continua perguntando, conforme o ajuste próprio dele."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ continuă să întrebe: așa prevede propria sa setare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Агент %@ продолжает спрашивать: так указано в его собственной настройке."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ தொடர்ந்து கேட்கும்: அதன் சொந்த அமைப்பு அவ்வாறு கூறுகிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ అడుగుతూనే ఉంటుంది: దాని స్వంత సెట్టింగ్ అలా చెబుతోంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ยังคงถามต่อไป: การตั้งค่าของตัวเองกำหนดไว้เช่นนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sormaya devam eder: kendi ayarı bunu böyle belirliyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ і далі питатиме: так задано у власних налаштуваннях."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%@ پوچھتا رہتا ہے: اس کی اپنی سیٹنگ یہی کہتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tiếp tục hỏi: cài đặt riêng của nó quy định như vậy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 会继续询问：其自身设置如此规定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 會繼續詢問：其自身設定如此規定。"
          }
        }
      }
    },
    "app.bypassNoFlag": {
      "comment": "A line in the list of the confirmation and under the switch: %@ is the name of an AI agent (for example Goose). This agent has no command-line flag that switches its permission prompts off, so it keeps asking even when the switch is on. Keep the %@.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%@ لا يملك خيارًا كهذا، فيظل يسأل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-এর এমন কোনো ফ্ল্যাগ নেই, তাই এটি জিজ্ঞাসা করতেই থাকে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat kein solches Flag und fragt weiterhin nach."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο πράκτορας %@ δεν έχει τέτοια σημαία και συνεχίζει να ρωτά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has no such flag and keeps asking."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no tiene una opción así y sigue preguntando."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%@ چنین گزینه‌ای ندارد و همچنان می‌پرسد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’a pas d’option de ce genre et continue de demander."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ל-%@ אין דגל כזה, והוא ממשיך לשאול."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ में ऐसा कोई फ़्लैग नहीं है और वह पूछता रहता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tidak punya opsi seperti itu dan tetap bertanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non ha un’opzione del genere e continua a chiedere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ にはそのようなオプションがなく、確認を求め続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에는 그런 옵션이 없어서 계속 묻습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ कडे असा कोणताही फ्लॅग नाही, त्यामुळे तो विचारत राहतो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tidak mempunyai bendera sebegitu dan terus bertanya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ heeft zo’n vlag niet en blijft vragen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent %@ nie ma takiej flagi i nadal pyta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não tem essa flag e continua perguntando."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nu are o asemenea opțiune și continuă să întrebe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У агента %@ нет такого флага, поэтому он продолжает спрашивать."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-க்கு அப்படிப்பட்ட கொடி எதுவும் இல்லை, எனவே அது தொடர்ந்து கேட்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ కి అలాంటి ఫ్లాగ్ లేదు, కాబట్టి అది అడుగుతూనే ఉంటుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ไม่มีแฟล็กดังกล่าว และจะยังคงถามต่อไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ böyle bir bayrağa sahip değil ve sormaya devam eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Агент %@ не має такого параметра, тож і далі питатиме."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%@ کے پاس ایسا کوئی فلیگ نہیں ہے، اس لیے وہ پوچھتا رہتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ không có cờ như vậy nên vẫn tiếp tục hỏi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 没有此类标志，因此会继续询问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 沒有這類旗標，因此會繼續詢問。"
          }
        }
      }
    },
    "app.bypassOwnSetting": {
      "comment": "Line under the switch 'Start agents without asking' (app.bypassTitle) while the switch is off: it names an agent whose own setting still makes it start without its permission prompts. %@ is the agent's name (Claude Code, Codex). It is the counterpart of app.bypassKeepsAsking ('%@ keeps asking: its own setting says so.'): use the same wording and structure as the translation of that sentence.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%@ يُشغَّل دون استئذان، فإعداده الخاص يقتضي ذلك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ জিজ্ঞাসা না করেই শুরু হয়: এর নিজের সেটিংয়ে তা-ই ঠিক করা আছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ startet ohne Nachfrage: Seine eigene Einstellung legt das fest."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο πράκτορας %@ ξεκινά χωρίς ερωτήσεις: αυτό ορίζει η δική του ρύθμιση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ starts without asking: its own setting says so."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se inicia sin preguntar: así lo establece su propia configuración."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%@ بدون پرسیدن شروع می‌شود، زیرا تنظیم خود آن همین را می‌گوید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ démarre sans demander : son propre réglage l’indique."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%@ מופעל בלי לשאול, כי ההגדרה שלו עצמו קובעת כך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ बिना पूछे शुरू होता है: उसकी अपनी सेटिंग यही कहती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ mulai tanpa bertanya: pengaturannya sendiri menyatakan demikian."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ si avvia senza chiedere: lo stabilisce la sua impostazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は確認せずに起動します。エージェント自身の設定で、そう指定されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: 자체 설정에 따라 묻지 않고 시작합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ विचारल्याशिवाय सुरू होतो: त्याच्या स्वतःच्या सेटिंगमध्येच तसे ठरवलेले आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dimulakan tanpa bertanya: setingnya sendiri menyatakan demikian."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ start zonder te vragen: zo is deze agent zelf ingesteld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent %@ uruchamia się bez pytania – tak wynika z jego własnego ustawienia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ inicia sem perguntar, conforme o ajuste próprio dele."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pornește fără întrebări: așa prevede propria sa setare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Агент %@ запускается без вопросов: так указано в его собственной настройке."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ கேட்காமல் தொடங்கும்: அதன் சொந்த அமைப்பு அவ்வாறு கூறுகிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ అడగకుండా ప్రారంభమవుతుంది: దాని స్వంత సెట్టింగ్ అలా చెబుతోంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ เริ่มโดยไม่ต้องถาม: การตั้งค่าของตัวเองกำหนดไว้เช่นนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sormadan başlar: kendi ayarı bunu böyle belirliyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ запускається без запитань: так задано у власних налаштуваннях."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%@ بغیر پوچھے شروع ہوتا ہے: اس کی اپنی سیٹنگ یہی کہتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ khởi chạy mà không hỏi: cài đặt riêng của nó quy định như vậy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 会无需询问即启动：其自身设置如此规定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 會無需詢問即啟動：其自身設定如此規定。"
          }
        }
      }
    },
    "app.bypassTitle": {
      "comment": "Title of a switch on the Agents page. When it is on, AI agents are started with the command-line flag that switches off their own permission prompts (the questions they ask before running a command or changing a file).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشغيل الوكلاء دون استئذان"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "জিজ্ঞাসা না করে এজেন্ট শুরু করুন"
          }
        },
        "de": {
          "stringUnit": {
