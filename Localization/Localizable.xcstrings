    "app.chooseFolderMessage": {
      "comment": "Text at the top of the folder panel that opens to choose the repository whose worktrees the setup window lists.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مجلداً داخل مستودع git لعرض worktrees الخاصة به."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "git রিপোজিটরির ভেতরের একটি ফোল্ডার বেছে নিন, যাতে এর worktree-গুলো দেখানো যায়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Ordner in einem Git-Repository aus, um seine Worktrees aufzulisten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε έναν φάκελο μέσα σε αποθετήριο git για να εμφανιστούν τα worktree του."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a folder in a git repository to list its worktrees."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una carpeta dentro de un repositorio de git para mostrar sus worktrees."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک پوشه را در یک مخزن git انتخاب کنید تا worktreeهای آن فهرست شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un dossier dans un dépôt git pour afficher ses worktrees."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לבחור תיקיה בתוך מאגר git כדי להציג את ה-worktrees שלו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी git रिपॉज़िटरी में एक फ़ोल्डर चुनें, ताकि उसके worktrees की सूची दिखे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih folder di dalam repositori git untuk menampilkan worktree-nya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una cartella in un repository git per elencarne i worktree."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークツリーを一覧表示するには、git リポジトリ内のフォルダを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "워크트리 목록을 보려면 git 저장소 안의 폴더를 선택하십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "त्याचे वर्कट्री दाखवण्यासाठी git रेपॉझिटरीमधील एक फोल्डर निवडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih folder dalam repositori git untuk menyenaraikan worktree-nya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een map in een git-repository om de worktrees ervan te tonen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz folder w repozytorium git, aby wyświetlić jego drzewa robocze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma pasta em um repositório git para listar seus worktrees."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alegeți un dosar dintr-un depozit git pentru a afișa worktree-urile acestuia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите папку в репозитории git, чтобы показать его рабочие деревья."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அதன் worktree-களைப் பட்டியலிட, git repository-இல் உள்ள ஒரு கோப்புறையைத் தேர்ந்தெடுக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దాని worktrees ను జాబితా చేయడానికి git రిపోజిటరీలో ఉన్న ఒక ఫోల్డర్ను ఎంచుకోండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกโฟลเดอร์ในรีโพซิทอรี git เพื่อแสดงรายการ worktree ของรีโพซิทอรีนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Worktree’lerini listelemek için bir git deposundaki bir klasörü seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть папку в git-репозиторії, щоб показати список його worktrees."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس کے ورک ٹریز دیکھنے کے لیے git ریپازٹری میں کوئی فولڈر منتخب کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn một thư mục trong kho git để liệt kê các worktree của kho đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择 git 仓库中的一个文件夹，以列出其工作树。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇 git 儲存庫中的一個檔案夾，以列出其工作樹。"
          }
        }
      }
