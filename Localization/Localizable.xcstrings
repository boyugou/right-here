        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ஐக் குறிப்பிட பின்சாய்வுக்கோடு தேவைப்படும் (பெயரில் பின்சாய்வுக்கோடு உள்ளது, அல்லது இடைவெளியுடன் அல்லது தொடக்கத்தில் மேற்கோள் குறி உள்ளது); அந்த இடத்தில் அதை AI முகவர்கள் படிக்கும் என்று தெரியவில்லை. வேறு வடிவில் நகலெடுக்கவும், அல்லது அதன் பெயரை மாற்றவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ను పేర్కొనడానికి బ్యాక్‌స్లాష్ అవసరమవుతుంది (పేరులో బ్యాక్‌స్లాష్ ఉంది, లేదా ఖాళీతో పాటు లేదా మొదట్లో కోట్ ఉంది); అక్కడ AI ఏజెంట్లు దాన్ని చదువుతాయో లేదో తెలియదు. దాన్ని వేరే రూపంలో కాపీ చేయండి, లేదా దాని పేరు మార్చండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การกล่าวถึง %@ จะต้องใช้แบ็กสแลช (ชื่อมีแบ็กสแลช หรือมีเครื่องหมายคำพูดคู่กับช่องว่างหรืออยู่ที่ต้นชื่อ) และยังไม่ทราบว่าเอเจนต์ AI อ่านแบ็กสแลชตรงนั้นหรือไม่ ให้คัดลอกในรูปแบบอื่น หรือเปลี่ยนชื่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ öğesinden bahsetmek için ters eğik çizgi gerekir (adında ters eğik çizgi ya da boşlukla birlikte veya başında tırnak var); YZ ajanlarının onu orada okuduğu bilinmiyor. Başka bir biçimde kopyalayın ya da adını değiştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для згадки %@ знадобилася б зворотна скісна риска (вона є в назві або назва містить лапки разом із пробілом чи на початку), а невідомо, чи читають її там ШІ-агенти. Скопіюйте її в іншому вигляді або перейменуйте."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%@ کا ذکر کرنے کے لیے بیک سلیش درکار ہوگا (اس کے نام میں بیک سلیش ہے، یا خالی جگہ کے ساتھ یا شروع میں واوین ہے)، اور یہ معلوم نہیں کہ AI ایجنٹ وہاں اسے پڑھتے ہیں۔ اسے کسی اور شکل میں کاپی کریں، یا اس کا نام بدلیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc nhắc đến %@ sẽ cần một dấu gạch chéo ngược (tên có dấu gạch chéo ngược, hoặc có dấu nháy đi kèm dấu cách hay ở đầu tên), và chưa rõ các tác tử AI có đọc nó ở đó không. Hãy sao chép nó ở dạng khác, hoặc đổi tên nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提及 %@ 需要用到反斜杠（名称本身含有反斜杠，或含有与空格同时出现或位于开头的引号），而目前不知道 AI 智能体是否会在那里识别反斜杠。请改用其他形式拷贝，或为它重新命名。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提及 %@ 需要用到反斜線（名稱本身含有反斜線，或含有與空格同時出現或位於開頭的引號），而目前不知道 AI 代理程式是否會在那裡辨識反斜線。請改用其他形式拷貝，或為它重新命名。"
          }
        }
      }
    },
    "refusal.danglingLink": {
      "comment": "Why an action did nothing, shown in the alert after a click in Finder (and, in English, by the command line). %@ is a path; a link is a symbolic link (an alias made by the system).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%@ رابط رمزي لا يشير إلى أي مكان (أو يشير إلى مكان لا يسمح macOS لتطبيق Right Here بالاطلاع عليه)، لذا لا يوجد مجلد لفتحه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ এমন একটি সিম্বলিক লিংক যা কোথাও নির্দেশ করে না (অথবা এমন জায়গায় নির্দেশ করে যেখানে macOS Right Here-কে দেখতে দেয় না), তাই খোলার মতো কোনো ফোল্ডার নেই।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist ein symbolischer Link, der ins Leere zeigt (oder an einen Ort, auf den macOS Right Here nicht zugreifen lässt), daher gibt es keinen Ordner zum Öffnen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %@ είναι συμβολικός σύνδεσμος που δεν δείχνει πουθενά (ή δείχνει σε θέση που το macOS δεν επιτρέπει στο Right Here να δει), οπότε δεν υπάρχει φάκελος για άνοιγμα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is a link that points nowhere (or into a place macOS will not let Right Here look at), so there is no folder to open."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ es un enlace simbólico que no apunta a ningún sitio (o que apunta a un lugar que macOS no deja ver a Right Here), así que no hay ninguna carpeta que abrir."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%@ پیوندی نمادین است که به جایی اشاره نمی‌کند (یا به جایی اشاره می‌کند که macOS به Right Here اجازهٔ دیدنش را نمی‌دهد)، بنابراین پوشه‌ای برای باز کردن وجود ندارد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est un lien symbolique qui ne pointe nulle part (ou vers un emplacement que macOS ne laisse pas Right Here examiner) ; il n’y a donc aucun dossier à ouvrir."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%@ הוא קישור סמלי שאינו מצביע לשום מקום (או שמצביע למקום ש-macOS לא מאפשר ל-Right Here לבדוק), ולכן אין תיקיה לפתוח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ एक सिमलिंक है जो कहीं नहीं ले जाता (या ऐसी जगह ले जाता है जिसे macOS Right Here को देखने नहीं देता), इसलिए खोलने के लिए कोई फ़ोल्डर नहीं है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ adalah tautan simbolis yang tidak mengarah ke mana pun (atau ke tempat yang tidak boleh dilihat Right Here menurut macOS), jadi tidak ada folder untuk dibuka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è un link simbolico che non punta a nulla (o punta a un luogo che macOS non permette a Right Here di esaminare), quindi non c’è nessuna cartella da aprire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はどこも指していないリンク（またはmacOSがRight Hereに参照を許可しない場所を指すリンク）のため、開くフォルダがありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 경로는 아무 곳도 가리키지 않는(또는 macOS가 Right Here의 확인을 허용하지 않는 곳을 가리키는) 링크이므로 열 폴더가 없습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ही कुठेच निर्देश न करणारी लिंक आहे (किंवा macOS जिथे Right Here ला पाहू देत नाही अशा ठिकाणी निर्देश करते), त्यामुळे उघडण्यासाठी कोणताही फोल्डर नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ialah pautan yang tidak menuju ke mana-mana (atau menuju ke tempat yang tidak dibenarkan oleh macOS untuk dilihat oleh Right Here), jadi tiada folder untuk dibuka."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is een link die nergens naartoe wijst (of naar een plek waar macOS Right Here niet laat kijken), dus er is geen map om te openen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ to dowiązanie symboliczne, które nigdzie nie prowadzi (albo prowadzi do miejsca, do którego macOS nie pozwala Right Here zajrzeć), więc nie ma folderu do otwarcia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ é um link que não aponta para lugar nenhum (ou aponta para um lugar que o macOS não deixa o Right Here examinar), então não há pasta para abrir."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ este un link care nu duce nicăieri (sau duce într-un loc pe care macOS nu îl lasă pe Right Here să-l examineze), deci nu există niciun dosar de deschis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — ссылка, которая никуда не ведет (или ведет туда, куда macOS не позволяет Right Here заглянуть), поэтому нет папки, которую можно открыть."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ எங்கும் சுட்டாத ஒரு symlink (அல்லது Right Here பார்க்க macOS அனுமதிக்காத இடத்தைச் சுட்டுகிறது), எனவே திறக்க எந்தக் கோப்புறையும் இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ఎక్కడికీ సూచించని symlink (లేదా Right Here చూడటానికి macOS అనుమతించని చోటికి సూచిస్తుంది), కాబట్టి తెరవడానికి ఫోల్డర్ లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ เป็น symlink ที่ไม่ได้ชี้ไปที่ใด (หรือชี้ไปยังที่ที่ macOS ไม่อนุญาตให้ Right Here ดู) จึงไม่มีโฟลเดอร์ให้เปิด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hiçbir yeri göstermeyen bir sembolik bağlantı (ya da macOS’in Right Here’in bakmasına izin vermediği bir yeri gösteriyor), bu yüzden açılacak bir klasör yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — це символічне посилання, яке нікуди не веде (або веде туди, куди macOS не дозволяє Right Here зазирнути), тому немає папки, яку можна відкрити."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%@ ایک ایسا سمبولک لنک ہے جو کہیں اشارہ نہیں کرتا (یا کسی ایسی جگہ اشارہ کرتا ہے جسے macOS، Right Here کو دیکھنے نہیں دیتا)، اس لیے کھولنے کے لیے کوئی فولڈر نہیں ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ là một liên kết tượng trưng không trỏ tới đâu cả (hoặc trỏ vào nơi mà macOS không cho Right Here xem), nên không có thư mục nào để mở."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 是一个不指向任何位置的符号链接（或指向 macOS 不允许 Right Here 查看的位置），因此没有可打开的文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 是一個不指向任何位置的符號連結（或指向 macOS 不允許 Right Here 查看的位置），因此沒有可開啟的檔案夾。"
          }
        }
      }
    },
