    "app.languageCaption": {
      "comment": "Under the language menu on the Overview page: what the chosen language applies to. Use the catalog's existing terms for the Finder menu (key app.menuTitle) and Quick Actions (key app.checkServices).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقائمة فايندر وهذه النافذة والتنبيهات وأسماء الإجراءات السريعة. يبقى سطر الأوامر بالإنجليزية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder মেনু, এই উইন্ডো, সতর্কবার্তা এবং Quick Actions-এর নামের জন্য। কমান্ড লাইন ইংরেজিতেই থাকে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für das Finder-Menü, dieses Fenster, die Hinweise und die Namen der Schnellaktionen. Die Befehlszeile bleibt auf Englisch."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για το μενού του Finder, αυτό το παράθυρο, τις ειδοποιήσεις και τα ονόματα των Γρήγορων ενεργειών. Η γραμμή εντολών παραμένει στα αγγλικά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For the Finder menu, this window, the alerts and the names of the Quick Actions. The command line stays in English."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para el menú del Finder, esta ventana, los avisos y los nombres de las Acciones rápidas. La línea de comandos sigue en inglés."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای منوی Finder، این پنجره، هشدارها و نام‌های Quick Actions. خط فرمان به انگلیسی می‌ماند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour le menu du Finder, cette fenêtre, les alertes et les noms des Actions rapides. La ligne de commande reste en anglais."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לתפריט Finder, לחלון זה, להתראות ולשמות של הפעולות המהירות. שורת הפקודה נשארת באנגלית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder मेन्यू, इस विंडो, अलर्ट और त्वरित क्रियाओं के नामों के लिए। कमांड लाइन अंग्रेज़ी में ही रहती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menu Finder, jendela ini, peringatan, dan nama Tindakan Cepat. Baris perintah tetap dalam bahasa Inggris."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per il menu del Finder, questa finestra, gli avvisi e i nomi delle Azioni rapide. La riga di comando resta in inglese."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder メニュー、このウインドウ、アラート、クイックアクションの名前に使われます。コマンドラインは英語のままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder 메뉴, 이 윈도우, 알림, 빠른 동작의 이름에 적용됩니다. 명령줄은 영어로 유지됩니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder मेनू, ही विंडो, सूचना आणि Quick Actions च्या नावांसाठी. कमांड लाइन इंग्रजीतच राहते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menu Finder, tetingkap ini, amaran dan nama Tindakan Cepat. Garis perintah kekal dalam bahasa Inggeris."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor het Finder-menu, dit venster, de meldingen en de namen van de snelle taken. De commandoregel blijft in het Engels."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotyczy menu Findera, tego okna, alertów i nazw Szybkich czynności. Wiersz poleceń pozostaje po angielsku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para o menu do Finder, esta janela, os alertas e os nomes das Ações Rápidas. A linha de comando continua em inglês."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru meniul Finder, această fereastră, alertele și numele Acțiunilor rapide. Linia de comandă rămâne în engleză."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для меню Finder, этого окна, предупреждений и названий быстрых действий. Командная строка остается на английском."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder மெனு, இந்தச் சாளரம், எச்சரிக்கைகள், Quick Actions-இன் பெயர்கள் ஆகியவற்றுக்கு. கட்டளை வரி ஆங்கிலத்திலேயே இருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder మెనూ, ఈ విండో, హెచ్చరికలు, Quick Actions పేర్ల కోసం. కమాండ్-లైన్ ఇంగ్లీష్‌లోనే ఉంటుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้กับเมนูของ Finder หน้าต่างนี้ การแจ้งเตือน และชื่อของการทำงานด่วน บรรทัดคำสั่งยังคงเป็นภาษาอังกฤษ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder menüsü, bu pencere, uyarılar ve Hızlı Eylemler’in adları için. Komut satırı İngilizce kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для меню Finder, цього вікна, оповісток і назв швидких дій. Командний рядок лишається англійською."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "‏Finder مینو، اس ونڈو، الرٹس اور Quick Actions کے ناموں کے لیے۔ کمانڈ لائن انگریزی میں ہی رہتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Áp dụng cho menu Finder, cửa sổ này, các cảnh báo và tên của Tác vụ nhanh. Dòng lệnh vẫn bằng tiếng Anh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于访达菜单、这个窗口、提示框和快速操作的名称。命令行仍为英文。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於 Finder 選單、這個視窗、警示訊息和快速動作的名稱。指令列仍為英文。"
          }
        }
      }
    },
