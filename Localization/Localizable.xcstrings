    "app.appNameTaken": {
      "comment": "Caption under the name field of the form that adds an app (the Add button is dimmed while it shows). %@ is the name typed. The Finder menu shows apps by name ('Open in <name>'), so two apps cannot share one. Use the same word for 'app' as app.appIsTerminal.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يوجد تطبيق آخر باسم %@. امنح هذا التطبيق اسمًا خاصًا به ليميّز القائمة بينهما."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আরেকটি অ্যাপের নাম আগে থেকেই %@। এটিকে নিজস্ব একটি নাম দিন, যাতে মেনুতে দুটিকে আলাদা করে চেনা যায়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eine andere App heißt bereits %@. Gib dieser einen eigenen Namen, damit das Menü die beiden unterscheiden kann."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Μια άλλη εφαρμογή ονομάζεται ήδη %@. Δώστε σε αυτή ένα δικό της όνομα, ώστε το μενού να τις ξεχωρίζει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another app is already called %@. Give this one a name of its own, so that the menu tells them apart."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otra app ya se llama %@. Dale a esta un nombre propio, para que el menú las distinga."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "یک برنامهٔ دیگر از قبل %@ نام دارد. به این برنامه نامی جداگانه بدهید تا منو آن‌ها را از هم تشخیص دهد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Une autre app s’appelle déjà %@. Donnez à celle-ci un nom à elle, pour que le menu les distingue."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "יש כבר יישום אחר בשם %@. יש לתת ליישום הזה שם משלו, כדי שהתפריט יבדיל ביניהם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "किसी दूसरी ऐप का नाम पहले से %@ है। इस ऐप को अपना अलग नाम दें, ताकि मेनू में दोनों अलग पहचाने जा सकें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "App lain sudah bernama %@. Beri app ini nama sendiri, agar menu dapat membedakan keduanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un’altra app si chiama già %@. Dai a questa un nome suo, così il menu le distingue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "別の App がすでに %@ という名前です。メニューで区別できるように、この App には別の名前を付けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "다른 앱이 이미 %@(이)라는 이름을 사용하고 있습니다. 메뉴에서 구분할 수 있도록 이 앱에 고유한 이름을 지정하십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "दुसऱ्या ॲपचे नाव आधीच %@ आहे. मेनूमध्ये दोन्ही वेगळे ओळखता यावेत म्हणून या ॲपला स्वतःचे नाव द्या."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apl lain sudah bernama %@. Berikan apl ini nama sendiri supaya menu dapat membezakan kedua-duanya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Een andere app heet al %@. Geef deze een eigen naam, zodat het menu ze uit elkaar houdt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inna aplikacja nazywa się już %@. Nadaj tej własną nazwę, aby menu je rozróżniało."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Outro app já se chama %@. Dê a este um nome próprio, para que o menu os diferencie."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O altă aplicație se numește deja %@. Dați-i acesteia un nume propriu, ca meniul să le poată deosebi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Другое приложение уже называется %@. Дайте этому приложению собственное имя, чтобы меню их различало."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "வேறொரு ஆப்பின் பெயர் ஏற்கெனவே %@. மெனு இரண்டையும் பிரித்தறிய, இந்த ஆப்புக்குத் தனிப் பெயர் கொடுக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "needs_review",
            "value": "మరో యాప్ పేరు ఇప్పటికే %@. మెనూ రెండింటినీ వేరు చేసి చూపేలా, ఈ యాప్‌కు సొంత పేరు ఇవ్వండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "มีแอปอื่นชื่อ %@ อยู่แล้ว ให้ตั้งชื่อของแอปนี้ให้ต่างออกไป เพื่อให้เมนูแยกแยะทั้งสองได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Başka bir uygulamanın adı zaten %@. Menünün ikisini ayırt edebilmesi için bu uygulamaya kendine ait bir ad verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Інша програма вже називається %@. Дайте цій програмі власну назву, щоб меню їх розрізняло."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "کسی اور ایپ کا نام پہلے سے %@ ہے۔ اس ایپ کو اپنا الگ نام دیں تاکہ مینو دونوں میں فرق کر سکے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Một ứng dụng khác đã có tên %@. Hãy đặt cho ứng dụng này một tên riêng để menu phân biệt được hai ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已有另一个 App 名为 %@。请为这个 App 另起一个名称，以便菜单区分它们。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已有另一個 App 名為 %@。請為這個 App 另取一個名稱，以便選單區分它們。"
          }
        }
      }
    },
    "app.appNotFound": {
      "comment": "Message in the setup window after the person chose an application whose Info.plist has no bundle identifier. %1$@ is the name of the app. 'bundle identifier' as in app.appBundleID. Keep the quotation marks of the language around the name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏«%1$@» ليس تطبيقًا يستطيع Right Here العثور عليه، فليس له معرّف حزمة صالح للاستخدام."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” এমন অ্যাপ নয় যেটি Right Here খুঁজে পেতে পারে: এর কোনো ব্যবহারযোগ্য বান্ডল আইডেন্টিফায়ার নেই।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ ist keine App, die Right Here finden kann, denn sie hat keine verwendbare Bundle-ID."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «%1$@» δεν είναι εφαρμογή που το Right Here μπορεί να βρει: δεν έχει χρησιμοποιήσιμο αναγνωριστικό δέσμης."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” is not an app that Right Here can find: it has no usable bundle identifier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» no es una app que Right Here pueda encontrar: no tiene un identificador del paquete utilizable."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "‏«%1$@» برنامه‌ای نیست که Right Here بتواند آن را پیدا کند: شناسهٔ باندل قابل‌استفاده ندارد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » n’est pas une app que Right Here peut trouver : elle n’a pas d’identifiant de bundle utilisable."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏Right Here לא יכול למצוא את היישום ״%1$@״: אין לו מזהה חבילה שמיש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” एक ऐसा ऐप नहीं है जिसे Right Here ढूँढ सके: इसमें कोई उपयोग योग्य बंडल आइडेंटिफ़ायर नहीं है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” bukan app yang bisa ditemukan oleh Right Here karena tidak memiliki pengenal bundel yang bisa digunakan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” non è un’app che Right Here può trovare: non ha un identificatore bundle utilizzabile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」は、Right Here が見つけられる App ではありません。利用可能なバンドル ID がないためです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here가 “%1$@” 앱을 찾을 수 없습니다. 사용할 수 있는 번들 식별자가 없습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” हे असे ॲप नाही जे Right Here शोधू शकेल: त्याला वापरण्यायोग्य बंडल आयडेंटिफायर नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” bukan aplikasi yang boleh ditemui oleh Right Here: ia tidak mempunyai pengecam pakej yang boleh digunakan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@” is geen app die Right Here kan vinden: hij heeft geen bruikbare bundel-ID."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here nie może znaleźć aplikacji „%1$@”: nie ma ona prawidłowego identyfikatora pakietu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” não é um app que o Right Here consegue encontrar: ele não tem identificador do pacote utilizável."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@” nu este o aplicație pe care Right Here o poate găsi: nu are identificator de pachet utilizabil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here не может найти приложение «%1$@»: у него нет пригодного идентификатора пакета."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” என்பது Right Here கண்டறியக்கூடிய செயலி அல்ல: அதற்கு பயன்படுத்தக்கூடிய பண்டில் அடையாளங்காட்டி இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” అనేది Right Here కనుగొనగల యాప్ కాదు: దానికి ఉపయోగించదగిన బండిల్ ఐడెంటిఫైయర్ లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” ไม่ใช่แอปที่ Right Here ค้นหาได้: แอปนี้ไม่มี Bundle identifier ที่ใช้งานได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”, Right Here’in bulabileceği bir uygulama değil: kullanılabilir bir paket tanıtıcısı yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here не може знайти програму «%1$@»: вона не має придатного ідентифікатора пакета."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "‏“%1$@” ایسی ایپ نہیں ہے جسے Right Here ڈھونڈ سکے: اس میں قابلِ استعمال بنڈل شناخت کنندہ نہیں ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” không phải là ứng dụng mà Right Here có thể tìm thấy: ứng dụng này không có mã định danh gói dùng được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”不是 Right Here 能找到的 App：它没有可用的 Bundle 标识符。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」不是 Right Here 能找到的 App：它沒有可用的 Bundle 識別碼。"
          }
        }
      }
    },
    "app.appRemove": {
      "comment": "Button at the bottom of the page of an app that the person added: it deletes the entry from the config (the app itself stays installed). Title-case in English like a macOS button. Same pattern as the glossary entries app.presetRemove and app.templateRemove.",
