    "app.placementWindowOnly": {
      "comment": "Warning on the Overview page. %@ is the name of the terminal (for example Terminal). That terminal cannot open tabs or splits, but the config file asks for one. Keep the %@.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏التطبيق %@ يفتح دائمًا نافذة جديدة، لذلك لا أثر لطريقة الفتح المحددة في ملف الإعداد لديك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ সব সময় নতুন উইন্ডো খোলে, তাই কনফিগারেশন ফাইলে থাকা খোলার স্থানের কোনো প্রভাব নেই।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ öffnet immer ein neues Fenster, daher hat die Angabe zur Öffnungsart in deiner Konfigurationsdatei keine Wirkung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %@ ανοίγει πάντα νέο παράθυρο, γι’ αυτό η ρύθμιση για τον τρόπο ανοίγματος στο αρχείο ρυθμίσεων δεν έχει καμία επίδραση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ always opens a new window, so the placement in your config has no effect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ siempre abre una ventana nueva, así que el modo de apertura de tu archivo de configuración no tiene efecto."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%@ همیشه یک پنجرهٔ تازه باز می‌کند، پس محلی که در پیکربندی شما تعیین شده، بی‌اثر است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ouvre toujours une nouvelle fenêtre, si bien que l’emplacement défini dans votre configuration n’a aucun effet."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%@ פותח תמיד חלון חדש, ולכן המיקום שנקבע בקובץ התצורה לא משפיע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ हमेशा एक नई विंडो खोलता है, इसलिए आपकी कॉन्फ़िगरेशन फ़ाइल में दी गई जगह का कोई असर नहीं होता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ selalu membuka jendela baru, sehingga penempatan dalam file konfigurasi Anda tidak berpengaruh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ apre sempre una nuova finestra, quindi l’impostazione di apertura nel file di configurazione non ha effetto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は常に新規ウインドウで開くため、設定ファイルの開く場所の指定は効果がありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 앱은 항상 새로운 윈도우를 열므로 설정 파일의 열기 위치 설정이 적용되지 않습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ नेहमी नवीन विंडो उघडते, त्यामुळे तुमच्या कॉन्फिगरेशन फाइलमधील उघडण्याच्या जागेचा परिणाम होत नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sentiasa membuka tetingkap baharu, jadi penempatan dalam fail konfigurasi anda tidak memberi kesan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ opent altijd een nieuw venster, dus de plaatsing in het configuratiebestand heeft geen effect."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ zawsze otwiera nowe okno, więc ustawienie miejsca otwarcia w pliku konfiguracji nie ma wpływu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sempre abre uma nova janela, então o local de abertura no arquivo de configuração não tem efeito."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ deschide întotdeauna o fereastră nouă, așa că setarea de amplasare din fișierul de configurare nu are efect."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ всегда открывает новое окно, поэтому размещение, заданное в файле конфигурации, не действует."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ எப்போதும் புதிய சாளரத்தையே திறக்கும்; அதனால் உங்கள் உள்ளமைவில் உள்ள திறக்கும் இடம் எந்த விளைவையும் ஏற்படுத்தாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ఎల్లప్పుడూ కొత్త విండోనే తెరుస్తుంది, కాబట్టి మీ కాన్ఫిగరేషన్ ఫైల్‌లోని తెరిచే చోటుకు ఎలాంటి ప్రభావం ఉండదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ จะเปิดหน้าต่างใหม่เสมอ ตำแหน่งการเปิดที่ตั้งไว้ในไฟล์การกำหนดค่าของคุณจึงไม่มีผล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ her zaman yeni pencere açar, bu yüzden yapılandırma dosyanızdaki açılış yerinin hiçbir etkisi olmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ завжди відкриває нове вікно, тому місце відкриття, вказане у вашому файлі конфігурації, не діє."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%@ ہمیشہ نئی ونڈو کھولتا ہے، اس لیے کنفیگریشن فائل میں درج کھلنے کی جگہ کا کوئی اثر نہیں ہوتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ luôn mở cửa sổ mới, nên cài đặt vị trí mở trong tệp cấu hình của bạn không có tác dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 总是打开新窗口，因此配置文件中的打开位置设置不起作用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 總是開啟新視窗，因此設定檔中的開啟位置設定不會生效。"
          }
        }
      }
    },
    "app.pluginCopied": {
      "comment": "Confirmation after the button app.copyPluginCommands was pressed. 'Claude Code' stays as it is.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نُسخت أوامر المكوّن الإضافي. الصقها في Claude Code."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্লাগইন কমান্ড কপি হয়েছে। Claude Code-এ পেস্ট করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Plug-in-Befehle kopiert. Füge sie in Claude Code ein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι εντολές του πρόσθετου αντιγράφηκαν. Επικολλήστε τις στο Claude Code."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plugin commands copied. Paste them into Claude Code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comandos del plugin copiados. Pégalos en Claude Code."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دستورهای افزونه کپی شد. آن‌ها را در Claude Code جای‌گذاری کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commandes du plugin copiées. Collez-les dans Claude Code."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פקודות התוסף הועתקו. יש להדביק אותן ב-Claude Code."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्लगइन कमांड कॉपी हो गईं। उन्हें Claude Code में पेस्ट करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perintah plugin disalin. Tempelkan ke Claude Code."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Comandi del plugin copiati. Incollali in Claude Code."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プラグインのコマンドをコピーしました。Claude Code にペーストしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플러그인 명령을 복사했습니다. Claude Code에 붙여넣으십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्लगइन कमांड्स कॉपी झाल्या. त्या Claude Code मध्ये पेस्ट करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perintah pemalam disalin. Tampalkannya dalam Claude Code."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plug-incommando’s gekopieerd. Plak ze in Claude Code."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skopiowano polecenia wtyczki. Wklej je w Claude Code."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comandos do plug-in copiados. Cole-os no Claude Code."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Comenzile pluginului au fost copiate. Lipiți-le în Claude Code."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Команды плагина скопированы. Вставьте их в Claude Code."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "செருகுநிரல் கட்டளைகள் நகலெடுக்கப்பட்டன. அவற்றை Claude Code-இல் ஒட்டவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్లగిన్ ఆదేశాలు కాపీ చేయబడ్డాయి. వాటిని Claude Code లో అతికించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คัดลอกคำสั่งปลั๊กอินแล้ว วางลงใน Claude Code"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eklenti komutları kopyalandı. Bunları Claude Code’a yapıştırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Команди плагіна скопійовано. Вставте їх у Claude Code."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پلگ ان کمانڈز کاپی ہو گئیں۔ انہیں Claude Code میں پیسٹ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã sao chép lệnh plugin. Hãy dán chúng vào Claude Code."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "插件命令已拷贝。请将其粘贴到 Claude Code 中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "外掛程式指令已拷貝。請將其貼到 Claude Code 中。"
          }
        }
      }
    },
