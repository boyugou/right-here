          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พรอมต์ของพรีเซ็ต “%@” พิมพ์ลงในเทอร์มินัลไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” adlı ön ayarın istemi bir terminale yazılamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Промпт пресету «%@» не можна ввести в термінал."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پری سیٹ “%@” کا پرامپٹ ٹرمینل میں ٹائپ نہیں کیا جا سکتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể gõ lời nhắc của mẫu “%@” vào terminal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
