    "doctor.agent.notFound": {
      "comment": "Detail line of a check in the setup window's Details list; it follows the check's title, so it is a fragment with no final period. %@ is the command that starts an AI agent, for example claude. A login shell is the shell the person's terminal starts.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُعثر على `%@` في مكوّن Shell الخاص بالدخول لديك"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার লগইন শেলে `%@` পাওয়া যায়নি"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "`%@` wurde in deiner Login-Shell nicht gefunden"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "δεν βρέθηκε το `%@` στο κέλυφος εισόδου σας"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "`%@` is not found in your login shell"
          }
