    "toolbar.tooltip": {
      "comment": "Tooltip of the Finder toolbar button.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فتح هنا، نسخ مسار، تشغيل وكيل"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখানে খুলুন, পাথ কপি করুন, এজেন্ট চালু করুন"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier öffnen, Pfad kopieren, Agenten starten"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άνοιγμα εδώ, αντιγραφή διαδρομής, εκκίνηση πράκτορα"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open here, copy a path, start an agent"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir aquí, copiar una ruta, iniciar un agente"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "باز کردن در اینجا، کپی مسیر، اجرای عامل"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir ici, copier un chemin, lancer un agent"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתיחה כאן, העתקת נתיב, הפעלת סוכן"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ खोलें, पाथ कॉपी करें, एजेंट शुरू करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka di sini, salin jalur, jalankan agen"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri qui, copia un percorso, avvia un agente"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここで開く、パスをコピー、エージェントを起動"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서 열기, 경로 복사, 에이전트 시작"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "येथे उघडा, पाथ कॉपी करा, एजंट सुरू करा"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka di sini, salin laluan, mulakan ejen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier openen, pad kopiëren, agent starten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz tutaj, skopiuj ścieżkę, uruchom agenta"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir aqui, copiar um caminho, iniciar um agente"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschideți aici, copiați o cale, porniți un agent"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть здесь, скопировать путь, запустить агента"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இங்கே திற, பாதையை நகலெடு, முகவரைத் தொடங்கு"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇక్కడ తెరవండి, పాత్‌ను కాపీ చేయండి, ఏజెంట్‌ను ప్రారంభించండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดที่นี่ คัดลอกเส้นทาง เริ่มเอเจนต์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada aç, yolu kopyala, ajan başlat"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрити тут, скопіювати шлях, запустити агента"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہاں کھولیں، پاتھ کاپی کریں، ایجنٹ شروع کریں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở tại đây, sao chép đường dẫn, khởi chạy tác tử"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此处打开、拷贝路径、启动智能体"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在此處打開、拷貝路徑、啟動代理程式"
          }
        }
      }
    },
    "trust.appOpened": {
      "comment": "On the card of a config change that an AI assistant proposed: why the person has to approve this setting. Lower-case start: it follows the setting's name and a colon, e.g. 'app.*.bundle_id: it decides which app is opened'.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحدّد أيّ تطبيق يُفتح"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
