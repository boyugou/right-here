        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有啟用任何代理程式；請在 general.agents 中列出一個，或在預設組中指定一個代理程式。"
          }
        }
      }
    },
    "refusal.preset.noPromptArgument": {
      "comment": "Why an action did nothing, shown in the alert after a click in Finder (and, in English, by the command line). %1$@ is an AI agent's name; %2$@ a section of the config; %3$@ and %4$@ are values of prompt_arg. prompt_arg is a word of the config: keep it.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من غير المعروف ما إذا كان %1$@ يتلقّى الموجّه الأول. اضبط prompt_arg في %2$@ (%3$@ أو خيارًا مثل %4$@)."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ প্রথম প্রম্পট নেয় কি না, তা জানা নেই। %2$@-এ prompt_arg সেট করুন (%3$@ বা একটি ফ্ল্যাগ, যেমন %4$@)।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von %1$@ ist nicht bekannt, ob es einen ersten Prompt annimmt. Setze prompt_arg in %2$@ (%3$@ oder ein Flag wie %4$@)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν είναι γνωστό αν ο πράκτορας %1$@ δέχεται μια πρώτη προτροπή. Ορίστε το prompt_arg στο %2$@ (%3$@ ή μια σημαία όπως %4$@)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is not known to take a first prompt. Set prompt_arg in %2$@ (%3$@ or a flag such as %4$@)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se sabe si %1$@ recibe un primer prompt. Define prompt_arg en %2$@ (%3$@ o una opción como %4$@)."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "معلوم نیست که %1$@ پرامپت اول را می‌پذیرد یا نه. prompt_arg را در %2$@ تنظیم کنید (%3$@ یا گزینه‌ای مانند %4$@)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On ne sait pas si %1$@ accepte un premier prompt. Définissez prompt_arg dans %2$@ (%3$@ ou une option comme %4$@)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ידוע אם %1$@ מקבל הנחיה ראשונה. יש להגדיר את prompt_arg ב-%2$@ (%3$@ או דגל כמו %4$@)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह पता नहीं है कि %1$@ पहला प्रॉम्प्ट लेता है या नहीं। %2$@ में prompt_arg सेट करें (%3$@ या %4$@ जैसा कोई फ़्लैग)।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak diketahui apakah %1$@ menerima prompt pertama. Atur prompt_arg di %2$@ (%3$@ atau opsi seperti %4$@)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non risulta che %1$@ accetti un primo prompt. Imposta prompt_arg in %2$@ (%3$@ o un’opzione come %4$@)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@が最初のプロンプトを受け取れるかどうかは不明です。%2$@でprompt_argを設定してください（%3$@、または%4$@のようなオプション）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 에이전트가 첫 프롬프트를 받는지 알 수 없습니다. %2$@ 섹션에서 prompt_arg를 설정하십시오(%3$@ 또는 %4$@ 같은 옵션)."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ पहिला प्रॉम्प्ट घेतो की नाही हे माहीत नाही. %2$@ मध्ये prompt_arg सेट करा (%3$@ किंवा %4$@ सारखा फ्लॅग)."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak diketahui sama ada %1$@ menerima gesaan pertama. Tetapkan prompt_arg dalam %2$@ (%3$@ atau bendera seperti %4$@)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Van %1$@ is niet bekend of hij een eerste prompt aanneemt. Stel prompt_arg in in %2$@ (%3$@ of een vlag zoals %4$@)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie wiadomo, czy agent %1$@ przyjmuje pierwszy prompt. Ustaw prompt_arg w sekcji %2$@ (%3$@ lub flagę, na przykład %4$@)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não se sabe se o %1$@ aceita um primeiro prompt. Defina prompt_arg em %2$@ (%3$@ ou uma flag como %4$@)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu se știe dacă %1$@ acceptă un prompt inițial. Setați prompt_arg în %2$@ (%3$@ sau o opțiune precum %4$@)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неизвестно, принимает ли агент «%1$@» первый промпт. Задайте prompt_arg в разделе %2$@ (%3$@ или флаг, например %4$@)."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ முதல் ப்ராம்ப்ட்டை ஏற்குமா என்பது தெரியவில்லை. %2$@ இல் prompt_arg ஐ அமைக்கவும் (%3$@, அல்லது %4$@ போன்ற ஒரு கொடி)."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ మొదటి ప్రాంప్ట్‌ను స్వీకరిస్తుందో లేదో తెలియదు. %2$@ లో prompt_arg ను సెట్ చేయండి (%3$@ లేదా %4$@ వంటి ఫ్లాగ్)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ทราบว่า %1$@ รับพรอมต์แรกได้หรือไม่ ตั้งค่า prompt_arg ใน %2$@ (%3$@ หรือแฟล็ก เช่น %4$@)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ajanının ilk istemi alıp almadığı bilinmiyor. %2$@ içinde prompt_arg ayarlayın (%3$@ ya da bir bayrak, örneğin %4$@)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Невідомо, чи приймає агент %1$@ перший промпт. Задайте prompt_arg у розділі %2$@ (%3$@ або параметр на кшталт %4$@)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ معلوم نہیں کہ %1$@ پہلا پرامپٹ لیتا ہے یا نہیں۔ %2$@ میں prompt_arg سیٹ کریں (%3$@ یا کوئی فلیگ، جیسے %4$@)۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không rõ %1$@ có nhận lời nhắc đầu tiên hay không. Hãy đặt prompt_arg trong %2$@ (%3$@ hoặc một cờ như %4$@)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不确定 %1$@ 是否接受第一个提示词。请在 %2$@ 中设置 prompt_arg（%3$@，或 %4$@ 这样的标志）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不確定 %1$@ 是否接受第一個提示詞。請在 %2$@ 中設定 prompt_arg（%3$@，或 %4$@ 這類旗標）。"
          }
        }
      }
    },
    "refusal.preset.permissionFlag": {
      "comment": "Why an action did nothing, shown in the alert after a click in Finder (and, in English, by the command line). %1$@ is an AI agent's name, %2$@ a command-line flag.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدأ %1$@ بالخيار %2$@ الذي يوقف طلبات الإذن الخاصة به، بينما يُبقي الإعداد المسبق للوكيل طلبات الإذن مفعّلة لأن موجّهه يحمل أسماء ملفات. أزل هذا الخيار من أمر الوكيل ووسيطاته (يضيفه إعداد الأذونات عند التشغيل العادي)، أو اجعل الإعداد المسبق للوكيل يستخدم وكيلًا آخر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ দিয়ে শুরু হয়, যা এর অনুমতি চাওয়ার প্রশ্ন বন্ধ করে দেয়, কিন্তু এজেন্ট প্রিসেট অনুমতি চাওয়ার প্রশ্ন চালু রাখে, কারণ এর প্রম্পটে ফাইলের নাম থাকে। এজেন্টের কমান্ড ও আর্গুমেন্ট থেকে ফ্ল্যাগটি সরিয়ে দিন (সাধারণভাবে শুরু করার সময় অনুমতির সেটিং এটি যোগ করে), অথবা এজেন্ট প্রিসেটটিকে অন্য একটি এজেন্ট দিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ wird mit %2$@ gestartet, das seine Berechtigungsabfragen abschaltet, doch eine Agent-Voreinstellung lässt die Berechtigungsabfragen eingeschaltet, weil ihr Prompt Dateinamen enthält. Entferne das Flag aus Befehl und Argumenten des Agenten (die Berechtigungseinstellung fügt es bei normalen Starts hinzu) oder gib der Agent-Voreinstellung einen anderen Agenten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο πράκτορας %1$@ ξεκινά με %2$@, που απενεργοποιεί τις ερωτήσεις του για άδειες, ενώ μια προεπιλογή πράκτορα κρατά ενεργές τις ερωτήσεις για άδειες, επειδή η προτροπή της περιέχει ονόματα αρχείων. Αφαιρέστε τη σημαία από την εντολή και τα ορίσματα του πράκτορα (η ρύθμιση αδειών την προσθέτει στις απλές εκκινήσεις) ή αναθέστε την προεπιλογή πράκτορα σε άλλον πράκτορα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is started with %2$@, which switches its permission prompts off, and a preset keeps them on because its prompt carries file names. Take the flag out of its command and arguments (the permission setting adds it for plain starts), or give the preset another agent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ se inicia con %2$@, que desactiva sus solicitudes de permiso, y un preajuste de agente mantiene activadas las solicitudes de permiso porque su prompt lleva nombres de archivo. Quita esa opción del comando y de los argumentos del agente (el ajuste de permisos la añade en los inicios normales) o asigna otro agente al preajuste de agente."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%1$@ با %2$@ اجرا می‌شود که درخواست‌های مجوزش را خاموش می‌کند، اما پیش‌تنظیم عامل درخواست‌های مجوز را روشن نگه می‌دارد، چون پرامپتش نام فایل‌ها را در خود دارد. این گزینه را از دستور و آرگومان‌های عامل بردارید (تنظیم مجوز آن را برای اجراهای معمولی اضافه می‌کند)، یا عامل دیگری به پیش‌تنظیم عامل بدهید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ est lancé avec %2$@, qui désactive ses demandes d’autorisation, alors qu’un préréglage d’agent garde les demandes d’autorisation activées, car son prompt contient des noms de fichiers. Retirez cette option de la commande et des arguments de l’agent (le réglage d’autorisation l’ajoute pour les lancements simples), ou attribuez un autre agent au préréglage d’agent."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%1$@ מופעל עם %2$@, שמכבה את בקשות ההרשאה שלו, אבל הגדרה מוכנה לסוכן משאירה את בקשות ההרשאה פעילות, כי ההנחיה שלה כוללת שמות קבצים. יש להסיר את הדגל מהפקודה ומהארגומנטים של הסוכן (הגדרת ההרשאות מוסיפה אותו בהפעלות רגילות), או להקצות להגדרה המוכנה סוכן אחר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ के साथ शुरू होता है, जो उसके अनुमति वाले सवाल बंद कर देता है, जबकि एजेंट प्रीसेट अनुमति वाले सवाल चालू रखता है, क्योंकि उसके प्रॉम्प्ट में फ़ाइलों के नाम होते हैं। इस फ़्लैग को एजेंट की कमांड और आर्ग्युमेंट से हटाएँ (सामान्य रूप से शुरू करने पर अनुमति वाली सेटिंग इसे जोड़ देती है), या एजेंट प्रीसेट को कोई दूसरा एजेंट दें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ dijalankan dengan %2$@, yang mematikan permintaan izinnya, sedangkan preset agen tetap menyalakan permintaan izin karena prompt-nya memuat nama file. Hapus opsi tersebut dari perintah dan argumen agen (pengaturan izin menambahkannya saat agen dimulai biasa), atau berikan agen lain untuk preset agen tersebut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ viene avviato con %2$@, che disattiva le sue richieste di permesso, mentre un preset mantiene attive le richieste di permesso perché il suo prompt contiene nomi di file. Togli l’opzione dal comando e dagli argomenti dell’agente (per gli avvii normali la aggiunge l’impostazione delle richieste di permesso), oppure assegna il preset a un altro agente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@は%2$@を付けて起動されます。このオプションは許可の確認をオフにしますが、プリセットはプロンプトにファイル名が含まれるため、許可の確認をオンのままにします。エージェントのコマンドと引数からこのオプションを取り除くか（通常の起動では許可の確認の設定がこのオプションを追加します）、プリセットに別のエージェントを指定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 에이전트는 %2$@ 옵션을 붙여 시작되는데, 이 옵션은 권한 요청을 끕니다. 그런데 프리셋은 프롬프트에 파일 이름이 들어가므로 권한 요청을 켜 둡니다. 에이전트의 명령과 인수에서 이 옵션을 빼거나(일반 시작에서는 권한 요청 설정이 이 옵션을 추가합니다), 프리셋에 다른 에이전트를 지정하십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ एजंट %2$@ सह सुरू होतो, जो त्याची परवानगी विचारणा बंद करतो, आणि प्रीसेट परवानगी विचारणा चालू ठेवतो कारण त्याच्या प्रॉम्प्टमध्ये फाइलची नावे असतात. हा फ्लॅग एजंटच्या कमांड आणि आर्ग्युमेंट्समधून काढा (साध्या सुरुवातीसाठी परवानगी विचारणेची सेटिंग तो जोडते), किंवा प्रीसेटला दुसरा एजंट द्या."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ dimulakan dengan %2$@, yang menyahaktifkan gesaan kebenarannya, sedangkan praset ejen mengekalkan gesaan kebenaran aktif kerana gesaannya mengandungi nama fail. Keluarkan bendera itu daripada perintah dan argumen ejen (seting gesaan kebenaran menambahnya untuk permulaan biasa), atau berikan praset itu ejen lain."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ wordt gestart met %2$@, dat de toestemmingsvragen van de agent uitschakelt, en een agentvoorinstelling houdt de toestemmingsvragen aan omdat de prompt ervan bestandsnamen bevat. Haal de vlag uit het commando en de argumenten van de agent (de instelling voor toestemmingsvragen voegt hem toe bij een gewone start), of geef de agentvoorinstelling een andere agent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent %1$@ jest uruchamiany z flagą %2$@, która wyłącza jego pytania o uprawnienia, a gotowy prompt utrzymuje pytania o uprawnienia włączone, ponieważ jego treść zawiera nazwy plików. Usuń tę flagę z polecenia i argumentów agenta (przy zwykłym uruchamianiu dodaje ją ustawienie pytań o uprawnienia) albo przypisz gotowy prompt innemu agentowi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O %1$@ é iniciado com %2$@, que desativa os pedidos de permissão dele, e uma predefinição de agente mantém os pedidos de permissão ativados porque o prompt dela contém nomes de arquivos. Tire a flag do comando e dos argumentos do agente (o ajuste de pedidos de permissão a adiciona quando o agente é iniciado normalmente) ou atribua outro agente à predefinição."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ este pornit cu %2$@, care îi dezactivează solicitările de permisiune, iar o presetare pentru agent păstrează solicitările de permisiune active, deoarece promptul ei conține nume de fișiere. Scoateți opțiunea din comanda și argumentele agentului (setarea pentru solicitările de permisiune o adaugă la pornirile obișnuite) sau atribuiți presetării alt agent."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Агент «%1$@» запускается с флагом %2$@, который отключает его запросы разрешений, а пресет агента оставляет запросы разрешений включенными, потому что его промпт содержит имена файлов. Уберите этот флаг из команды и аргументов агента (для обычного запуска его добавляет настройка запросов разрешений) или назначьте пресету другого агента."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ முகவர் %2$@ உடன் தொடங்கப்படுகிறது, அது அதன் அனுமதிக் கேள்விகளை அணைக்கிறது; ஆனால் முன்னமைவின் ப்ராம்ப்ட்டில் கோப்புப் பெயர்கள் இருப்பதால், முன்னமைவு அனுமதிக் கேள்விகளை இயக்கத்திலேயே வைத்திருக்கும். முகவரின் கட்டளையிலிருந்தும் வாதங்களிலிருந்தும் அந்தக் கொடியை நீக்கவும் (சாதாரணத் தொடக்கங்களுக்கு அனுமதி அமைப்பு அதைச் சேர்க்கும்), அல்லது முன்னமைவுக்கு வேறொரு முகவரைக் கொடுக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ను %2$@ తో ప్రారంభిస్తారు, అది దాని అనుమతి ప్రశ్నలను ఆఫ్ చేస్తుంది; కానీ ప్రీసెట్ ప్రాంప్ట్‌లో ఫైల్ పేర్లు ఉంటాయి కాబట్టి, ప్రీసెట్ అనుమతి ప్రశ్నలను ఆన్‌లోనే ఉంచుతుంది. ఏజెంట్ ఆదేశం మరియు ఆర్గ్యుమెంట్‌ల నుండి ఆ ఫ్లాగ్‌ను తీసివేయండి (సాధారణ ప్రారంభాలకు అనుమతి సెట్టింగ్ దాన్ని జోడిస్తుంది), లేదా ప్రీసెట్‌కు మరో ఏజెంట్‌ను ఇవ్వండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ เริ่มทำงานด้วย %2$@ ซึ่งปิดการถามขออนุญาตของเอเจนต์ แต่พรีเซ็ตจะเปิดการถามขออนุญาตไว้เสมอเพราะพรอมต์ของพรีเซ็ตมีชื่อไฟล์ เอาแฟล็กนั้นออกจากคำสั่งและอาร์กิวเมนต์ของเอเจนต์ (การตั้งค่าการขออนุญาตจะเพิ่มแฟล็กนี้ให้เองเมื่อเริ่มแบบปกติ) หรือกำหนดเอเจนต์อื่นให้พรีเซ็ตนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, izin istemlerini kapatan %2$@ ile başlatılıyor; ancak ön ayarın istemi dosya adları içerdiği için ön ayar izin istemlerini açık tutar. Bayrağı ajanın komutundan ve argümanlarından çıkarın (izin ayarı onu normal başlatmalar için ekler) ya da ön ayara başka bir ajan atayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Агент %1$@ запускається з параметром %2$@, що вимикає його запити на дозвіл, а пресет агента залишає запити на дозвіл увімкненими, бо його промпт містить назви файлів. Приберіть цей параметр із команди та аргументів агента (налаштування дозволів додає його для звичайних запусків) або призначте пресету іншого агента."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%1$@ کو %2$@ کے ساتھ شروع کیا جاتا ہے، جو اس کے اجازت کے پرامپٹ بند کر دیتا ہے، جبکہ پری سیٹ اجازت کے پرامپٹ کھلے رکھتا ہے کیونکہ اس کے پرامپٹ میں فائلوں کے نام ہوتے ہیں۔ یہ فلیگ ایجنٹ کی کمانڈ اور آرگیومنٹس سے نکال دیں (عام طریقے سے شروع کرنے کے لیے اجازت کی سیٹنگ اسے خود شامل کرتی ہے)، یا پری سیٹ کو کوئی اور ایجنٹ دیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ được khởi chạy với %2$@, cờ này tắt lời nhắc xin phép của nó, trong khi mẫu lời nhắc luôn giữ lời nhắc xin phép bật vì lời nhắc của mẫu có chứa tên tệp. Hãy bỏ cờ đó khỏi lệnh và đối số của tác tử (cài đặt quyền sẽ thêm cờ này cho các lần khởi chạy thông thường), hoặc giao mẫu lời nhắc này cho một tác tử khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 以 %2$@ 启动，这会关闭其权限提示；而预设的提示词中包含文件名，所以预设会保持权限提示开启。请从该智能体的命令和参数中去掉这个标志（权限设置会在普通启动时自动添加它），或为该预设指定其他智能体。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 以 %2$@ 啟動，這會關閉其權限提示；而預設組的提示詞中包含檔案名稱，所以預設組會保持權限提示開啟。請從該代理程式的指令和引數中移除這個旗標（權限設定會在一般啟動時自動加入它），或為該預設組指定其他代理程式。"
          }
        }
      }
    },
    "refusal.preset.shellSyntax": {
      "comment": "Why an action did nothing, shown in the alert after a click in Finder (and, in English, by the command line). %@ is an AI agent's name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتوي أمر %@ على صياغة Shell لا يستطيع Right Here قراءة نتيجتها ($، أو علامة اقتباس عكسية، أو {a,b}، أو علامة اقتباس غير مغلقة)، لذا لا يمكنه معرفة ما إذا كان الأمر يوقف طلبات الإذن، بينما يُبقي الإعداد المسبق للوكيل طلبات الإذن مفعّلة لأن موجّهه يحمل أسماء ملفات. اكتب الأمر بكلمات عادية وعلامات اقتباس."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-এর কমান্ডে এমন শেল সিনট্যাক্স আছে যার ফলাফল Right Here পড়তে পারে না ($, একটি ব্যাকটিক, {a,b} বা বন্ধ না করা উদ্ধৃতিচিহ্ন), তাই কমান্ডটি অনুমতি চাওয়ার প্রশ্ন বন্ধ করে কি না তা বোঝা যায় না, আর এজেন্ট প্রিসেট অনুমতি চাওয়ার প্রশ্ন চালু রাখে, কারণ এর প্রম্পটে ফাইলের নাম থাকে। কমান্ডটি সাধারণ শব্দ ও উদ্ধৃতিচিহ্ন দিয়ে লিখুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Befehl von %@ enthält Shell-Syntax, deren Ergebnis Right Here nicht lesen kann ($, ein Backtick, {a,b} oder ein nicht geschlossenes Anführungszeichen), daher lässt sich nicht feststellen, ob er die Berechtigungsabfragen abschaltet, und eine Agent-Voreinstellung lässt die Berechtigungsabfragen eingeschaltet, weil ihr Prompt Dateinamen enthält. Schreibe den Befehl als einfache Wörter und Anführungszeichen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εντολή του %@ έχει σύνταξη κελύφους της οποίας το αποτέλεσμα δεν μπορεί να διαβάσει το Right Here ($, ανάποδο εισαγωγικό, {a,b} ή εισαγωγικό που δεν κλείνει), οπότε δεν μπορεί να καταλάβει αν απενεργοποιεί τις ερωτήσεις για άδειες, ενώ μια προεπιλογή πράκτορα κρατά ενεργές τις ερωτήσεις για άδειες, επειδή η προτροπή της περιέχει ονόματα αρχείων. Γράψτε την εντολή με απλές λέξεις και εισαγωγικά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The command of %@ has shell syntax whose result Right Here cannot read ($, a backtick, {a,b} or a quote that is not closed), so it cannot tell whether it switches the permission prompts off, and a preset keeps them on because its prompt carries file names. Write the command as plain words and quotes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El comando de %@ tiene sintaxis de shell cuyo resultado Right Here no puede leer ($, un acento grave, {a,b} o una comilla sin cerrar), así que no puede saber si desactiva las solicitudes de permiso, y un preajuste de agente mantiene activadas las solicitudes de permiso porque su prompt lleva nombres de archivo. Escribe el comando con palabras sencillas y comillas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دستور %@ نحو پوسته‌ای دارد که Right Here نمی‌تواند نتیجه‌اش را بخواند ($، بک‌تیک، {a,b} یا گیومه‌ای که بسته نشده)، بنابراین نمی‌تواند تشخیص دهد که این دستور درخواست‌های مجوز را خاموش می‌کند یا نه، اما پیش‌تنظیم عامل درخواست‌های مجوز را روشن نگه می‌دارد، چون پرامپتش نام فایل‌ها را در خود دارد. دستور را با واژه‌های ساده و گیومه بنویسید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La commande de %@ contient une syntaxe shell dont Right Here ne peut pas lire le résultat ($, un accent grave, {a,b} ou un guillemet non fermé) ; il ne peut donc pas savoir si elle désactive les demandes d’autorisation, alors qu’un préréglage d’agent garde les demandes d’autorisation activées, car son prompt contient des noms de fichiers. Écrivez la commande avec de simples mots et des guillemets."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפקודה של %@ כוללת תחביר מעטפת ש-Right Here לא יכול לקרוא את התוצאה שלו ($, גרש הפוך, {a,b} או מירכאה שלא נסגרה), ולכן אי אפשר לדעת אם היא מכבה את בקשות ההרשאה, והגדרה מוכנה לסוכן משאירה את בקשות ההרשאה פעילות, כי ההנחיה שלה כוללת שמות קבצים. יש לכתוב את הפקודה כמילים פשוטות ומירכאות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ की कमांड में ऐसा शेल सिंटैक्स है जिसका नतीजा Right Here नहीं पढ़ सकता ($, बैकटिक, {a,b} या ऐसा उद्धरण चिह्न जो बंद नहीं हुआ), इसलिए वह नहीं बता सकता कि यह कमांड अनुमति वाले सवाल बंद करती है या नहीं, जबकि एजेंट प्रीसेट अनुमति वाले सवाल चालू रखता है, क्योंकि उसके प्रॉम्प्ट में फ़ाइलों के नाम होते हैं। कमांड को सादे शब्दों और उद्धरण चिह्नों में लिखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perintah %@ berisi sintaks shell yang hasilnya tidak dapat dibaca Right Here ($, backtick, {a,b}, atau tanda kutip yang tidak ditutup), jadi Right Here tidak dapat mengetahui apakah perintah itu mematikan permintaan izin, sedangkan preset agen tetap menyalakan permintaan izin karena prompt-nya memuat nama file. Tulis perintah sebagai kata biasa dan tanda kutip."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il comando di %@ contiene una sintassi della shell il cui risultato Right Here non può leggere ($, un backtick, {a,b} o una virgoletta non chiusa), quindi non può stabilire se disattiva le richieste di permesso, mentre un preset mantiene attive le richieste di permesso perché il suo prompt contiene nomi di file. Scrivi il comando con semplici parole e virgolette."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@のコマンドには、Right Hereが結果を読み取れないシェル構文（$、バッククォート、{a,b}、閉じられていない引用符）が含まれているため、許可の確認がオフになるかどうかを判断できません。プリセットはプロンプトにファイル名が含まれるため、許可の確認をオンのままにします。コマンドは単純な単語と引用符だけで書いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 에이전트의 명령에 Right Here가 결과를 읽을 수 없는 셸 문법($, 백틱, {a,b}, 닫히지 않은 따옴표)이 있어, 이 명령이 권한 요청을 끄는지 알 수 없습니다. 그리고 프리셋은 프롬프트에 파일 이름이 들어가므로 권한 요청을 켜 둡니다. 명령을 일반 단어와 따옴표로만 작성하십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ एजंटच्या कमांडमध्ये अशी शेल सिंटॅक्स आहे जिचा परिणाम Right Here वाचू शकत नाही ($, बॅकटिक, {a,b} किंवा बंद न केलेले अवतरणचिन्ह), त्यामुळे ती परवानगी विचारणा बंद करते की नाही हे ठरवता येत नाही, आणि प्रीसेट परवानगी विचारणा चालू ठेवतो कारण त्याच्या प्रॉम्प्टमध्ये फाइलची नावे असतात. कमांड साधे शब्द आणि अवतरणचिन्हे वापरून लिहा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perintah %@ mengandungi sintaks cangkerang yang hasilnya tidak dapat dibaca oleh Right Here ($, backtick, {a,b} atau tanda petikan yang tidak ditutup), jadi Right Here tidak dapat menentukan sama ada perintah itu menyahaktifkan gesaan kebenaran, sedangkan praset ejen mengekalkan gesaan kebenaran aktif kerana gesaannya mengandungi nama fail. Tulis perintah itu sebagai perkataan biasa dan tanda petikan sahaja."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het commando van %@ bevat shellsyntaxis waarvan Right Here het resultaat niet kan lezen ($, een backtick, {a,b} of een aanhalingsteken dat niet is gesloten), dus Right Here kan niet bepalen of het de toestemmingsvragen uitschakelt, en een agentvoorinstelling houdt de toestemmingsvragen aan omdat de prompt ervan bestandsnamen bevat. Schrijf het commando als gewone woorden en aanhalingstekens."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Polecenie agenta %@ zawiera składnię powłoki, której wyniku Right Here nie potrafi odczytać ($, grawis, {a,b} lub niezamknięty cudzysłów), więc nie wiadomo, czy wyłącza ono pytania o uprawnienia, a gotowy prompt utrzymuje pytania o uprawnienia włączone, ponieważ jego treść zawiera nazwy plików. Zapisz polecenie jako zwykłe słowa i cudzysłowy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O comando de %@ tem uma sintaxe de shell cujo resultado o Right Here não consegue ler ($, um acento grave, {a,b} ou aspas não fechadas), então não é possível saber se ele desativa os pedidos de permissão, e uma predefinição de agente mantém os pedidos de permissão ativados porque o prompt dela contém nomes de arquivos. Escreva o comando só com palavras simples e aspas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Comanda agentului %@ conține sintaxă de shell al cărei rezultat Right Here nu îl poate citi ($, un backtick, {a,b} sau ghilimele neînchise), deci nu se poate stabili dacă dezactivează solicitările de permisiune, iar o presetare pentru agent păstrează solicitările de permisiune active, deoarece promptul ei conține nume de fișiere. Scrieți comanda doar cu cuvinte simple și ghilimele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Команда агента «%@» содержит синтаксис оболочки, результат которого Right Here не может прочитать ($, обратный апостроф, {a,b} или незакрытая кавычка), поэтому нельзя определить, отключает ли она запросы разрешений, а пресет агента оставляет запросы разрешений включенными, потому что его промпт содержит имена файлов. Запишите команду простыми словами и кавычками."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ இன் கட்டளையில், Right Here ஆல் முடிவைப் படிக்க முடியாத shell தொடரியல் உள்ளது ($, பின்மேற்கோள் குறி, {a,b} அல்லது மூடப்படாத மேற்கோள் குறி), எனவே அது அனுமதிக் கேள்விகளை அணைக்கிறதா என்பதை Right Here ஆல் அறிய முடியாது; முன்னமைவின் ப்ராம்ப்ட்டில் கோப்புப் பெயர்கள் இருப்பதால், முன்னமைவு அனுமதிக் கேள்விகளை இயக்கத்திலேயே வைத்திருக்கும். கட்டளையைச் சாதாரணச் சொற்களாலும் மேற்கோள் குறிகளாலும் மட்டும் எழுதவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ఆదేశంలో Right Here ఫలితాన్ని చదవలేని shell సింటాక్స్ ఉంది ($, బ్యాక్‌టిక్, {a,b} లేదా మూసివేయని కోట్), కాబట్టి అది అనుమతి ప్రశ్నలను ఆఫ్ చేస్తుందో లేదో Right Here తెలుసుకోలేకపోతుంది; ప్రీసెట్ ప్రాంప్ట్‌లో ఫైల్ పేర్లు ఉంటాయి కాబట్టి, ప్రీసెట్ అనుమతి ప్రశ్నలను ఆన్‌లోనే ఉంచుతుంది. ఆదేశాన్ని సాధారణ పదాలు మరియు కోట్స్‌తో మాత్రమే రాయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำสั่งของ %@ มีไวยากรณ์ของเชลล์ที่ Right Here อ่านผลลัพธ์ไม่ได้ ($, แบ็กทิก, {a,b} หรือเครื่องหมายคำพูดที่ไม่ได้ปิด) จึงบอกไม่ได้ว่าคำสั่งนี้ปิดการถามขออนุญาตหรือไม่ และพรีเซ็ตจะเปิดการถามขออนุญาตไว้เสมอเพราะพรอมต์ของพรีเซ็ตมีชื่อไฟล์ เขียนคำสั่งด้วยคำธรรมดาและเครื่องหมายคำพูดเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ajanının komutunda, Right Here’in sonucunu okuyamadığı kabuk sözdizimi var ($, ters tırnak, {a,b} veya kapatılmamış bir tırnak); bu yüzden komutun izin istemlerini kapatıp kapatmadığı anlaşılamıyor ve ön ayarın istemi dosya adları içerdiği için ön ayar izin istemlerini açık tutar. Komutu yalnızca düz sözcükler ve tırnaklarla yazın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Команда агента %@ містить синтаксис оболонки, результат якого Right Here не може прочитати ($, зворотний апостроф, {a,b} або незакриті лапки), тому неможливо визначити, чи вимикає вона запити на дозвіл, а пресет агента залишає запити на дозвіл увімкненими, бо його промпт містить назви файлів. Запишіть команду лише звичайними словами та лапками."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%@ کی کمانڈ میں ایسا شیل سنٹیکس ہے جس کا نتیجہ Right Here نہیں پڑھ سکتا ($، بیک ٹک، {a,b} یا بند نہ کیے گئے واوین)، اس لیے وہ یہ نہیں بتا سکتا کہ کمانڈ اجازت کے پرامپٹ بند کرتی ہے یا نہیں، جبکہ پری سیٹ اجازت کے پرامپٹ کھلے رکھتا ہے کیونکہ اس کے پرامپٹ میں فائلوں کے نام ہوتے ہیں۔ کمانڈ صرف سادہ الفاظ اور واوین سے لکھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lệnh của %@ có cú pháp shell mà Right Here không đọc được kết quả ($, dấu backtick, {a,b} hoặc dấu nháy chưa đóng), nên không thể biết lệnh có tắt lời nhắc xin phép hay không, trong khi mẫu lời nhắc luôn giữ lời nhắc xin phép bật vì lời nhắc của mẫu có chứa tên tệp. Hãy viết lệnh chỉ bằng các từ thông thường và dấu nháy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的命令包含 Right Here 无法读出结果的 shell 语法（$、反引号、{a,b} 或未闭合的引号），因此无法判断它是否会关闭权限提示；而预设的提示词中包含文件名，所以预设会保持权限提示开启。请只用普通单词和引号来写这条命令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的指令包含 Right Here 無法讀出結果的 shell 語法（$、反引號、{a,b} 或未閉合的引號），因此無法判斷它是否會關閉權限提示；而預設組的提示詞中包含檔案名稱，所以預設組會保持權限提示開啟。請只用一般字詞和引號來寫這條指令。"
          }
        }
      }
    },
    "refusal.preset.tooManyFiles": {
      "comment": "Why an action did nothing, shown in the alert after a click in Finder (and, in English, by the command line). %1$@ and %2$@ are numbers. max_files is a word of the config: keep it.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدد الملفات المحددة كبير جدًا: %1$@. يقبل هذا الإعداد المسبق للوكيل %2$@ على الأكثر (max_files)."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনেক বেশি ফাইল নির্বাচন করা হয়েছে: %1$@। এই এজেন্ট প্রিসেট সর্বাধিক %2$@টি ফাইল নেয় (max_files)।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Dateien sind ausgewählt: %1$@. Diese Agent-Voreinstellung nimmt höchstens %2$@ (max_files)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είναι επιλεγμένα πάρα πολλά αρχεία: %1$@. Αυτή η προεπιλογή πράκτορα δέχεται το πολύ %2$@ (max_files)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many files are selected: %1$@. This preset takes at most %2$@ (max_files)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay demasiados archivos seleccionados: %1$@. Este preajuste de agente admite como máximo %2$@ (max_files)."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تعداد فایل‌های انتخاب‌شده بیش از حد زیاد است: %1$@. این پیش‌تنظیم عامل حداکثر %2$@ فایل می‌پذیرد (max_files)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de fichiers sont sélectionnés : %1$@. Ce préréglage d’agent en accepte au plus %2$@ (max_files)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נבחרו יותר מדי קבצים: %1$@. הגדרה מוכנה זו מקבלת לכל היותר %2$@ (max_files)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बहुत ज़्यादा फ़ाइलें चुनी गई हैं: %1$@। यह एजेंट प्रीसेट ज़्यादा से ज़्यादा %2$@ फ़ाइलें लेता है (max_files)।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terlalu banyak file yang dipilih: %1$@. Preset agen ini menerima paling banyak %2$@ (max_files)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono selezionati troppi file: %1$@. Questo preset ne accetta al massimo %2$@ (max_files)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択されているファイルが多すぎます（%1$@個）。このプリセットで扱えるのは最大%2$@個です（max_files）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 파일이 너무 많습니다(%1$@개). 이 프리셋은 최대 %2$@개까지 받습니다(max_files)."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "खूप जास्त फाइल निवडल्या आहेत: %1$@. हा प्रीसेट जास्तीत जास्त %2$@ घेतो (max_files)."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terlalu banyak fail dipilih: %1$@. Praset ini menerima paling banyak %2$@ (max_files)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn te veel bestanden geselecteerd: %1$@. Deze agentvoorinstelling neemt er hoogstens %2$@ (max_files)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznaczono za dużo plików: %1$@. Limit tego gotowego promptu: %2$@ (max_files)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há arquivos demais selecionados: %1$@. Esta predefinição de agente aceita no máximo %2$@ (max_files)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunt selectate prea multe fișiere: %1$@. Această presetare acceptă cel mult %2$@ (max_files)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбрано слишком много файлов: %1$@. Максимум для этого пресета: %2$@ (max_files)."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அதிகமான கோப்புகள் தேர்ந்தெடுக்கப்பட்டுள்ளன: %1$@. இந்த முன்னமைவு அதிகபட்சம் %2$@ கோப்புகளை ஏற்கும் (max_files)."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చాలా ఎక్కువ ఫైళ్లు ఎంచుకోబడ్డాయి: %1$@. ఈ ప్రీసెట్ గరిష్ఠంగా %2$@ ఫైళ్లను తీసుకుంటుంది (max_files)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกไฟล์มากเกินไป: %1$@ พรีเซ็ตนี้รับได้สูงสุด %2$@ ไฟล์ (max_files)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çok fazla dosya seçili: %1$@. Bu ön ayar en fazla %2$@ dosya alır (max_files)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибрано забагато файлів: %1$@. Максимум для цього пресету агента: %2$@ (max_files)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بہت زیادہ فائلیں منتخب ہیں: %1$@۔ یہ پری سیٹ زیادہ سے زیادہ %2$@ فائلیں لیتا ہے (max_files)۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã chọn quá nhiều tệp: %1$@. Mẫu lời nhắc này nhận tối đa %2$@ tệp (max_files)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选文件过多：%1$@ 个。此预设最多接受 %2$@ 个（max_files）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選檔案過多：%1$@ 個。此預設組最多接受 %2$@ 個（max_files）。"
          }
        }
      }
    },
    "refusal.preset.typed": {
      "comment": "Why an action did nothing, shown in the alert after a click in Finder (and, in English, by the command line).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُكتب الإعداد المسبق للوكيل في وحدة طرفية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এজেন্ট প্রিসেট টার্মিনালে টাইপ করা হয়।"
          }
        },
        "de": {
