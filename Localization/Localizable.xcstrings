    "app.bypassByAlias": {
      "comment": "Line under the switch 'Start agents without asking' (app.bypassTitle), whether the switch is on or off. It names an agent that starts without its permission prompts because the person's login shell has an alias for its command that adds the flag (alias claude='claude --dangerously-skip-permissions'); prompt presets, which otherwise keep asking (app.bypassHelp), are no exception. %1$@ is the agent's name (Claude Code, Codex). %2$@ is the command-line flag, for example --dangerously-skip-permissions: keep it exactly. 'Alias' is the shell's alias. Word 'starts without asking' as in app.bypassOwnSetting.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%1$@ يُشغَّل دون استئذان، بما في ذلك الإعدادات المسبقة للموجّهات، فالاسم المستعار له في مكوّن Shell الخاص بالدخول لديك يضيف %2$@."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ জিজ্ঞাসা না করেই শুরু হয়, প্রম্পট প্রিসেটেও: আপনার লগইন শেলে এর অ্যালিয়াস %2$@ যোগ করে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ startet ohne Nachfrage, auch bei Prompt-Voreinstellungen: Der Alias dafür in deiner Login-Shell fügt %2$@ hinzu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο πράκτορας %1$@ ξεκινά χωρίς ερωτήσεις, και στις προεπιλογές προτροπών: το ψευδώνυμό του στο κέλυφος εισόδου σας προσθέτει το %2$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ starts without asking, prompt presets included: its alias in your login shell adds %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ se inicia sin preguntar, también con los preajustes de prompt: su alias en tu shell de inicio de sesión añade %2$@."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%1$@ بدون پرسیدن شروع می‌شود، حتی با پیش‌تنظیم‌های پرامپت، زیرا نام مستعار آن در پوستهٔ ورود شما %2$@ را اضافه می‌کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ démarre sans demander, préréglages de prompt compris : son alias dans votre shell de connexion ajoute %2$@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%1$@ מופעל בלי לשאול, גם בהגדרות מוכנות, כי הכינוי שלו במעטפת ההתחברות מוסיף את %2$@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ बिना पूछे शुरू होता है, प्रॉम्प्ट प्रीसेट में भी: आपके लॉगइन शेल में इसका उपनाम %2$@ जोड़ता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ mulai tanpa bertanya, termasuk untuk preset prompt: alias-nya di shell masuk Anda menambahkan %2$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ si avvia senza chiedere, preset di prompt compresi: il suo alias nella tua shell di login aggiunge %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ は確認せずに起動します（プロンプトのプリセットも同様）。ログインシェルのエイリアスが %2$@ を付けています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: 묻지 않고 시작합니다(프롬프트 프리셋 포함). 로그인 셸의 별칭이 %2$@을(를) 붙입니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ विचारल्याशिवाय सुरू होतो, प्रॉम्प्ट प्रीसेटसाठीही: तुमच्या लॉगिन शेलमधील त्याचे टोपणनाव %2$@ जोडते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ dimulakan tanpa bertanya, termasuk untuk praset gesaan: aliasnya dalam cangkerang log masuk anda menambah %2$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ start zonder te vragen, ook bij agentvoorinstellingen: de alias ervoor in je inlogshell voegt %2$@ toe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent %1$@ uruchamia się bez pytania, także w gotowych promptach – jego alias w powłoce logowania dodaje %2$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ inicia sem perguntar, inclusive nas predefinições de prompt: o alias dele no seu shell de login adiciona %2$@."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ pornește fără întrebări, inclusiv la presetările pentru agent: aliasul său din shellul de login adaugă %2$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Агент %1$@ запускается без вопросов, в том числе с пресетами агента: его псевдоним в оболочке входа добавляет %2$@."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ கேட்காமல் தொடங்கும், ப்ராம்ப்ட் முன்னமைவுகளிலும்: உங்கள் login shell இல் அதன் மாற்றுப்பெயர் %2$@ ஐச் சேர்க்கிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ అడగకుండా ప్రారంభమవుతుంది, ప్రాంప్ట్ ప్రీసెట్‌లలో కూడా: మీ login shell లోని దాని మారుపేరు %2$@ ను జోడిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ เริ่มโดยไม่ต้องถาม รวมถึงพรีเซ็ตพรอมต์ด้วย: นามแฝงของคำสั่งนี้ในเชลล์เข้าสู่ระบบของคุณเพิ่ม %2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sormadan başlar, istem ön ayarlarında da: oturum açma kabuğunuzdaki takma adı %2$@ ekliyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ запускається без запитань, зокрема й із пресетами агента: його псевдонім у вашій оболонці входу додає %2$@."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%1$@ بغیر پوچھے شروع ہوتا ہے، پرامپٹ پری سیٹس میں بھی: آپ کی لاگ ان شیل میں اس کا عرف %2$@ شامل کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ khởi chạy mà không hỏi, kể cả với các mẫu lời nhắc: bí danh của nó trong shell đăng nhập của bạn thêm %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 会无需询问即启动，提示词预设也一样：你的登录 shell 中它的别名会加上 %2$@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 會無需詢問即啟動，提示詞預設組也一樣：你的登入 shell 中它的別名會加上 %2$@。"
          }
        }
      }
    },
    "app.bypassConfirmButton": {
      "comment": "The button of the confirmation that confirms switching on app.bypassTitle. Short, a verb phrase.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
