    "doctor.agent.aliasBypass": {
      "comment": "Detail line of a check in the setup window's Details list; it follows the check's title, so it is a fragment with no final period. %1$@ is the command of an AI agent (claude). %2$@ is the title of a Finder menu item in English, for example Claude Code Here: keep it as it is, in quotes if that is natural. %3$@ is a command-line flag that switches the agent's own permission prompts off, for example --dangerously-skip-permissions: keep it exactly. The person's login shell has an alias for the command (alias claude='claude --dangerously-skip-permissions') that adds the flag, so the agent starts without its permission prompts even from a prompt preset, which otherwise keeps asking (app.bypassHelp). 'Alias' is the shell's alias. It is a variant of doctor.agent.bypass: word the shared parts the same way.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم العثور على `%1$@`؛ الاسم المستعار له في مكوّن Shell الخاص بالدخول لديك يضيف `%3$@`، لذا يبدأ من «%2$@» وطلبات الإذن الخاصة به متوقفة، بما في ذلك الإعدادات المسبقة للموجّهات"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "`%1$@` পাওয়া গেছে; আপনার লগইন শেলে এর অ্যালিয়াস `%3$@` যোগ করে, তাই এটি “%2$@” দিয়ে শুরু হয় এবং অনুমতি চাওয়ার প্রশ্ন বন্ধ থাকে, প্রম্পট প্রিসেটেও"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "`%1$@` gefunden; der Alias dafür in deiner Login-Shell fügt `%3$@` hinzu, daher startet der Agent mit „%2$@“ und mit ausgeschalteten Berechtigungsabfragen, auch bei Prompt-Voreinstellungen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "βρέθηκε το `%1$@`· το ψευδώνυμό του στο κέλυφος εισόδου σας προσθέτει το `%3$@`, οπότε ξεκινά με «%2$@» και με απενεργοποιημένες τις ερωτήσεις για άδειες, και στις προεπιλογές προτροπών"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "`%1$@` found; its alias in your login shell adds `%3$@`, so it starts with %2$@ and its permission prompts switched off, prompt presets included"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "`%1$@` encontrado; su alias en tu shell de inicio de sesión añade `%3$@`, así que se inicia con «%2$@» y con las solicitudes de permiso desactivadas, también con los preajustes de prompt"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "‏`%1$@` پیدا شد؛ نام مستعار آن در پوستهٔ ورود شما `%3$@` را اضافه می‌کند، پس با «%2$@» شروع می‌شود و درخواست‌های مجوزش خاموش است، حتی با پیش‌تنظیم‌های پرامپت"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "`%1$@` trouvé ; son alias dans votre shell de connexion ajoute `%3$@`, il est donc lancé par « %2$@ » avec ses demandes d’autorisation désactivées, préréglages de prompt compris"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏`%1$@` נמצא; הכינוי שלו במעטפת ההתחברות מוסיף את `%3$@`, ולכן הוא מופעל מהפריט ״%2$@״ ובקשות ההרשאה שלו כבויות, גם בהגדרות מוכנות"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "`%1$@` मिली; आपके लॉगइन शेल में इसका उपनाम `%3$@` जोड़ता है, इसलिए यह “%2$@” से अनुमति वाले सवाल बंद करके शुरू होती है, प्रॉम्प्ट प्रीसेट में भी"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "`%1$@` ditemukan; alias-nya di shell masuk Anda menambahkan `%3$@`, jadi dimulai dengan “%2$@” dan permintaan izinnya dimatikan, termasuk untuk preset prompt"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "`%1$@` trovato; il suo alias nella tua shell di login aggiunge `%3$@`, quindi si avvia con “%2$@” e con le proprie richieste di permesso disattivate, preset di prompt compresi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "`%1$@` が見つかりました；ログインシェルのエイリアスが `%3$@` を付けるため、「%2$@」で起動し、自身の許可の確認はオフ（プロンプトのプリセットも同様）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "`%1$@` 찾음; 실행 항목: “%2$@”, 로그인 셸의 별칭이 `%3$@`을(를) 붙여 자체 권한 요청 꺼져 있음(프롬프트 프리셋 포함)"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "`%1$@` सापडले; सुरू करणारा मेनू आयटम: “%2$@”, तुमच्या लॉगिन शेलमधील त्याचे टोपणनाव `%3$@` जोडते, त्यामुळे त्याची परवानगी विचारणा बंद, प्रॉम्प्ट प्रीसेटसाठीही"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "`%1$@` ditemui; aliasnya dalam cangkerang log masuk anda menambah `%3$@`, jadi ia dimulakan dengan “%2$@” dan gesaan kebenarannya dinyahaktifkan, termasuk untuk praset gesaan"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "`%1$@` gevonden; de alias ervoor in je inlogshell voegt `%3$@` toe, dus start het met „%2$@” en met uitgeschakelde toestemmingsvragen, ook bij agentvoorinstellingen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "znaleziono `%1$@`; jego alias w powłoce logowania dodaje `%3$@`, więc jest uruchamiany przez pozycję „%2$@” z wyłączonymi pytaniami o uprawnienia, także w gotowych promptach"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "`%1$@` encontrado; o alias dele no seu shell de login adiciona `%3$@`, então inicia com “%2$@” e com os pedidos de permissão desativados, inclusive nas predefinições de prompt"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "`%1$@` găsit; aliasul său din shellul de login adaugă `%3$@`, deci pornește cu „%2$@” și cu solicitările de permisiune dezactivate, inclusiv la presetările pentru agent"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "`%1$@` найден; его псевдоним в оболочке входа добавляет `%3$@`, поэтому он запускается пунктом «%2$@» с отключенными запросами разрешений, в том числе с пресетами агента"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "`%1$@` கண்டறியப்பட்டது; உங்கள் login shell இல் அதன் மாற்றுப்பெயர் `%3$@` ஐச் சேர்க்கிறது, எனவே “%2$@” மூலம் தொடங்கும், அனுமதிக் கேள்விகள் முடக்கப்பட்டிருக்கும், ப்ராம்ப்ட் முன்னமைவுகளிலும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "`%1$@` కనుగొనబడింది; మీ login shell లోని దాని మారుపేరు `%3$@` ను జోడిస్తుంది, కాబట్టి “%2$@” ద్వారా ప్రారంభమవుతుంది, అనుమతి ప్రశ్నలు నిలిపివేయబడతాయి, ప్రాంప్ట్ ప్రీసెట్‌లలో కూడా"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พบ `%1$@` นามแฝงของคำสั่งนี้ในเชลล์เข้าสู่ระบบของคุณเพิ่ม `%3$@` จึงเริ่มทำงานด้วย “%2$@” โดยปิดการถามขออนุญาต รวมถึงพรีเซ็ตพรอมต์ด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "`%1$@` bulundu; oturum açma kabuğunuzdaki takma adı `%3$@` ekliyor, bu yüzden “%2$@” ile başlar ve izin istemleri kapalı, istem ön ayarlarında da"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "`%1$@` знайдено; його псевдонім у вашій оболонці входу додає `%3$@`, тож він запускається з пункту «%2$@» із вимкненими запитами на дозвіл, зокрема й із пресетами агента"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "‏`%1$@` مل گیا؛ آپ کی لاگ ان شیل میں اس کا عرف `%3$@` شامل کرتا ہے، اس لیے یہ “%2$@” سے شروع ہوتا ہے اور اس کے اجازت کے پرامپٹ بند ہیں، پرامپٹ پری سیٹس میں بھی"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "đã tìm thấy `%1$@`; bí danh của nó trong shell đăng nhập của bạn thêm `%3$@`, nên nó khởi chạy qua mục “%2$@” với các lời nhắc xin phép đang tắt, kể cả với các mẫu lời nhắc"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已找到 `%1$@`；你的登录 shell 中它的别名会加上 `%3$@`，因此通过“%2$@”启动时其权限提示是关闭的，提示词预设也一样"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已找到 `%1$@`；你的登入 shell 中它的別名會加上 `%3$@`，因此透過「%2$@」啟動時其權限提示是關閉的，提示詞預設組也一樣"
          }
        }
      }
    },
    "doctor.agent.bypass": {
      "comment": "Detail line of a check in the setup window's Details list; it follows the check's title, so it is a fragment with no final period. %1$@ is the command of an AI agent. %2$@ is the title of a Finder menu item in English, for example Claude Code Here: keep it as it is, in quotes if that is natural. %3$@ is a command-line flag that switches the agent's own permission prompts off, for example --dangerously-skip-permissions: keep it exactly.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم العثور على `%1$@`؛ يبدأ من «%2$@» وطلبات الإذن الخاصة به متوقفة بالخيار `%3$@`"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "`%1$@` পাওয়া গেছে; “%2$@” দিয়ে শুরু হয় এবং অনুমতি চাওয়ার প্রশ্ন বন্ধ থাকে (`%3$@`)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "`%1$@` gefunden; startet mit „%2$@“ und mit ausgeschalteten Berechtigungsabfragen (`%3$@`)"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "βρέθηκε το `%1$@`· ξεκινά με «%2$@» και με απενεργοποιημένες τις ερωτήσεις για άδειες (`%3$@`)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "`%1$@` found; starts with %2$@ and its permission prompts switched off (`%3$@`)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "`%1$@` encontrado; se inicia con «%2$@» y con las solicitudes de permiso desactivadas (`%3$@`)"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "‏`%1$@` پیدا شد؛ با «%2$@» شروع می‌شود و درخواست‌های مجوزش خاموش است (`%3$@`)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "`%1$@` trouvé ; lancé par « %2$@ », avec ses demandes d’autorisation désactivées (`%3$@`)"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏`%1$@` נמצא; מופעל מהפריט ״%2$@״ ובקשות ההרשאה שלו כבויות (`%3$@`)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "`%1$@` मिली; “%2$@” से अनुमति वाले सवाल बंद करके शुरू होती है (`%3$@`)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "`%1$@` ditemukan; dimulai dengan “%2$@” dan permintaan izinnya dimatikan (`%3$@`)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "`%1$@` trovato; si avvia con “%2$@” e con le proprie richieste di permesso disattivate (`%3$@`)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "`%1$@` が見つかりました；「%2$@」で起動し、自身の許可の確認はオフ（`%3$@`）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "`%1$@` 찾음; 실행 항목: “%2$@”, 자체 권한 요청 꺼져 있음 (`%3$@`)"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "`%1$@` सापडले; सुरू करणारा मेनू आयटम: “%2$@”, त्याची परवानगी विचारणा बंद (`%3$@`)"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "`%1$@` ditemui; dimulakan dengan “%2$@” dan gesaan kebenarannya dinyahaktifkan (`%3$@`)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "`%1$@` gevonden; start met „%2$@” en met uitgeschakelde toestemmingsvragen (`%3$@`)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "znaleziono `%1$@`; uruchamiany przez pozycję „%2$@” z wyłączonymi pytaniami o uprawnienia (`%3$@`)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "`%1$@` encontrado; inicia com “%2$@” e com os pedidos de permissão desativados (`%3$@`)"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "`%1$@` găsit; pornește cu „%2$@” și cu solicitările de permisiune dezactivate (`%3$@`)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "`%1$@` найден; запускается пунктом «%2$@», запросы разрешений отключены (`%3$@`)"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "`%1$@` கண்டறியப்பட்டது; “%2$@” மூலம் தொடங்கும், அனுமதிக் கேள்விகள் முடக்கப்பட்டிருக்கும் (`%3$@`)"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "`%1$@` కనుగొనబడింది; “%2$@” ద్వారా ప్రారంభమవుతుంది, అనుమతి ప్రశ్నలు నిలిపివేయబడతాయి (`%3$@`)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พบ `%1$@` เริ่มทำงานด้วย “%2$@” โดยปิดการถามขออนุญาต (`%3$@`)"
