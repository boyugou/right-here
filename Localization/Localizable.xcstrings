        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎనేబుల్ చేయబడింది, కానీ అనేక స్థానాల (%1$@) నుండి రిజిస్టర్ చేయబడింది: %2$@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดใช้งานแล้ว แต่ลงทะเบียนจากหลายตำแหน่ง (%1$@): %2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "etkin, ancak birden fazla konumdan kayıtlı (%1$@): %2$@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "увімкнено, але зареєстровано з розташувань (%1$@): %2$@"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فعال ہے، مگر %1$@ مقامات سے رجسٹر ہے: %2$@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "đã bật, nhưng được đăng ký từ %1$@ vị trí: %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已启用，但注册位置有 %1$@ 个：%2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已啟用，但註冊位置有 %1$@ 個：%2$@"
          }
        }
      }
