    "app.stepOneBody": {
      "comment": "Step 1 text; a short list of the found terminal and editor is shown under it.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "عثر Right Here على هذه التطبيقات على جهاز Mac. لتغييرها، عدّل ملف الإعداد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here আপনার Mac-এ এগুলো পেয়েছে। পরিবর্তন করতে কনফিগ ফাইল সম্পাদনা করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here hat diese auf Ihrem Mac gefunden. Zum Ändern bearbeiten Sie die Konfigurationsdatei."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Το Right Here βρήκε τα παρακάτω στο Mac σας. Για να τα αλλάξετε, επεξεργαστείτε το αρχείο ρυθμίσεων."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here found these on your Mac. To change them, edit the config file."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here encontró estos en su Mac. Para cambiarlos, edite el archivo de configuración."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "‏Right Here این‌ها را در مک شما پیدا کرد. برای تغییر آن‌ها، فایل پیکربندی را ویرایش کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here a trouvé ceux-ci sur votre Mac. Pour les modifier, changez le fichier de configuration."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "‏Right Here מצאה את אלה ב-Mac שלכם. כדי לשנות אותם, ערכו את קובץ ההגדרות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here को आपके Mac पर ये मिले। इन्हें बदलने के लिए कॉन्फ़िग फ़ाइल संपादित करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here menemukan aplikasi berikut di Mac Anda. Untuk mengubahnya, edit file konfigurasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here ha trovato questi sul Mac. Per modificarli, cambia il file di configurazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here がこの Mac で見つけたアプリです。変更するには設定ファイルを編集してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here가 이 Mac에서 찾은 항목입니다. 변경하려면 설정 파일을 편집하세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here ला तुमच्या Mac वर हे सापडले. ते बदलण्यासाठी कॉन्फिग फाइल संपादित करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here menemui yang berikut pada Mac anda. Untuk menukarnya, sunting fail konfigurasi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here heeft deze op de Mac gevonden. Pas het configuratiebestand aan om ze te wijzigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here znalazł je na tym Macu. Aby je zmienić, edytuj plik konfiguracyjny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Right Here encontrou estes no seu Mac. Para alterá-los, edite o arquivo de configuração."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here le-a găsit pe acestea pe Mac. Pentru a le schimba, editează fișierul de configurare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here нашёл их на вашем Mac. Чтобы изменить выбор, отредактируйте файл конфигурации."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here உங்கள் Mac-இல் இவற்றைக் கண்டறிந்தது. இவற்றை மாற்ற, கட்டமைப்பு கோப்பைத் திருத்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here మీ Mac లో వీటిని కనుగొంది. వాటిని మార్చడానికి కాన్ఫిగ్ ఫైల్‌ను ఎడిట్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here พบรายการเหล่านี้บน Mac ของคุณ หากต้องการเปลี่ยน ให้แก้ไขไฟล์การตั้งค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here, Mac'inizde şunları buldu. Bunları değiştirmek için yapılandırma dosyasını düzenleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here знайшов їх на вашому Mac. Щоб змінити вибір, відредагуйте файл конфігурації."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "‏Right Here کو آپ کے Mac پر یہ ملے۔ انہیں تبدیل کرنے کے لیے کنفیگ فائل میں ترمیم کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here đã tìm thấy các ứng dụng sau trên Mac của bạn. Để thay đổi, hãy chỉnh sửa tệp cấu hình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here 在您的 Mac 上找到了以下应用。如需更改，请编辑配置文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here 在您的 Mac 上找到了這些 App。如要變更，請編輯設定檔。"
          }
        }
      }
    },
