            "state": "translated",
            "value": "git 已安裝，因此選單中的儲存庫連結可以讀取各自的儲存庫。"
          }
        }
      }
    },
    "doctor.menu.empty": {
      "comment": "Detail line of a check in the setup window's Details list; it follows the check's title (\"Finder menu\"), so it is a fragment with no final period. With the config as it is, a right-click on a folder in Finder would offer nothing: no entry is left to show.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فارغة لمجلد: لا يتبقى أي عنصر بهذا الإعداد"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফোল্ডারের জন্য খালি: এই কনফিগে কোনো আইটেম বাকি থাকে না"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "leer für einen Ordner: Mit dieser Konfiguration bleibt kein Eintrag übrig"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "άδειο για φάκελο: με αυτή τη ρύθμιση δεν μένει κανένα στοιχείο"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "empty for a folder: no entry is left with this config"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "vacío para una carpeta: con esta configuración no queda ningún elemento"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای یک پوشه خالی است: با این پیکربندی هیچ گزینه‌ای باقی نمی‌ماند"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "vide pour un dossier : avec cette configuration, il ne reste aucune commande à afficher"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ריק עבור תיקיה: עם התצורה הזו לא נשאר אף פריט"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोल्डर के लिए खाली: इस कॉन्फ़िग के साथ कोई आइटम नहीं बचता"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "kosong untuk folder: tidak ada item yang tersisa dengan konfigurasi ini"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "vuoto per una cartella: con questa configurazione non resta nessuna voce"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダでは空：この設定では項目が一つも残りません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더에서는 비어 있음: 이 설정에서 남은 항목 없음"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फोल्डरसाठी रिकामे: या कॉन्फिगमध्ये कोणताही आयटम उरत नाही"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "kosong untuk folder: tiada item tinggal dengan konfigurasi ini"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "leeg voor een map: met deze configuratie blijft geen enkel onderdeel over"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "puste dla folderu: przy tej konfiguracji nie pozostaje żadna pozycja"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "vazio em uma pasta: com esta configuração, não sobra nenhum item"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "gol pentru un dosar: cu această configurație nu rămâne niciun articol"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "пусто для папки: с этой конфигурацией не остается ни одного пункта"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கோப்புறைக்குக் காலியாக: இந்த உள்ளமைவில் எந்த உள்ளீடும் எஞ்சியிருக்காது"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫోల్డర్‌కు ఖాళీ: ఈ కాన్ఫిగరేషన్‌తో ఏ ఎంట్రీ మిగలదు"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ว่างเปล่าสำหรับโฟลเดอร์: ไม่เหลือรายการใดเมื่อใช้การกำหนดค่านี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "klasör için boş: bu yapılandırmayla hiçbir öğe kalmıyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "для папки порожньо: з цією конфігурацією не залишається жодного пункту"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فولڈر کے لیے خالی: اس کنفیگ کے ساتھ کوئی آئٹم باقی نہیں رہتا"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "trống đối với thư mục: cấu hình này không để lại mục nào"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件夹的菜单为空：按此配置，没有剩下任何项目"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案夾的選單是空的：依此設定，沒有任何項目可顯示"
          }
        }
      }
    },
    "doctor.pending.waiting": {
      "comment": "Detail of the check 'Changes to approve'. %@ is a number. The person must look at them; an AI assistant cannot apply them itself.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغييرات اقترحها مساعد ذكاء اصطناعي بانتظارك: %@"
