    "app.copyPathCaption": {
      "comment": "Caption under the heading 'Copy Path' (glossary entry group.copyPath, the title of that Finder submenu: use its existing translation) on the Finder menu page of the setup window. A form is one way of writing the path of a file: its absolute path, with ~, from the git root, the name only.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أشكال المسار التي يعرضها «نسخ المسار» في قائمة فايندر، بهذا الترتيب."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“পাথ কপি করুন” Finder মেনুতে যেসব ধরনের পাথ দেয়, সেগুলো এই ক্রমে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Schreibweisen eines Pfads, die „Pfad kopieren“ im Finder-Menü anbietet, in dieser Reihenfolge."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Οι μορφές μιας διαδρομής που προσφέρει το υπομενού «Αντιγραφή διαδρομής» στο μενού του Finder, με αυτή τη σειρά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The forms of a path that “Copy Path” offers in the Finder menu, in this order."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las formas de ruta que ofrece «Copiar ruta» en el menú del Finder, en este orden."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "شکل‌هایی از مسیر که «کپی مسیر» در منوی Finder ارائه می‌کند، به همین ترتیب."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les formes d’un chemin que « Copier le chemin » propose dans le menu du Finder, dans cet ordre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "צורות הנתיב שתפריט המשנה ״העתקת נתיב״ מציע בתפריט Finder, לפי סדר זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Finder मेन्यू में “पाथ कॉपी करें” जिन रूपों में पाथ देता है, वे इसी क्रम में हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bentuk-bentuk jalur yang ditawarkan “Salin Jalur” di menu Finder, dalam urutan ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le forme di un percorso che “Copia percorso” offre nel menu del Finder, in quest’ordine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Finder のメニューの「パスをコピー」が提供するパスの形式を、この順に並べています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Finder 메뉴의 “경로 복사”가 제공하는 경로 형식을 이 순서대로 나열합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Finder मेनूमधील “पाथ कॉपी करा” देत असलेले पाथचे प्रकार, या क्रमाने."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bentuk-bentuk laluan yang ditawarkan “Salin Laluan” dalam menu Finder, mengikut susunan ini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De vormen van een pad die „Kopieer pad” in het Finder-menu aanbiedt, in deze volgorde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sposoby zapisu ścieżki, które oferuje pozycja „Kopiuj ścieżkę” w menu Findera, w tej kolejności."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As formas de um caminho que a opção “Copiar Caminho” do menu do Finder oferece, nesta ordem."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Formele unei căi oferite de opțiunea „Copiați calea” din meniul Finder, în această ordine."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Варианты записи пути, которые предлагает пункт «Скопировать путь» в меню Finder, в этом порядке."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Finder மெனுவில் உள்ள “பாதையை நகலெடு” வழங்கும் பாதையின் வடிவங்கள், இந்த வரிசையில்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Finder మెనూలో ఉన్న “పాత్‌ను కాపీ చేయండి” అందించే పాత్ రూపాలు, ఈ క్రమంలో."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "รูปแบบของเส้นทางที่ “คัดลอกเส้นทาง” ในเมนูของ Finder เสนอให้ เรียงตามลำดับนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Finder menüsündeki “Yolu Kopyala” komutunun sunduğu yol biçimleri, bu sırayla."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Варіанти запису шляху, які пропонує пункт «Скопіювати шлях» у меню Finder, у такому порядку."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "‏Finder کے مینو میں “پاتھ کاپی کریں” کے ذریعے پیش کی جانے والی پاتھ کی شکلیں، اس ترتیب میں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Các dạng đường dẫn mà mục “Sao chép đường dẫn” trong menu Finder cung cấp, theo thứ tự này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "访达菜单中“拷贝路径”提供的路径格式，按此顺序排列。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Finder 選單中「拷貝路徑」提供的路徑格式，依此順序排列。"
          }
        }
      }
    },
    "app.copyPathInexactNote": {
      "comment": "Gray caption above the list of the forms of Copy Path, shown only when the config file writes the list in an unusual way (for example a form twice). Same wording and structure as the existing glossary entry app.agentArgumentsInexactNote, with 'The forms' instead of 'The arguments'. 'The Config page' is a section of the app (glossary entry app.tabConfig).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "كُتبت الأشكال في ملف الإعداد بطريقة لا تسمح لهذه القائمة بتغييرها واحدةً تلو الأخرى. عدِّلها كنص في صفحة ملف الإعداد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ধরনগুলো কনফিগারেশন ফাইলে এমনভাবে লেখা আছে যে এই তালিকা সেগুলো একটি একটি করে বদলাতে পারে না। কনফিগ পৃষ্ঠায় টেক্সট হিসেবে সেগুলো বদলান।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Schreibweisen sind so in deiner Konfigurationsdatei geschrieben, dass diese Liste sie nicht einzeln ändern kann. Ändere sie als Text auf der Seite „Konfiguration“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Οι μορφές είναι γραμμένες στο αρχείο ρυθμίσεων με τρόπο που αυτή η λίστα δεν μπορεί να τις αλλάξει μία μία. Αλλάξτε τις ως κείμενο στη σελίδα «Ρυθμίσεις»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The forms are written in your config file in a way this list cannot change one by one. Change them as text on the Config page."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las formas están escritas en tu archivo de configuración de un modo que esta lista no puede cambiar una por una. Cámbialas como texto en la página Configuración."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "شکل‌ها در فایل پیکربندی شما به شکلی نوشته شده‌اند که این فهرست نمی‌تواند آن‌ها را یکی‌یکی تغییر دهد. آن‌ها را به‌صورت متن در صفحهٔ پیکربندی تغییر دهید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les formes sont écrites dans votre fichier de configuration d’une façon qui ne permet pas à cette liste de les modifier une par une. Modifiez-les sous forme de texte dans la page Configuration."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "הצורות כתובות בקובץ התצורה באופן שרשימה זו לא יכולה לשנות כל אחת מהן בנפרד. יש לשנות אותן כטקסט בעמוד ״תצורה״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "रूप आपकी कॉन्फ़िगरेशन फ़ाइल में इस तरह लिखे गए हैं कि यह सूची उन्हें एक-एक करके नहीं बदल सकती। उन्हें कॉन्फ़िग पेज पर टेक्स्ट के रूप में बदलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bentuk-bentuk ditulis di file konfigurasi Anda dengan cara yang tidak dapat diubah satu per satu oleh daftar ini. Ubahlah sebagai teks di halaman Konfigurasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le forme sono scritte nel file di configurazione in un modo che questo elenco non può modificare una alla volta. Modificale come testo nella pagina Configurazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "形式は、この一覧では一つずつ変更できない形で設定ファイルに書かれています。設定ページでテキストとして変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "형식은 이 목록에서 한 개씩 바꿀 수 없는 방식으로 설정 파일에 적혀 있습니다. 설정 페이지에서 텍스트로 바꾸십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "प्रकार कॉन्फिगरेशन फाइलमध्ये अशा पद्धतीने लिहिलेले आहेत की ही यादी त्यांना एकेक करून बदलू शकत नाही. कॉन्फिग पृष्ठावर मजकूर म्हणून ते बदला."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bentuk-bentuk ditulis dalam fail konfigurasi anda dengan cara yang senarai ini tidak dapat mengubahnya satu demi satu. Ubahlah sebagai teks pada halaman Konfigurasi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De vormen staan in het configuratiebestand op een manier die deze lijst niet één voor één kan wijzigen. Wijzig ze als tekst op de pagina Configuratie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Formy są zapisane w pliku konfiguracji w taki sposób, że nie można ich zmieniać pojedynczo na tej liście. Zmień je jako tekst na stronie Konfiguracja."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As formas estão escritas no arquivo de configuração de uma forma que esta lista não consegue alterar uma por uma. Altere-as como texto na página Configuração."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Formele sunt scrise în fișierul de configurare într-un mod în care această listă nu le poate modifica una câte una. Modificați-le ca text pe pagina Configurație."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Варианты записаны в файле конфигурации таким образом, что этот список не может изменять их по одному. Измените их в виде текста на странице «Конфигурация»."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "வடிவங்கள் உங்கள் உள்ளமைவுக் கோப்பில், இந்தப் பட்டியலால் ஒவ்வொன்றாக மாற்ற முடியாத விதத்தில் எழுதப்பட்டுள்ளன. உரையாக, உள்ளமைவுப் பக்கத்தில் அவற்றை மாற்றவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "needs_review",
            "value": "రూపాలు మీ కాన్ఫిగరేషన్ ఫైల్‌లో ఈ జాబితా ఒక్కొక్కటిగా మార్చలేని విధంగా రాయబడ్డాయి. కాన్ఫిగరేషన్ పేజీలో వాటిని టెక్స్ట్‌గా మార్చండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "รูปแบบถูกเขียนไว้ในไฟล์การกำหนดค่าของคุณในลักษณะที่รายการนี้ไม่สามารถเปลี่ยนทีละรายการได้ แก้ไขเป็นข้อความในหน้าการกำหนดค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Biçimler yapılandırma dosyanızda, bu listenin tek tek değiştiremeyeceği bir biçimde yazılmış. Bunları Yapılandırma sayfasında metin olarak değiştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Варіанти записані у вашому файлі конфігурації так, що цей список не може змінювати їх по одному. Змініть їх у вигляді тексту на сторінці «Конфігурація»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "شکلیں آپ کی کنفیگریشن فائل میں اس طرح لکھی گئی ہیں کہ یہ فہرست انہیں ایک ایک کر کے تبدیل نہیں کر سکتی۔ انہیں کنفیگ صفحے پر متن کے طور پر تبدیل کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Các dạng được viết trong tệp cấu hình của bạn theo cách danh sách này không thể thay đổi từng cái một. Chỉnh sửa chúng dưới dạng văn bản trên trang Cấu hình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "配置文件中这些格式的写法使此列表无法逐个更改它们。请在“配置”页面以文本形式更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "設定檔中這些格式的寫法讓這份清單無法逐一變更。請在「設定檔」頁面以文字形式變更。"
          }
        }
      }
    },
    "app.copyPluginCommands": {
      "comment": "Button that copies the two commands shown above it.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "نسخ أوامر المكوّن الإضافي"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "প্লাগইন কমান্ড কপি করুন"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plug-in-Befehle kopieren"
          }
        },
