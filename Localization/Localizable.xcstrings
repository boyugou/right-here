    "refusal.repository.notPushed": {
      "comment": "Why an action did nothing, shown in the alert after a click in Finder (and, in English, by the command line). %@ is a remote name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإيداع الحالي ليس موجودًا بعد في المستودع البعيد «%@»، لذا ليست له صفحة هناك. ادفعه (push)، ثم حاول مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চেক-আউট করা কমিটটি এখনও রিমোট “%@”-এ নেই, তাই সেখানে এর কোনো পৃষ্ঠা নেই। কমিটটি পুশ করুন, তারপর আবার চেষ্টা করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der ausgecheckte Commit ist noch nicht auf dem Remote „%@“ und hat dort daher keine Seite. Pushe ihn und versuche es dann erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το τρέχον commit δεν βρίσκεται ακόμη στο απομακρυσμένο αποθετήριο «%@», οπότε δεν έχει σελίδα εκεί. Κάντε push και δοκιμάστε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The checked-out commit is not on remote \"%@\" yet, so it has no page there. Push it, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El commit actual todavía no está en el remoto «%@», así que no tiene página allí. Haz push y vuelve a intentarlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کامیت فعلی هنوز روی مخزن راه‌دور «%@» نیست، بنابراین آنجا صفحه‌ای ندارد. آن را push کنید و دوباره تلاش کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le commit extrait n’est pas encore sur le dépôt distant « %@ », il n’a donc pas de page sur ce dépôt distant. Poussez-le, puis réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ה-commit הנוכחי עדיין לא נמצא במאגר המרוחק ״%@״, ולכן אין לו עמוד שם. יש לבצע push ולנסות שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चेक-आउट किया हुआ कमिट अभी रिमोट “%@” पर नहीं है, इसलिए वहाँ उसका कोई पेज नहीं है। उसे पुश करें, फिर दोबारा कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Commit yang sedang di-checkout belum ada di remote “%@”, jadi belum memiliki halaman di sana. Push commit tersebut, lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il commit del checkout attuale non è ancora sul remote “%@”, quindi lì non ha una pagina. Esegui il push, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チェックアウト中のコミットがまだリモート「%@」にないため、そこにはページがありません。プッシュしてから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체크아웃된 커밋이 아직 “%@” 리모트에 없으므로 그곳에 페이지가 없습니다. 푸시한 다음 다시 시도하십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "चेक आउट केलेला कमिट अजून रिमोट “%@” वर नाही, त्यामुळे तिथे त्याचे पृष्ठ नाही. तो पुश करा आणि पुन्हा प्रयत्न करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Komit yang di-checkout belum berada pada remote “%@”, jadi ia tiada halaman di sana. Push komit itu, kemudian cuba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De uitgecheckte commit staat nog niet op remote „%@”, dus hij heeft daar geen pagina. Push de commit en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bieżącego commita nie ma jeszcze w zdalnym repozytorium „%@”, więc nie ma on tam strony. Wypchnij go (push), a następnie spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O commit em checkout ainda não está no remote “%@”, então não tem página lá. Faça o push e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Commitul curent nu se află încă pe remote-ul „%@”, deci nu are nicio pagină acolo. Faceți push, apoi încercați din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текущего коммита еще нет в удаленном репозитории «%@», поэтому страницы там нет. Отправьте его (push) и повторите попытку."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "checkout செய்யப்பட்ட commit இன்னும் “%@” என்ற remote-இல் இல்லை, எனவே அங்கே அதற்குப் பக்கம் இல்லை. அதை push செய்து, மீண்டும் முயலவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చెక్‌అవుట్ చేసిన కమిట్ ఇంకా “%@” రిమోట్‌లో లేదు, కాబట్టి అక్కడ దానికి పేజీ లేదు. దాన్ని push చేసి, మళ్లీ ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "commit ที่ checkout อยู่ยังไม่อยู่บนรีโมต “%@” จึงยังไม่มีหน้าที่นั่น push commit นั้นแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçerli commit henüz “%@” adlı remote’ta değil, bu yüzden orada sayfası yok. Commit’i push edin ve tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поточного коміту ще немає в remote «%@», тому там немає його сторінки. Надішліть коміт (push) і повторіть спробу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "چیک آؤٹ شدہ کمٹ ابھی ریموٹ “%@” پر نہیں ہے، اس لیے وہاں اس کا کوئی صفحہ نہیں ہے۔ اسے پش کریں، پھر دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Commit đang được checkout chưa có trên remote “%@” nên chưa có trang ở đó. Hãy push commit đó, rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前检出的提交尚未推送到远程仓库“%@”，因此那里还没有它的页面。请推送该提交，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前檢出的提交尚未推送到遠端儲存庫「%@」，因此那裡還沒有它的頁面。請推送該提交，然後重試。"
          }
        }
      }
    },
    "refusal.repository.notRead": {
      "comment": "Why an action did nothing, shown in the alert after a click in Finder (and, in English, by the command line). %@ is a path.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تتم قراءة مستودع %@، لذا لا يمكن إنشاء رابطه هنا؛ الأمر `rh run` يقرؤه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-এর রিপোজিটরি পড়া হয়নি, তাই এর লিংক এখানে তৈরি করা যায় না; `rh run` রিপোজিটরিটি পড়ে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Repository von %@ wurde nicht gelesen, daher kann sein Link hier nicht erstellt werden; `rh run` liest es."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το αποθετήριο του %@ δεν διαβάστηκε, οπότε ο σύνδεσμός του δεν μπορεί να δημιουργηθεί εδώ· η εντολή `rh run` το διαβάζει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The repository of %@ was not read, so its link cannot be made here; `rh run` reads it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El repositorio de %@ no se leyó, así que su enlace no se puede crear aquí; `rh run` sí lo lee."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مخزن %@ خوانده نشد، بنابراین پیوند آن را نمی‌توان اینجا ساخت؛ `rh run` آن را می‌خواند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dépôt de %@ n’a pas été lu, son lien ne peut donc pas être créé ici ; `rh run` le lit."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המאגר של %@ לא נקרא, ולכן אי אפשר ליצור כאן את הקישור שלו; הפקודה `rh run` קוראת אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ की रिपॉज़िटरी पढ़ी नहीं गई, इसलिए उसका लिंक यहाँ नहीं बनाया जा सकता; `rh run` उसे पढ़ता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Repositori %@ tidak dibaca, jadi tautannya tidak dapat dibuat di sini; `rh run` membacanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il repository di %@ non è stato letto, quindi qui non se ne può creare il link; `rh run` lo legge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@のリポジトリが読み取られていないため、ここではリンクを作成できません。`rh run` ではリポジトリが読み取られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 경로의 저장소를 읽지 않았으므로 여기서는 링크를 만들 수 없습니다. `rh run` 명령은 저장소를 읽습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ची रेपॉझिटरी वाचली गेली नाही, त्यामुळे त्याची लिंक इथे बनवता येत नाही; `rh run` ती वाचते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Repositori bagi %@ tidak dibaca, jadi pautannya tidak boleh dibuat di sini; `rh run` membacanya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De repository van %@ is niet gelezen, dus de link kan hier niet worden gemaakt; `rh run` leest de repository wel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie odczytano repozytorium, w którym jest %@, więc nie można tu utworzyć łącza; `rh run` je odczytuje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O repositório de %@ não foi lido, então o link não pode ser criado aqui; o `rh run` lê o repositório."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Depozitul pentru %@ nu a fost citit, deci linkul nu poate fi creat aici; `rh run` îl citește."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Репозиторий объекта %@ не был прочитан, поэтому ссылку здесь создать нельзя; команда `rh run` его читает."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ இன் repository படிக்கப்படவில்லை, எனவே அதன் இணைப்பை இங்கே உருவாக்க முடியாது; `rh run` அதைப் படிக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ యొక్క రిపోజిటరీ చదవబడలేదు, కాబట్టి దాని లింక్‌ను ఇక్కడ తయారు చేయలేము; `rh run` దాన్ని చదువుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้อ่านรีโพซิทอรีของ %@ จึงสร้างลิงก์ที่นี่ไม่ได้ `rh run` จะอ่านรีโพซิทอรีนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ konumunun deposu okunmadı, bu yüzden bağlantısı burada oluşturulamaz; `rh run` depoyu okur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Репозиторій для %@ не прочитано, тому посилання тут створити не можна; `rh run` читає репозиторій."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%@ کی ریپازٹری نہیں پڑھی گئی، اس لیے اس کا لنک یہاں نہیں بنایا جا سکتا؛ `rh run` اسے پڑھتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kho git của %@ chưa được đọc nên không thể tạo liên kết ở đây; `rh run` sẽ đọc kho đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未读取 %@ 所在的仓库，因此无法在此生成其链接；`rh run` 会读取该仓库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未讀取 %@ 所在的儲存庫，因此無法在此產生其連結；`rh run` 會讀取該儲存庫。"
          }
        }
      }
    },
    "refusal.repository.oneItem": {
      "comment": "Why an action did nothing, shown in the alert after a click in Finder (and, in English, by the command line). Name the two commands as action.openRepositoryPage and action.copyRepositoryLink do in this language.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح «فتح صفحة المستودع» صفحة عنصر واحد فقط. للحصول على روابط عدة عناصر، استخدم «نسخ رابط المستودع»."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "“রিপোজিটরি পৃষ্ঠা খুলুন” কেবল একটি আইটেমের পৃষ্ঠা খোলে। একাধিক আইটেমের লিংক পেতে “রিপোজিটরি লিংক কপি করুন” ব্যবহার করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Repository-Seite öffnen“ öffnet die Seite eines einzelnen Objekts. Für die Links mehrerer Objekte nutze „Repository-Link kopieren“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «Άνοιγμα σελίδας αποθετηρίου» ανοίγει τη σελίδα ενός μόνο στοιχείου. Για τους συνδέσμους πολλών στοιχείων, χρησιμοποιήστε την «Αντιγραφή συνδέσμου αποθετηρίου»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Repository Page opens the page of one item. To get the links of several, use Copy Repository Link."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Abrir página del repositorio» abre la página de un solo elemento. Para obtener los enlaces de varios, usa «Copiar enlace del repositorio»."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "«باز کردن صفحهٔ مخزن» فقط صفحهٔ یک مورد را باز می‌کند. برای گرفتن پیوندهای چند مورد، از «کپی پیوند مخزن» استفاده کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Ouvrir la page du dépôt » ouvre la page d’un seul élément. Pour obtenir les liens de plusieurs éléments, utilisez « Copier le lien du dépôt »."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "״פתיחת עמוד המאגר״ פותח את העמוד של פריט אחד בלבד. כדי לקבל את הקישורים של כמה פריטים, יש להשתמש ב״העתקת קישור המאגר״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“रिपॉज़िटरी पेज खोलें” सिर्फ़ एक आइटम का पेज खोलता है। कई आइटम के लिंक पाने के लिए “रिपॉज़िटरी लिंक कॉपी करें” इस्तेमाल करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "“Buka Halaman Repositori” membuka halaman satu item saja. Untuk mendapatkan tautan beberapa item, gunakan “Salin Tautan Repositori”."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“Apri pagina del repository” apre la pagina di un solo elemento. Per ottenere i link di più elementi, usa “Copia link del repository”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「リポジトリのページを開く」は1つの項目のページを開きます。複数の項目のリンクを取得するには、「リポジトリのリンクをコピー」を使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“저장소 페이지 열기”는 한 항목의 페이지를 엽니다. 여러 항목의 링크를 얻으려면 “저장소 링크 복사”를 사용하십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "“रेपॉझिटरी पृष्ठ उघडा” एका आयटमचे पृष्ठ उघडते. अनेक आयटमच्या लिंक मिळवण्यासाठी “रेपॉझिटरी लिंक कॉपी करा” वापरा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "“Buka Halaman Repositori” membuka halaman satu item. Untuk mendapatkan pautan beberapa item, gunakan “Salin Pautan Repositori”."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Open repositorypagina” opent de pagina van één onderdeel. Gebruik „Kopieer repositorylink” om de links van meerdere onderdelen te krijgen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Otwórz stronę repozytorium” otwiera stronę jednego elementu. Aby uzyskać łącza kilku elementów, użyj „Kopiuj łącze repozytorium”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“Abrir Página do Repositório” abre a página de um item. Para obter os links de vários itens, use “Copiar Link do Repositório”."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "„Deschideți pagina depozitului” deschide pagina unui singur articol. Pentru a obține linkurile mai multor articole, folosiți „Copiați linkul depozitului”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Открыть страницу репозитория» открывает страницу одного объекта. Чтобы получить ссылки на несколько объектов, используйте «Скопировать ссылку на репозиторий»."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "“Repository பக்கத்தைத் திற” ஒரு உருப்படியின் பக்கத்தை மட்டுமே திறக்கும். பல உருப்படிகளின் இணைப்புகளைப் பெற, “Repository இணைப்பை நகலெடு” ஐப் பயன்படுத்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "“రిపోజిటరీ పేజీని తెరవండి” ఒక అంశం యొక్క పేజీని మాత్రమే తెరుస్తుంది. అనేక అంశాల లింక్‌లు పొందడానికి, “రిపోజిటరీ లింక్‌ను కాపీ చేయండి” ను ఉపయోగించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "“เปิดหน้ารีโพซิทอรี” จะเปิดหน้าของรายการเดียวเท่านั้น หากต้องการลิงก์ของหลายรายการ ให้ใช้ “คัดลอกลิงก์รีโพซิทอรี”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Depo Sayfasını Aç” tek bir öğenin sayfasını açar. Birkaç öğenin bağlantılarını almak için “Depo Bağlantısını Kopyala” komutunu kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Команда «Відкрити сторінку репозиторію» відкриває сторінку одного елемента. Щоб отримати посилання на кілька елементів, скористайтеся командою «Скопіювати посилання на репозиторій»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "“ریپازٹری صفحہ کھولیں” ایک ہی آئٹم کا صفحہ کھولتا ہے۔ کئی آئٹمز کے لنکس لینے کے لیے “ریپازٹری لنک کاپی کریں” استعمال کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“Mở trang kho git” chỉ mở trang của một mục. Để lấy liên kết của nhiều mục, hãy dùng “Sao chép liên kết kho git”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“打开仓库页面”只会打开一个项目的页面。要获取多个项目的链接，请使用“拷贝仓库链接”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「打開儲存庫頁面」只會打開一個項目的頁面。要取得多個項目的連結，請使用「拷貝儲存庫連結」。"
          }
        }
      }
    },
    "refusal.repository.outside": {
      "comment": "Why an action did nothing, shown in the alert after a click in Finder (and, in English, by the command line). %1$@ is a path, %2$@ the path of the repository's top folder: the item is a link that leads out of the repository.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%1$@ خارج المستودع الذي وجده git، وهو %2$@."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ git-এর খুঁজে পাওয়া রিপোজিটরি %2$@-এর বাইরে আছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ liegt außerhalb des von git gefundenen Repositorys %2$@."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %1$@ βρίσκεται έξω από το αποθετήριο %2$@ που βρήκε το git."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is outside the repository git found, %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ está fuera del repositorio %2$@, que encontró git."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%1$@ بیرون از مخزنی است که git پیدا کرد، یعنی %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ se trouve en dehors du dépôt %2$@ trouvé par git."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%1$@ נמצא מחוץ למאגר ש-git מצא, %2$@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ git को मिली रिपॉज़िटरी %2$@ के बाहर है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ berada di luar repositori %2$@ yang ditemukan git."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ si trova fuori dal repository %2$@ trovato da git."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@は、gitが見つけたリポジトリ%2$@の外にあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 경로는 git이 찾은 저장소 %2$@ 밖에 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ हे git ला सापडलेल्या रेपॉझिटरी %2$@ च्या बाहेर आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ berada di luar repositori %2$@ yang ditemui oleh git."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ligt buiten de door git gevonden repository %2$@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Element %1$@ znajduje się poza repozytorium, które znalazł git: %2$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ está fora do repositório encontrado pelo git, %2$@."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ se află în afara depozitului %2$@ găsit de git."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объект %1$@ находится вне репозитория, который нашел git: %2$@."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, git கண்டறிந்த repository-க்கு (%2$@) வெளியே உள்ளது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, git కనుగొన్న రిపోజిటరీ %2$@ వెలుపల ఉంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ อยู่นอกรีโพซิทอรีที่ git พบ (%2$@)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, git’in bulduğu %2$@ deposunun dışında."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Елемент %1$@ розташований поза репозиторієм, який знайшов git: %2$@."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%1$@ اس ریپازٹری سے باہر ہے جو git کو ملی، یعنی %2$@۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ nằm ngoài kho git %2$@ mà git đã tìm thấy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 位于 git 找到的仓库 %2$@ 之外。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 位於 git 找到的儲存庫 %2$@ 之外。"
          }
        }
      }
    },
    "refusal.repository.pushesElsewhere": {
      "comment": "Why an action did nothing, shown in the alert after a click in Finder (and, in English, by the command line). %@ is a remote name. The remote fetches from one repository and pushes to another (a pushurl or a pushInsteadOf setting of git), so Right Here cannot tell whether the repository it would link to has the commit. Keep `git remote add` exactly. Use the same words for remote, repository, push, checked-out commit and 'try again' as refusal.repository.notPushed.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المستودع البعيد «%@» يدفع (push) إلى مستودع غير الذي يجلب منه، لذا ليس واضحًا أيهما يحتوي على الإيداع الحالي. أنشئ للمستودع الذي تدفع إليه مستودعًا بعيدًا خاصًا به (`git remote add`)، ثم حاول مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রিমোট “%@” যে রিপোজিটরি থেকে ফেচ করে, তার বদলে অন্য একটি রিপোজিটরিতে পুশ করে, তাই দুটির কোনটিতে চেক-আউট করা কমিটটি আছে তা স্পষ্ট নয়। যে রিপোজিটরিতে পুশ করেন, সেটির জন্য আলাদা একটি রিমোট যোগ করুন (`git remote add`), তারপর আবার চেষ্টা করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Remote „%@“ pusht in ein anderes Repository als das, aus dem es fetcht, daher ist unklar, welches der beiden den ausgecheckten Commit hat. Gib dem Repository, in das du pushst, ein eigenes Remote (`git remote add`) und versuche es dann erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το απομακρυσμένο αποθετήριο «%@» κάνει push σε άλλο αποθετήριο από αυτό από το οποίο κάνει fetch, οπότε δεν είναι σαφές ποιο από τα δύο έχει το τρέχον commit. Δώστε στο αποθετήριο στο οποίο κάνετε push ένα δικό του απομακρυσμένο αποθετήριο (`git remote add`) και δοκιμάστε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote \"%@\" pushes to another repository than the one it fetches from, so it is not clear which of the two has the checked-out commit. Give the repository you push to a remote of its own (`git remote add`), then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El remoto «%@» hace push a un repositorio distinto del que usa para fetch, así que no está claro cuál de los dos tiene el commit actual. Dale al repositorio al que haces push un remoto propio (`git remote add`) y vuelve a intentarlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مخزن راه‌دور «%@» به مخزنی غیر از مخزنی که از آن fetch می‌کند push می‌کند، بنابراین روشن نیست کدام‌یک از این دو کامیت فعلی را دارد. برای مخزنی که به آن push می‌کنید یک مخزن راه‌دور جداگانه تعریف کنید (`git remote add`) و دوباره تلاش کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dépôt distant « %@ » pousse vers un autre dépôt que celui depuis lequel il récupère ; on ne sait donc pas lequel des deux contient le commit extrait. Donnez au dépôt vers lequel vous poussez un dépôt distant à lui (`git remote add`), puis réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המאגר המרוחק ״%@״ מבצע push למאגר אחר מזה שממנו הוא מבצע fetch, ולכן לא ברור איזה מהשניים מכיל את ה-commit הנוכחי. יש להגדיר למאגר שאליו מבצעים push מאגר מרוחק משלו (`git remote add`) ולנסות שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिमोट “%@” जिस रिपॉज़िटरी से फ़ेच करता है, उससे अलग रिपॉज़िटरी में पुश करता है, इसलिए यह साफ़ नहीं है कि दोनों में से किसमें चेक-आउट किया हुआ कमिट है। जिस रिपॉज़िटरी में आप पुश करते हैं, उसके लिए अलग रिमोट जोड़ें (`git remote add`), फिर दोबारा कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote “%@” melakukan push ke repositori yang berbeda dari repositori tempatnya melakukan fetch, jadi tidak jelas mana dari keduanya yang memiliki commit yang sedang di-checkout. Berikan repositori tujuan push Anda remote tersendiri (`git remote add`), lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il remote “%@” esegue il push verso un repository diverso da quello da cui esegue il fetch, quindi non è chiaro quale dei due abbia il commit del checkout attuale. Assegna al repository verso cui esegui il push un remote proprio (`git remote add`), poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモート「%@」はフェッチ元とは別のリポジトリにプッシュするため、チェックアウト中のコミットがどちらにあるかわかりません。プッシュ先のリポジトリに専用のリモートを追加（`git remote add`）してから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” 리모트는 페치하는 저장소와 다른 저장소로 푸시하므로, 체크아웃된 커밋이 둘 중 어디에 있는지 알 수 없습니다. 푸시하는 저장소에 별도의 리모트를 추가한 다음(`git remote add`) 다시 시도하십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "रिमोट “%@” ज्या रेपॉझिटरीमधून फेच करतो त्याऐवजी दुसऱ्या रेपॉझिटरीत पुश करतो, त्यामुळे चेक आउट केलेला कमिट दोन्हीपैकी कोणत्या रेपॉझिटरीत आहे ते स्पष्ट नाही. तुम्ही ज्या रेपॉझिटरीत पुश करता तिच्यासाठी स्वतंत्र रिमोट जोडा (`git remote add`) आणि पुन्हा प्रयत्न करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote “%@” membuat push ke repositori yang berbeza daripada repositori tempat ia membuat fetch, jadi tidak jelas yang mana antara kedua-duanya mempunyai komit yang di-checkout. Berikan repositori tempat anda membuat push itu remote tersendiri (`git remote add`), kemudian cuba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote „%@” pusht naar een andere repository dan die waaruit hij fetcht, dus het is niet duidelijk welke van de twee de uitgecheckte commit heeft. Geef de repository waarnaar je pusht een eigen remote (`git remote add`) en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdalne repozytorium „%@” wypycha (push) do innego repozytorium niż to, z którego pobiera (fetch), więc nie wiadomo, które z nich ma bieżący commit. Dodaj dla repozytorium, do którego wypychasz, osobne zdalne repozytorium (`git remote add`), a następnie spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O remote “%@” faz push para um repositório diferente daquele de onde faz fetch, então não está claro qual dos dois tem o commit em checkout. Dê ao repositório para o qual você faz push um remote próprio (`git remote add`) e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote-ul „%@” face push într-un alt depozit decât cel din care face fetch, deci nu este clar care dintre cele două are commitul curent. Dați depozitului în care faceți push un remote propriu (`git remote add`), apoi încercați din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаленный репозиторий «%@» отправляет изменения (push) в другой репозиторий, чем тот, из которого получает (fetch), поэтому непонятно, в каком из двух есть текущий коммит. Добавьте для репозитория, в который вы отправляете изменения, отдельный удаленный репозиторий (`git remote add`) и повторите попытку."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” என்ற remote, fetch செய்யும் repository-க்குப் பதிலாக வேறொரு repository-க்கு push செய்கிறது, எனவே இரண்டில் எதில் checkout செய்யப்பட்ட commit உள்ளது என்பது தெளிவாக இல்லை. நீங்கள் push செய்யும் repository-க்குத் தனி remote ஒன்றைச் சேர்த்து (`git remote add`), மீண்டும் முயலவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” రిమోట్ fetch చేసే రిపోజిటరీకి కాకుండా వేరే రిపోజిటరీకి push చేస్తుంది, కాబట్టి చెక్‌అవుట్ చేసిన కమిట్ రెండింటిలో దేనిలో ఉందో స్పష్టంగా లేదు. మీరు push చేసే రిపోజిటరీకి ప్రత్యేక రిమోట్‌ను జోడించి (`git remote add`), మళ్లీ ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รีโมต “%@” push ไปยังรีโพซิทอรีอื่นที่ไม่ใช่รีโพซิทอรีที่ใช้ fetch จึงไม่ชัดเจนว่า commit ที่ checkout อยู่อยู่ในรีโพซิทอรีใด ให้เพิ่มรีโมตแยกสำหรับรีโพซิทอรีที่คุณ push ไป (`git remote add`) แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” adlı remote, fetch yaptığı depodan farklı bir depoya push ediyor; bu yüzden geçerli commit’in ikisinden hangisinde olduğu belli değil. Push ettiğiniz depoya kendi remote’unu ekleyin (`git remote add`) ve tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote «%@» надсилає зміни (push) до іншого репозиторію, ніж той, з якого отримує (fetch), тому незрозуміло, в якому з двох є поточний коміт. Додайте для репозиторію, до якого ви надсилаєте зміни, окремий remote (`git remote add`) і повторіть спробу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ریموٹ “%@” جس ریپازٹری سے فیچ کرتا ہے، اس کے بجائے کسی دوسری ریپازٹری میں پش کرتا ہے، اس لیے واضح نہیں کہ دونوں میں سے کس میں چیک آؤٹ شدہ کمٹ ہے۔ جس ریپازٹری میں آپ پش کرتے ہیں اس کے لیے الگ ریموٹ شامل کریں (`git remote add`)، پھر دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote “%@” push tới một kho git khác với kho mà nó fetch, nên không rõ kho nào trong hai kho có commit đang được checkout. Hãy thêm cho kho bạn push tới một remote riêng (`git remote add`), rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远程仓库“%@”推送到的仓库与其拉取的仓库不同，因此无法确定当前检出的提交在哪一个仓库中。请为你推送到的仓库单独添加一个远程仓库（`git remote add`），然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遠端儲存庫「%@」推送到的儲存庫與其擷取的儲存庫不同，因此無法確定目前檢出的提交在哪一個儲存庫中。請為你推送到的儲存庫另外加入一個遠端儲存庫（`git remote add`），然後重試。"
          }
        }
      }
    },
    "refusal.repository.severalRemotes": {
      "comment": "Why an action did nothing, shown in the alert after a click in Finder (and, in English, by the command line). %@ is a list of remote names. origin is a name: keep it.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للمستودع عدة مستودعات بعيدة (%@)، وليس أي منها origin ولا المستودع البعيد upstream أو push للفرع، لذا ليس واضحًا بأيها يجب الربط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রিপোজিটরিটির একাধিক রিমোট আছে (%@), যার কোনোটিই origin বা ব্রাঞ্চের upstream বা push রিমোট নয়, তাই কোনটির সঙ্গে লিংক করতে হবে তা স্পষ্ট নয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Repository hat mehrere Remotes (%@), aber keines davon ist origin oder das Upstream- oder Push-Remote des Branches, daher ist unklar, auf welches verlinkt werden soll."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το αποθετήριο έχει πολλά απομακρυσμένα αποθετήρια (%@), κανένα από τα οποία δεν είναι το origin ή το upstream ή το απομακρυσμένο αποθετήριο push του κλάδου, οπότε δεν είναι σαφές προς ποιο να γίνει η σύνδεση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The repository has several remotes (%@), none of them origin or the branch's upstream or push remote, so it is not clear which one to link to."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El repositorio tiene varios remotos (%@) y ninguno es origin ni el remoto upstream o de push de la rama, así que no está claro a cuál enlazar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مخزن چند مخزن راه‌دور دارد (%@) و هیچ‌کدام origin یا مخزن راه‌دور upstream یا push شاخه نیست، بنابراین روشن نیست به کدام باید پیوند داد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dépôt a plusieurs dépôts distants (%@), dont aucun n’est origin ni le dépôt distant upstream ou de push de la branche ; on ne sait donc pas vers lequel créer le lien."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "למאגר יש כמה מאגרים מרוחקים (%@), ואף אחד מהם אינו origin או מאגר ה-upstream או ה-push של הענף, ולכן לא ברור לאיזה מהם לקשר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिपॉज़िटरी के कई रिमोट हैं (%@), जिनमें से कोई भी origin या ब्रांच का upstream या push रिमोट नहीं है, इसलिए यह साफ़ नहीं है कि किससे लिंक करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Repositori ini memiliki beberapa remote (%@), dan tidak satu pun adalah origin atau remote upstream atau push dari branch, jadi tidak jelas remote mana yang harus ditautkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il repository ha più remote (%@), nessuno dei quali è origin, l’upstream del branch o il suo remote di push, quindi non è chiaro per quale creare il link."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リポジトリに複数のリモート（%@）があり、どれもoriginでも、ブランチのアップストリームやプッシュ先のリモートでもないため、どれにリンクすればよいかわかりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장소에 리모트가 여러 개(%@) 있는데, 그중 어느 것도 origin이나 브랜치의 업스트림 또는 푸시 리모트가 아니므로 어느 리모트로 링크해야 할지 알 수 없습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "रेपॉझिटरीला अनेक रिमोट आहेत (%@), आणि त्यापैकी कोणताही origin नाही, किंवा ब्रांचचा अपस्ट्रीम किंवा पुश रिमोट नाही, त्यामुळे कोणत्या रिमोटची लिंक द्यायची ते स्पष्ट नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Repositori ini mempunyai beberapa remote (%@), dan tiada satu pun daripadanya ialah origin atau remote upstream atau push bagi cawangan itu, jadi tidak jelas remote mana yang hendak dipautkan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De repository heeft meerdere remotes (%@), en geen ervan is origin of de upstream- of push-remote van de branch, dus het is niet duidelijk naar welke gelinkt moet worden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Repozytorium ma kilka zdalnych repozytoriów (%@), a żadne z nich nie jest origin ani zdalnym repozytorium upstream lub push gałęzi, więc nie wiadomo, do którego utworzyć łącze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O repositório tem vários remotes (%@), e nenhum deles é origin nem o upstream ou o remote de push da branch, então não está claro para qual criar o link."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Depozitul are mai multe remote-uri (%@), dintre care niciunul nu este origin sau remote-ul upstream ori de push al ramurii, deci nu este clar către care să se facă linkul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В репозитории несколько удаленных репозиториев (%@), и ни один из них не является origin, upstream ветки или удаленным репозиторием для push, поэтому непонятно, на какой из них давать ссылку."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த repository-க்குப் பல remote-கள் உள்ளன (%@); அவற்றில் எதுவும் origin அல்ல, branch-இன் upstream அல்லது push remote-உம் அல்ல, எனவே எதற்கு இணைப்பு கொடுப்பது என்பது தெளிவாக இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ రిపోజిటరీకి అనేక రిమోట్‌లు ఉన్నాయి (%@); వాటిలో ఏదీ origin కాదు, బ్రాంచ్ యొక్క upstream లేదా push రిమోట్ కూడా కాదు, కాబట్టి దేనికి లింక్ ఇవ్వాలో స్పష్టంగా లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รีโพซิทอรีนี้มีรีโมตหลายตัว (%@) แต่ไม่มีตัวใดเป็น origin หรือเป็นรีโมต upstream หรือรีโมต push ของ branch จึงไม่ชัดเจนว่าควรลิงก์ไปที่ตัวใด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Depoda birkaç remote var (%@) ve hiçbiri origin, dalın upstream’i ya da push remote’u değil; bu yüzden hangisine bağlantı verileceği belli değil."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Репозиторій має кілька remote (%@), і жоден із них не є origin, upstream гілки чи remote для push, тому незрозуміло, на який із них дати посилання."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس ریپازٹری کے کئی ریموٹ ہیں (%@)، اور ان میں سے کوئی بھی origin نہیں، نہ ہی برانچ کا upstream یا push ریموٹ ہے، اس لیے واضح نہیں کہ کس کا لنک بنایا جائے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kho git có nhiều remote (%@), nhưng không remote nào là origin, upstream hay remote push của nhánh, nên không rõ phải liên kết tới remote nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该仓库有多个远程仓库（%@），但没有一个是 origin，也不是当前分支的上游或推送远程仓库，因此无法确定该链接到哪一个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該儲存庫有多個遠端儲存庫（%@），但沒有一個是 origin，也不是目前分支的上游或推送遠端儲存庫，因此無法確定該連結到哪一個。"
          }
        }
      }
    },
    "refusal.repository.submodule": {
      "comment": "Why an action did nothing, shown in the alert after a click in Finder (and, in English, by the command line). %@ is a folder name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%@ وحدة فرعية (submodule): صفحاتها في مستودعها الخاص. حدّد عنصرًا داخلها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ একটি সাবমডিউল: এর পৃষ্ঠাগুলো এর নিজস্ব রিপোজিটরিতে আছে। এর ভেতরের একটি আইটেম নির্বাচন করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist ein Submodul: Seine Seiten liegen in seinem eigenen Repository. Wähle ein Objekt darin aus."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %@ είναι υπομονάδα (submodule): οι σελίδες του βρίσκονται στο δικό του αποθετήριο. Επιλέξτε ένα στοιχείο μέσα σε αυτό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is a submodule: its pages are in its own repository. Select an item inside it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ es un submódulo: sus páginas están en su propio repositorio. Selecciona un elemento dentro de él."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%@ یک زیرماژول است: صفحه‌هایش در مخزن خودش هستند. موردی را درون آن انتخاب کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est un sous-module : ses pages se trouvent dans son propre dépôt. Sélectionnez un élément à l’intérieur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%@ הוא תת-מודול (submodule): העמודים שלו נמצאים במאגר משלו. יש לבחור פריט בתוכו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ एक सबमॉड्यूल है: इसके पेज इसकी अपनी रिपॉज़िटरी में हैं। इसके अंदर का कोई आइटम चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ adalah submodul: halamannya ada di repositorinya sendiri. Pilih item di dalamnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è un submodule: le sue pagine sono nel suo repository. Seleziona un elemento al suo interno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はサブモジュールです。そのページはサブモジュール自身のリポジトリにあります。その中の項目を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 폴더는 서브모듈입니다. 해당 페이지는 서브모듈 자체의 저장소에 있습니다. 그 안의 항목을 선택하십시오."
