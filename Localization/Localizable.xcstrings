          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "general.terminal で別のターミナルを選ぶか、%1$@ または %2$@ を設定してください。"
          }
        },
        "ko": {
          "stringUnit": {
