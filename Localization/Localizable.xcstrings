    "doctor.fix.agentLauncher": {
      "comment": "Fix line under a check in the setup window's Details list: what the person should do. A sentence. general.terminal is a config setting: keep it exactly. %1$@ is the setting launcher = \"link\" and %2$@ the word \"desktop\" in quotes (technical text, shown as it is); translate only the word or between them.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر وحدة طرفية أخرى باستخدام general.terminal، أو اضبط %1$@ أو %2$@."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "general.terminal দিয়ে অন্য একটি টার্মিনাল বেছে নিন, অথবা %1$@ বা %2$@ সেট করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle mit general.terminal ein anderes Terminal, oder setze %1$@ oder %2$@."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε άλλο τερματικό με το general.terminal ή ορίστε %1$@ ή %2$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose another terminal with general.terminal, or set %1$@ or %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige otra terminal con general.terminal o define %1$@ o %2$@."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با general.terminal ترمینال دیگری انتخاب کنید، یا %1$@ یا %2$@ را تنظیم کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un autre terminal avec general.terminal, ou définissez %1$@ ou %2$@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לבחור מסוף אחר עם general.terminal, או להגדיר %1$@ או %2$@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "general.terminal से कोई दूसरा टर्मिनल चुनें, या %1$@ या %2$@ सेट करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
