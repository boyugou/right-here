        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ப்ராம்ப்ட்டில் வரி முறிவு அல்லது வேறொரு கட்டுப்பாட்டு எழுத்து உள்ளது."
          }
        },
        "te": {
