            "value": "config.toml de la carpeta aún no se ha descargado (o no se puede leer)"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "‏config.toml در پوشه هنوز دانلود نشده است (یا خوانده نمی‌شود)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
