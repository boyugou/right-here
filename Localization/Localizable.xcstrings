          "stringUnit": {
            "state": "translated",
            "value": "git, %1$@ öğesinin deposunu okuyamadı: %2$@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "git не може прочитати репозиторій для %1$@: %2$@"
