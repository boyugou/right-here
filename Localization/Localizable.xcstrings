    "doctor.fix.editorFallback": {
      "comment": "Fix line under the check \"Default editor\" in the setup window's Details list: what the person should do. A sentence. \"it\" is the editor the config chooses, which is not installed. general.editor is a config setting: keep it exactly.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثبّته، أو غيّر general.editor (أزل الإعداد لاستخدام أول محرر مثبَّت)."
