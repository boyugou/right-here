          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "`rh menu --explain` を実行して、各項目が除外された理由を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "`rh menu --explain` 명령을 실행하여 각 항목이 빠진 이유를 확인하세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
