    "app.mcpCopied": {
      "comment": "Confirmation after the button app.copyMCPConfig was pressed.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تم نسخ إعدادات MCP. الصقها في إعدادات MCP لدى مساعدك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "MCP কনফিগারেশন কপি হয়েছে. আপনার সহকারীর MCP সেটিংসে এটি পেস্ট করুন."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "MCP-Konfiguration kopiert. Fügen Sie sie in die MCP-Einstellungen Ihres Assistenten ein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Η ρύθμιση MCP αντιγράφηκε. Επικολλήστε την στις ρυθμίσεις MCP του βοηθού σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MCP configuration copied. Paste it into your assistant's MCP settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Configuración de MCP copiada. Péguela en los ajustes de MCP de su asistente."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "پیکربندی MCP کپی شد. آن را در تنظیمات MCP دستیار خود جای‌گذاری کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Configuration MCP copiée. Collez-la dans les réglages MCP de votre assistant."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "תצורת MCP הועתקה. הדביקו אותה בהגדרות MCP של העוזר שלכם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "MCP कॉन्फ़िगरेशन कॉपी हो गई। इसे अपने AI असिस्टेंट की MCP सेटिंग में पेस्ट करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Konfigurasi MCP disalin. Tempelkan ke pengaturan MCP asisten Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Configurazione MCP copiata. Incollala nelle impostazioni MCP del tuo assistente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "MCP の設定をコピーしました。AIアシスタントの MCP 設定にペーストしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "MCP 설정을 복사했습니다. 어시스턴트의 MCP 설정에 붙여넣으세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "MCP कॉन्फिगरेशन कॉपी झाले. ते तुमच्या असिस्टंटच्या MCP सेटिंग्जमध्ये पेस्ट करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Konfigurasi MCP telah disalin. Tampalkannya dalam tetapan MCP pembantu anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "MCP-configuratie gekopieerd. Plak die in de MCP-instellingen van je assistent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skopiowano konfigurację MCP. Wklej ją w ustawieniach MCP asystenta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Configuração MCP copiada. Cole-a nas configurações MCP do seu assistente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Configurația MCP a fost copiată. Lipiți-o în setările MCP ale asistentului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Конфигурация MCP скопирована. Вставьте её в настройки MCP вашего ассистента."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "MCP உள்ளமைவு நகலெடுக்கப்பட்டது. அதை உங்கள் உதவியாளரின் MCP அமைப்புகளில் ஒட்டவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "needs_review",
            "value": "MCP కాన్ఫిగరేషన్ కాపీ చేయబడింది. దాన్ని మీ సహాయకుడి MCP సెట్టింగ్లలో అతికించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "คัดลอกการกำหนดค่า MCP แล้ว วางลงในการตั้งค่า MCP ของผู้ช่วยของคุณ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "MCP yapılandırması kopyalandı. Bunu asistanınızın MCP ayarlarına yapıştırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Конфігурацію MCP скопійовано. Вставте її в налаштування MCP вашого асистента."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "‏MCP کنفیگریشن کاپی ہو گئی۔ اسے اپنے اسسٹنٹ کی MCP سیٹنگز میں پیسٹ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đã sao chép cấu hình MCP. Hãy dán vào phần cài đặt MCP của trợ lý."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已拷贝 MCP 配置。请将其粘贴到助手的 MCP 设置中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已拷貝 MCP 設定。請將其貼到助理的 MCP 設定中。"
          }
        }
      }
    },
    "app.menuCaption": {
      "comment": "Caption under the title of the Finder menu preview in the setup window: it shows the menu for a folder, and Finder adds items for selected files when files are selected. Two short sentences at most.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "هذه قائمة المجلد. تظهر العناصر الخاصة بالملفات المحددة عند تحديد ملفات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এটি একটি ফোল্ডারের মেনু। আপনি ফাইল নির্বাচন করলে নির্বাচিত ফাইলের জন্য আইটেমগুলো দেখা যায়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das ist das Menü für einen Ordner. Befehle für ausgewählte Dateien erscheinen, wenn du Dateien auswählst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Αυτό είναι το μενού για έναν φάκελο. Τα στοιχεία για επιλεγμένα αρχεία εμφανίζονται όταν επιλέξετε αρχεία."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the menu for a folder. Items for selected files appear when you select files."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este es el menú para una carpeta. Los comandos para los archivos seleccionados aparecen cuando seleccionas archivos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "این منوی یک پوشه است. گزینه‌های مربوط به پرونده‌های انتخاب‌شده وقتی پرونده انتخاب می‌کنید ظاهر می‌شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Voici le menu d’un dossier. Les commandes pour les fichiers sélectionnés apparaissent lorsque vous sélectionnez des fichiers."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "זהו התפריט לתיקייה. פריטים עבור הקבצים שנבחרו מופיעים כשאתה בוחר קבצים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यह एक फ़ोल्डर का मेनू है। चयनित फ़ाइलों के आइटम तभी दिखते हैं, जब आप फ़ाइलें चुनते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ini adalah menu untuk folder. Item untuk file yang dipilih muncul saat Anda memilih file."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questo è il menu per una cartella. I comandi per i file selezionati compaiono quando selezioni dei file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "これはフォルダ用のメニューです。選択したファイル向けの項目は、ファイルを選択したときに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이것은 폴더용 메뉴입니다. 선택한 파일에 해당하는 항목은 파일을 선택하면 나타납니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "हा एका फोल्डरचा मेनू आहे. निवडलेल्या फाइल्ससाठीचे आयटम्स तुम्ही फाइल्स निवडता तेव्हा दिसतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ini ialah menu untuk folder. Item untuk fail yang dipilih muncul apabila anda memilih fail."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dit is het menu voor een map. Opdrachten voor geselecteerde bestanden verschijnen wanneer je bestanden selecteert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "To jest menu dla folderu. Pozycje dotyczące plików pojawiają się dopiero po ich zaznaczeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este é o menu para uma pasta. Os itens para arquivos aparecem somente quando arquivos são selecionados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Acesta este meniul pentru un folder. Elementele pentru fișiere apar doar la selectarea fișierelor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Это меню для папки. Пункты для выбранных файлов появляются только при выборе файлов."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இது ஒரு கோப்புறைக்கான மெனு. நீங்கள் கோப்புகளைத் தேர்ந்தெடுக்கும்போது, தேர்ந்தெடுத்த கோப்புகளுக்கான உருப்படிகள் தோன்றும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ఇది ఫోల్డర్ కోసం మెనూ. మీరు ఫైల్స్ ఎంచుకున్నప్పుడు, ఎంచుకున్న ఫైల్స్ కోసం అంశాలు కనిపిస్తాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "นี่คือเมนูสำหรับโฟลเดอร์ รายการสำหรับไฟล์ที่เลือกจะปรากฏขึ้นเมื่อคุณเลือกไฟล์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu, bir klasör için menüdür. Seçili dosyalara yönelik öğeler, dosya seçtiğinizde görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Це меню для папки. Пункти для файлів відображаються лише тоді, коли файли виділено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "یہ فولڈر کا مینو ہے۔ منتخب فائلوں سے متعلق آئٹمز اس وقت ظاہر ہوتے ہیں جب آپ فائلیں منتخب کرتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đây là trình đơn cho một thư mục. Các mục dành cho tệp đã chọn chỉ xuất hiện khi bạn chọn tệp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "这是文件夹的菜单。选中文件时，针对所选文件的项目才会出现。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "這是資料夾的選單。選取檔案時，針對所選檔案的項目才會出現。"
          }
        }
      }
    },
    "app.menuEmpty": {
      "comment": "Text in the Finder menu section of the setup window when the config leaves the menu empty or has an error. 'Checks' is the name of a section of the window (app.tabChecks); use the same word.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا توجد قائمة لعرضها الآن. يُذكر السبب ضمن الفحوصات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এই মুহূর্তে দেখানোর মতো কোনো মেনু নেই. কারণটি চেক-এ তালিকাভুক্ত আছে."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Im Moment gibt es kein Menü zum Anzeigen. Der Grund steht unter Prüfungen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Δεν υπάρχει μενού για εμφάνιση αυτή τη στιγμή. Η αιτία αναφέρεται στους Ελέγχους."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no menu to show right now. The reason is listed under Checks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ahora mismo no hay ningún menú que mostrar. El motivo aparece en Comprobaciones."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "در حال حاضر منوی قابل نمایشی وجود ندارد. دلیل آن در بخش بررسی‌ها فهرست شده است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aucun menu à afficher pour l’instant. La raison figure sous Vérifications."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "אין כרגע תפריט להצגה. הסיבה מופיעה תחת בדיקות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अभी दिखाने के लिए कोई मेन्यू नहीं है। कारण जाँच में सूचीबद्ध है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tidak ada menu yang bisa ditampilkan saat ini. Alasannya tercantum di bagian Pemeriksaan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Al momento non c'è nessun menu da mostrare. Il motivo è elencato in Controlli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "現在表示できるメニューがありません。理由は「確認」に表示されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "지금은 표시할 메뉴가 없습니다. 이유는 확인 항목에 나와 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सध्या दाखवण्यासाठी कोणताही मेनू नाही. त्याचे कारण तपासण्या विभागात दिले आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tiada menu untuk dipaparkan buat masa ini. Sebabnya disenaraikan di bawah Semakan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Er is op dit moment geen menu om te tonen. De reden staat onder Controles."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie ma teraz menu do pokazania. Przyczyna jest podana w sekcji Kontrole."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No momento não há menu para mostrar. O motivo está listado em Verificações."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Momentan nu există niciun meniu de afișat. Motivul este indicat în secțiunea Verificări."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сейчас нет меню для показа. Причина перечислена в разделе Проверки."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இப்போது காட்ட மெனு எதுவும் இல்லை. காரணம் சோதனைகளின் கீழ் பட்டியலிடப்பட்டுள்ளது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ప్రస్తుతం చూపించడానికి మెనూ ఏదీ లేదు. కారణం తనిఖీల కింద జాబితా చేయబడింది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ตอนนี้ไม่มีเมนูให้แสดง เหตุผลแสดงอยู่ใต้การตรวจสอบ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
