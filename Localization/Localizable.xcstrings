    "refusal.terminalTooOld": {
      "comment": "Why an action did nothing, shown in the alert after a click in Finder (and, in English, by the command line). %1$@ is a terminal app (Ghostty, iTerm), %2$@ its installed version, %3$@ the first version that can.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع %1$@ %2$@ تنفيذ الأوامر؛ الإصدار %3$@ أو أحدث يستطيع ذلك. حدّث التطبيق أو اختر وحدة طرفية أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ কমান্ড চালাতে পারে না; সংস্করণ %3$@ বা তার পরের সংস্করণ পারে। অ্যাপটি আপডেট করুন, অথবা অন্য একটি টার্মিনাল বেছে নিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ kann keine Befehle ausführen; ab Version %3$@ ist das möglich. Aktualisiere die App oder wähle ein anderes Terminal."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %1$@ %2$@ δεν μπορεί να εκτελεί εντολές· η έκδοση %3$@ ή νεότερη μπορεί. Ενημερώστε την εφαρμογή ή επιλέξτε άλλο τερματικό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ cannot run commands; version %3$@ or later can. Update it or choose another terminal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ no puede ejecutar comandos; la versión %3$@ o posterior sí puede. Actualiza la app o elige otra terminal."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%1$@ %2$@ نمی‌تواند دستور اجرا کند؛ نسخهٔ %3$@ یا جدیدتر می‌تواند. برنامه را به‌روزرسانی کنید یا ترمینال دیگری انتخاب کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ ne peut pas exécuter de commandes ; la version %3$@ ou ultérieure le peut. Mettez l’app à jour ou choisissez un autre terminal."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%1$@ %2$@ לא יכול להריץ פקודות; גירסה %3$@ ואילך יכולה. יש לעדכן את היישום או לבחור מסוף אחר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ कमांड नहीं चला सकता; संस्करण %3$@ या उसके बाद का संस्करण चला सकता है। ऐप अपडेट करें या कोई दूसरा टर्मिनल चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ tidak dapat menjalankan perintah; versi %3$@ atau yang lebih baru dapat melakukannya. Perbarui app tersebut atau pilih terminal lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ non può eseguire comandi; può farlo la versione %3$@ o successiva. Aggiorna l’app o scegli un altro terminale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ではコマンドを実行できません。バージョン%3$@以降で実行できます。アップデートするか、別のターミナルを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ 버전은 명령을 실행할 수 없습니다. %3$@ 이상 버전에서 실행할 수 있습니다. 업데이트하거나 다른 터미널을 선택하십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ कमांड चालवू शकत नाही; आवृत्ती %3$@ किंवा त्यानंतरची आवृत्ती चालवू शकते. ते अपडेट करा किंवा दुसरे टर्मिनल निवडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ tidak dapat menjalankan perintah; versi %3$@ atau lebih baharu boleh. Kemas kini aplikasi itu atau pilih terminal lain."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ kan geen commando’s uitvoeren; versie %3$@ of nieuwer kan dat wel. Werk de app bij of kies een andere terminal."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja %1$@ w wersji %2$@ nie może uruchamiać poleceń; potrafi to wersja %3$@ lub nowsza. Zaktualizuj ją albo wybierz inny terminal."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O %1$@ %2$@ não consegue executar comandos; a versão %3$@ ou posterior consegue. Atualize o app ou escolha outro terminal."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ nu poate rula comenzi; versiunea %3$@ sau una mai nouă poate. Actualizați aplicația sau alegeți alt terminal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение «%1$@» версии %2$@ не может выполнять команды; это умеет версия %3$@ или новее. Обновите его или выберите другой терминал."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ ஆல் கட்டளைகளை இயக்க முடியாது; பதிப்பு %3$@ அல்லது அதற்குப் பிந்தைய பதிப்பால் முடியும். அதைப் புதுப்பிக்கவும், அல்லது வேறொரு டெர்மினலைத் தேர்ந்தெடுக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ ఆదేశాలను అమలు చేయలేకపోతుంది; వెర్షన్ %3$@ లేదా ఆ తర్వాతి వెర్షన్ చేయగలదు. దాన్ని అప్‌డేట్ చేయండి లేదా మరో టెర్మినల్‌ను ఎంచుకోండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ รันคำสั่งไม่ได้ ต้องเป็นเวอร์ชั่น %3$@ ขึ้นไป อัปเดตแอปหรือเลือกเทอร์มินัลอื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ komut çalıştıramaz; %3$@ veya sonraki sürümler çalıştırabilir. Uygulamayı güncelleyin ya da başka bir terminal seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ не може виконувати команди; це вміє версія %3$@ або новіша. Оновіть програму або виберіть інший термінал."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%1$@ %2$@ کمانڈز نہیں چلا سکتا؛ ورژن %3$@ یا اس کے بعد کا ورژن چلا سکتا ہے۔ اسے اپ ڈیٹ کریں یا کوئی اور ٹرمینل منتخب کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ không thể chạy lệnh; phiên bản %3$@ trở lên thì có thể. Hãy cập nhật ứng dụng hoặc chọn terminal khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ 无法运行命令；%3$@ 或更高版本才可以。请更新它，或选择其他终端。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ 無法執行指令；%3$@ 或更新的版本才可以。請更新它，或選擇其他終端機。"
          }
        }
      }
    },
    "refusal.timedOut": {
      "comment": "Why an action did nothing, shown in the alert after a click in Finder (and, in English, by the command line). %1$@ is a step, in English; %2$@ a number of seconds.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يكتمل %1$@ في الوقت المحدد وتم إيقافه (الحد: %2$@ ثانية). إذا كان macOS ينتظر أن تسمح لتطبيق Right Here بالتحكم في أحد التطبيقات (طلب إذن)، فأجب عنه ثم حاول مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ সময়মতো শেষ হয়নি এবং থামিয়ে দেওয়া হয়েছে (সীমা: %2$@ সেকেন্ড)। macOS যদি অপেক্ষা করে যে আপনি Right Here-কে কোনো অ্যাপ নিয়ন্ত্রণ করার অনুমতি দেবেন (একটি অনুমতির প্রশ্ন), তাহলে সেটির উত্তর দিন এবং আবার চেষ্টা করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ wurde nicht rechtzeitig fertig und wurde abgebrochen (Limit: %2$@ s). Falls macOS darauf wartet, dass du Right Here erlaubst, eine App zu steuern (eine Berechtigungsabfrage), beantworte sie und versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %1$@ δεν ολοκληρώθηκε εγκαίρως και διακόπηκε (όριο: %2$@ δευτ.). Αν το macOS περιμένει να επιτρέψετε στο Right Here να ελέγξει μια εφαρμογή (μια ερώτηση για άδεια), απαντήστε και δοκιμάστε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ did not finish in time and was stopped (limit: %2$@ s). If macOS is waiting for you to allow Right Here to control an app (a permission prompt), answer it and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ no terminó a tiempo y se detuvo (límite: %2$@ s). Si macOS está esperando a que permitas que Right Here controle una app (una solicitud de permiso), respóndela y vuelve a intentarlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%1$@ به‌موقع تمام نشد و متوقف شد (حد: %2$@ ثانیه). اگر macOS منتظر است که به Right Here اجازهٔ کنترل یک برنامه را بدهید (یک درخواست مجوز)، به آن پاسخ دهید و دوباره تلاش کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ne s’est pas terminé à temps et a été arrêté (limite : %2$@ s). Si macOS attend que vous autorisiez Right Here à contrôler une app (une demande d’autorisation), répondez-y et réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%1$@ לא הסתיים בזמן והופסק (מגבלה: %2$@ שניות). אם macOS ממתין לאישור לכך ש-Right Here ישלוט ביישום (בקשת הרשאה), יש להשיב לבקשה ולנסות שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ समय पर पूरा नहीं हुआ और रोक दिया गया (सीमा: %2$@ सेकंड)। अगर macOS इस इंतज़ार में है कि आप Right Here को किसी ऐप को नियंत्रित करने की अनुमति दें (अनुमति का सवाल), तो उसका जवाब दें और दोबारा कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tidak selesai tepat waktu dan dihentikan (batas: %2$@ detik). Jika macOS sedang menunggu Anda mengizinkan Right Here mengontrol sebuah app (permintaan izin), jawab permintaan itu, lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ non è terminato in tempo ed è stato interrotto (limite: %2$@ s). Se macOS sta aspettando che tu consenta a Right Here di controllare un’app (una richiesta di permesso), rispondi e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@が時間内に終わらなかったため、停止しました（制限：%2$@秒）。macOSが、Right Hereにアプリの制御を許可するかどうかの確認を表示している場合は、それに応答してから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 단계가 제시간에 끝나지 않아 중지되었습니다(제한: %2$@초). macOS가 Right Here의 앱 제어를 허용할지 묻고 있다면(권한 요청) 응답한 다음 다시 시도하십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ वेळेत पूर्ण झाले नाही आणि थांबवले गेले (मर्यादा: %2$@ सेकंद). Right Here ला एखादे ॲप नियंत्रित करण्याची परवानगी तुम्ही द्यावी म्हणून macOS वाट पाहत असेल (परवानगी विचारणा), तर त्याला उत्तर द्या आणि पुन्हा प्रयत्न करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tidak selesai dalam masa dan telah dihentikan (had: %2$@ s). Jika macOS sedang menunggu anda membenarkan Right Here mengawal aplikasi (gesaan kebenaran), jawab gesaan itu dan cuba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ was niet op tijd klaar en is gestopt (limiet: %2$@ s). Als macOS wacht tot je Right Here toestemming geeft om een app te bedienen (een toestemmingsvraag), beantwoord die dan en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Krok %1$@ nie zakończył się na czas i został zatrzymany (limit: %2$@ s). Jeśli macOS czeka, aż zezwolisz Right Here na sterowanie aplikacją (pytanie o uprawnienia), odpowiedz na nie i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ não terminou a tempo e foi interrompido (limite: %2$@ s). Se o macOS estiver esperando você permitir que o Right Here controle um app (um pedido de permissão), responda e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ nu s-a terminat la timp și a fost oprit (limită: %2$@ s). Dacă macOS așteaptă să permiteți aplicației Right Here să controleze o aplicație (o solicitare de permisiune), răspundeți și încercați din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаг %1$@ не завершился вовремя и был остановлен (лимит: %2$@ с). Если macOS ждет, пока Вы разрешите Right Here управлять приложением (запрос разрешения), ответьте на запрос и повторите попытку."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ நேரத்திற்குள் முடியவில்லை, எனவே நிறுத்தப்பட்டது (வரம்பு: %2$@ வினாடிகள்). Right Here ஒரு செயலியைக் கட்டுப்படுத்த நீங்கள் அனுமதிப்பதற்காக macOS காத்திருந்தால் (அனுமதிக் கேள்வி), அதற்குப் பதிலளித்து மீண்டும் முயலவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ సమయానికి పూర్తి కాలేదు, కాబట్టి ఆపివేయబడింది (పరిమితి: %2$@ సెకన్లు). Right Here ఒక యాప్‌ను నియంత్రించడానికి మీరు అనుమతించాలని macOS వేచి ఉంటే (అనుమతి ప్రశ్న), దానికి సమాధానం ఇచ్చి మళ్లీ ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ทำงานไม่เสร็จทันเวลาและถูกหยุด (จำกัด %2$@ วินาที) หาก macOS กำลังรอให้คุณอนุญาตให้ Right Here ควบคุมแอป (หน้าต่างขออนุญาต) ให้ตอบหน้าต่างนั้นแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ adımı zamanında bitmedi ve durduruldu (sınır: %2$@ sn). macOS, Right Here’in bir uygulamayı denetlemesine izin vermenizi bekliyorsa (bir izin istemi), istemi yanıtlayın ve tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Крок %1$@ не завершився вчасно, тому його зупинено (ліміт: %2$@ с). Якщо macOS чекає, поки ви дозволите Right Here керувати програмою (запит на дозвіл), дайте відповідь на запит і повторіть спробу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%1$@ وقت پر مکمل نہیں ہوا اور اسے روک دیا گیا (حد: %2$@ سیکنڈ)۔ اگر macOS اس انتظار میں ہے کہ آپ Right Here کو کسی ایپ کو کنٹرول کرنے کی اجازت دیں (اجازت کا پرامپٹ)، تو اس کا جواب دیں اور دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ không hoàn tất kịp thời gian nên đã bị dừng (giới hạn: %2$@ giây). Nếu macOS đang chờ bạn cho phép Right Here điều khiển một ứng dụng (hộp thoại xin quyền), hãy trả lời hộp thoại đó rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 未能按时完成，已被停止（限时：%2$@ 秒）。如果 macOS 正在等待你允许 Right Here 控制某个 App（权限提示），请作出回应，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 未能按時完成，已被停止（限時：%2$@ 秒）。如果 macOS 正在等待你允許 Right Here 控制某個 App（權限提示），請作出回應，然後重試。"
          }
        }
      }
    },
    "refusal.typesFolderBackslash": {
      "comment": "Why an action did nothing, shown in the alert after a click in Finder (and, in English, by the command line). %1$@ is a terminal app (Terminal, iTerm), %2$@ a path.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يكتب %1$@ المجلد في برنامج Shell، وبرامج Shell تختلف في قراءة الشرطة المائلة العكسية في الاسم، لذا لن يبدأ أي أمر في %2$@. أعد تسمية المجلد، أو استخدم وحدة طرفية يُسلَّم إليها المجلد مباشرةً، مثل Ghostty."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ফোল্ডারটি একটি শেলে টাইপ করে, আর নামের ভেতরের ব্যাকস্ল্যাশ বিভিন্ন শেল বিভিন্নভাবে পড়ে, তাই %2$@-এ কোনো কমান্ড শুরু হবে না। ফোল্ডারটির নাম বদলান, অথবা এমন একটি টার্মিনাল ব্যবহার করুন যাকে ফোল্ডারটি সরাসরি দেওয়া হয়, যেমন Ghostty।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ gibt den Ordner in eine Shell ein, und Shells lesen einen Backslash in einem Namen unterschiedlich, daher wird in %2$@ kein Befehl gestartet. Benenne den Ordner um oder nutze ein Terminal, dem der Ordner direkt übergeben wird, etwa Ghostty."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %1$@ πληκτρολογεί τον φάκελο σε ένα κέλυφος, και τα κελύφη δεν διαβάζουν όλα με τον ίδιο τρόπο μια ανάστροφη κάθετο σε ένα όνομα, οπότε δεν θα ξεκινήσει καμία εντολή στο %2$@. Μετονομάστε τον φάκελο ή χρησιμοποιήστε ένα τερματικό στο οποίο παραδίδεται απευθείας ο φάκελος, όπως το Ghostty."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ types the folder into a shell, and shells disagree about a backslash in a name, so it will not start a command in %2$@. Rename the folder, or use a terminal that is handed the folder, such as Ghostty."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ escribe la carpeta en un shell, y los shells no leen igual una barra invertida en un nombre, así que no se iniciará ningún comando en %2$@. Cambia el nombre de la carpeta o usa una terminal que reciba la carpeta directamente, como Ghostty."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%1$@ پوشه را در یک پوسته تایپ می‌کند و پوسته‌ها بک‌اسلش در نام را یکسان نمی‌خوانند، بنابراین هیچ دستوری در %2$@ اجرا نمی‌شود. نام پوشه را تغییر دهید، یا از ترمینالی استفاده کنید که پوشه مستقیماً به آن داده می‌شود، مانند Ghostty."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ saisit le dossier dans un shell, et les shells ne lisent pas tous de la même façon une barre oblique inverse dans un nom ; aucune commande ne sera donc lancée dans %2$@. Renommez le dossier ou utilisez un terminal qui reçoit directement le dossier, comme Ghostty."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%1$@ מקליד את התיקיה במעטפת, והמעטפות לא קוראות באותו אופן לוכסן הפוך בשם, ולכן לא תופעל פקודה ב-%2$@. יש לשנות את שם התיקיה, או להשתמש במסוף שהתיקיה מועברת אליו ישירות, כמו Ghostty."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ फ़ोल्डर को शेल में टाइप करता है, और नाम में बैकस्लैश को अलग-अलग शेल अलग तरह से पढ़ते हैं, इसलिए %2$@ में कोई कमांड शुरू नहीं होगी। फ़ोल्डर का नाम बदलें, या ऐसा टर्मिनल इस्तेमाल करें जिसे फ़ोल्डर सीधे सौंपा जाता है, जैसे Ghostty।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ mengetik folder ke dalam shell, dan shell tidak sepakat tentang cara membaca garis miring terbalik dalam nama, jadi tidak ada perintah yang akan dijalankan di %2$@. Ganti nama folder tersebut, atau gunakan terminal yang menerima folder secara langsung, seperti Ghostty."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ digita la cartella in una shell, e le shell non concordano su una barra rovesciata in un nome, quindi in %2$@ non verrà avviato alcun comando. Rinomina la cartella, oppure usa un terminale a cui viene passata la cartella, come Ghostty."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@はフォルダをシェルに入力しますが、名前に含まれるバックスラッシュの解釈はシェルによって異なるため、%2$@ではコマンドを起動しません。フォルダの名前を変更するか、Ghosttyのようにフォルダを直接受け取るターミナルを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 앱은 폴더를 셸에 입력하는데, 이름 속 백슬래시를 셸마다 다르게 읽으므로 %2$@ 경로에서는 명령을 시작하지 않습니다. 폴더 이름을 바꾸거나, Ghostty처럼 폴더를 직접 전달받는 터미널을 사용하십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ फोल्डर शेलमध्ये टाइप करते, आणि नावातील बॅकस्लॅश सर्व शेल सारखा वाचत नाहीत, त्यामुळे %2$@ मध्ये कमांड सुरू केली जाणार नाही. फोल्डरचे नाव बदला, किंवा Ghostty सारखे फोल्डर थेट दिले जाणारे टर्मिनल वापरा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ menaip folder ke dalam cangkerang, dan cangkerang tidak sepakat tentang garis condong terbalik dalam nama, jadi perintah tidak akan dimulakan dalam %2$@. Namakan semula folder itu, atau gunakan terminal yang menerima folder secara terus, seperti Ghostty."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ typt de map in een shell, en shells lezen een backslash in een naam niet allemaal op dezelfde manier, dus er wordt geen commando gestart in %2$@. Wijzig de naam van de map, of gebruik een terminal die de map rechtstreeks krijgt, zoals Ghostty."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja %1$@ wpisuje folder do powłoki, a powłoki różnie odczytują ukośnik wsteczny w nazwie, więc polecenie nie zostanie uruchomione w folderze %2$@. Zmień nazwę folderu albo użyj terminala, któremu przekazywany jest folder, na przykład Ghostty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O %1$@ digita a pasta em um shell, e os shells divergem sobre uma barra invertida em um nome, então nenhum comando será iniciado em %2$@. Renomeie a pasta ou use um terminal que recebe a pasta diretamente, como o Ghostty."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tastează dosarul într-un shell, iar shellurile nu citesc la fel o bară oblică inversă dintr-un nume, deci nu se va porni nicio comandă în %2$@. Redenumiți dosarul sau folosiți un terminal căruia i se transmite dosarul, cum ar fi Ghostty."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение «%1$@» вводит папку в оболочку, а оболочки по-разному читают обратную косую черту в имени, поэтому команда не будет запущена в папке %2$@. Переименуйте папку или используйте терминал, которому передается сама папка, например Ghostty."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ கோப்புறையை ஒரு shell இல் தட்டச்சு செய்கிறது; பெயரிலுள்ள பின்சாய்வுக்கோட்டை shell-கள் வெவ்வேறு விதமாகப் படிக்கின்றன, எனவே அது %2$@ இல் கட்டளையைத் தொடங்காது. கோப்புறையின் பெயரை மாற்றவும், அல்லது Ghostty போன்ற, கோப்புறையை நேரடியாகப் பெறும் டெர்மினலைப் பயன்படுத்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ఫోల్డర్‌ను shell లో టైప్ చేస్తుంది, పేరులోని బ్యాక్‌స్లాష్‌ను shell లు ఒకే విధంగా చదవవు, కాబట్టి అది %2$@ లో ఆదేశాన్ని ప్రారంభించదు. ఫోల్డర్ పేరు మార్చండి, లేదా Ghostty వంటి, ఫోల్డర్‌ను నేరుగా అందుకునే టెర్మినల్‌ను ఉపయోగించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ พิมพ์โฟลเดอร์ลงในเชลล์ และเชลล์แต่ละตัวอ่านแบ็กสแลชในชื่อไม่เหมือนกัน จึงจะไม่เริ่มคำสั่งใน %2$@ เปลี่ยนชื่อโฟลเดอร์ หรือใช้เทอร์มินัลที่รับโฟลเดอร์ไปโดยตรง เช่น Ghostty"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, klasörü bir kabuğa yazar ve kabuklar addaki ters eğik çizgiyi farklı okur; bu yüzden %2$@ konumunda bir komut başlatılmaz. Klasörü yeniden adlandırın ya da klasörün doğrudan verildiği bir terminal kullanın, örneğin Ghostty."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Термінал %1$@ вводить папку в оболонку, а оболонки по-різному читають зворотну скісну риску в назві, тому команду в папці %2$@ не буде запущено. Перейменуйте папку або скористайтеся терміналом, якому папку передають напряму, наприклад Ghostty."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%1$@ فولڈر کو شیل میں ٹائپ کرتا ہے، اور شیلز نام میں بیک سلیش کو ایک طرح نہیں پڑھتیں، اس لیے یہ %2$@ میں کمانڈ شروع نہیں کرے گا۔ فولڈر کا نام بدلیں، یا کوئی ایسا ٹرمینل استعمال کریں جسے فولڈر براہِ راست دیا جاتا ہے، جیسے Ghostty۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ gõ thư mục vào shell, mà các shell đọc dấu gạch chéo ngược trong tên theo những cách khác nhau, nên nó sẽ không khởi chạy lệnh trong %2$@. Hãy đổi tên thư mục, hoặc dùng một terminal nhận thư mục trực tiếp, chẳng hạn Ghostty."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 会把文件夹输入到 shell 中，而各种 shell 对名称中反斜杠的解读不一致，因此它不会在 %2$@ 中启动命令。请重命名该文件夹，或使用直接接收文件夹的终端，例如 Ghostty。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 會把檔案夾輸入到 shell 中，而各種 shell 對名稱中反斜線的解讀不一致，因此它不會在 %2$@ 中啟動指令。請重新命名該檔案夾，或使用直接接收檔案夾的終端機，例如 Ghostty。"
          }
        }
      }
    },
