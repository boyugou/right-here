    "app.newFileNewCaption": {
      "comment": "Caption of the form for a new new-file template. py, md and txt are file extensions and stay as they are.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُنشئ القالب نوعًا واحدًا من الملفات. له عنوان في القائمة وملحق لاسم ملفه (py، md، txt)."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি টেমপ্লেট এক ধরনের ফাইল তৈরি করে। মেনুতে এর একটি শিরোনাম থাকে, আর থাকে ফাইলের নামের এক্সটেনশন (py, md, txt)।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Vorlage erstellt eine Art von Datei. Sie hat einen Titel im Menü und die Endung ihres Dateinamens (py, md, txt)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα πρότυπο δημιουργεί ένα είδος αρχείου. Έχει τίτλο στο μενού και επέκταση ονόματος αρχείου (py, md, txt)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A template makes one kind of file. It has a title in the menu and the extension of its file name (py, md, txt)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una plantilla crea un tipo de archivo. Tiene un título en el menú y la extensión de su nombre de archivo (py, md, txt)."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک الگو یک نوع فایل می‌سازد. عنوانی در منو و پسوندی برای نام فایلش (py، md، txt) دارد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un modèle crée un type de fichier. Il a un titre dans le menu et une extension de fichier (py, md, txt)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תבנית יוצרת סוג אחד של קובץ. יש לה כותרת בתפריט וסיומת של שם הקובץ (py, md, txt)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक टेम्पलेट एक प्रकार की फ़ाइल बनाता है। मेन्यू में उसका एक शीर्षक होता है, और फ़ाइल-नाम का एक एक्सटेंशन (py, md, txt)।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebuah templat membuat satu jenis file. Templat itu punya judul di menu dan ekstensi nama file (py, md, txt)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un modello crea un tipo di file. Ha un titolo nel menu e l’estensione del nome del file (py, md, txt)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テンプレートは一種類のファイルを作成します。メニューでのタイトルと、ファイル名の拡張子 (py、md、txt) を持ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "템플릿은 파일 한 종류를 만듭니다. 메뉴에 보이는 제목과 파일 이름의 확장자(py, md, txt)가 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एक टेम्प्लेट एक प्रकारची फाइल तयार करते. त्याला मेनूमध्ये एक शीर्षक असते आणि फाइलच्या नावाचा एक्सटेंशन (py, md, txt) असतो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu templat mencipta satu jenis fail. Ia mempunyai tajuk dalam menu dan sambungan nama failnya (py, md, txt)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een sjabloon maakt één soort bestand. Het heeft een titel in het menu en de extensie van de bestandsnaam (py, md, txt)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szablon tworzy jeden rodzaj pliku. Ma tytuł w menu oraz rozszerzenie nazwy pliku (py, md, txt)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um modelo cria um tipo de arquivo. Ele tem um título no menu e a extensão do nome do arquivo (py, md, txt)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un șablon creează un tip de fișier. Are un titlu în meniu și extensia numelui fișierului (py, md, txt)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаблон создает один вид файла. У него есть название в меню и расширение имени файла (py, md, txt)."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு வார்ப்புரு ஒரு வகைக் கோப்பை உருவாக்குகிறது. அதற்கு மெனுவில் ஒரு தலைப்பும், கோப்புப் பெயரின் நீட்டிப்பும் (py, md, txt) உண்டு."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఒక టెంప్లేట్ ఒక రకమైన ఫైల్‌ను సృష్టిస్తుంది. దానికి మెనూలో ఒక శీర్షిక, ఫైల్ పేరు యొక్క పొడిగింపు (py, md, txt) ఉంటాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เทมเพลตหนึ่งรายการสร้างไฟล์หนึ่งชนิด มีชื่อที่แสดงในเมนูและนามสกุลไฟล์ (py, md, txt)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir şablon bir dosya türü oluşturur. Menüde bir başlığı ve dosya adının uzantısı (py, md, txt) vardır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаблон створює один тип файлу. Він має назву в меню та розширення імені файлу (py, md, txt)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک ٹیمپلیٹ ایک قسم کی فائل بناتا ہے۔ اس کا مینو میں ایک عنوان ہوتا ہے اور فائل کے نام کی توسیع (py, md, txt) ہوتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một mẫu tệp tạo ra một loại tệp. Nó có một tiêu đề trong menu và phần mở rộng của tên tệp (py, md, txt)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个模板创建一种文件。它有一个在菜单中显示的标题，以及文件名的扩展名（py、md、txt）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一個範本用來建立一種檔案。它有一個在選單中顯示的標題，以及檔名的副檔名（py、md、txt）。"
          }
        }
      }
    },
