    "refusal.terminalNotEditor": {
      "comment": "Why an action did nothing, shown in the alert after a click in Finder (and, in English, by the command line). %1$@ is an app name, %2$@ an action id.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%1$@ وحدة طرفية وليس محررًا. استخدم %2$@ لفتح مجلد فيه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ একটি টার্মিনাল, এডিটর নয়। এতে একটি ফোল্ডার খুলতে %2$@ ব্যবহার করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
