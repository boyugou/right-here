    "refusal.presetFileName": {
      "comment": "Why an action did nothing, shown in the alert after a click in Finder (and, in English, by the command line). %1$@ is a file name, quoted; %2$@ a preset id. One of the refusal.name.* sentences follows and says why.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن ذكر الملف %1$@ في موجّه الإعداد المسبق للوكيل «%2$@»."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফাইল %1$@-এর নাম এজেন্ট প্রিসেট “%2$@”-এর প্রম্পটে উল্লেখ করা যায় না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei %1$@ kann im Prompt der Agent-Voreinstellung „%2$@“ nicht genannt werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το αρχείο %1$@ δεν μπορεί να αναφερθεί στην προτροπή της προεπιλογής πράκτορα «%2$@»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file %1$@ cannot be named in the prompt of preset \"%2$@\"."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo %1$@ no se puede nombrar en el prompt del preajuste de agente «%2$@»."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نام فایل %1$@ را نمی‌توان در پرامپت پیش‌تنظیم عامل «%2$@» آورد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier %1$@ ne peut pas être nommé dans le prompt du préréglage d’agent « %2$@ »."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אי אפשר לציין את הקובץ %1$@ בהנחיה של ההגדרה המוכנה לסוכן ״%2$@״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइल %1$@ का नाम एजेंट प्रीसेट “%2$@” के प्रॉम्प्ट में नहीं लिया जा सकता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File %1$@ tidak dapat disebut dalam prompt preset agen “%2$@”."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file %1$@ non può essere nominato nel prompt del preset “%2$@”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイル%1$@の名前は、プリセット「%2$@」のプロンプトに含めることができません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 파일은 “%2$@” 프리셋의 프롬프트에서 이름으로 지정할 수 없습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फाइल %1$@ चे नाव प्रीसेट “%2$@” च्या प्रॉम्प्टमध्ये देता येत नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fail %1$@ tidak boleh dinamakan dalam gesaan praset “%2$@”."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bestand %1$@ kan niet worden genoemd in de prompt van agentvoorinstelling „%2$@”."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pliku %1$@ nie można wymienić w treści gotowego promptu „%2$@”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo %1$@ não pode ser citado no prompt da predefinição de agente “%2$@”."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fișierul %1$@ nu poate fi numit în promptul presetării „%2$@”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл %1$@ нельзя упомянуть в промпте пресета «%2$@»."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "“%2$@” முன்னமைவின் ப்ராம்ப்ட்டில் %1$@ என்ற கோப்பைக் குறிப்பிட முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "“%2$@” ప్రీసెట్ ప్రాంప్ట్‌లో %1$@ ఫైల్‌ను పేర్కొనలేము."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระบุไฟล์ %1$@ ในพรอมต์ของพรีเซ็ต “%2$@” ไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ dosyasının adı “%2$@” adlı ön ayarın istemine yazılamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл %1$@ не можна назвати в промпті пресету «%2$@»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فائل %1$@ کا نام پری سیٹ “%2$@” کے پرامپٹ میں نہیں لیا جا سکتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể ghi tên tệp %1$@ vào lời nhắc của mẫu “%2$@”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法在预设“%2$@”的提示词中写入文件 %1$@ 的名称。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法在預設組「%2$@」的提示詞中寫入檔案 %1$@ 的名稱。"
          }
        }
      }
    },
