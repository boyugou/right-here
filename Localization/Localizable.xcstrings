    "doctor.sync.diverged": {
      "comment": "Detail line of a check in the setup window's Details list; it follows the check's title, so it is a fragment with no final period. About the config sync feature: both the local config and the synced copy changed.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
