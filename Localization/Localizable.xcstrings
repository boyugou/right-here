    "doctor.services.differ": {
      "comment": "Detail line of a check in the setup window's Details list; it follows the check's title, so it is a fragment with no final period. %1$@ is the number of installed Finder Services; %2$@ how many the config asks for that are not installed; %3$@ how many installed ones the config no longer asks for. Use wording that works for any number.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المثبَّتة: %1$@، لكنها تختلف عن ملف الإعداد (المفقودة: %2$@، القديمة: %3$@)"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ইনস্টল করা আছে: %1$@, কিন্তু কনফিগের সঙ্গে মিলছে না (অনুপস্থিত: %2$@, পুরোনো: %3$@)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ installiert, aber abweichend von der Konfiguration (fehlend: %2$@, veraltet: %3$@)"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "εγκατεστημένες: %1$@, αλλά διαφέρουν από το αρχείο ρυθμίσεων (λείπουν: %2$@, ξεπερασμένες: %3$@)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ installed, but they differ from the config (%2$@ missing, %3$@ stale)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "instalados: %1$@, pero difieren de la configuración (faltan: %2$@, obsoletos: %3$@)"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نصب‌شده: %1$@، اما با پیکربندی تفاوت دارند (مفقود: %2$@، قدیمی: %3$@)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "services installés : %1$@ ; ils diffèrent de la configuration (manquants : %2$@, obsolètes : %3$@)"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שירותי Finder מותקנים: %1$@; הם שונים מהתצורה (חסרים: %2$@, מיושנים: %3$@)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इंस्टॉल की गई त्वरित क्रियाएँ: %1$@; ये कॉन्फ़िग से अलग हैं (गायब: %2$@, पुरानी: %3$@)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ layanan Finder diinstal, tetapi berbeda dari konfigurasi (%2$@ hilang, %3$@ usang)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Servizi del Finder installati: %1$@; differiscono dalla configurazione (mancanti: %2$@, obsoleti: %3$@)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール済みの Finder のサービス %1$@ 件；設定と一致しません（不足 %2$@ 件、古いもの %3$@ 件）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@개 설치됨, 하지만 설정과 다름 (누락 %2$@, 오래됨 %3$@)"
          }
        },
        "mr": {
          "stringUnit": {
