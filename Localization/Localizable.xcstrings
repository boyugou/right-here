        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இது முழுக் கோப்பையும் மீண்டும் எழுதும், அதன் உள்ளடக்கத்தில் ஒரு நிரல் இருக்கக்கூடும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ఇది మొత్తం ఫైల్‌ను మళ్లీ రాస్తుంది, దాని కంటెంట్‌లో ఒక ప్రోగ్రామ్ ఉండవచ్చు"
          }
        },
        "th": {
