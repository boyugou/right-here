    "doctor.fix.terminalFallback": {
      "comment": "Fix line under the check \"Default terminal\" in the setup window's Details list: what the person should do. A sentence. \"it\" is the terminal the config chooses, which is not installed. general.terminal is a config setting: keep it exactly.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثبّتها، أو غيّر general.terminal (أزل الإعداد لاستخدام أول وحدة طرفية مثبَّتة)."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি ইনস্টল করুন, অথবা general.terminal পরিবর্তন করুন (ইনস্টল করা প্রথম টার্মিনালটি ব্যবহার করতে সেটিংটি সরিয়ে দিন)।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiere es, oder ändere general.terminal (entferne die Einstellung, um das erste installierte Terminal zu verwenden)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εγκαταστήστε το τερματικό, ή αλλάξτε το general.terminal (αφαιρέστε τη ρύθμιση για να χρησιμοποιηθεί το πρώτο εγκατεστημένο τερματικό)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install it, or change general.terminal (remove the setting to use the first installed terminal)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instálala, o cambia general.terminal (quita el ajuste para usar la primera terminal instalada)."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آن را نصب کنید، یا general.terminal را تغییر دهید (برای استفاده از اولین ترمینال نصب‌شده، این تنظیم را حذف کنید)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez-le, ou modifiez general.terminal (retirez ce réglage pour utiliser le premier terminal installé)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להתקין אותו, או לשנות את general.terminal (בלי ההגדרה, ייעשה שימוש במסוף המותקן הראשון)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे इंस्टॉल करें, या general.terminal बदलें (पहला इंस्टॉल किया गया टर्मिनल इस्तेमाल करने के लिए सेटिंग हटाएँ)।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Instal terminal tersebut, atau ubah general.terminal (hapus pengaturan agar menggunakan terminal pertama yang diinstal)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installalo, oppure cambia general.terminal (rimuovi l’impostazione per usare il primo terminale installato)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのターミナルをインストールするか、general.terminal を変更してください（設定を削除すると、インストール済みの最初のターミナルを使用します）。"
          }
        },
        "ko": {
