    "trust.fileRuns": {
      "comment": "Same card, same form: the contents of a New File template.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يصبح ملفًا قد يشغّله شيء ما على هذا الـ Mac (برنامج نصي، عنصر دخول)"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি এমন একটি ফাইল হয়ে যায়, যা এই Mac-এ চালানো হতে পারে (একটি স্ক্রিপ্ট, একটি লগইন আইটেম)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "wird zu einer Datei, die etwas auf diesem Mac ausführen kann (ein Skript, ein Anmeldeobjekt)"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "γίνεται ένα αρχείο που μπορεί να εκτελεστεί από κάτι σε αυτό το Mac (ένα σκριπτ, ένα στοιχείο εισόδου)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "it becomes a file that something on this Mac may run (a script, a login item)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "se convierte en un archivo que algo de este Mac podría ejecutar (un script, un ítem de inicio)"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به فایلی تبدیل می‌شود که ممکن است چیزی روی این مک آن را اجرا کند (یک اسکریپت، یک آیتم ورود)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "devient un fichier que quelque chose sur ce Mac peut exécuter (un script, un élément d’ouverture)"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היא הופכת לקובץ שמשהו ב-Mac זה עשוי להריץ (תסריט, פריט התחברות)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह एक ऐसी फ़ाइल बन जाती है जिसे इस Mac पर कुछ चला सकता है (कोई स्क्रिप्ट, कोई लॉगइन आइटम)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "menjadi file yang mungkin dijalankan oleh sesuatu di Mac ini (skrip, item masuk)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "diventa un file che qualcosa su questo Mac potrebbe eseguire (uno script, un elemento login)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac 上の何かが実行するかもしれないファイルになります（スクリプト、ログイン項目など）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac의 무언가가 실행할 수 있는 파일이 됩니다(스크립트, 로그인 항목 등)"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ही अशी फाइल बनते जी या Mac वर चालवली जाऊ शकते (एखादी स्क्रिप्ट, एखादा लॉगिन आयटम)"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "menjadi fail yang mungkin dijalankan oleh sesuatu pada Mac ini (skrip, item log masuk)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "wordt een bestand dat iets op deze Mac kan uitvoeren (een script, een inlogonderdeel)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "staje się plikiem, który coś na tym Macu może uruchomić (skrypt, rzecz otwierana podczas logowania)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "se torna um arquivo que algo neste Mac pode executar (um script, um item de início de sessão)"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "devine un fișier pe care ceva de pe acest Mac îl poate rula (un script, un articol cu lansare la login)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "становится файлом, который что-то на этом Mac может запустить (скрипт, объект входа)"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது இந்த Mac-இல் ஏதோ ஒன்று இயக்கக்கூடிய கோப்பாக மாறும் (ஒரு ஸ்கிரிப்ட், ஒரு உள்நுழைவு உருப்படி)"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇది ఈ Mac లో ఏదో ఒకటి రన్ చేయగల ఫైల్‌గా మారుతుంది (ఒక స్క్రిప్ట్, ఒక లాగిన్ ఐటెమ్)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กลายเป็นไฟล์ที่บางอย่างบน Mac เครื่องนี้อาจรันได้ (สคริปต์ รายการเข้าสู่ระบบ)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "bu Mac’teki bir şeyin çalıştırabileceği bir dosyaya dönüşür (bir betik, bir oturum açma öğesi)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "стає файлом, який щось на цьому Mac може запустити (скрипт, елемент автозапуску)"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ ایسی فائل بن جاتی ہے جسے اس Mac پر کوئی چیز چلا سکتی ہے (کوئی اسکرپٹ، کوئی لاگ ان آئٹم)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "trở thành một tệp mà thứ gì đó trên máy Mac này có thể chạy (một tập lệnh, một mục đăng nhập)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它会成为这台 Mac 上可能被运行的文件（脚本、登录项）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它會成為這台 Mac 上可能被執行的檔案（指令碼、登入項目）"
          }
        }
      }
    },
