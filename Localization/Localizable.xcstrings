    "config.cannotBeEdited": {
      "comment": "Shown in the setup window (and, in English, by the command line) when a change or a setup did not work. %@ is the problem as the config check says it, in English, ending with a full stop.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن تعديل ملف الإعداد بحالته الحالية: %@ أصلِح ذلك أولًا (يوضّح `rh config validate` مكانه)."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কনফিগারেশন এখন যে অবস্থায় আছে, সেভাবে এটি সম্পাদনা করা যায় না: %@ আগে সেটি ঠিক করুন (কোথায়, তা `rh config validate` জানায়)।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Konfiguration kann in diesem Zustand nicht bearbeitet werden: %@ Behebe das zuerst (`rh config validate` zeigt, wo)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το αρχείο ρυθμίσεων δεν μπορεί να επεξεργαστεί όπως είναι τώρα: %@ Διορθώστε πρώτα αυτό (η εντολή `rh config validate` δείχνει πού)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The config cannot be edited as it is: %@ Fix that first (`rh config validate` says where)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuración no se puede editar tal como está: %@ Corrige eso primero (`rh config validate` indica dónde)."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیکربندی را در وضعیت فعلی نمی‌توان ویرایش کرد: %@ ابتدا آن را درست کنید (محل آن را `rh config validate` نشان می‌دهد)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuration ne peut pas être modifiée en l’état : %@ Corrigez d’abord ce problème (`rh config validate` indique où)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לערוך את התצורה במצבה הנוכחי: %@ יש לתקן זאת תחילה (הפקודה `rh config validate` מראה איפה)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कॉन्फ़िगरेशन को उसकी मौजूदा स्थिति में संपादित नहीं किया जा सकता: %@ पहले इसे ठीक करें (कहाँ, यह `rh config validate` बताता है)।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurasi tidak dapat diedit dalam keadaannya sekarang: %@ Perbaiki itu terlebih dahulu (`rh config validate` menunjukkan letaknya)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La configurazione non può essere modificata così com’è: %@ Correggi prima questo problema (`rh config validate` indica dove)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定ファイルは現在の状態では編集できません：%@ まずこれを修正してください（場所は `rh config validate` で確認できます）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 파일을 현재 상태로는 편집할 수 없습니다: %@ 먼저 이 문제를 해결하십시오(`rh config validate`로 위치를 확인할 수 있습니다)."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कॉन्फिगरेशन सध्याच्या स्थितीत संपादित करता येत नाही: %@ आधी ते दुरुस्त करा (कुठे ते `rh config validate` सांगते)."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurasi tidak dapat diedit dalam keadaan sekarang: %@ Betulkan perkara itu dahulu (`rh config validate` menunjukkan di mana)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De configuratie kan in deze staat niet worden bewerkt: %@ Los dat eerst op (`rh config validate` laat zien waar)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfiguracji nie można edytować w obecnym stanie: %@ Najpierw to popraw (`rh config validate` pokazuje, gdzie)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A configuração não pode ser editada como está: %@ Corrija isso primeiro (`rh config validate` mostra onde)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurația nu poate fi modificată în starea actuală: %@ Corectați mai întâi această problemă (`rh config validate` arată unde)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Конфигурацию нельзя изменить в ее текущем виде: %@ Сначала исправьте это (`rh config validate` покажет, где)."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உள்ளமைவை அதன் தற்போதைய நிலையில் திருத்த முடியாது: %@ முதலில் அதைச் சரிசெய்யவும் (எங்கே என்பதை `rh config validate` காட்டும்)."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కాన్ఫిగరేషన్‌ను ప్రస్తుతం ఉన్న స్థితిలో ఎడిట్ చేయలేము: %@ ముందుగా దాన్ని సరిచేయండి (సమస్య ఎక్కడ ఉందో `rh config validate` చూపిస్తుంది)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แก้ไขการกำหนดค่าในสภาพปัจจุบันไม่ได้: %@ โปรดแก้ปัญหานั้นก่อน (`rh config validate` จะบอกว่าอยู่ตรงไหน)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapılandırma bu hâliyle düzenlenemez: %@ Önce bunu düzeltin (yerini `rh config validate` gösterir)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Конфігурацію не можна змінити в її теперішньому стані: %@ Спершу виправте це (`rh config validate` покаже, де саме)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کنفیگریشن کو موجودہ حالت میں تبدیل نہیں کیا جا سکتا: %@ پہلے اسے درست کریں (`rh config validate` بتاتا ہے کہ مسئلہ کہاں ہے)۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể chỉnh sửa cấu hình ở trạng thái hiện tại: %@ Hãy sửa lỗi đó trước (`rh config validate` cho biết ở đâu)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置在当前状态下无法编辑：%@ 请先修正这个问题（`rh config validate` 会指出位置）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定檔在目前狀態下無法編輯：%@ 請先修正這個問題（`rh config validate` 會指出位置）。"
          }
        }
      }
    },
    "config.cannotBeUsed": {
      "comment": "Shown in the setup window (and, in English, by the command line) when a change or a setup did not work. %1$@ is the path of a config file; %2$@ is why, in the config check's or the system's own English words (it may itself start with \"cannot read\").",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملف الإعداد %1$@ غير قابل للاستخدام: %2$@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কনফিগারেশন ফাইল %1$@ ব্যবহার করা যাচ্ছে না: %2$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Konfigurationsdatei %1$@ kann nicht verwendet werden: %2$@"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το αρχείο ρυθμίσεων %1$@ δεν μπορεί να χρησιμοποιηθεί: %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ cannot be used: %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo de configuración %1$@ no se puede usar: %2$@"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فایل پیکربندی %1$@ قابل استفاده نیست: %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier de configuration %1$@ est inutilisable : %2$@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן להשתמש בקובץ התצורה %1$@: %2$@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कॉन्फ़िगरेशन फ़ाइल %1$@ का इस्तेमाल नहीं किया जा सकता: %2$@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File konfigurasi %1$@ tidak dapat digunakan: %2$@"
          }
        },
        "it": {
          "stringUnit": {
