    "app.presetNewCaption": {
      "comment": "Caption of the form for a new prompt preset. The placeholders {files}, {folder} and {name} are written exactly like that in every language and are never translated.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإعداد المسبق موجّه يبدأ به الوكيل. اكتب {files} حيث تُوضع الملفات المحددة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রিসেট হলো এমন একটি প্রম্পট যা দিয়ে এজেন্ট শুরু হয়। নির্বাচিত ফাইলগুলো যেখানে যাবে, সেখানে {files} লিখুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Voreinstellung ist ein Prompt, mit dem ein Agent startet. Schreibe {files} dorthin, wo die ausgewählten Dateien stehen sollen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η προεπιλογή είναι μια προτροπή με την οποία ξεκινά ένας πράκτορας. Γράψτε {files} εκεί όπου θα μπουν τα επιλεγμένα αρχεία."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A preset is a prompt that an agent starts with. Write {files} where the selected files go."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un preajuste es un prompt con el que empieza un agente. Escribe {files} donde vayan los archivos seleccionados."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیش‌تنظیم پرامپتی است که عامل با آن شروع می‌کند. {files} را جایی بنویسید که فایل‌های انتخاب‌شده قرار می‌گیرند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un préréglage est un prompt avec lequel un agent démarre. Écrivez {files} à l’endroit où iront les fichiers sélectionnés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגדרה מוכנה היא הנחיה שסוכן מתחיל ממנה. יש לכתוב {files} במקום שבו יופיעו הקבצים שנבחרו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रीसेट वह प्रॉम्प्ट है जिससे कोई एजेंट शुरू होता है। जहाँ चुनी हुई फ़ाइलें जाएँगी, वहाँ {files} लिखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Preset adalah prompt yang menjadi awal kerja agen. Tulis {files} di tempat file yang dipilih."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un preset è un prompt con cui inizia un agente. Scrivi {files} dove andranno i file selezionati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プリセットは、エージェントが開始時に使うプロンプトです。選択したファイルを置く場所に {files} と入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프리셋은 에이전트가 시작할 때 쓰는 프롬프트입니다. 선택한 파일이 들어갈 곳에 {files} 표시를 넣으십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रीसेट हा एक प्रॉम्प्ट आहे ज्याने एजंट सुरू होतो. निवडलेल्या फाइली जिथे जातील तिथे {files} लिहा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Praset ialah gesaan permulaan untuk ejen. Tulis {files} di tempat fail yang dipilih."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een voorinstelling is een prompt waarmee een agent start. Schrijf {files} waar de geselecteerde bestanden moeten komen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gotowy prompt to zapisany tekst, od którego agent zaczyna pracę. Wpisz {files} w miejscu, gdzie mają trafić zaznaczone pliki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma predefinição é um prompt com o qual um agente começa. Escreva {files} onde devem entrar os arquivos selecionados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O presetare este un prompt cu care pornește un agent. Scrieți {files} acolo unde trebuie să ajungă fișierele selectate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пресет — это промпт, с которого начинает работу агент. Напишите {files} там, куда должны попасть выбранные файлы."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முன்னமைவு என்பது ஒரு முகவர் தொடங்கும் ப்ராம்ப்ட். தேர்ந்தெடுக்கப்பட்ட கோப்புகள் செல்ல வேண்டிய இடத்தில் {files} என எழுதுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రీసెట్ అంటే ఏజెంట్‌ను ప్రారంభించేటప్పుడు దానికి ఇచ్చే ప్రాంప్ట్. ఎంచుకున్న ఫైల్‌లు వెళ్లవలసిన చోట {files} అని రాయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พรีเซ็ตคือพรอมต์ที่เอเจนต์ใช้เริ่มการทำงาน เขียน {files} ตรงตำแหน่งที่ควรใส่ไฟล์ที่เลือก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ön ayar, bir ajanın başladığı bir istemdir. Seçili dosyaların ekleneceği yere {files} yazın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пресет — це промпт, з якого починає роботу агент. Напишіть {files} там, куди мають потрапити вибрані файли."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پری سیٹ ایک پرامپٹ ہے جس سے ایجنٹ شروع ہوتا ہے۔ جہاں منتخب فائلیں جائیں وہاں {files} لکھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mẫu là một lời nhắc để tác tử bắt đầu. Viết {files} ở vị trí các tệp đã chọn sẽ được đưa vào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预设是智能体启动时使用的提示词。在所选文件应出现的位置写入 {files}。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設組是代理程式啟動時所用的提示詞。在所選檔案應放置的位置寫入 {files}。"
          }
        }
      }
    },
    "app.presetPlaceholders": {
      "comment": "Caption under the field for the text of a prompt preset. {files}, {folder} and {name} are placeholders that are replaced when the preset is used. The placeholders {files}, {folder} and {name} are written exactly like that in every language and are never translated.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمثّل {files} الملفات المحددة. ويمثّل {folder} المجلد الذي توجد فيه، و{name} اسم ما تم تحديده. يُكتب الموجّه في سطر واحد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "{files} মানে নির্বাচিত ফাইলগুলো। {folder} মানে সেগুলো যে ফোল্ডারে আছে, আর {name} মানে নির্বাচিত আইটেমের নাম। প্রম্পট এক লাইনে লেখা হয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "{files} steht für die ausgewählten Dateien. {folder} steht für den Ordner, in dem sie liegen, und {name} für den Namen des Ausgewählten. Der Prompt wird in einer einzigen Zeile eingegeben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το {files} αντιπροσωπεύει τα επιλεγμένα αρχεία. Το {folder} αντιπροσωπεύει τον φάκελο στον οποίο βρίσκονται και το {name} το όνομα του επιλεγμένου στοιχείου. Η προτροπή πληκτρολογείται σε μία γραμμή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{files} stands for the selected files. {folder} stands for the folder they are in, and {name} for the name of what is selected. The prompt is typed as one line."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "{files} representa los archivos seleccionados. {folder} representa la carpeta en la que están, y {name} el nombre de lo que está seleccionado. El prompt se escribe en una sola línea."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "‏{files} معادل فایل‌های انتخاب‌شده است. {folder} معادل پوشه‌ای است که آن‌ها در آن هستند و {name} معادل نام چیزی است که انتخاب شده. پرامپت در یک خط تایپ می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "{files} représente les fichiers sélectionnés. {folder} représente le dossier qui les contient, et {name} le nom de l’élément sélectionné. Le prompt se saisit sur une seule ligne."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏{files} מייצג את הקבצים שנבחרו. {folder} מייצג את התיקיה שבה הם נמצאים, ו-{name} את שמו של מה שנבחר. ההנחיה מוקלדת בשורה אחת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "{files} चुनी गई फ़ाइलों के लिए है। {folder} उस फ़ोल्डर के लिए है जिसमें वे हैं, और {name} चुनी गई चीज़ के नाम के लिए। प्रॉम्प्ट एक पंक्ति में टाइप किया जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "{files} mewakili file yang dipilih. {folder} mewakili folder tempat file itu berada, dan {name} mewakili nama item yang dipilih. Prompt ditulis dalam satu baris."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "{files} indica i file selezionati. {folder} indica la cartella in cui si trovano e {name} il nome dell’elemento selezionato. Il prompt viene digitato su una sola riga."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{files} は選択したファイルを表します。{folder} はそのファイルがあるフォルダ、{name} は選択した項目の名前を表します。プロンプトは1行で入力します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{files} 자리에는 선택한 파일이 들어갑니다. {folder} 자리에는 그 파일이 있는 폴더가, {name} 자리에는 선택한 항목의 이름이 들어갑니다. 프롬프트는 한 줄로 입력합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "{files} म्हणजे निवडलेल्या फाइली. {folder} म्हणजे त्या फाइली असलेला फोल्डर आणि {name} म्हणजे निवडलेल्या वस्तूचे नाव. प्रॉम्प्ट एका ओळीत टाइप केला जातो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "{files} mewakili fail yang dipilih. {folder} mewakili folder tempat fail itu berada dan {name} mewakili nama item yang dipilih. Gesaan ditaip dalam satu baris."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "{files} staat voor de geselecteerde bestanden. {folder} staat voor de map waarin ze staan en {name} voor de naam van wat is geselecteerd. De prompt wordt in één regel getypt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "{files} oznacza zaznaczone pliki. {folder} oznacza folder, w którym się znajdują, a {name} – nazwę zaznaczonej pozycji. Prompt wpisuje się w jednym wierszu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "{files} representa os arquivos selecionados. {folder} representa a pasta em que eles estão e {name} o nome do item selecionado. O prompt é digitado em uma única linha."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "{files} înseamnă fișierele selectate. {folder} înseamnă dosarul în care se află acestea și {name} numele articolului selectat. Promptul se introduce pe un singur rând."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "{files} обозначает выбранные файлы. {folder} — папку, в которой они находятся, а {name} — имя выбранного объекта. Промпт вводится в одну строку."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "{files} என்பது தேர்ந்தெடுக்கப்பட்ட கோப்புகளைக் குறிக்கும். {folder} அவை உள்ள கோப்புறையையும், {name} தேர்ந்தெடுக்கப்பட்டதன் பெயரையும் குறிக்கும். ப்ராம்ப்ட் ஒரே வரியில் தட்டச்சு செய்யப்படுகிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "{files} అంటే ఎంచుకున్న ఫైల్‌లు. {folder} అంటే అవి ఉన్న ఫోల్డర్, {name} అంటే ఎంచుకున్నదాని పేరు. ప్రాంప్ట్ ఒకే వరుసలో టైప్ చేయబడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "{files} แทนไฟล์ที่เลือก {folder} แทนโฟลเดอร์ที่ไฟล์เหล่านั้นอยู่ และ {name} แทนชื่อของสิ่งที่เลือก พรอมต์จะถูกพิมพ์เป็นบรรทัดเดียว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "{files} seçili dosyaları temsil eder. {folder} bu dosyaların bulunduğu klasörü, {name} ise seçilenin adını temsil eder. İstem tek satır olarak yazılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "{files} означає вибрані файли. {folder} — папку, у якій вони розташовані, а {name} — назву вибраного обʼєкта. Промпт вводиться в один рядок."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "‏{files} منتخب فائلوں کو ظاہر کرتا ہے۔ {folder} اُس فولڈر کو ظاہر کرتا ہے جس میں وہ ہیں، اور {name} منتخب شے کے نام کو۔ پرامپٹ ایک ہی سطر میں ٹائپ کیا جاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "{files} là các tệp đã chọn. {folder} là thư mục chứa chúng, còn {name} là tên của mục đã chọn. Lời nhắc được nhập thành một dòng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "{files} 代表所选文件。{folder} 代表这些文件所在的文件夹，{name} 代表所选项目的名称。提示词以单行形式输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "{files} 代表所選的檔案。{folder} 代表檔案所在的檔案夾，{name} 代表所選項目的名稱。提示詞會以單行輸入。"
          }
        }
      }
    },
