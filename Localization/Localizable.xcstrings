    "app.fixAgentLauncherWindow": {
      "comment": "Checks page: the agent cannot start in the terminal that is used. 'Agents' = app.tabAgents. Window form of doctor.fix.agentLauncher.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر وحدة طرفية أخرى أو طريقة أخرى لتشغيله في صفحة الوكيل (الوكلاء)."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এজেন্টের পৃষ্ঠায় (এজেন্ট) অন্য একটি টার্মিনাল বা এটি চালু করার অন্য উপায় বেছে নিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle auf der Seite dieses Agenten unter „Agenten“ ein anderes Terminal oder eine andere Art, ihn zu starten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε άλλο τερματικό ή άλλον τρόπο εκκίνησης στη σελίδα του πράκτορα (Πράκτορες)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose another terminal or another way to start it on the agent's page (Agents)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige otra terminal u otra forma de iniciarlo en la página del agente (Agentes)."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در صفحهٔ عامل (عامل‌ها) ترمینال دیگری یا راه دیگری برای اجرای آن انتخاب کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un autre terminal ou une autre façon de le lancer dans la page de l’agent (Agents)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לבחור מסוף אחר או דרך הפעלה אחרת בעמוד של הסוכן (״סוכנים״)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एजेंट के पेज (एजेंट) पर कोई दूसरा टर्मिनल या इसे शुरू करने का कोई दूसरा तरीका चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih terminal lain atau cara lain untuk menjalankannya di halaman agen (Agen)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un altro terminale o un altro modo di avviarlo nella pagina dell’agente (Agenti)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントのページ（エージェント）で、別のターミナルか別の起動方法を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트 페이지에서 이 에이전트를 열고 다른 터미널이나 다른 시작 방법을 선택하십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एजंटच्या पृष्ठावर (एजंट) दुसरे टर्मिनल किंवा ते सुरू करण्याचा दुसरा मार्ग निवडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih terminal lain atau cara lain untuk memulakannya pada halaman ejen (Ejen)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies op de pagina van de agent (Agenten) een andere terminal of een andere manier om hem te starten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz inny terminal lub inny sposób uruchamiania na stronie agenta (Agenci)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha outro terminal ou outra forma de iniciá-lo na página do agente (Agentes)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alegeți alt terminal sau alt mod de a-l porni pe pagina agentului (Agenți)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите другой терминал или другой способ запуска на странице агента («Агенты»)."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முகவரின் பக்கத்தில் (முகவர்கள்) வேறொரு டெர்மினலை அல்லது அதைத் தொடங்க வேறொரு வழியைத் தேர்ந்தெடுக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఏజెంట్ పేజీలో (ఏజెంట్లు) మరో టెర్మినల్‌ను లేదా దాన్ని ప్రారంభించే మరో మార్గాన్ని ఎంచుకోండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกเทอร์มินัลอื่นหรือวิธีอื่นในการเริ่มเอเจนต์ในหน้าของเอเจนต์ (เอเจนต์)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajanın sayfasında (Ajanlar) başka bir terminal veya onu başlatmanın başka bir yolunu seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть інший термінал або інший спосіб запуску на сторінці агента («Агенти»)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایجنٹ کے صفحے (ایجنٹس) پر کوئی اور ٹرمینل یا اسے شروع کرنے کا کوئی اور طریقہ منتخب کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn terminal khác hoặc cách khác để khởi chạy nó trên trang của tác tử (Tác tử)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在该智能体的页面（智能体）中选择其他终端或其他启动方式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在該代理程式的頁面（「代理程式」）中選擇其他終端機或其他啟動方式。"
          }
        }
      }
    },
    "app.fixAgentRemoveWindow": {
      "comment": "Checks page: an agent in the menu whose command is not found. 'it' = the agent. 'Agents' = app.tabAgents. Window form of doctor.fix.agentRemove.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثبّته، أو ألغِ تحديده في صفحة «الوكلاء»."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি ইনস্টল করুন, অথবা “এজেন্ট” পৃষ্ঠায় এর টিক তুলে দিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiere ihn, oder entferne auf der Seite „Agenten“ das Häkchen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εγκαταστήστε τον πράκτορα ή αποεπιλέξτε τον στη σελίδα «Πράκτορες»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install it, or uncheck it on the Agents page."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instálalo o desmárcalo en la página Agentes."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آن را نصب کنید، یا در صفحهٔ «عامل‌ها» علامتش را بردارید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez-le, ou décochez-le dans la page Agents."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להתקין אותו, או להסיר את הסימון שלו בעמוד ״סוכנים״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे इंस्टॉल करें, या “एजेंट” पेज पर इसका चयन हटाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Instal agen tersebut, atau hapus centangnya di halaman Agen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installalo, oppure deselezionalo nella pagina Agenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのエージェントをインストールするか、「エージェント」ページでチェックを外してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트를 설치하거나 에이전트 페이지에서 체크를 해제하십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ते इन्स्टॉल करा, किंवा “एजंट” पृष्ठावर त्याची टिक काढा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasang ejen itu, atau nyahtanda ejen itu pada halaman Ejen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Installeer hem, of vink hem uit op de pagina Agenten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zainstaluj go albo odznacz go na stronie Agenci."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale-o, ou desmarque-o na página Agentes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalați-l sau debifați-l pe pagina Agenți."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установите его или снимите с него отметку на странице «Агенты»."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அதை நிறுவவும், அல்லது முகவர்கள் பக்கத்தில் அதன் தேர்வை நீக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దాన్ని ఇన్‌స్టాల్ చేయండి, లేదా ఏజెంట్లు పేజీలో దాని ఎంపికను తీసివేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ติดตั้งเอเจนต์นั้น หรือเลิกเลือกในหน้าเอเจนต์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yükleyin veya Ajanlar sayfasında işaretini kaldırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інсталюйте його або зніміть із нього позначку на сторінці «Агенти»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسے انسٹال کریں، یا ایجنٹس صفحے پر اس کا انتخاب ہٹا دیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài đặt nó, hoặc bỏ chọn nó trên trang Tác tử."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装它，或在“智能体”页面中取消勾选它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安裝它，或在「代理程式」頁面中取消勾選它。"
          }
        }
      }
    },
    "app.fixAgentsAddWindow": {
      "comment": "Checks page: no agent is in the Finder menu. 'Agents' is the page (key app.tabAgents). Window form of doctor.fix.agentsAdd.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدِّد الوكلاء الذين تعرضهم القائمة في صفحة «الوكلاء»."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "“এজেন্ট” পৃষ্ঠায় মেনু যে এজেন্টগুলো দেখাবে সেগুলোতে টিক দিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kreuze auf der Seite „Agenten“ die Agenten an, die das Menü anbieten soll."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε στη σελίδα «Πράκτορες» τους πράκτορες που προσφέρει το μενού."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the agents that the menu offers on the Agents page."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca en la página Agentes los agentes que ofrece el menú."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در صفحهٔ «عامل‌ها» عامل‌هایی را که منو ارائه می‌دهد علامت بزنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans la page Agents, cochez les agents que le menu doit proposer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לסמן בעמוד ״סוכנים״ את הסוכנים שהתפריט יציע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“एजेंट” पेज पर वे एजेंट चुनें जिन्हें मेन्यू दिखाए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Centang agen yang ditawarkan menu di halaman Agen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nella pagina Agenti, seleziona gli agenti che il menu deve offrire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「エージェント」ページで、メニューに表示するエージェントにチェックを入れてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트 페이지에서 메뉴에 표시할 에이전트를 체크하십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "“एजंट” पृष्ठावर मेनू दाखवेल ते एजंट टिक करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tandakan ejen yang ditawarkan oleh menu pada halaman Ejen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vink op de pagina Agenten de agenten aan die het menu aanbiedt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na stronie Agenci zaznacz agentów, których ma oferować menu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque na página Agentes os agentes que o menu oferece."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Bifați pe pagina Agenți agenții pe care îi oferă meniul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметьте на странице «Агенты» агентов, которых предлагает меню."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முகவர்கள் பக்கத்தில், மெனு வழங்கும் முகவர்களைத் தேர்ந்தெடுக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఏజెంట్లు పేజీలో, మెనూ అందించే ఏజెంట్లను ఎంచుకోండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกเอเจนต์ที่เมนูจะแสดงในหน้าเอเจนต์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Menünün sunduğu ajanları Ajanlar sayfasında işaretleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначте на сторінці «Агенти» агентів, яких пропонує меню."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایجنٹس صفحے پر وہ ایجنٹس منتخب کریں جو مینو پیش کرے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn các tác tử mà menu cung cấp trên trang Tác tử."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“智能体”页面中勾选菜单要提供的智能体。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「代理程式」頁面中勾選選單要提供的代理程式。"
          }
        }
      }
    },
    "app.fixConfigErrorsWindow": {
      "comment": "Checks page: the config file has errors. 'Config' is the page (key app.tabConfig). Window form of doctor.fix.configErrors.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أصلح الأخطاء في صفحة «ملف الإعداد». وحتى ذلك الحين تُطبَّق القيم الافتراضية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "“কনফিগ” পৃষ্ঠায় ত্রুটিগুলো ঠিক করুন। ততক্ষণ ডিফল্ট মানগুলো প্রযোজ্য থাকবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behebe die Fehler auf der Seite „Konfiguration“. Bis dahin gelten die Standardwerte."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διορθώστε τα σφάλματα στη σελίδα «Ρυθμίσεις». Μέχρι τότε ισχύουν οι προεπιλογές."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fix the errors on the Config page. Until then the defaults apply."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrige los errores en la página Configuración. Mientras tanto se aplican los valores predeterminados."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "خطاها را در صفحهٔ «پیکربندی» برطرف کنید. تا آن زمان مقادیر پیش‌فرض اعمال می‌شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrigez les erreurs dans la page Configuration. D’ici là, les valeurs par défaut s’appliquent."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לתקן את השגיאות בעמוד ״תצורה״. עד אז חלות ברירות המחדל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“कॉन्फ़िग” पेज पर एरर ठीक करें। तब तक डिफ़ॉल्ट लागू रहते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perbaiki kesalahannya di halaman Konfigurasi. Sampai saat itu, nilai default yang berlaku."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Correggi gli errori nella pagina Configurazione. Fino ad allora valgono i valori predefiniti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「設定」ページでエラーを修正してください。それまでは既定値が使われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 페이지에서 오류를 수정하십시오. 그때까지는 기본값이 적용됩니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "“कॉन्फिग” पृष्ठावर त्रुटी दुरुस्त करा. तोपर्यंत डीफॉल्ट मूल्ये लागू राहतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Betulkan ralat pada halaman Konfigurasi. Sehingga itu, nilai lalai digunakan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Los de fouten op de pagina Configuratie op. Tot die tijd gelden de standaardwaarden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Popraw błędy na stronie Konfiguracja. Do tego czasu obowiązują wartości domyślne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrija os erros na página Configuração. Até lá, valem os padrões."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Corectați erorile pe pagina Configurație. Până atunci se aplică valorile implicite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исправьте ошибки на странице «Конфигурация». До тех пор действуют значения по умолчанию."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உள்ளமைவுப் பக்கத்தில் பிழைகளைச் சரிசெய்யவும். அதுவரை இயல்புநிலை மதிப்புகள் பொருந்தும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కాన్ఫిగరేషన్ పేజీలో లోపాలను సరిచేయండి. అప్పటివరకు డిఫాల్ట్‌లు వర్తిస్తాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แก้ไขข้อผิดพลาดในหน้าการกำหนดค่า ระหว่างนี้จะใช้ค่าเริ่มต้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hataları Yapılandırma sayfasında düzeltin. O zamana kadar saptanmış değerler geçerlidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виправте помилки на сторінці «Конфігурація». Доти діють типові значення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کنفیگ صفحے پر غلطیاں درست کریں۔ تب تک ڈیفالٹس لاگو رہتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sửa các lỗi trên trang Cấu hình. Cho đến lúc đó, các giá trị mặc định được áp dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“配置”页面中修正错误。在此之前，将使用默认设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「設定檔」頁面中修正錯誤。在此之前，將使用預設值。"
          }
        }
      }
    },
    "app.fixConfigWarningsWindow": {
      "comment": "Checks page: the config has warnings. 'Config' = app.tabConfig. Window form of doctor.fix.configWarnings.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطّلع على التحذيرات في صفحة «ملف الإعداد»: التحذير غالبًا خطأ كتابي، وما كان يُفترض ضبطه غير موجود."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "“কনফিগ” পৃষ্ঠায় সতর্কবার্তাগুলো দেখুন: সতর্কবার্তা সাধারণত টাইপের ভুল, আর যা সেট করার কথা ছিল তা নেই।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh dir die Warnungen auf der Seite „Konfiguration“ an: Eine Warnung ist meist ein Tippfehler, und was damit gesetzt werden sollte, fehlt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δείτε τις προειδοποιήσεις στη σελίδα «Ρυθμίσεις»: μια προειδοποίηση είναι συνήθως τυπογραφικό λάθος, και λείπει αυτό που έπρεπε να οριστεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look at the warnings on the Config page: a warning is usually a typo, and what it was meant to set is missing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa las advertencias en la página Configuración: una advertencia suele ser un error tipográfico, y falta lo que se pretendía configurar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هشدارها را در صفحهٔ «پیکربندی» ببینید: هشدار معمولاً یک غلط تایپی است و مقداری که قرار بوده تنظیم شود، وجود ندارد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultez les avertissements dans la page Configuration : un avertissement signale généralement une faute de frappe, et le réglage voulu n’est alors pas défini."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לעיין באזהרות בעמוד ״תצורה״: אזהרה היא בדרך כלל שגיאת הקלדה, וההגדרה שהייתה אמורה להיקבע חסרה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“कॉन्फ़िग” पेज पर चेतावनियाँ देखें: चेतावनी आमतौर पर टाइपिंग की गलती होती है, और जो सेटिंग होनी चाहिए थी, वह गायब है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat peringatan di halaman Konfigurasi: peringatan biasanya berupa salah ketik, dan pengaturan yang seharusnya diatur belum ada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda gli avvisi nella pagina Configurazione: un avviso è di solito un errore di battitura, e manca quanto avrebbe dovuto impostare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「設定」ページで警告を確認してください。警告の多くは入力ミスで、本来設定されるはずだった項目が欠けています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 페이지에서 경고를 확인하십시오. 경고는 대개 오타이며, 설정하려던 항목이 빠져 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "“कॉन्फिग” पृष्ठावरील चेतावण्या पाहा: चेतावणी सहसा टायपिंगची चूक असते, आणि जे सेट करायचे होते ते गहाळ आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat amaran pada halaman Konfigurasi: amaran biasanya kesilapan menaip, dan seting yang sepatutnya ditetapkan itu tiada."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk de waarschuwingen op de pagina Configuratie: een waarschuwing is meestal een typefout, en de instelling die bedoeld was, ontbreekt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź ostrzeżenia na stronie Konfiguracja: ostrzeżenie to zwykle literówka, przez którą zamierzone ustawienie nie zostało zastosowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja os avisos na página Configuração: um aviso costuma ser um erro de digitação, e está faltando a configuração que deveria ter sido definida."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Uitați-vă la avertismentele de pe pagina Configurație: un avertisment este de obicei o greșeală de tastare, iar ceea ce trebuia să seteze lipsește."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Посмотрите предупреждения на странице «Конфигурация»: предупреждение обычно вызвано опечаткой, и то, что оно должно было задать, отсутствует."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உள்ளமைவுப் பக்கத்தில் எச்சரிக்கைகளைப் பாருங்கள்: எச்சரிக்கை பொதுவாகத் தட்டச்சுப் பிழையாக இருக்கும்; அது அமைக்க வேண்டிய மதிப்பு விடுபட்டுள்ளது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కాన్ఫిగరేషన్ పేజీలో హెచ్చరికలను చూడండి: హెచ్చరిక సాధారణంగా అక్షర దోషమే, అది సెట్ చేయాలనుకున్నది లేకుండా పోయింది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูคำเตือนในหน้าการกำหนดค่า คำเตือนมักเกิดจากการพิมพ์ผิด และค่าที่ควรตั้งไว้จึงหายไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapılandırma sayfasındaki uyarılara bakın: bir uyarı genellikle bir yazım hatasıdır ve ayarlanması gereken değer eksiktir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перегляньте попередження на сторінці «Конфігурація»: попередження зазвичай спричинене друкарською помилкою, і того параметра, який мали задати, немає."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کنفیگ صفحے پر انتباہات دیکھیں: انتباہ عموماً ٹائپنگ کی غلطی سے آتا ہے، اور جو سیٹنگ مقصود تھی وہ غائب ہوتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem các cảnh báo trên trang Cấu hình: cảnh báo thường do gõ sai, và thiết lập lẽ ra phải đặt bị thiếu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看“配置”页面中的警告：警告通常是拼写错误，本应设置的配置项缺失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查看「設定檔」頁面中的警告：警告通常是打字錯誤，本應設定的項目卻缺少了。"
          }
        }
      }
    },
    "app.fixEditorWindow": {
      "comment": "Same, for the editor (doctor.fix.editor). 'Overview' = app.tabOverview.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثبّت محررًا، أو اختر واحدًا في صفحة «نظرة عامة»."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি এডিটর ইনস্টল করুন, অথবা “সারসংক্ষেপ” পৃষ্ঠায় একটি বেছে নিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiere einen Editor oder wähle einen auf der Seite „Übersicht“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εγκαταστήστε έναν επεξεργαστή ή επιλέξτε έναν στη σελίδα «Επισκόπηση»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install an editor, or choose one on the Overview."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala un editor o elige uno en la página Resumen."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک ویرایشگر نصب کنید یا در صفحهٔ «نمای کلی» یکی را انتخاب کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez un éditeur ou choisissez-en un dans la page Vue d’ensemble."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להתקין עורך או לבחור עורך בעמוד ״סקירה כללית״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई एडिटर इंस्टॉल करें या “ओवरव्यू” पेज पर कोई एक चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Instal editor atau pilih salah satu di halaman Ringkasan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installa un editor o scegline uno nella pagina Panoramica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エディタをインストールするか、「概要」ページで選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집기를 설치하거나 개요 페이지에서 선택하십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एडिटर इन्स्टॉल करा किंवा “आढावा” पृष्ठावर एक निवडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasang editor atau pilih satu pada halaman Gambaran Keseluruhan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Installeer een editor of kies er een op de pagina Overzicht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zainstaluj edytor albo wybierz edytor na stronie Przegląd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale um editor ou escolha um na página Visão geral."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalați un editor sau alegeți unul pe pagina Privire de ansamblu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установите редактор или выберите его на странице «Обзор»."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு எடிட்டரை நிறுவவும் அல்லது மேலோட்டம் பக்கத்தில் ஒன்றைத் தேர்ந்தெடுக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఒక ఎడిటర్‌ను ఇన్‌స్టాల్ చేయండి లేదా అవలోకనం పేజీలో ఒకదాన్ని ఎంచుకోండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ติดตั้งโปรแกรมแก้ไข หรือเลือกโปรแกรมแก้ไขในหน้าภาพรวม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir düzenleyici yükleyin veya Genel Bakış sayfasında birini seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інсталюйте редактор або виберіть його на сторінці «Огляд»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی ایڈیٹر انسٹال کریں یا جائزہ صفحے پر کوئی ایک منتخب کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài đặt một trình soạn thảo hoặc chọn một trình soạn thảo trên trang Tổng quan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装编辑器，或在“概览”页面中选择一个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安裝編輯器，或在「概覽」頁面中選擇一個。"
          }
        }
      }
    },
    "app.fixExtensionClean": {
      "comment": "What to do when the Finder extension is registered from more than one place. Based on the existing translation of the older sentence (`similar`, which says to run `rh setup`): keep its wording for the stale copies, and name the button Install or Repair with its existing translation (glossary) in place of the command.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط «تثبيت أو إصلاح» لإزالة النسخ القديمة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পুরোনো কপিগুলো সরাতে “ইনস্টল বা মেরামত করুন” চাপ দিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücke „Installieren oder reparieren“, um die veralteten Kopien zu entfernen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε «Εγκατάσταση ή επισκευή» για να αφαιρέσετε τα παλιά αντίγραφα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press Install or Repair to remove the stale copies."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa «Instalar o reparar» para eliminar las copias obsoletas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "«نصب یا تعمیر» را بزنید تا نسخه‌های قدیمی حذف شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur Installer ou réparer pour supprimer les copies obsolètes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי להסיר את העותקים הישנים, יש ללחוץ על ״התקנה או תיקון״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पुरानी प्रतियाँ हटाने के लिए इंस्टॉल या मरम्मत करें बटन दबाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan Instal atau Perbaiki untuk menghapus salinan lama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi Installa o ripara per rimuovere le copie obsolete."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「インストールまたは修復」を押して、古いコピーを削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치 또는 복구를 눌러 오래된 복사본을 제거하십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "जुन्या प्रती काढण्यासाठी “इन्स्टॉल किंवा दुरुस्त करा” दाबा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan Pasang atau Baiki untuk mengeluarkan salinan usang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik op „Installeer of repareer” om de verouderde kopieën te verwijderen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij w Zainstaluj lub napraw, aby usunąć nieaktualne kopie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique em Instalar ou Reparar para remover as cópias desatualizadas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Faceți clic pe Instalați sau reparați pentru a elimina copiile învechite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите «Установить или восстановить», чтобы удалить устаревшие копии."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பழைய நகல்களை நீக்க நிறுவு அல்லது சரிசெய் பொத்தானை அழுத்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పాత కాపీలను తొలగించడానికి ఇన్‌స్టాల్ లేదా మరమ్మతు చేయండి బటన్‌ను నొక్కండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กดปุ่มติดตั้งหรือซ่อมแซมเพื่อลบสำเนาเก่าออก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eski kopyaları kaldırmak için Yükle veya Onar düğmesine basın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть «Інсталювати або полагодити», щоб видалити застарілі копії."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پرانی کاپیاں ہٹانے کے لیے “انسٹال یا مرمت کریں” دبائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn Cài đặt hoặc sửa chữa để xóa các bản sao cũ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按“安装或修复”以移除过时的副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下「安裝或修復」以移除過時的副本。"
          }
        }
      }
    },
    "app.fixExtensionEnable": {
      "comment": "What to do when the Finder extension is registered but switched off. The existing translation of the older, longer sentence (given as `similar`) has the same second half: reuse its wording of the System Settings path exactly and drop its first clause (the one about running `rh setup`).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّل Right Here في إعدادات النظام › عام › عناصر الدخول والملحقات › Finder."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "System Settings › General › Login Items & Extensions › Finder-এর অধীনে Right Here চালু করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
