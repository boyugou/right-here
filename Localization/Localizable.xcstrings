          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ติดตั้งแล้ว: %1$@ แต่ต่างจากการกำหนดค่า (ขาดหายไป: %2$@, ค้างเก่า: %3$@)"
