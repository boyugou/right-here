    "app.otherCopyBody": {
      "comment": "Under that title. %1$@ is a folder such as /Applications (a value). Compare app.olderCopyBody: reuse its wording for 'Open it, and move this copy to the Trash so that Spotlight opens …'.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "النسخة التي يجب الاحتفاظ بها موجودة في %1$@. افتحها، وانقل هذه النسخة إلى سلة المهملات حتى يفتح Spotlight تلك النسخة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "যে কপিটি রাখতে হবে সেটি %1$@-এ আছে। সেটি খুলুন, আর এই কপিটি Trash-এ সরান, যাতে Spotlight সেটি খোলে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Kopie, die du behalten solltest, liegt in %1$@. Öffne sie und lege diese Kopie in den Papierkorb, damit Spotlight die andere öffnet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Το αντίγραφο που πρέπει να κρατήσετε βρίσκεται στο %1$@. Ανοίξτε το και μετακινήστε αυτό το αντίγραφο στον Κάδο, ώστε το Spotlight να ανοίγει εκείνο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The copy to keep is in %1$@. Open it, and move this copy to the Trash so that Spotlight opens that one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La copia que debes conservar está en %1$@. Ábrela y mueve esta copia a la Papelera para que Spotlight abra esa."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "نسخه‌ای که باید نگه دارید در %1$@ است. آن را باز کنید و این نسخه را به Trash ببرید تا Spotlight همان نسخه را باز کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La copie à conserver se trouve dans %1$@. Ouvrez-la et placez cette copie dans la Corbeille pour que Spotlight ouvre celle-là."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "העותק שיש להשאיר נמצא ב-%1$@. יש לפתוח אותו ולהעביר עותק זה לפח, כדי ש-Spotlight יפתח אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "जिस प्रति को रखना है, वह %1$@ में है। उसे खोलें और इस प्रति को रद्दी में मूव करें, ताकि Spotlight वही प्रति खोले।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salinan yang perlu disimpan ada di %1$@. Buka salinan itu, lalu pindahkan salinan ini ke Tong Sampah agar Spotlight membuka salinan tersebut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La copia da tenere si trova in %1$@. Aprila e sposta questa copia nel Cestino, così Spotlight aprirà quella."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "残しておくべきコピーは %1$@ にあります。それを開き、Spotlight でそちらが開くように、このコピーをゴミ箱に入れてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "남겨 둘 복사본은 %1$@에 있습니다. 해당 복사본을 열고, Spotlight가 그 복사본을 열도록 이 복사본을 휴지통으로 옮기십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ठेवायची प्रत %1$@ मध्ये आहे. ती उघडा, आणि Spotlight तीच प्रत उघडेल यासाठी ही प्रत Trash मध्ये हलवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salinan yang perlu disimpan berada dalam %1$@. Bukanya, dan pindahkan salinan ini ke Sampah supaya Spotlight membuka salinan itu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De kopie die je moet bewaren staat in %1$@. Open die en verplaats deze kopie naar de prullenmand, zodat Spotlight die andere opent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kopia, którą należy zachować, jest w %1$@. Otwórz ją, a tę kopię przenieś do Kosza, aby Spotlight otwierał tamtą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A cópia que deve ser mantida está em %1$@. Abra-a e mova esta cópia para o Lixo para que o Spotlight abra aquela."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Copia care trebuie păstrată se află în %1$@. Deschideți-o și mutați această copie în Coș, astfel încât Spotlight să o deschidă pe aceea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Копия, которую нужно оставить, находится в %1$@. Откройте ее, а эту копию переместите в Корзину, чтобы Spotlight открывал ту."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "வைத்துக்கொள்ள வேண்டிய நகல் %1$@ இல் உள்ளது. அதைத் திறந்து, Spotlight அந்த நகலைத் திறக்கும்படி இந்த நகலை Trash-க்கு நகர்த்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ఉంచుకోవాల్సిన కాపీ %1$@ లో ఉంది. దాన్ని తెరిచి, Spotlight ఆ కాపీని తెరిచేలా ఈ కాపీని Trash కు తరలించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "สำเนาที่ควรเก็บไว้อยู่ใน %1$@ เปิดสำเนานั้น แล้วย้ายสำเนานี้ไปยังถังขยะ เพื่อให้ Spotlight เปิดสำเนานั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Saklanması gereken kopya %1$@ konumunda. Onu açın ve Spotlight’ın onu açması için bu kopyayı Çöp Sepeti’ne taşıyın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Копія, яку слід залишити, міститься в %1$@. Відкрийте її, а цю копію перемістіть у Смітник, щоб Spotlight відкривав ту."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "جو کاپی رکھنی ہے وہ %1$@ میں ہے۔ اسے کھولیں، اور اس کاپی کو Trash میں منتقل کریں تاکہ Spotlight وہی کاپی کھولے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bản sao cần giữ lại nằm trong %1$@. Hãy mở bản sao đó và chuyển bản sao này vào Thùng rác để Spotlight mở bản sao kia."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "应保留的副本位于 %1$@ 中。请打开它，并将此副本移到废纸篓，这样 聚焦 就会打开那个副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "應保留的副本位於 %1$@ 中。請打開它，並將此副本移到垃圾桶，這樣 Spotlight 就會打開那個副本。"
          }
        }
      }
    },
    "app.otherCopyTitle": {
      "comment": "Title of the card at the top of the setup window when the person opened a copy of the app that has the same version as another one that is installed in the Mac's Applications folder, which is the one to keep. Compare app.olderCopyTitle (for an older copy): use the same style.",
