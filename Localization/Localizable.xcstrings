    "app.foldersNote": {
      "comment": "Text at the top of the Folders section of the setup window: where the pinned and the recent folders are kept, and who can read them. 'MCP' stays as it is.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يحتفظ Right Here بهذه المجلدات على هذا Mac فقط، في ملف بجانب ملف الإعدادات الخاص بك. ويمكن لمساعد AI متصل عبر MCP أن يقرأها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here এই ফোল্ডারগুলো শুধু এই Mac-এ, আপনার কনফিগারেশন ফাইলের পাশের একটি ফাইলে মনে রাখে. MCP দিয়ে আপনি যে AI সহকারীকে সংযুক্ত করেন, সে এগুলো পড়তে পারে."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here merkt sich diese Ordner nur auf diesem Mac, und zwar in einer Datei neben Ihrer Konfigurationsdatei. Ein AI-Assistent, den Sie über MCP verbinden, kann sie lesen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Το Right Here θυμάται αυτούς τους φακέλους μόνο σε αυτό το Mac, σε ένα αρχείο δίπλα στο αρχείο ρυθμίσεών σας. Ένας βοηθός AI που συνδέετε μέσω MCP μπορεί να τους διαβάσει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here remembers these folders on this Mac only, in a file next to your config. An AI assistant that you connect through MCP can read them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here recuerda estas carpetas solo en este Mac, en un archivo junto a su archivo de configuración. Un asistente de AI conectado a través de MCP puede leerlas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "‏Right Here این پوشه‌ها را فقط روی همین مک و در فایلی کنار فایل پیکربندی شما نگه می‌دارد. یک دستیار AI که از طریق MCP وصلش می‌کنید می‌تواند آن‌ها را بخواند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here mémorise ces dossiers uniquement sur ce Mac, dans un fichier placé à côté de votre fichier de configuration. Un assistant AI que vous connectez via MCP peut les lire."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "‏Right Here זוכר את התיקיות האלה רק על ה-Mac הזה, בקובץ שנמצא ליד קובץ הגדרות שלכם. עוזר AI שאתם מחברים דרך MCP יכול לקרוא אותן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here इन फ़ोल्डरों को केवल इस Mac पर, आपकी कॉन्फ़िगरेशन फ़ाइल के बगल वाली एक फ़ाइल में याद रखता है। जो AI असिस्टेंट आप MCP के ज़रिए जोड़ते हैं, वह इन्हें पढ़ सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here menyimpan folder-folder ini hanya di Mac ini, dalam berkas di samping berkas konfigurasi Anda. Asisten AI yang Anda hubungkan melalui MCP dapat membacanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here ricorda queste cartelle solo su questo Mac, in un file accanto al file di configurazione. Un assistente AI collegato tramite MCP può leggerle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here は、これらのフォルダをこの Mac の中にだけ、設定ファイルの隣のファイルに保存します。MCP で接続した AIアシスタントは、それらを読み取れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here는 이 폴더들을 이 Mac에만, 설정 파일 옆의 파일에 저장합니다. MCP로 연결한 AI 어시스턴트가 이 폴더들을 읽을 수 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ही फोल्डर्स फक्त या Mac वर, तुमच्या कॉन्फिगरेशन फाइलजवळील एका फाइलमध्ये Right Here कडून जतन केली जातात. MCP द्वारे जोडलेला AI असिस्टंट त्यांना वाचू शकतो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here mengingati folder-folder ini pada Mac ini sahaja, dalam satu fail di sebelah fail konfigurasi anda. Pembantu AI yang anda sambungkan melalui MCP boleh membacanya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here onthoudt deze mappen alleen op deze Mac, in een bestand naast je configuratiebestand. Een AI-assistent die je via MCP verbindt, kan ze lezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here zapamiętuje te foldery tylko na tym Macu, w pliku obok konfiguracji. Asystent AI podłączony przez MCP może je odczytać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Right Here guarda estas pastas somente neste Mac, em um arquivo ao lado da sua configuração. Um assistente de AI conectado pelo MCP pode lê-las."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here reține aceste dosare doar pe acest Mac, într-un fișier lângă fișierul de configurare. Un asistent AI conectat prin MCP le poate citi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here запоминает эти папки только на этом Mac, в файле рядом с файлом конфигурации. AI-ассистент, подключённый через MCP, может их читать."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here இந்தக் கோப்புறைகளை இந்த Mac-இல் மட்டுமே, உங்கள் உள்ளமைவுக் கோப்புக்கு அடுத்துள்ள ஒரு கோப்பில் நினைவில் வைத்திருக்கிறது. நீங்கள் MCP மூலம் இணைக்கும் ஒரு AI உதவியாளர் இவற்றைப் படிக்க முடியும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here ఈ ఫోల్డర్లను ఈ Mac లో మాత్రమే, మీ కాన్ఫిగరేషన్ ఫైల్ పక్కనే ఉన్న ఫైల్లో గుర్తుంచుకుంటుంది. MCP ద్వారా మీరు కనెక్ట్ చేసే AI సహాయకుడు వాటిని చదవగలరు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here จดจำโฟลเดอร์เหล่านี้ไว้บน Mac เครื่องนี้เท่านั้น ในไฟล์ที่อยู่ถัดจากไฟล์ตั้งค่าของคุณ ผู้ช่วย AI ที่คุณเชื่อมต่อผ่าน MCP สามารถอ่านโฟลเดอร์เหล่านี้ได้."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here bu klasörleri yalnızca bu Mac’te, yapılandırma dosyanızın yanındaki bir dosyada saklar. MCP üzerinden bağladığınız bir AI asistanı bunları okuyabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here зберігає ці папки лише на цьому Mac у файлі поруч із вашим файлом конфігурації. AI-асистент, якого ви підключаєте через MCP, може їх читати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "‏Right Here ان فولڈرز کو صرف اسی Mac پر یاد رکھتا ہے، کنفیگ فائل کے ساتھ والی ایک فائل میں۔ MCP کے ذریعے جڑا ہوا کوئی بھی AI اسسٹنٹ انہیں پڑھ سکتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here chỉ ghi nhớ các thư mục này trên Mac này, trong một tệp nằm cạnh cấu hình của bạn. Trợ lý AI mà bạn kết nối qua MCP có thể đọc chúng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here 只在这台 Mac 上记住这些文件夹，记录保存在你的配置文件旁边的一个文件中。你通过 MCP 连接的 AI 助手可以读取它们。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here 只會在這台 Mac 上記住這些資料夾，記錄存放在你的設定檔旁邊的一個檔案中。你透過 MCP 連接的 AI 助理可以讀取這些資料。"
          }
        }
      }
    },
