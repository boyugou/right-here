    "doctor.agent.bypass": {
      "comment": "Detail line of a check in the setup window's Details list; it follows the check's title, so it is a fragment with no final period. %1$@ is the command of an AI agent. %2$@ is the title of a Finder menu item in English, for example Claude Code Here: keep it as it is, in quotes if that is natural. %3$@ is a command-line flag that switches the agent's own permission prompts off, for example --dangerously-skip-permissions: keep it exactly.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تم العثور على `%1$@`؛ يبدأ من «%2$@» وطلبات الإذن الخاصة به متوقفة بالخيار `%3$@`"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "`%1$@` পাওয়া গেছে; “%2$@” দিয়ে শুরু হয় এবং অনুমতি চাওয়ার প্রশ্ন বন্ধ থাকে (`%3$@`)"
