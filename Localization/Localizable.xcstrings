        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lời nhắc có dấu xuống dòng hoặc một ký tự điều khiển khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
