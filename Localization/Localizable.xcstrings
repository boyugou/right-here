    "app.configNoProblems": {
      "comment": "Said under the text editor when the text being edited has no error and no warning.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا توجد مشكلات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "কোনো সমস্যা নেই।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
