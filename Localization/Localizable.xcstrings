            "value": "La cartella %@ non può essere scritta in un link per Warp."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダ%@をWarp用のリンクに書き込むことはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 폴더는 Warp용 링크에 쓸 수 없습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फोल्डर %@ Warp साठीच्या लिंकमध्ये लिहिता येत नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder %@ tidak boleh ditulis ke dalam pautan untuk Warp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De map %@ kan niet in een link voor Warp worden geschreven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Folderu %@ nie można zapisać w łączu dla Warp."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pasta %@ não pode ser escrita em um link para o Warp."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosarul %@ nu poate fi scris într-un link pentru Warp."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папку %@ нельзя записать в ссылку для Warp."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ என்ற கோப்புறையை Warp க்கான இணைப்பில் எழுத முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ఫోల్డర్‌ను Warp కోసం లింక్‌లో రాయలేము."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เขียนโฟลเดอร์ %@ ลงในลิงก์สำหรับ Warp ไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ klasörü Warp için bir bağlantıya yazılamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Папку %@ не можна записати в посилання для Warp."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فولڈر %@ کو Warp کے لنک میں نہیں لکھا جا سکتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể ghi thư mục %@ vào liên kết cho Warp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法将文件夹 %@ 写入 Warp 的链接中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法將檔案夾 %@ 寫入 Warp 的連結中。"
          }
        }
      }
    },
    "refusal.worktreeHoldsOthers": {
      "comment": "Said when the person asks to remove a git worktree (a second working copy of a repository) that has other worktrees inside its folder. %1$@ is the folder of the worktree, %2$@ a list of the folders inside it.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتوي %1$@ على worktrees أخرى (%2$@). إزالته ستحذفها مع عملها، لذلك لم تتم إزالته. أزل تلك أولًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-এর ভেতরে অন্য worktree আছে (%2$@)। এটি সরালে সেগুলো ও তাদের কাজ মুছে যাবে, তাই এটি সরানো হয়নি। আগে সেগুলো সরান।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ enthält andere Worktrees (%2$@). Beim Entfernen würden sie samt ihrer Arbeit gelöscht, deshalb wurde es nicht entfernt. Entferne zuerst diese."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %1$@ περιέχει άλλα worktree (%2$@). Η αφαίρεσή του θα τα διέγραφε μαζί με την εργασία τους, γι’ αυτό δεν αφαιρέθηκε. Αφαιρέστε πρώτα εκείνα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ holds other worktrees (%2$@). Removing it would delete them and their work, so it was not removed. Remove those first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ contiene otros worktrees (%2$@). Quitarlo los borraría junto con su trabajo, así que no se ha quitado. Quita primero esos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%1$@ worktreeهای دیگری در خود دارد (%2$@). حذف آن، آن‌ها را همراه با کارشان پاک می‌کند، پس حذف نشد. اول آن‌ها را حذف کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ contient d’autres worktrees (%2$@). Le supprimer les effacerait avec leur travail : il n’a donc pas été supprimé. Supprimez-les d’abord."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%1$@ מכיל worktrees אחרים (%2$@). הסרתו הייתה מוחקת אותם ואת העבודה שבהם, ולכן הוא לא הוסר. יש להסיר אותם קודם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ में दूसरे worktree हैं (%2$@)। इसे हटाने से वे और उनका काम मिट जाएगा, इसलिए इसे नहीं हटाया गया। पहले उन्हें हटाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ berisi worktree lain (%2$@). Menghapusnya akan menghapus worktree tersebut beserta pekerjaannya, jadi tidak dihapus. Hapus yang itu terlebih dahulu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ contiene altri worktree (%2$@). Rimuoverlo li eliminerebbe insieme al loro lavoro, quindi non è stato rimosso. Rimuovi prima quelli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ の中にはほかのワークツリーがあります（%2$@）。削除するとそれらと中の作業も消えるため、削除しませんでした。先にそれらを削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 안에 다른 워크트리가 있습니다(%2$@). 제거하면 그 워크트리와 작업 내용도 삭제되므로 제거하지 않았습니다. 그것들을 먼저 제거하십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ मध्ये इतर वर्कट्री आहेत (%2$@). ते काढल्यास ते आणि त्यांचे काम हटवले जाईल, म्हणून ते काढले नाही. आधी ते काढा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ mengandungi worktree lain (%2$@). Mengeluarkannya akan memadamkan worktree itu bersama kerjanya, jadi ia tidak dikeluarkan. Keluarkan yang itu dahulu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ bevat andere worktrees (%2$@). Verwijderen zou ze met hun werk wissen, dus het is niet verwijderd. Verwijder die eerst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ zawiera inne drzewa robocze (%2$@). Usunięcie go skasowałoby je razem z ich pracą, więc nie zostało usunięte. Najpierw usuń tamte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ contém outros worktrees (%2$@). Removê-lo apagaria esses worktrees e o trabalho deles, então ele não foi removido. Remova-os primeiro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ conține alte worktree-uri (%2$@). Eliminarea lui le-ar șterge împreună cu munca din ele, așa că nu a fost eliminat. Eliminați-le mai întâi pe acelea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В %1$@ есть другие рабочие деревья (%2$@). Удаление стерло бы их вместе с их работой, поэтому оно не выполнено. Сначала удалите их."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ இல் வேறு worktree-கள் உள்ளன (%2$@). இதை நீக்கினால் அவையும் அவற்றின் வேலையும் அழியும், எனவே இது நீக்கப்படவில்லை. முதலில் அவற்றை நீக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ లో వేరే worktree లు ఉన్నాయి (%2$@). దీన్ని తీసివేస్తే అవి, వాటి పని కూడా తొలగిపోతాయి, అందుకే దీన్ని తీసివేయలేదు. ముందుగా వాటిని తీసివేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ มี worktree อื่นอยู่ข้างใน (%2$@) การเอาออกจะลบ worktree เหล่านั้นพร้อมงานในนั้นด้วย จึงไม่ได้เอาออก โปรดเอา worktree เหล่านั้นออกก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ başka worktree’ler içeriyor (%2$@). Kaldırmak onları içlerindeki çalışmayla birlikte silerdi, bu yüzden kaldırılmadı. Önce onları kaldırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У %1$@ є інші worktrees (%2$@). Вилучення стерло б їх разом із їхньою роботою, тому його не виконано. Спершу вилучіть їх."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%1$@ میں دوسرے ورک ٹریز موجود ہیں (%2$@)۔ اسے ہٹانے سے وہ اور ان کا کام مٹ جاتا، اس لیے اسے نہیں ہٹایا گیا۔ پہلے انہیں ہٹائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ chứa các worktree khác (%2$@). Xóa nó sẽ xóa luôn các worktree đó cùng công việc trong đó, nên nó chưa bị xóa. Hãy xóa các worktree đó trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 中还有其他工作树（%2$@）。移除它会把这些工作树及其中的工作一起删除，因此没有移除。请先移除它们。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 中還有其他工作樹（%2$@）。移除它會把這些工作樹及其中的工作一起刪除，因此沒有移除。請先移除它們。"
          }
        }
      }
    },
    "refusal.worktreeIgnoredFiles": {
      "comment": "Said when the person asks to remove a git worktree that holds files git ignores (such as a .env file or build output), which a removal would delete. %1$@ is the worktree's folder, %2$@ a list of the files.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتوي %1$@ على ملفات يتجاهلها git ولا توجد إلا فيه: %2$@. إزالته ستحذفها، لذلك لم تتم إزالته."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-এ এমন ফাইল আছে যা git উপেক্ষা করে এবং যা কেবল সেখানেই আছে: %2$@। এটি সরালে সেগুলো মুছে যাবে, তাই এটি সরানো হয়নি।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ enthält Dateien, die git ignoriert und die es nur dort gibt: %2$@. Beim Entfernen würden sie gelöscht, deshalb wurde es nicht entfernt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %1$@ περιέχει αρχεία που αγνοεί το git και υπάρχουν μόνο εκεί: %2$@. Η αφαίρεσή του θα τα διέγραφε, γι’ αυτό δεν αφαιρέθηκε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ holds files that git ignores and that exist only there: %2$@. Removing it would delete them, so it was not removed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ contiene archivos que git ignora y que solo existen ahí: %2$@. Quitarlo los borraría, así que no se ha quitado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%1$@ فایل‌هایی دارد که git نادیده می‌گیرد و فقط همان‌جا هستند: %2$@. حذف آن، این فایل‌ها را پاک می‌کند، پس حذف نشد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ contient des fichiers que git ignore et qui n’existent que là : %2$@. Le supprimer les effacerait : il n’a donc pas été supprimé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%1$@ מכיל קבצים ש-git מתעלם מהם ושקיימים רק שם: %2$@. הסרתו הייתה מוחקת אותם, ולכן הוא לא הוסר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ में ऐसी फ़ाइलें हैं जिन्हें git अनदेखा करता है और जो सिर्फ़ वहीं हैं: %2$@। इसे हटाने से वे मिट जाएँगी, इसलिए इसे नहीं हटाया गया।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ berisi file yang diabaikan git dan hanya ada di sana: %2$@. Menghapusnya akan menghapus file tersebut, jadi tidak dihapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ contiene file che git ignora e che esistono solo lì: %2$@. Rimuoverlo li eliminerebbe, quindi non è stato rimosso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ には、git が無視していてそこにしかないファイルがあります: %2$@。削除するとそれらも消えるため、削除しませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@에는 git이 무시하며 그곳에만 있는 파일이 있습니다: %2$@. 제거하면 이 파일들이 삭제되므로 제거하지 않았습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ मध्ये git दुर्लक्ष करतो अशा आणि फक्त तिथेच असलेल्या फाइल आहेत: %2$@. ते काढल्यास त्या हटवल्या जातील, म्हणून ते काढले नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ mengandungi fail yang diabaikan oleh git dan hanya wujud di situ: %2$@. Mengeluarkannya akan memadamkan fail itu, jadi ia tidak dikeluarkan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ bevat bestanden die git negeert en die alleen daar bestaan: %2$@. Verwijderen zou ze wissen, dus het is niet verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ zawiera pliki, które git ignoruje i które istnieją tylko tam: %2$@. Usunięcie skasowałoby je, więc nie zostało usunięte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ contém arquivos que o git ignora e que só existem ali: %2$@. Removê-lo apagaria esses arquivos, então ele não foi removido."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ conține fișiere pe care git le ignoră și care există doar acolo: %2$@. Eliminarea lui le-ar șterge, așa că nu a fost eliminat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В %1$@ есть файлы, которые git игнорирует и которые есть только там: %2$@. Удаление стерло бы их, поэтому оно не выполнено."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ இல் git புறக்கணிக்கும், அங்கு மட்டுமே உள்ள கோப்புகள் உள்ளன: %2$@. இதை நீக்கினால் அவை அழியும், எனவே இது நீக்கப்படவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ లో git పట్టించుకోని, అక్కడ మాత్రమే ఉన్న ఫైల్‌లు ఉన్నాయి: %2$@. దీన్ని తీసివేస్తే అవి తొలగిపోతాయి, అందుకే దీన్ని తీసివేయలేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ มีไฟล์ที่ git ละเว้นและมีอยู่ที่นั่นเท่านั้น: %2$@ การเอาออกจะลบไฟล์เหล่านั้น จึงไม่ได้เอาออก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, git’in yok saydığı ve yalnızca orada bulunan dosyalar içeriyor: %2$@. Kaldırmak onları silerdi, bu yüzden kaldırılmadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У %1$@ є файли, які git ігнорує і які є лише там: %2$@. Вилучення стерло б їх, тому його не виконано."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%1$@ میں ایسی فائلیں ہیں جنہیں git نظر انداز کرتا ہے اور جو صرف وہیں ہیں: %2$@۔ اسے ہٹانے سے وہ مٹ جاتیں، اس لیے اسے نہیں ہٹایا گیا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ chứa các tệp mà git bỏ qua và chỉ có ở đó: %2$@. Xóa nó sẽ xóa các tệp này, nên nó chưa bị xóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 中有 git 忽略、且只存在于那里的文件：%2$@。移除它会删除这些文件，因此没有移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 中有 git 忽略、且只存在於那裡的檔案：%2$@。移除它會刪除這些檔案，因此沒有移除。"
          }
        }
      }
    },
    "refusal.worktreeLink": {
      "comment": "Said when a repository has a symbolic link where Right Here keeps its git worktrees (.right-here or .right-here/worktrees). %@ is that path.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%@ رابط رمزي. يحفظ Right Here worktrees الخاصة به في مجلدات حقيقية في المستودع فقط، لذلك لم يتم إنشاء أي شيء أو إزالته."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ একটি সিমলিংক। Right Here তার worktree কেবল রিপোজিটরির আসল ফোল্ডারে রাখে, তাই কিছু তৈরি বা সরানো হয়নি।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist ein symbolischer Link. Right Here legt seine Worktrees nur in echten Ordnern des Repositorys an, daher wurde nichts erstellt oder entfernt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %@ είναι συμβολικός σύνδεσμος. Το Right Here κρατά τα worktree του μόνο σε πραγματικούς φακέλους του αποθετηρίου, γι’ αυτό δεν δημιουργήθηκε ούτε αφαιρέθηκε τίποτα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is a symbolic link. Right Here keeps its worktrees only in real folders of the repository, so nothing was made or removed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ es un enlace simbólico. Right Here solo guarda sus worktrees en carpetas reales del repositorio, así que no se ha creado ni quitado nada."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%@ یک پیوند نمادین است. Right Here worktreeهای خود را فقط در پوشه‌های واقعی مخزن نگه می‌دارد، پس چیزی ساخته یا حذف نشد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est un lien symbolique. Right Here ne garde ses worktrees que dans de vrais dossiers du dépôt : rien n’a été créé ni supprimé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%@ הוא קישור סמלי. Right Here שומר את ה-worktrees שלו רק בתיקיות אמיתיות של המאגר, ולכן שום דבר לא נוצר ולא הוסר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ एक सिमलिंक है। Right Here अपने worktree सिर्फ़ रिपॉज़िटरी के असली फ़ोल्डरों में रखता है, इसलिए कुछ भी नहीं बनाया या हटाया गया।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ adalah symlink. Right Here hanya menyimpan worktree-nya di folder asli repositori, jadi tidak ada yang dibuat atau dihapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è un link simbolico. Right Here tiene i suoi worktree solo in cartelle reali del repository, quindi non è stato creato né rimosso nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はシンボリックリンクです。Right Here はワークツリーをリポジトリの実際のフォルダにしか置かないため、何も作成・削除しませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 심볼릭 링크입니다. Right Here는 저장소의 실제 폴더에만 워크트리를 두므로 아무것도 만들거나 제거하지 않았습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ सिम्लिंक आहे. Right Here आपले वर्कट्री फक्त रेपॉझिटरीच्या खऱ्या फोल्डरमध्ये ठेवतो, म्हणून काहीही तयार केले किंवा काढले नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ialah pautan simbolik. Right Here hanya menyimpan worktree dalam folder sebenar repositori, jadi tiada apa-apa dibuat atau dikeluarkan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is een symlink. Right Here bewaart zijn worktrees alleen in echte mappen van de repository, dus er is niets gemaakt of verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ to dowiązanie symboliczne. Right Here trzyma swoje drzewa robocze tylko w prawdziwych folderach repozytorium, więc niczego nie utworzono ani nie usunięto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ é um link simbólico. O Right Here só guarda seus worktrees em pastas reais do repositório, então nada foi criado nem removido."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ este un link simbolic. Right Here își păstrează worktree-urile doar în dosare reale ale depozitului, așa că nu s-a creat și nu s-a eliminat nimic."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — символическая ссылка. Right Here хранит свои рабочие деревья только в настоящих папках репозитория, поэтому ничего не создано и не удалено."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ஒரு symlink. Right Here தன் worktree-களை repository-யின் உண்மையான கோப்புறைகளில் மட்டுமே வைக்கும், எனவே எதுவும் உருவாக்கப்படவோ நீக்கப்படவோ இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ఒక symlink. Right Here తన worktree లను రిపోజిటరీలోని నిజమైన ఫోల్డర్లలోనే ఉంచుతుంది, అందుకే ఏదీ సృష్టించలేదు, తీసివేయలేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ เป็น symlink Right Here เก็บ worktree ไว้ในโฟลเดอร์จริงของรีโพซิทอรีเท่านั้น จึงไม่ได้สร้างหรือเอาสิ่งใดออก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bir sembolik bağlantı. Right Here worktree’lerini yalnızca deponun gerçek klasörlerinde tutar, bu yüzden hiçbir şey oluşturulmadı veya kaldırılmadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — символічне посилання. Right Here зберігає свої worktrees лише в справжніх папках репозиторію, тому нічого не створено й не вилучено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%@ ایک سمبولک لنک ہے۔ Right Here اپنے ورک ٹریز صرف ریپازٹری کے اصل فولڈروں میں رکھتا ہے، اس لیے نہ کچھ بنایا گیا نہ ہٹایا گیا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ là một liên kết tượng trưng. Right Here chỉ giữ các worktree trong thư mục thật của kho, nên không có gì được tạo hay xóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 是符号链接。Right Here 只把工作树放在仓库中真实的文件夹里，因此没有创建或移除任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 是符號連結。Right Here 只把工作樹放在儲存庫中真實的檔案夾裡，因此沒有建立或移除任何內容。"
          }
        }
      }
    },
    "setup.configUnusable": {
      "comment": "The detail of a setup step, shown after the step's name (Config file, Quick Actions) in the setup window; it starts in lower case as the doctor's details do, unless the language has no case. %1$@ is the path of the config file, %2$@ what is wrong with it, in the config check's English.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%1$@ غير قابل للاستخدام (%2$@)، لذلك تُرك كما هو ولم يُنشأ منه شيء"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ব্যবহার করা যাচ্ছে না (%2$@), তাই সেটআপ এটিকে যেমন ছিল তেমনই রেখেছে এবং এটি থেকে কিছুই তৈরি করেনি"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kann nicht verwendet werden (%2$@), daher hat die Einrichtung die Datei unverändert gelassen und nichts daraus erstellt"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "το %1$@ δεν μπορεί να χρησιμοποιηθεί (%2$@), οπότε αφέθηκε ως είχε και δεν δημιουργήθηκε τίποτα από αυτό"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ cannot be used (%2$@), so setup left it as it is and made nothing from it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ no se puede usar (%2$@), así que se dejó como estaba y no se creó nada a partir de él"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%1$@ قابل استفاده نیست (%2$@)، پس راه‌اندازی آن را همان‌طور که بود گذاشت و چیزی از آن نساخت"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ est inutilisable (%2$@) ; il a donc été laissé tel quel et rien n’en a été créé"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן להשתמש ב-%1$@ (%2$@), ולכן ההגדרה השאירה אותו כפי שהוא ולא יצרה ממנו דבר"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ का इस्तेमाल नहीं किया जा सकता (%2$@), इसलिए सेटअप ने इसे जैसा था वैसा ही छोड़ दिया और इससे कुछ नहीं बनाया"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tidak dapat digunakan (%2$@), jadi penyiapan membiarkannya apa adanya dan tidak membuat apa pun darinya"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "il file %1$@ non può essere usato (%2$@), quindi è stato lasciato com’è e non ne è stato ricavato nulla"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ は使用できない（%2$@）ため、セットアップではそのままにして、そこから何も作成しませんでした"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 파일을 사용할 수 없으므로(%2$@) 그대로 두었고 이 파일로 아무것도 만들지 않음"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ वापरता येत नाही (%2$@), म्हणून सेटअपने ती फाइल जशी होती तशीच ठेवली आणि तिच्यापासून काहीही तयार केले नाही"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tidak dapat digunakan (%2$@), jadi persediaan membiarkannya seperti asal dan tidak membuat apa-apa daripadanya"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is niet bruikbaar (%2$@), dus de installatie heeft het bestand gelaten zoals het is en er niets van gemaakt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "pliku %1$@ nie można użyć (%2$@), więc pozostawiono go bez zmian i niczego z niego nie utworzono"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "não é possível usar %1$@ (%2$@), então ele foi deixado como está e nada foi criado a partir dele"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "fișierul %1$@ nu poate fi folosit (%2$@), așa că a fost lăsat așa cum este și nu s-a creat nimic din el"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "файл %1$@ нельзя использовать (%2$@), поэтому настройка оставила его как есть и ничего из него не создала"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ஐப் பயன்படுத்த முடியாது (%2$@), எனவே அமைப்பு அதை அப்படியே விட்டுவிட்டது, அதிலிருந்து எதையும் உருவாக்கவில்லை"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ను ఉపయోగించలేము (%2$@), కాబట్టి సెటప్ దాన్ని అలాగే వదిలేసింది, దాని నుండి ఏమీ తయారు చేయలేదు"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ %1$@ ไม่ได้ (%2$@) การตั้งค่าจึงปล่อยไฟล์ไว้ตามเดิมและไม่ได้สร้างสิ่งใดจากไฟล์นั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kullanılamıyor (%2$@), bu yüzden kurulum onu olduğu gibi bıraktı ve ondan hiçbir şey oluşturmadı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "файл %1$@ не можна використати (%2$@), тому налаштування залишило його як є і нічого з нього не створило"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فائل %1$@ استعمال نہیں کی جا سکتی (%2$@)، اس لیے سیٹ اپ نے اسے ویسے ہی رہنے دیا اور اس سے کچھ نہیں بنایا"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "không thể dùng %1$@ (%2$@), nên quá trình thiết lập để nguyên tệp và không tạo gì từ tệp đó"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 无法使用（%2$@），因此设置未改动它，也没有根据它生成任何内容"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 無法使用（%2$@），因此未更動它，也沒有根據它產生任何內容"
          }
        }
      }
    },
    "setup.didNotFinish": {
      "comment": "Shown in the setup window when Install or Repair stopped without saying why.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يكتمل الإعداد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সেটআপ শেষ হয়নি।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einrichtung wurde nicht abgeschlossen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ρύθμιση δεν ολοκληρώθηκε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Setup did not finish."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuración no se completó."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "راه‌اندازی تمام نشد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuration ne s’est pas terminée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההגדרה לא הסתיימה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटअप पूरा नहीं हुआ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penyiapan tidak selesai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La configurazione non è stata completata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セットアップが完了しませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정을 완료하지 못했습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटअप पूर्ण झाला नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Persediaan tidak selesai."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De installatie is niet voltooid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfiguracja nie została ukończona."
          }
        },
        "pt-BR": {
          "stringUnit": {
