    "refusal.noRunArgs": {
      "comment": "Why an action did nothing, shown in the alert after a click in Finder (and, in English, by the command line). %@ is a terminal app. run_args is a word of the config: keep it.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليس لـ %@ قيمة run_args في ملف الإعداد، لذا لا يمكنه تشغيل أمر. أضف run_args، أو اختر وحدة طرفية أخرى لهذا الوكيل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কনফিগে %@-এর কোনো run_args নেই, তাই এটি কোনো কমান্ড শুরু করতে পারে না। run_args যোগ করুন, অথবা এই এজেন্টের জন্য অন্য একটি টার্মিনাল বেছে নিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat in der Konfiguration keine run_args und kann daher keinen Befehl starten. Füge run_args hinzu oder wähle für diesen Agenten ein anderes Terminal."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %@ δεν έχει run_args στο αρχείο ρυθμίσεων, οπότε δεν μπορεί να ξεκινήσει εντολή. Προσθέστε run_args ή επιλέξτε άλλο τερματικό για αυτόν τον πράκτορα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has no run_args in the config, so it cannot start a command. Add run_args, or choose another terminal for this agent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no tiene run_args en la configuración, así que no puede iniciar un comando. Añade run_args o elige otra terminal para este agente."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%@ در پیکربندی run_args ندارد، بنابراین نمی‌تواند دستوری را اجرا کند. run_args را اضافه کنید، یا برای این عامل ترمینال دیگری انتخاب کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’a pas de run_args dans la configuration, il ne peut donc pas lancer de commande. Ajoutez run_args ou choisissez un autre terminal pour cet agent."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ל-%@ אין run_args בקובץ התצורה, ולכן הוא לא יכול להפעיל פקודה. יש להוסיף run_args, או לבחור מסוף אחר לסוכן זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कॉन्फ़िग में %@ के लिए run_args नहीं है, इसलिए यह कमांड शुरू नहीं कर सकता। run_args जोड़ें, या इस एजेंट के लिए कोई दूसरा टर्मिनल चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tidak memiliki run_args di konfigurasi, jadi tidak dapat menjalankan perintah. Tambahkan run_args, atau pilih terminal lain untuk agen ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non ha run_args nel file di configurazione, quindi non può avviare un comando. Aggiungi run_args, oppure scegli un altro terminale per questo agente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定ファイルの%@にはrun_argsがないため、コマンドを起動できません。run_argsを追加するか、このエージェントには別のターミナルを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 파일에 %@ 앱의 run_args가 없어 명령을 시작할 수 없습니다. run_args를 추가하거나 이 에이전트에 다른 터미널을 선택하십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कॉन्फिगरेशन फाइलमध्ये %@ साठी run_args नाहीत, त्यामुळे ते कमांड सुरू करू शकत नाही. run_args जोडा, किंवा या एजंटसाठी दुसरे टर्मिनल निवडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tiada run_args dalam fail konfigurasi, jadi ia tidak dapat memulakan perintah. Tambah run_args, atau pilih terminal lain untuk ejen ini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ heeft geen run_args in het configuratiebestand, dus kan het geen commando starten. Voeg run_args toe, of kies een andere terminal voor deze agent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja %@ nie ma run_args w pliku konfiguracji, więc nie może uruchomić polecenia. Dodaj run_args albo wybierz inny terminal dla tego agenta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O %@ não tem run_args no arquivo de configuração, então não consegue iniciar um comando. Adicione run_args ou escolha outro terminal para este agente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nu are run_args în fișierul de configurare, deci nu poate porni o comandă. Adăugați run_args sau alegeți alt terminal pentru acest agent."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У приложения «%@» нет run_args в файле конфигурации, поэтому оно не может запустить команду. Добавьте run_args или выберите другой терминал для этого агента."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உள்ளமைவுக் கோப்பில் %@ க்கு run_args இல்லை, எனவே அதனால் கட்டளையைத் தொடங்க முடியாது. run_args ஐச் சேர்க்கவும், அல்லது இந்த முகவருக்கு வேறொரு டெர்மினலைத் தேர்ந்தெடுக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కాన్ఫిగరేషన్ ఫైల్‌లో %@ కు run_args లేదు, కాబట్టి అది ఆదేశాన్ని ప్రారంభించలేకపోతుంది. run_args ను జోడించండి, లేదా ఈ ఏజెంట్ కోసం మరో టెర్మినల్‌ను ఎంచుకోండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ไม่มี run_args ในไฟล์การกำหนดค่า จึงเริ่มคำสั่งไม่ได้ เพิ่ม run_args หรือเลือกเทอร์มินัลอื่นสำหรับเอเจนต์นี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapılandırmada %@ için run_args yok, bu yüzden bu terminal bir komut başlatamaz. run_args ekleyin ya da bu ajan için başka bir terminal seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Термінал %@ не має run_args у конфігурації, тому не може запустити команду. Додайте run_args або виберіть для цього агента інший термінал."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کنفیگریشن فائل میں %@ کے لیے run_args نہیں ہے، اس لیے یہ کمانڈ شروع نہیں کر سکتا۔ run_args شامل کریں، یا اس ایجنٹ کے لیے کوئی اور ٹرمینل منتخب کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ không có run_args trong tệp cấu hình nên không thể khởi chạy lệnh. Hãy thêm run_args, hoặc chọn terminal khác cho tác tử này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 在配置中没有 run_args，因此无法启动命令。请添加 run_args，或为此智能体选择其他终端。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 在設定檔中沒有 run_args，因此無法啟動指令。請加入 run_args，或為此代理程式選擇其他終端機。"
          }
        }
      }
    },
    "refusal.noTarget": {
      "comment": "Why an action did nothing, shown in the alert after a click in Finder (and, in English, by the command line).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد مجلد أو تحديد لتنفيذ الإجراء عليه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কাজ করার মতো কোনো ফোল্ডার বা নির্বাচন নেই।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt keinen Ordner und keine Auswahl, auf die sich die Aktion anwenden lässt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχει φάκελος ή επιλογή στην οποία να εφαρμοστεί η ενέργεια."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no folder or selection to act on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ninguna carpeta ni selección sobre la que actuar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هیچ پوشه یا انتخابی برای انجام کار وجود ندارد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n’y a aucun dossier ni aucune sélection sur lesquels agir."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין תיקיה או בחירה שאפשר להפעיל עליהן את הפעולה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "काम करने के लिए कोई फ़ोल्डर या चयन नहीं है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada folder atau pilihan untuk ditindaklanjuti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c’è nessuna cartella o selezione su cui agire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "操作の対象となるフォルダや選択項目がありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업할 폴더나 선택 항목이 없습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कृती करण्यासाठी कोणताही फोल्डर किंवा निवड नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada folder atau item terpilih untuk diproses."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is geen map of selectie om iets mee te doen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma folderu ani zaznaczenia, na którym można wykonać czynność."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há pasta nem seleção para executar a ação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu există niciun dosar sau nicio selecție asupra căreia să se acționeze."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет папки или выбранных объектов, с которыми можно выполнить действие."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "செயல்பட கோப்புறையோ தேர்வோ எதுவும் இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చర్య తీసుకోవడానికి ఫోల్డర్ గానీ ఎంపిక గానీ లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีโฟลเดอร์หรือรายการที่เลือกให้ดำเนินการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üzerinde işlem yapılacak bir klasör veya seçim yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає папки чи вибраних елементів, з якими можна виконати дію."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کارروائی کے لیے کوئی فولڈر یا انتخاب موجود نہیں ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có thư mục hay mục được chọn nào để thực hiện tác vụ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可操作的文件夹或所选项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有可操作的檔案夾或所選項目。"
          }
        }
      }
    },
