    "doctor.extension.disabled": {
      "comment": "Detail line of a check in the setup window's Details list; it follows the check's title, so it is a fragment with no final period. The Finder extension is known to macOS but switched off.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مسجَّل، لكنه معطَّل"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নিবন্ধিত, কিন্তু বন্ধ আছে"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "registriert, aber ausgeschaltet"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
