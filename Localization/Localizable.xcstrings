    "app.configNone": {
      "comment": "Said on the Config page on a Mac that has no config file yet.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد ملف إعداد بعد. أعِدّ Right Here أولًا في صفحة «نظرة عامة»، فالإعداد هو الذي ينشئه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনো কোনো কনফিগারেশন ফাইল নেই। প্রথমে “সারসংক্ষেপ” পৃষ্ঠায় Right Here সেটআপ করুন; সেটিই এটি তৈরি করে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt noch keine Konfigurationsdatei. Richte Right Here zuerst auf der Seite „Übersicht“ ein; dabei wird sie erstellt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχει ακόμα αρχείο ρυθμίσεων. Ρυθμίστε πρώτα το Right Here από τη σελίδα «Επισκόπηση», και έτσι θα δημιουργηθεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no config file yet. Set Right Here up on the Overview page first; that makes it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay ningún archivo de configuración. Configura primero Right Here en la página Resumen; así se creará."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنوز فایل پیکربندی وجود ندارد. ابتدا Right Here را در صفحهٔ «نمای کلی» راه‌اندازی کنید؛ این کار آن را می‌سازد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n’y a pas encore de fichier de configuration. Configurez d’abord Right Here dans la page Vue d’ensemble ; cela le crée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדיין אין קובץ תצורה. יש להגדיר תחילה את Right Here בעמוד ״סקירה כללית״; ההגדרה תיצור אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई कॉन्फ़िगरेशन फ़ाइल नहीं है। पहले ओवरव्यू पेज पर Right Here सेट अप करें; इससे वह बन जाएगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada file konfigurasi. Siapkan Right Here di halaman Ringkasan terlebih dahulu; langkah itu akan membuatnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c’è ancora alcun file di configurazione. Per crearlo, configura prima Right Here nella pagina Panoramica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定ファイルはまだありません。先に「概要」ページで Right Here をセットアップすると、設定ファイルが作られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 설정 파일이 없습니다. 먼저 개요 페이지에서 Right Here를 설정하십시오. 그러면 설정 파일이 만들어집니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अजून कॉन्फिगरेशन फाइल नाही. आधी “आढावा” पृष्ठावर Right Here सेटअप करा; त्यामुळे ती तयार होईल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada fail konfigurasi. Sediakan Right Here pada halaman Gambaran Keseluruhan dahulu; itu akan mencipta fail tersebut."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is nog geen configuratiebestand. Stel Right Here eerst in op de pagina Overzicht; dan wordt het bestand aangemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma jeszcze pliku konfiguracji. Najpierw skonfiguruj Right Here na stronie Przegląd; wtedy plik zostanie utworzony."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há arquivo de configuração. Configure primeiro o Right Here na página Visão geral; isso cria o arquivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu există încă un fișier de configurare. Configurați mai întâi Right Here pe pagina Privire de ansamblu; astfel se creează fișierul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл конфигурации еще не создан. Сначала настройте Right Here на странице «Обзор» — тогда он появится."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இன்னும் உள்ளமைவுக் கோப்பு இல்லை. முதலில் மேலோட்டம் பக்கத்தில் Right Here-ஐ அமைக்கவும்; அதுவே அந்தக் கோப்பை உருவாக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇంకా కాన్ఫిగరేషన్ ఫైల్ లేదు. ముందుగా అవలోకనం పేజీలో Right Here సెటప్ చేయండి; అదే ఆ ఫైల్‌ను సృష్టిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีไฟล์การกำหนดค่า โปรดตั้งค่า Right Here ในหน้าภาพรวมก่อน ขั้นตอนนั้นจะสร้างไฟล์ให้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz yapılandırma dosyası yok. Önce Genel Bakış sayfasında Right Here kurulumunu yapın; dosyayı bu oluşturur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлу конфігурації ще немає. Спершу налаштуйте Right Here на сторінці «Огляд»: тоді він і зʼявиться."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھی کوئی کنفیگریشن فائل نہیں ہے۔ پہلے جائزہ صفحے پر Right Here کا سیٹ اپ کریں، وہی اسے بنائے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có tệp cấu hình nào. Hãy thiết lập Right Here ở trang Tổng quan trước; việc thiết lập đó sẽ tạo ra tệp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前还没有配置文件。请先在“概览”页面设置 Right Here，设置过程会创建它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前還沒有設定檔。請先在「概覽」頁面設定 Right Here，設定時就會建立它。"
          }
        }
      }
    },
