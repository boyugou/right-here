          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ zonder te vragen starten?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uruchamiać %@ bez pytania?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar %@ sem perguntar?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Porniți %@ fără întrebări?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускать агента %@ без вопросов?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ கேட்காமல் தொடங்கவா?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ అడగకుండా ప్రారంభించాలా?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่ม %@ โดยไม่ต้องถามหรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sormadan başlatılsın mı?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускати %@ без запитань?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%@ بغیر پوچھے شروع کریں؟"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khởi chạy %@ mà không hỏi?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需询问即可启动 %@？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無需詢問即可啟動 %@？"
          }
        }
      }
