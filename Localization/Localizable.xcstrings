          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενεργοποιήστε το Right Here στις Ρυθμίσεις συστήματος › Γενικά › Στοιχεία εισόδου και επεκτάσεις › Finder."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch on Right Here in System Settings › General › Login Items & Extensions › Finder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Right Here en Ajustes del Sistema › General › Ítems de inicio y extensiones › Finder."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "‏Right Here را در System Settings › General › Login Items & Extensions › Finder روشن کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Right Here dans Réglages Système › Général › Ouverture et extensions › Finder."
