          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定ファイル %1$@ は使用できません：%2$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 설정 파일을 사용할 수 없습니다: %2$@"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कॉन्फिगरेशन फाइल %1$@ वापरता येत नाही: %2$@"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fail konfigurasi %1$@ tidak dapat digunakan: %2$@"
          }
