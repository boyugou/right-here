    "doctor.fix.appCopies": {
      "comment": "What to do about several installed copies of the app. %1$@ is the path of the newest copy, such as /Applications/Right Here.app. 'Trash' is the macOS Trash: use the system's name for it in each language. Launchpad and Spotlight are product names.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "احتفظ بـ %1$@ وانقل النسخ الأخرى إلى سلة المهملات. قد يفتح Spotlight وLaunchpad أيًّا منها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ রাখুন এবং অন্য কপিগুলো Trash-এ সরান। Spotlight ও Launchpad এগুলোর যেকোনোটি খুলতে পারে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Behalte %1$@ und lege die anderen Kopien in den Papierkorb. Spotlight und Launchpad können jede davon öffnen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Κρατήστε το %1$@ και μετακινήστε τα άλλα αντίγραφα στον Κάδο. Το Spotlight και το Launchpad μπορεί να ανοίξουν οποιοδήποτε από αυτά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep %1$@ and move the other copies to the Trash. Spotlight and Launchpad can open any of them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Conserva %1$@ y mueve las demás copias a la Papelera. Spotlight y Launchpad pueden abrir cualquiera de ellas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "‏%1$@ را نگه دارید و نسخه‌های دیگر را به Trash ببرید. Spotlight و Launchpad ممکن است هر کدام از آن‌ها را باز کنند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Conservez %1$@ et placez les autres copies dans la Corbeille. Spotlight et Launchpad peuvent ouvrir n’importe laquelle d’entre elles."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "יש להשאיר את %1$@ ולהעביר את שאר העותקים לפח. Spotlight ו-Launchpad עלולים לפתוח כל אחד מהם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ रखें और बाकी प्रतियों को रद्दी में मूव करें। Spotlight और Launchpad इनमें से कोई भी खोल सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Simpan %1$@ dan pindahkan salinan lainnya ke Tong Sampah. Spotlight dan Launchpad dapat membuka salah satu dari salinan tersebut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tieni %1$@ e sposta le altre copie nel Cestino. Spotlight e Launchpad possono aprirne una qualsiasi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ を残し、ほかのコピーをゴミ箱に入れてください。Spotlight と Launchpad は、そのどれを開くこともあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@은(는) 그대로 두고 다른 복사본은 휴지통으로 옮기십시오. Spotlight와 Launchpad는 이 중 어느 것이든 열 수 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ ठेवा आणि इतर प्रती Trash मध्ये हलवा. Spotlight आणि Launchpad या प्रतींपैकी कोणतीही प्रत उघडू शकतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Simpan %1$@ dan pindahkan salinan lain ke Sampah. Spotlight dan Launchpad boleh membuka mana-mana salinan itu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bewaar %1$@ en verplaats de andere kopieën naar de prullenmand. Spotlight en Launchpad kunnen elke kopie openen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zachowaj %1$@, a pozostałe kopie przenieś do Kosza. Spotlight i Launchpad mogą otworzyć dowolną z nich."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mantenha %1$@ e mova as outras cópias para o Lixo. O Spotlight e o Launchpad podem abrir qualquer uma delas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Păstrați %1$@ și mutați celelalte copii în Coș. Spotlight și Launchpad pot deschide oricare dintre ele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Оставьте %1$@, а остальные копии переместите в Корзину. Spotlight и Launchpad могут открыть любую из них."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ ஐ வைத்துக்கொண்டு, மற்ற நகல்களை Trash-க்கு நகர்த்தவும். Spotlight-உம் Launchpad-உம் இவற்றில் எதையும் திறக்கக்கூடும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ ను ఉంచి, మిగతా కాపీలను Trash కు తరలించండి. Spotlight మరియు Launchpad వీటిలో దేనినైనా తెరవవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เก็บ %1$@ ไว้ แล้วย้ายสำเนาอื่นไปยังถังขยะ Spotlight และ Launchpad อาจเปิดสำเนาใดก็ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ kopyasını tutun ve diğer kopyaları Çöp Sepeti’ne taşıyın. Spotlight ve Launchpad bunlardan herhangi birini açabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Залиште %1$@, а інші копії перемістіть у Смітник. Spotlight і Launchpad можуть відкрити будь-яку з них."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "‏%1$@ رکھیں اور باقی کاپیاں Trash میں منتقل کریں۔ Spotlight اور Launchpad ان میں سے کوئی بھی کھول سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Giữ lại %1$@ và chuyển các bản sao khác vào Thùng rác. Spotlight và Launchpad có thể mở bất kỳ bản sao nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "保留 %1$@，并将其他副本移到废纸篓。聚焦 和 启动台 可能会打开其中任何一个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "保留 %1$@，並將其他副本移到垃圾桶。Spotlight 和「啟動台」可能會打開其中任何一個。"
          }
        }
      }
    },
    "doctor.fix.claudeLink": {
      "comment": "Fix line under a check in the setup window's Details list: what the person should do. A sentence.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "شغّل `claude` مرة واحدة وأرسل موجّهًا؛ يسجّل Claude Code المعالِج."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "`claude` একবার চালু করুন এবং একটি প্রম্পট পাঠান; Claude Code হ্যান্ডলারটি নিবন্ধন করে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Starte `claude` einmal und sende einen Prompt; Claude Code registriert den Handler."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ξεκινήστε το `claude` μία φορά και στείλτε μια προτροπή· το Claude Code καταχωρίζει τον χειριστή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start `claude` once and send a prompt; Claude Code registers the handler."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inicia `claude` una vez y envía un prompt; Claude Code registra el manejador."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "‏`claude` را یک بار اجرا کنید و یک پرامپت ارسال کنید؛ Claude Code کنترل‌کننده را ثبت می‌کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lancez `claude` une fois et envoyez un prompt ; Claude Code enregistre alors le gestionnaire."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "יש להפעיל את `claude` פעם אחת ולשלוח הנחיה; Claude Code ירשום את המטפל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "`claude` एक बार चलाएँ और कोई प्रॉम्प्ट भेजें; Claude Code हैंडलर पंजीकृत करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jalankan `claude` sekali dan kirim prompt; Claude Code mendaftarkan handler."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Avvia `claude` una volta e invia un prompt; Claude Code registra il gestore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "`claude` を一度起動してプロンプトを送信してください。Claude Code がハンドラを登録します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "`claude` 명령을 한 번 실행하고 프롬프트를 보내십시오. 그러면 Claude Code가 핸들러를 등록합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "`claude` एकदा सुरू करा आणि एक प्रॉम्प्ट पाठवा; Claude Code हँडलर नोंदवते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mulakan `claude` sekali dan hantar satu gesaan; Claude Code mendaftarkan pengendali."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Start `claude` eenmaal en stuur een prompt; Claude Code registreert de handler."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uruchom `claude` raz i wyślij prompt; Claude Code zarejestruje program obsługi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inicie `claude` uma vez e envie um prompt; o Claude Code registra o manipulador."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Porniți `claude` o dată și trimiteți un prompt; Claude Code înregistrează handlerul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Один раз запустите `claude` и отправьте промпт; Claude Code зарегистрирует обработчик."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "`claude` ஐ ஒருமுறை தொடங்கி ஒரு ப்ராம்ப்ட்டை அனுப்பவும்; Claude Code handler ஐப் பதிவு செய்யும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "needs_review",
            "value": "`claude` ను ఒకసారి ప్రారంభించి ఒక ప్రాంప్ట్ పంపండి; Claude Code handler ను రిజిస్టర్ చేస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เริ่ม `claude` หนึ่งครั้งและส่งพรอมต์ จากนั้น Claude Code จะลงทะเบียน handler ให้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "`claude` komutunu bir kez başlatın ve bir istem gönderin; Claude Code handler’ı kaydeder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Запустіть `claude` один раз і надішліть промпт; Claude Code зареєструє обробник."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "‏`claude` ایک بار شروع کریں اور کوئی پرامپٹ بھیجیں؛ Claude Code ہینڈلر رجسٹر کر دے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Khởi chạy `claude` một lần và gửi một lời nhắc; Claude Code sẽ đăng ký trình xử lý."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "启动一次 `claude` 并发送一条提示词；Claude Code 会注册处理程序。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "啟動一次 `claude` 並傳送一則提示詞；Claude Code 會註冊處理程式。"
          }
        }
      }
    },
