          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "`%@`: 로그인 셸에서 찾을 수 없음"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "`%@` तुमच्या लॉगिन शेलमध्ये सापडत नाही"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "`%@` tidak ditemui dalam cangkerang log masuk anda"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "`%@` is niet gevonden in je inlogshell"
          }
        },
        "pl": {
