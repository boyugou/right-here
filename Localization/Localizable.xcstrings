    "app.appAlreadyAvailable": {
      "comment": "Message in the setup window after the person chose an application that Right Here already offers (it is built in or already in the config). %1$@ is the name of the app. Keep the quotation marks of the language around it.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏التطبيق «%1$@» متوفر بالفعل، فلا يوجد ما يُضاف."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” আগে থেকেই পাওয়া যায়, তাই যোগ করার কিছু নেই।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ ist schon verfügbar, es gibt also nichts hinzuzufügen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «%1$@» είναι ήδη διαθέσιμο, οπότε δεν υπάρχει τίποτα να προστεθεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” is already available, so there is nothing to add."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» ya está disponible, así que no hay nada que añadir."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "‏«%1$@» از قبل موجود است، بنابراین چیزی برای افزودن وجود ندارد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » est déjà disponible, il n’y a donc rien à ajouter."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היישום ״%1$@״ כבר זמין, ולכן אין מה להוסיף."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” पहले से उपलब्ध है, इसलिए जोड़ने के लिए कुछ नहीं है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” sudah tersedia, jadi tidak ada yang perlu ditambahkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” è già disponibile, quindi non c’è nulla da aggiungere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」は既に利用可能なので、追加するものはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” 앱은 이미 사용할 수 있으므로 추가할 것이 없습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” आधीच उपलब्ध आहे, त्यामुळे जोडण्यासारखे काही नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” sudah tersedia, jadi tiada apa yang perlu ditambah."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@” is al beschikbaar, dus er is niets toe te voegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja „%1$@” jest już dostępna, więc nie ma nic do dodania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” já está disponível, então não há nada para adicionar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicația „%1$@” este deja disponibilă, deci nu există nimic de adăugat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение «%1$@» уже доступно, поэтому добавлять нечего."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” ஏற்கெனவே கிடைக்கிறது, எனவே சேர்க்க எதுவும் இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” ఇప్పటికే అందుబాటులో ఉంది, కాబట్టి జోడించడానికి ఏమీ లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” มีอยู่แล้ว จึงไม่มีอะไรให้เพิ่ม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” zaten kullanılabilir, bu yüzden eklenecek bir şey yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Програма «%1$@» уже доступна, тож нічого додавати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "‏“%1$@” پہلے ہی دستیاب ہے، اس لیے شامل کرنے کے لیے کچھ نہیں ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” đã có sẵn, nên không có gì để thêm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”已可用，因此无需添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」已經可用，因此無需加入。"
          }
        }
      }
    },
    "app.appBundleID": {
      "comment": "Label of the line, on the page of an app, that shows the bundle identifier (such as com.panic.Nova) by which macOS and Right Here find the app. 'Bundle identifier' is the term macOS developers use; translate it as an Apple does in the language, or keep the English term where Apple does.",
