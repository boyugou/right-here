    "app.presetAgent": {
      "comment": "Label of the menu that chooses the AI coding agent that runs a prompt preset. One word, as the label of a row of settings.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الوكيل"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এজেন্ট"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Agent"
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Πράκτορας"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent"
          }
        },
        "es": {
          "stringUnit": {
