    "app.templateFileHelp": {
      "comment": "Caption under the fields for the file name and the extension of a new-file template.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسم الملف الجديد قبل ملحقه. يُضاف رقم إذا كان ملف بهذا الاسم موجودًا في المجلد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এক্সটেনশনের আগে নতুন ফাইলের নাম। ওই নামের ফাইল ফোল্ডারে আগে থেকে থাকলে একটি সংখ্যা যোগ করা হয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Name einer neuen Datei vor ihrer Endung. Liegt im Ordner schon eine Datei mit diesem Namen, wird eine Zahl angehängt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το όνομα ενός νέου αρχείου πριν από την επέκτασή του. Προστίθεται αριθμός όταν υπάρχει ήδη αρχείο με αυτό το όνομα στον φάκελο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The name of a new file before its extension. A number is added when a file of that name is already in the folder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre de un archivo nuevo antes de su extensión. Si ya hay un archivo con ese nombre en la carpeta, se añade un número."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نام فایل جدید پیش از پسوندش. اگر از قبل فایلی با این نام در پوشه باشد، عددی به آن افزوده می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom d’un nouveau fichier, avant son extension. Un numéro est ajouté lorsqu’un fichier de ce nom existe déjà dans le dossier."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שם הקובץ החדש לפני הסיומת שלו. כשכבר יש בתיקיה קובץ בשם זה, מתווסף מספר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नई फ़ाइल का नाम, उसके एक्सटेंशन से पहले। फ़ोल्डर में उस नाम की फ़ाइल पहले से हो, तो एक संख्या जोड़ दी जाती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama file baru sebelum ekstensinya. Angka ditambahkan jika file dengan nama itu sudah ada di folder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nome di un nuovo file prima della sua estensione. Se nella cartella esiste già un file con quel nome, viene aggiunto un numero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拡張子の前にある、新しいファイルの名前です。同じ名前のファイルがフォルダにすでにある場合は、番号が追加されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확장자 앞에 붙는 새 파일의 이름입니다. 폴더에 같은 이름의 파일이 이미 있으면 숫자가 덧붙습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "नवीन फाइलचे नाव तिच्या एक्सटेंशनपूर्वी. त्या नावाची फाइल फोल्डरमध्ये आधीपासून असल्यास एक क्रमांक जोडला जातो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama fail baharu sebelum sambungannya. Nombor ditambah apabila fail dengan nama itu sudah wujud dalam folder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De naam van een nieuw bestand, vóór de extensie. Er wordt een nummer toegevoegd als er al een bestand met die naam in de map staat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazwa nowego pliku przed rozszerzeniem. Jeśli w folderze jest już plik o tej nazwie, dodawany jest numer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome de um arquivo novo antes da extensão. Um número é acrescentado quando já existe um arquivo com esse nome na pasta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Numele unui fișier nou, înainte de extensie. Dacă în dosar există deja un fișier cu acest nume, se adaugă un număr."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя нового файла до расширения. Если в папке уже есть файл с таким именем, добавляется номер."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புதிய கோப்பின் பெயர், அதன் நீட்டிப்புக்கு முன். அந்தப் பெயருடைய கோப்பு ஏற்கனவே கோப்புறையில் இருந்தால் ஓர் எண் சேர்க்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కొత్త ఫైల్ పేరు, దాని పొడిగింపుకు ముందు. ఆ పేరుతో ఫైల్ ఇప్పటికే ఫోల్డర్‌లో ఉంటే ఒక సంఖ్య జోడించబడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อของไฟล์ใหม่ก่อนนามสกุล เมื่อมีไฟล์ที่ชื่อเดียวกันอยู่ในโฟลเดอร์แล้ว จะมีการเพิ่มตัวเลขต่อท้าย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni bir dosyanın uzantısı öncesindeki adı. Klasörde bu adda bir dosya zaten varsa bir numara eklenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Назва нового файлу до розширення. Якщо в папці вже є файл із такою назвою, додається число."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نئی فائل کا نام، اس کی توسیع سے پہلے۔ اگر فولڈر میں اس نام کی فائل پہلے ہی موجود ہو تو ایک نمبر شامل کر دیا جاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên của tệp mới trước phần mở rộng. Nếu thư mục đã có tệp cùng tên, một số sẽ được thêm vào tên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新文件在扩展名之前的名称。如果文件夹中已有同名文件，将自动添加一个数字。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新檔案在副檔名之前的名稱。如果檔案夾中已有同名的檔案，會自動加上一個數字。"
          }
        }
      }
    },
    "app.templateName": {
      "comment": "Label of the field for the name that a new file gets, without its extension (for example 'untitled'). Short, as the label of a row of settings.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسم الملف"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফাইলের নাম"
          }
        },
        "de": {
