    "app.worktreeNotRemovable": {
      "comment": "Shown when the window is asked to remove a git worktree that Right Here did not make: it does not remove it, and says so. A sentence with a final period.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لم تُزِل Right Here شجرة العمل هذه، لأنها ليست من إنشاء Right Here، فتُركت كما هي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here এই ওয়ার্কট্রি সরায়নি: এটি Right Here-এর তৈরি নয়, তাই এটি অক্ষত রাখা হয়েছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here hat diesen Worktree nicht entfernt: Er wurde nicht von Right Here angelegt und bleibt deshalb unverändert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Το Right Here δεν αφαίρεσε αυτό το worktree: δεν το δημιούργησε το Right Here, γι’ αυτό μένει ως έχει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Right Here did not remove this worktree: it is not one Right Here made, so it is left alone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here no eliminó este worktree: no lo creó Right Here, así que se deja tal cual."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "‏Right Here این درخت کاری را حذف نکرد: آن را Right Here نساخته است، پس دست نمی‌خورد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here n’a pas supprimé ce worktree : il n’a pas été créé par Right Here, il est donc laissé tel quel."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "‏Right Here לא הסיר את עץ העבודה הזה: הוא לא נוצר על ידי Right Here, ולכן הוא נשאר כמות שהוא."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here ने यह वर्कट्री नहीं हटाया: यह Right Here द्वारा बनाई गई नहीं है, इसलिए इसे छोड़ दिया गया है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here tidak menghapus worktree ini: worktree itu tidak dibuat oleh Right Here, jadi dibiarkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here non ha rimosso questo worktree: non è stato creato da Right Here, quindi è stato lasciato com’è."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here はこのワークツリーを削除しませんでした。Right Here が作成したものではないため、そのままにしています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here는 이 워크트리를 제거하지 않았습니다. Right Here가 만든 것이 아니므로 그대로 두었습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here ने हा वर्कट्री काढला नाही: तो Right Here ने तयार केलेला नाही, म्हणून तो तसाच ठेवला आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here tidak mengeluarkan worktree ini: ia bukan dicipta oleh Right Here, jadi ia dibiarkan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here heeft deze worktree niet verwijderd: hij is niet door Right Here gemaakt en blijft dus staan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here nie usunęło tego worktree: nie został utworzony przez Right Here, więc pozostaje bez zmian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Right Here não removeu este worktree: ele não foi criado pelo Right Here, então foi deixado como está."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here nu a șters acest worktree: nu a fost creat de Right Here, așa că a fost lăsat neatins."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here не удалил это рабочее дерево: оно создано не Right Here, поэтому оно оставлено как есть."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here இந்த வொர்க்ட்ரீயை நீக்கவில்லை: இது Right Here உருவாக்கியது அல்ல, அதனால் அது அப்படியே விடப்பட்டது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here ఈ వర్క్‌ట్రీని తీసివేయలేదు: ఇది Right Here సృష్టించినది కాదు, కాబట్టి అది అలాగే ఉంచబడింది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here ไม่ได้ลบ worktree นี้: worktree นี้ไม่ได้ถูกสร้างโดย Right Here จึงปล่อยไว้ตามเดิม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here bu worktree’yi kaldırmadı: Right Here tarafından oluşturulmadığı için olduğu gibi bırakıldı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here не видалив це робоче дерево: воно створене не Right Here, тож залишено без змін."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "‏Right Here نے یہ ورک ٹری نہیں ہٹایا: یہ Right Here کا بنایا ہوا نہیں ہے، اس لیے اسے چھوڑ دیا گیا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here không xóa worktree này: nó không do Right Here tạo ra nên được giữ nguyên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here 没有删除这个工作树：它不是 Right Here 创建的，因此保持原样。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here 沒有刪除這個工作樹：它不是 Right Here 建立的，因此保持原樣。"
          }
        }
      }
