    "doctor.sync.remoteEvicted": {
      "comment": "Detail line of a check in the setup window's Details list; it follows the check's title, so it is a fragment with no final period. About the config sync feature: the synced copy of the config file lives in a cloud folder and has not been downloaded.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُنزَّل config.toml في المجلد بعد (أو تعذّرت قراءته)"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফোল্ডারের config.toml এখনো ডাউনলোড হয়নি (বা পড়া যাচ্ছে না)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "config.toml im Ordner ist noch nicht heruntergeladen (oder nicht lesbar)"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "το config.toml στον φάκελο δεν έχει ληφθεί ακόμη (ή δεν μπορεί να διαβαστεί)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
