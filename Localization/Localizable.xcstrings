          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Perintah plugin disalin. Tempelkan ke Claude Code."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Comandi del plugin copiati. Incollali in Claude Code."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "プラグインのコマンドをコピーしました。Claude Code にペーストしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "플러그인 명령을 복사했습니다. Claude Code에 붙여넣으십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "प्लगइन कमांड्स कॉपी झाल्या. त्या Claude Code मध्ये पेस्ट करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Perintah pemalam disalin. Tampalkannya dalam Claude Code."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plug-incommando’s gekopieerd. Plak ze in Claude Code."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skopiowano polecenia wtyczki. Wklej je w Claude Code."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Comandos do plug-in copiados. Cole-os no Claude Code."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Comenzile pluginului au fost copiate. Lipiți-le în Claude Code."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Команды плагина скопированы. Вставьте их в Claude Code."
