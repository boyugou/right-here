    "app.aiPluginBody": {
      "comment": "Text under the heading app.aiPluginTitle, above two commands. 'Claude Code' and 'Right Here' stay as they are.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "شغّل هذين الأمرين في Claude Code لإضافة مهارات Right Here وأدواته."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here-এর স্কিল ও টুল যোগ করতে Claude Code-এ এই দুটি কমান্ড চালান।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Führe diese zwei Befehle in Claude Code aus, um die Skills und Werkzeuge von Right Here hinzuzufügen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Εκτελέστε αυτές τις δύο εντολές στο Claude Code για να προσθέσετε τις δεξιότητες και τα εργαλεία του Right Here."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run these two commands in Claude Code to add Right Here's skills and tools."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ejecuta estos dos comandos en Claude Code para añadir las habilidades y herramientas de Right Here."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "برای افزودن مهارت‌ها و ابزارهای Right Here، این دو دستور را در Claude Code اجرا کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Exécutez ces deux commandes dans Claude Code pour ajouter les compétences et les outils de Right Here."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "יש להריץ את שתי הפקודות האלה ב-Claude Code כדי להוסיף את המיומנויות והכלים של Right Here."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here के स्किल्स और टूल्स जोड़ने के लिए Claude Code में ये दो कमांड चलाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jalankan dua perintah ini di Claude Code untuk menambahkan skill dan alat dari Right Here."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esegui questi due comandi in Claude Code per aggiungere le skill e gli strumenti di Right Here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Claude Code で次の 2 つのコマンドを実行すると、Right Here のスキルとツールを追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Claude Code에서 다음 두 명령을 실행하여 Right Here의 스킬과 도구를 추가하십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here ची स्किल्स आणि टूल्स जोडण्यासाठी Claude Code मध्ये खालील दोन कमांड चालवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jalankan dua perintah ini dalam Claude Code untuk menambah kemahiran dan alatan Right Here."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Voer deze twee commando’s uit in Claude Code om de vaardigheden en hulpmiddelen van Right Here toe te voegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uruchom te dwa polecenia w Claude Code, aby dodać umiejętności i narzędzia Right Here."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Execute estes dois comandos no Claude Code para adicionar as habilidades e ferramentas do Right Here."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rulați aceste două comenzi în Claude Code pentru a adăuga abilitățile și instrumentele Right Here."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Выполните в Claude Code эти две команды, чтобы добавить навыки и инструменты Right Here."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Claude Code-இல் இந்த இரண்டு கட்டளைகளை இயக்கி, Right Here-இன் திறன்களையும் கருவிகளையும் சேர்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Claude Code లో ఈ రెండు ఆదేశాలను రన్ చేయండి; అవి Right Here నైపుణ్యాలను, సాధనాలను జోడిస్తాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เรียกใช้คำสั่งทั้งสองนี้ใน Claude Code เพื่อเพิ่มทักษะและเครื่องมือของ Right Here"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Right Here’in becerilerini ve araçlarını eklemek için Claude Code’da şu iki komutu çalıştırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Виконайте ці дві команди у Claude Code, щоб додати навички та інструменти від Right Here."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "یہ دو کمانڈز Claude Code میں چلائیں تاکہ Right Here کی سکلز اور ٹولز شامل ہو جائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chạy hai lệnh sau trong Claude Code để thêm kỹ năng và công cụ của Right Here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在 Claude Code 中运行以下两条命令，以添加 Right Here 的技能和工具。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在 Claude Code 中執行以下兩個指令，以加入 Right Here 的技能與工具。"
          }
        }
      }
    },
