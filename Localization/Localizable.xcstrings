        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या मशीनचा कॉन्फिग फोल्डरपेक्षा नवीन आहे"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "konfigurasi mesin ini lebih baharu daripada folder"
          }
        },
