    "app.tabChecks": {
      "comment": "Name of the section in the sidebar of the setup window that lists every check (is the Finder extension on, is a terminal installed, and so on) with its result. A plural noun: 'the checks'.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الفحوصات"
          }
        },
        "bn": {
