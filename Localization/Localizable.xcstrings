    "doctor.fix.syncCommands": {
      "comment": "Fix line under a check in the setup window's Details list: what the person should do. Sentences. About the config sync feature: \"them\" are the launch settings listed above; the folder's copy is the config in the sync folder. Keep the commands in backticks exactly.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راجعها بالأمر `rh config sync status`. إذا كانت لك، فشغّل `rh config sync pull --allow-commands` لاعتماد نسخة المجلد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "`rh config sync status` দিয়ে এগুলো দেখুন। এগুলো আপনারই হলে ফোল্ডারের কপিটি নিতে `rh config sync pull --allow-commands` চালান।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe sie mit `rh config sync status`. Wenn sie von dir stammen, führe `rh config sync pull --allow-commands` aus, um die Kopie aus dem Ordner zu übernehmen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ελέγξτε τις ρυθμίσεις με το `rh config sync status`. Αν είναι δικές σας, το `rh config sync pull --allow-commands` παίρνει το αντίγραφο από τον φάκελο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read them with `rh config sync status`. If they are yours, `rh config sync pull --allow-commands` takes the copy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revísalos con `rh config sync status`. Si son tuyos, ejecuta `rh config sync pull --allow-commands` para quedarte con la copia de la carpeta."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آن‌ها را با `rh config sync status` بررسی کنید. اگر متعلق به شما هستند، برای گرفتن نسخهٔ پوشه `rh config sync pull --allow-commands` را اجرا کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultez-les avec `rh config sync status`. Si ce sont les vôtres, exécutez `rh config sync pull --allow-commands` pour prendre la copie du dossier."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לבדוק אותן באמצעות `rh config sync status`. אם הן שלך, יש להריץ את `rh config sync pull --allow-commands` כדי לקחת את העותק שבתיקיה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इन्हें `rh config sync status` से जाँचें। अगर ये आपकी हैं, तो फ़ोल्डर वाली कॉन्फ़िग लेने के लिए `rh config sync pull --allow-commands` चलाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Periksa pengaturan tersebut dengan `rh config sync status`. Jika memang milik Anda, `rh config sync pull --allow-commands` mengambil salinan dari folder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controllale con `rh config sync status`. Se sono tue, esegui `rh config sync pull --allow-commands` per usare la copia della cartella."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの起動設定を `rh config sync status` で確認してください。自分で設定したものであれば、`rh config sync pull --allow-commands` を実行してフォルダ内のコピーを採用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위의 실행 설정을 `rh config sync status` 명령으로 확인하십시오. 직접 설정한 것이라면 `rh config sync pull --allow-commands` 명령으로 폴더의 사본을 가져오십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "`rh config sync status` वापरून त्या तपासा. त्या तुमच्याच असतील तर फोल्डरमधील प्रत घेण्यासाठी `rh config sync pull --allow-commands` चालवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semak seting tersebut dengan `rh config sync status`. Jika itu milik anda, `rh config sync pull --allow-commands` mengambil salinan daripada folder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk ze met `rh config sync status`. Als ze van jou zijn, voer `rh config sync pull --allow-commands` uit om de kopie uit de map te nemen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź je poleceniem `rh config sync status`. Jeśli pochodzą od Ciebie, polecenie `rh config sync pull --allow-commands` pobierze kopię z folderu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja-os com `rh config sync status`. Se forem seus, `rh config sync pull --allow-commands` usa a configuração da pasta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificați-le cu `rh config sync status`. Dacă sunt ale dvs., `rh config sync pull --allow-commands` ia configurația din dosar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Посмотрите их с помощью `rh config sync status`. Если это Ваши настройки, `rh config sync pull --allow-commands` возьмет конфигурацию из папки."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "`rh config sync status` மூலம் அவற்றைப் பார்க்கவும். அவை உங்களுடையவையாக இருந்தால், கோப்புறையிலுள்ள நகலை எடுக்க `rh config sync pull --allow-commands` ஐ இயக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "`rh config sync status` ద్వారా వాటిని చూడండి. అవి మీవే అయితే, ఫోల్డర్‌లో ఉన్న కాపీని తీసుకోవడానికి `rh config sync pull --allow-commands` రన్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูการตั้งค่าเหล่านี้ด้วย `rh config sync status` หากเป็นของคุณ ให้เรียกใช้ `rh config sync pull --allow-commands` เพื่อใช้สำเนาในโฟลเดอร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ayarları `rh config sync status` ile inceleyin. Bunlar sizinse `rh config sync pull --allow-commands` klasördeki kopyayı alır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перегляньте їх за допомогою `rh config sync status`. Якщо вони ваші, `rh config sync pull --allow-commands` візьме конфігурацію з папки."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "انہیں `rh config sync status` سے دیکھیں۔ اگر یہ آپ کی طرف سے ہیں تو فولڈر کی کنفیگ لینے کے لیے `rh config sync pull --allow-commands` چلائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra các cài đặt đó bằng `rh config sync status`. Nếu chúng là của bạn, `rh config sync pull --allow-commands` sẽ lấy bản sao từ thư mục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 `rh config sync status` 查看这些启动设置。如果这些是自己设置的，运行 `rh config sync pull --allow-commands` 即可采用文件夹中的副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用 `rh config sync status` 查看這些啟動設定。如果這些是自己設定的，執行 `rh config sync pull --allow-commands` 即可採用檔案夾中的副本。"
          }
        }
      }
    },
    "doctor.fix.syncCompare": {
      "comment": "Fix line under a check in the setup window's Details list: what the person should do. A sentence. About the config sync feature. \"the folder's\" means the synced copy; \"this one\" means this machine's config.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قارن بينهما باستخدام `rh config sync status`. ثم شغّل `rh config sync pull --force` لاعتماد نسخة المجلد، أو `push --force` للاحتفاظ بهذه النسخة. يُحفظ الملف المستبدَل أولًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "`rh config sync status` দিয়ে দুটো তুলনা করুন। তারপর ফোল্ডারেরটি নিতে `rh config sync pull --force` চালান, অথবা এটি রাখতে `push --force` চালান। প্রতিস্থাপিত ফাইলটি আগে সংরক্ষিত হয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergleiche beide mit `rh config sync status`. Führe dann `rh config sync pull --force` aus, um die Version aus dem Ordner zu übernehmen, oder `push --force`, um die Version dieses Rechners zu behalten. Die ersetzte Datei wird vorher gesichert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συγκρίνετε τις δύο εκδόσεις με την εντολή `rh config sync status`. Έπειτα εκτελέστε `rh config sync pull --force` για να πάρετε εκείνη του φακέλου ή `push --force` για να κρατήσετε αυτή. Το αρχείο που αντικαθίσταται αποθηκεύεται πρώτα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare them with `rh config sync status`. Then run `rh config sync pull --force` to take the folder's copy, or `push --force` to keep this one. The replaced file is saved first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara ambas versiones con `rh config sync status`. Después ejecuta `rh config sync pull --force` para quedarte con la de la carpeta, o `push --force` para conservar esta. El archivo reemplazado se guarda antes."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آن‌ها را با `rh config sync status` مقایسه کنید. سپس برای گرفتن نسخهٔ پوشه `rh config sync pull --force` را اجرا کنید، یا برای نگه داشتن این نسخه `push --force` را. فایل جایگزین‌شده ابتدا ذخیره می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparez-les avec `rh config sync status`. Exécutez ensuite `rh config sync pull --force` pour prendre la copie du dossier, ou `push --force` pour garder celle de cette machine. Le fichier remplacé est d’abord sauvegardé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להשוות ביניהם באמצעות `rh config sync status`. לאחר מכן יש להריץ את `rh config sync pull --force` כדי לקחת את העותק שבתיקיה, או את `push --force` כדי לשמור את העותק שבמחשב זה. הקובץ שמוחלף נשמר קודם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "`rh config sync status` से दोनों की तुलना करें। फिर फ़ोल्डर वाली कॉन्फ़िग लेने के लिए `rh config sync pull --force` चलाएँ, या इस मशीन वाली रखने के लिए `push --force` चलाएँ। बदली जाने वाली फ़ाइल पहले सहेजी जाती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bandingkan keduanya dengan `rh config sync status`. Lalu jalankan `rh config sync pull --force` untuk mengambil yang ada di folder, atau `push --force` untuk mempertahankan yang ada di mesin ini. File yang diganti disimpan lebih dulu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Confrontali con `rh config sync status`. Poi esegui `rh config sync pull --force` per usare la copia della cartella, oppure `push --force` per mantenere questa. Il file sostituito viene prima salvato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "`rh config sync status` で両者を比較してください。その後、フォルダ側のコピーを採用するなら `rh config sync pull --force`、このマシン側を残すなら `push --force` を実行します。置き換えられるファイルは先に保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "`rh config sync status` 명령으로 두 설정을 비교하십시오. 그다음 폴더의 설정을 가져오려면 `rh config sync pull --force` 명령을, 이 기기의 설정을 유지하려면 `push --force` 명령을 실행하십시오. 교체되는 파일은 그 전에 사본으로 저장됩니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "त्यांची तुलना `rh config sync status` ने करा. मग फोल्डरमधील कॉन्फिग घेण्यासाठी `rh config sync pull --force` किंवा हा कॉन्फिग ठेवण्यासाठी `push --force` चालवा. बदललेली फाइल आधी जतन केली जाते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bandingkan kedua-duanya dengan `rh config sync status`. Kemudian jalankan `rh config sync pull --force` untuk mengambil salinan folder, atau `push --force` untuk mengekalkan yang ini. Fail yang digantikan disimpan dahulu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergelijk ze met `rh config sync status`. Voer daarna `rh config sync pull --force` uit om de versie uit de map te nemen, of `push --force` om deze te houden. Het vervangen bestand wordt eerst opgeslagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Porównaj je poleceniem `rh config sync status`. Następnie uruchom `rh config sync pull --force`, aby pobrać wersję z folderu, albo `push --force`, aby zachować tę z tego komputera. Zastąpiony plik zostanie najpierw zapisany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare as duas com `rh config sync status`. Em seguida, execute `rh config sync pull --force` para usar a da pasta ou `push --force` para manter esta. O arquivo substituído é salvo antes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparați-le cu `rh config sync status`. Apoi rulați `rh config sync pull --force` pentru a lua configurația din dosar sau `push --force` pentru a păstra configurația de pe acest calculator. Fișierul înlocuit se salvează mai întâi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сравните их с помощью `rh config sync status`. Затем выполните `rh config sync pull --force`, чтобы взять конфигурацию из папки, или `push --force`, чтобы сохранить конфигурацию этого компьютера. Заменяемый файл сначала сохраняется."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அவற்றை `rh config sync status` மூலம் ஒப்பிடவும். பிறகு கோப்புறையிலுள்ளதை எடுக்க `rh config sync pull --force` ஐ, அல்லது இந்தக் கணினியிலுள்ளதை வைத்திருக்க `push --force` ஐ இயக்கவும். மாற்றப்படும் கோப்பு முதலில் சேமிக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వాటిని `rh config sync status` తో పోల్చండి. తర్వాత ఫోల్డర్‌లోనిది తీసుకోవడానికి `rh config sync pull --force`, లేదా ఈ కంప్యూటర్‌లోనిదాన్ని ఉంచుకోవడానికి `push --force` రన్ చేయండి. భర్తీ చేయబడిన ఫైల్ ముందుగా సేవ్ చేయబడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปรียบเทียบทั้งสองด้วย `rh config sync status` จากนั้นเรียกใช้ `rh config sync pull --force` เพื่อใช้ของในโฟลเดอร์ หรือ `push --force` เพื่อเก็บของเครื่องนี้ไว้ ไฟล์ที่ถูกแทนที่จะถูกบันทึกไว้ก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunları `rh config sync status` ile karşılaştırın. Ardından klasördekini almak için `rh config sync pull --force`, bu bilgisayardakini tutmak için `push --force` komutunu çalıştırın. Değiştirilen dosya önce kaydedilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Порівняйте їх за допомогою `rh config sync status`. Потім виконайте `rh config sync pull --force`, щоб взяти конфігурацію з папки, або `push --force`, щоб залишити цю. Замінений файл спершу буде збережено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ان کا `rh config sync status` سے موازنہ کریں۔ پھر فولڈر کی کنفیگ لینے کے لیے `rh config sync pull --force`، یا اپنی کنفیگ رکھنے کے لیے `push --force` چلائیں۔ بدلی جانے والی فائل پہلے محفوظ کر لی جاتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "So sánh chúng bằng `rh config sync status`. Sau đó chạy `rh config sync pull --force` để lấy cấu hình trong thư mục, hoặc `push --force` để giữ cấu hình này. Tệp bị thay thế sẽ được lưu trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 `rh config sync status` 比较两者。然后运行 `rh config sync pull --force` 以采用文件夹中的配置，或运行 `push --force` 以保留本机配置。被替换的文件会先被保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用 `rh config sync status` 比較兩者。然後執行 `rh config sync pull --force` 以採用檔案夾中的設定，或執行 `push --force` 以保留本機設定。被取代的檔案會先被儲存。"
          }
        }
      }
    },
    "doctor.fix.syncConflict": {
      "comment": "Fix line under a check in the setup window's Details list: what the person should do. A sentence. About the config sync feature.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كتب جهازان config.toml في الوقت نفسه. قارن النسخ، واحتفظ بالمحتوى الصحيح في config.toml، واحذف النسخ الأخرى يدويًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দুটি কম্পিউটার একসঙ্গে config.toml লিখেছে। কপিগুলো তুলনা করুন, config.toml-এ সঠিক বিষয়বস্তু রাখুন, এবং বাকিগুলো হাতে মুছে ফেলুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei Rechner haben config.toml gleichzeitig geschrieben. Vergleiche die Kopien, behalte den richtigen Inhalt in config.toml und lösche die übrigen von Hand."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δύο υπολογιστές έγραψαν το config.toml ταυτόχρονα. Συγκρίνετε τα αντίγραφα, διατηρήστε το σωστό περιεχόμενο στο config.toml και διαγράψτε χειροκίνητα τα υπόλοιπα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two machines wrote config.toml at once. Compare the copies, keep the right content in config.toml, and delete the others by hand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos equipos escribieron config.toml a la vez. Compara las copias, deja el contenido correcto en config.toml y elimina las demás a mano."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دو دستگاه هم‌زمان config.toml را نوشته‌اند. نسخه‌ها را مقایسه کنید، محتوای درست را در config.toml نگه دارید و بقیه را به‌صورت دستی حذف کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux machines ont écrit config.toml en même temps. Comparez les copies, gardez le bon contenu dans config.toml, puis supprimez les autres à la main."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שני מחשבים כתבו את config.toml בבת אחת. יש להשוות בין העותקים, לשמור את התוכן הנכון ב-config.toml ולמחוק את האחרים ידנית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दो मशीनों ने एक ही समय पर config.toml लिखी। प्रतियों की तुलना करें, config.toml में सही कॉन्टेंट रखें, और बाकी प्रतियाँ ख़ुद डिलीट करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dua mesin menulis config.toml sekaligus. Bandingkan salinannya, simpan isi yang benar di config.toml, dan hapus yang lain secara manual."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Due computer hanno scritto config.toml nello stesso momento. Confronta le copie, mantieni il contenuto giusto in config.toml ed elimina le altre a mano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2 台のマシンが同時に config.toml を書き込みました。コピーを比較して正しい内容を config.toml に残し、ほかのコピーは手作業で削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 기기가 config.toml을 동시에 기록했습니다. 사본들을 비교하고, 올바른 내용을 config.toml에 남긴 다음, 나머지는 직접 삭제하십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "दोन मशीननी एकाच वेळी config.toml लिहिले. प्रतींची तुलना करा, config.toml मध्ये योग्य मजकूर ठेवा आणि इतर हाताने हटवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dua mesin menulis config.toml serentak. Bandingkan salinan, kekalkan kandungan yang betul dalam config.toml, dan padam yang lain secara manual."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twee machines hebben tegelijk config.toml geschreven. Vergelijk de kopieën, bewaar de juiste inhoud in config.toml en verwijder de andere handmatig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dwa komputery zapisały config.toml jednocześnie. Porównaj kopie, zachowaj właściwą zawartość w config.toml, a pozostałe usuń ręcznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dois computadores gravaram config.toml ao mesmo tempo. Compare as cópias, mantenha o conteúdo correto em config.toml e apague as outras manualmente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Două calculatoare au scris config.toml în același timp. Comparați copiile, păstrați conținutul corect în config.toml și ștergeți manual celelalte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Два компьютера одновременно записали config.toml. Сравните копии, оставьте правильное содержимое в config.toml и удалите остальные вручную."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இரண்டு கணினிகள் ஒரே நேரத்தில் config.toml ஐ எழுதின. நகல்களை ஒப்பிட்டு, config.toml இல் சரியான உள்ளடக்கத்தை வைத்துக்கொண்டு, மற்றவற்றை கைமுறையாக நீக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రెండు కంప్యూటర్లు ఒకే సమయంలో config.toml ను రాశాయి. కాపీలను పోల్చి, config.toml లో సరైన కంటెంట్‌ను ఉంచి, మిగిలినవాటిని చేతితో తొలగించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีสองเครื่องเขียน config.toml พร้อมกัน เปรียบเทียบสำเนาต่าง ๆ เก็บเนื้อหาที่ถูกต้องไว้ใน config.toml และลบสำเนาอื่นด้วยตนเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki bilgisayar config.toml dosyasını aynı anda yazdı. Kopyaları karşılaştırın, config.toml içinde doğru içeriği tutun ve diğerlerini elle silin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Два компʼютери одночасно записали config.toml. Порівняйте копії, залиште правильний вміст у config.toml, а решту видаліть вручну."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دو کمپیوٹروں نے ایک ساتھ config.toml لکھی۔ کاپیوں کا موازنہ کریں، config.toml میں درست مواد رکھیں، اور باقی کو ہاتھ سے حذف کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai máy đã ghi config.toml cùng lúc. So sánh các bản sao, giữ nội dung đúng trong config.toml, và xóa thủ công các bản còn lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两台机器同时写入了 config.toml。比较这些副本，在 config.toml 中保留正确的内容，并手动删除其余副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩台電腦同時寫入了 config.toml。比較這些副本，在 config.toml 中保留正確的內容，並手動刪除其餘副本。"
          }
        }
      }
    },
    "doctor.fix.syncDownload": {
      "comment": "Fix line under a check in the setup window's Details list: what the person should do. A sentence. About the config sync feature.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح المجلد في فايندر، وانتظر حتى يكتمل التنزيل، ثم شغّل `rh config sync status`."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder-এ ফোল্ডারটি খুলুন, ডাউনলোড শেষ হতে দিন, তারপর `rh config sync status` চালান।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne den Ordner im Finder, warte, bis der Download abgeschlossen ist, und führe dann `rh config sync status` aus."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίξτε τον φάκελο στο Finder, περιμένετε να ολοκληρωθεί η λήψη και μετά εκτελέστε `rh config sync status`."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the folder in Finder, let the download finish, then run `rh config sync status`."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la carpeta en el Finder, espera a que termine la descarga y luego ejecuta `rh config sync status`."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پوشه را در Finder باز کنید، صبر کنید دانلود تمام شود، سپس `rh config sync status` را اجرا کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez le dossier dans le Finder, laissez le téléchargement se terminer, puis exécutez `rh config sync status`."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לפתוח את התיקיה ב-Finder, להמתין לסיום ההורדה ואז להריץ את `rh config sync status`."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोल्डर को Finder में खोलें, डाउनलोड पूरा होने दें, फिर `rh config sync status` चलाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka folder di Finder, tunggu unduhan selesai, lalu jalankan `rh config sync status`."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri la cartella nel Finder, attendi il completamento del download, poi esegui `rh config sync status`."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder でフォルダを開き、ダウンロードが完了するまで待ってから、`rh config sync status` を実行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder에서 폴더를 열고 다운로드가 끝날 때까지 기다린 다음 `rh config sync status` 명령을 실행하십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder मध्ये फोल्डर उघडा, डाउनलोड पूर्ण होऊ द्या, मग `rh config sync status` चालवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka folder dalam Finder, biarkan muat turun selesai, kemudian jalankan `rh config sync status`."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open de map in Finder, wacht tot de download klaar is en voer daarna `rh config sync status` uit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz folder w Finderze, poczekaj, aż pobieranie się zakończy, a następnie uruchom `rh config sync status`."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra a pasta no Finder, aguarde o download terminar e execute `rh config sync status`."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschideți dosarul în Finder, lăsați descărcarea să se termine, apoi rulați `rh config sync status`."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте папку в Finder, дождитесь окончания загрузки и выполните `rh config sync status`."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கோப்புறையை Finder இல் திறந்து, பதிவிறக்கம் முடியும் வரை காத்திருந்து, பிறகு `rh config sync status` ஐ இயக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫోల్డర్‌ను Finderలో తెరవండి, డౌన్‌లోడ్ పూర్తయ్యేవరకు ఆగండి, తర్వాత `rh config sync status` రన్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดโฟลเดอร์ใน Finder รอจนดาวน์โหลดเสร็จ แล้วเรียกใช้ `rh config sync status`"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klasörü Finder’da açın, indirmenin bitmesini bekleyin, ardından `rh config sync status` komutunu çalıştırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте папку у Finder, дочекайтеся завершення завантаження, а потім виконайте `rh config sync status`."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فولڈر کو Finder میں کھولیں، ڈاؤن لوڈ مکمل ہونے دیں، پھر `rh config sync status` چلائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở thư mục trong Finder, đợi tải xuống hoàn tất, rồi chạy `rh config sync status`."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在访达中打开该文件夹，等待下载完成，然后运行 `rh config sync status`。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Finder 中開啟該檔案夾，等待下載完成，然後執行 `rh config sync status`。"
          }
        }
      }
    },
    "doctor.fix.syncFixRemote": {
      "comment": "Fix line under a check in the setup window's Details list: what the person should do. A sentence. About the config sync feature.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أصلح الملف في المجلد، أو شغّل `rh config sync push --force` من جهاز يحتوي على إعداد سليم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফোল্ডারের ফাইলটি ঠিক করুন, অথবা ভালো কনফিগ আছে এমন কম্পিউটার থেকে `rh config sync push --force` চালান।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Korrigiere die Datei im Ordner, oder führe `rh config sync push --force` auf einem Rechner mit einer guten Konfiguration aus."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διορθώστε το αρχείο στον φάκελο ή εκτελέστε `rh config sync push --force` από υπολογιστή με σωστό αρχείο ρυθμίσεων."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fix the file in the folder, or run `rh config sync push --force` from a machine with a good config."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrige el archivo de la carpeta o ejecuta `rh config sync push --force` desde un equipo con una configuración correcta."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فایل داخل پوشه را اصلاح کنید، یا `rh config sync push --force` را از دستگاهی که پیکربندی درستی دارد اجرا کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrigez le fichier dans le dossier, ou exécutez `rh config sync push --force` depuis une machine dont la configuration est correcte."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לתקן את הקובץ בתיקיה, או להריץ את `rh config sync push --force` ממחשב שיש בו תצורה תקינה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोल्डर की फ़ाइल ठीक करें, या किसी ऐसी मशीन से `rh config sync push --force` चलाएँ जिसकी कॉन्फ़िग सही हो।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perbaiki file di folder, atau jalankan `rh config sync push --force` dari mesin yang konfigurasinya benar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Correggi il file nella cartella, oppure esegui `rh config sync push --force` da un computer con una configurazione corretta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダ内のファイルを修正するか、設定が正しいマシンから `rh config sync push --force` を実行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더의 파일을 고치거나, 설정이 올바른 기기에서 `rh config sync push --force` 명령을 실행하십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फोल्डरमधील फाइल दुरुस्त करा, किंवा चांगला कॉन्फिग असलेल्या मशीनवरून `rh config sync push --force` चालवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Betulkan fail dalam folder, atau jalankan `rh config sync push --force` dari mesin yang mempunyai konfigurasi yang baik."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herstel het bestand in de map, of voer `rh config sync push --force` uit op een machine met een goede configuratie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Napraw plik w folderze albo uruchom `rh config sync push --force` na komputerze z poprawną konfiguracją."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrija o arquivo na pasta ou execute `rh config sync push --force` em um computador com uma boa configuração."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Reparați fișierul din dosar sau rulați `rh config sync push --force` de pe un calculator cu o configurație corectă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исправьте файл в папке или выполните `rh config sync push --force` на компьютере с правильной конфигурацией."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கோப்புறையிலுள்ள கோப்பைச் சரிசெய்யவும், அல்லது சரியான உள்ளமைவு உள்ள கணினியிலிருந்து `rh config sync push --force` ஐ இயக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫోల్డర్‌లోని ఫైల్‌ను సరిచేయండి, లేదా మంచి కాన్ఫిగరేషన్ ఉన్న కంప్యూటర్ నుండి `rh config sync push --force` రన్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แก้ไขไฟล์ในโฟลเดอร์ หรือเรียกใช้ `rh config sync push --force` จากเครื่องที่มีการกำหนดค่าที่ถูกต้อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klasördeki dosyayı düzeltin veya sağlıklı bir yapılandırması olan bilgisayardan `rh config sync push --force` komutunu çalıştırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виправте файл у папці або виконайте `rh config sync push --force` на компʼютері з робочою конфігурацією."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فولڈر میں موجود فائل درست کریں، یا درست کنفیگ والے کمپیوٹر سے `rh config sync push --force` چلائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sửa tệp trong thư mục, hoặc chạy `rh config sync push --force` từ một máy có cấu hình đúng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修复文件夹中的文件，或在配置正确的机器上运行 `rh config sync push --force`。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "修正檔案夾中的檔案，或在設定正確的電腦上執行 `rh config sync push --force`。"
          }
        }
      }
    },
    "doctor.fix.syncFolder": {
      "comment": "Fix line under a check in the setup window's Details list: what the person should do. A sentence. About the config sync feature.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقّق من توفّر القرص أو iCloud Drive. أو شغّل `rh config sync push` لإنشاء المجلد، أو اختر مجلدًا آخر باستخدام `rh config sync enable --folder <folder>`‎."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ড্রাইভ বা iCloud Drive পাওয়া যাচ্ছে কি না দেখুন। অথবা ফোল্ডার তৈরি করতে `rh config sync push` চালান, কিংবা `rh config sync enable --folder <folder>` দিয়ে অন্য একটি বেছে নিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe, ob das Laufwerk oder iCloud Drive verfügbar ist. Oder führe `rh config sync push` aus, um den Ordner anzulegen, oder wähle mit `rh config sync enable --folder <folder>` einen anderen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ελέγξτε ότι ο δίσκος ή το iCloud Drive είναι διαθέσιμο. Ή εκτελέστε `rh config sync push` για να δημιουργήσετε τον φάκελο ή επιλέξτε άλλον με `rh config sync enable --folder <folder>`."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check that the drive or iCloud Drive is available. Or run `rh config sync push` to create the folder, or choose another with `rh config sync enable --folder <folder>`."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba que la unidad o iCloud Drive esté disponible. O ejecuta `rh config sync push` para crear la carpeta, o elige otra con `rh config sync enable --folder <folder>`."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بررسی کنید که درایو یا iCloud Drive در دسترس باشد. یا برای ساختن پوشه `rh config sync push` را اجرا کنید، یا با `rh config sync enable --folder <folder>`‎ پوشهٔ دیگری انتخاب کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez que le disque ou iCloud Drive est disponible. Ou exécutez `rh config sync push` pour créer le dossier, ou choisissez-en un autre avec `rh config sync enable --folder <folder>`."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לוודא שהכונן או iCloud Drive זמינים. אפשר גם להריץ את `rh config sync push` כדי ליצור את התיקיה, או לבחור תיקיה אחרת עם `rh config sync enable --folder <folder>`‎."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जाँचें कि ड्राइव या iCloud Drive उपलब्ध है। या फ़ोल्डर बनाने के लिए `rh config sync push` चलाएँ, या `rh config sync enable --folder <folder>` से कोई दूसरा फ़ोल्डर चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastikan drive atau iCloud Drive tersedia. Atau jalankan `rh config sync push` untuk membuat folder, atau pilih folder lain dengan `rh config sync enable --folder <folder>`."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica che il disco o iCloud Drive sia disponibile. Oppure esegui `rh config sync push` per creare la cartella, o scegline un’altra con `rh config sync enable --folder <folder>`."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドライブまたは iCloud Drive が利用可能か確認してください。または、`rh config sync push` を実行してフォルダを作成するか、`rh config sync enable --folder <folder>` で別のフォルダを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드라이브 또는 iCloud Drive를 사용할 수 있는지 확인하십시오. 또는 `rh config sync push` 명령을 실행하여 폴더를 만들거나, `rh config sync enable --folder <folder>` 명령으로 다른 폴더를 선택하십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ड्राइव्ह किंवा iCloud Drive उपलब्ध आहे का ते तपासा. किंवा फोल्डर तयार करण्यासाठी `rh config sync push` चालवा, किंवा `rh config sync enable --folder <folder>` वापरून दुसरे फोल्डर निवडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semak sama ada pemacu atau iCloud Drive tersedia. Atau jalankan `rh config sync push` untuk mencipta folder, atau pilih yang lain dengan `rh config sync enable --folder <folder>`."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer of de schijf of iCloud Drive beschikbaar is. Of voer `rh config sync push` uit om de map aan te maken, of kies een andere map met `rh config sync enable --folder <folder>`."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź, czy dysk lub iCloud Drive jest dostępny. Możesz też uruchomić `rh config sync push`, aby utworzyć folder, albo wybrać inny poleceniem `rh config sync enable --folder <folder>`."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique se o drive ou o iCloud Drive está disponível. Ou execute `rh config sync push` para criar a pasta, ou escolha outra com `rh config sync enable --folder <folder>`."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificați dacă unitatea sau iCloud Drive este disponibilă. Sau rulați `rh config sync push` pentru a crea dosarul, sau alegeți alt dosar cu `rh config sync enable --folder <folder>`."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте, доступен ли диск или iCloud Drive. Или выполните `rh config sync push`, чтобы создать папку, или выберите другую с помощью `rh config sync enable --folder <folder>`."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இயக்ககம் அல்லது iCloud Drive கிடைக்கிறதா எனச் சரிபார்க்கவும். அல்லது கோப்புறையை உருவாக்க `rh config sync push` ஐ இயக்கவும், அல்லது `rh config sync enable --folder <folder>` மூலம் வேறொன்றைத் தேர்ந்தெடுக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "డ్రైవ్ లేదా iCloud Drive అందుబాటులో ఉందో లేదో తనిఖీ చేయండి. లేదా ఫోల్డర్‌ను సృష్టించడానికి `rh config sync push` రన్ చేయండి, లేదా `rh config sync enable --folder <folder>` తో మరొకదాన్ని ఎంచుకోండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบว่าไดรฟ์หรือ iCloud Drive พร้อมใช้งาน หรือเรียกใช้ `rh config sync push` เพื่อสร้างโฟลเดอร์ หรือเลือกโฟลเดอร์อื่นด้วย `rh config sync enable --folder <folder>`"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürücünün veya iCloud Drive’ın kullanılabilir olduğunu denetleyin. Ya da klasörü oluşturmak için `rh config sync push` komutunu çalıştırın veya `rh config sync enable --folder <folder>` ile başka bir klasör seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірте, чи доступний диск або iCloud Drive. Або виконайте `rh config sync push`, щоб створити папку, або виберіть іншу за допомогою `rh config sync enable --folder <folder>`."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دیکھیں کہ ڈرائیو یا iCloud Drive دستیاب ہے۔ یا فولڈر بنانے کے لیے `rh config sync push` چلائیں، یا `rh config sync enable --folder <folder>`‎ کے ساتھ کوئی اور منتخب کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra xem ổ đĩa hoặc iCloud Drive có sẵn sàng không. Hoặc chạy `rh config sync push` để tạo thư mục, hoặc chọn thư mục khác bằng `rh config sync enable --folder <folder>`."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查驱动器或 iCloud 云盘是否可用。或者运行 `rh config sync push` 创建文件夹，或使用 `rh config sync enable --folder <folder>` 选择其他文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請確認磁碟或「iCloud雲碟」可用。或者執行 `rh config sync push` 建立檔案夾，或使用 `rh config sync enable --folder <folder>` 選擇其他檔案夾。"
          }
        }
      }
    },
