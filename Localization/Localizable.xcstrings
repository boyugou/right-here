    "refusal.repository.noRemote": {
      "comment": "Why an action did nothing, shown in the alert after a click in Finder (and, in English, by the command line). A remote is git's name for a copy of the repository elsewhere; a git host is GitHub, GitLab and the like.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليس للمستودع أي مستودع بعيد، لذا ليست له صفحة على أي خدمة استضافة git."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রিপোজিটরিটির কোনো রিমোট নেই, তাই কোনো git হোস্টে এর কোনো পৃষ্ঠা নেই।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Repository hat kein Remote und daher keine Seite bei einem Git-Hosting-Dienst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το αποθετήριο δεν έχει απομακρυσμένο αποθετήριο, οπότε δεν έχει σελίδα σε υπηρεσία φιλοξενίας git."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The repository has no remote, so it has no page on a git host."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El repositorio no tiene ningún remoto, así que no tiene página en un servicio de alojamiento de git."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مخزن هیچ مخزن راه‌دوری ندارد، بنابراین صفحه‌ای روی هیچ میزبان git ندارد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dépôt n’a aucun dépôt distant, il n’a donc pas de page sur un hébergeur git."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "למאגר אין מאגר מרוחק, ולכן אין לו עמוד בשירות אירוח של git."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिपॉज़िटरी का कोई रिमोट नहीं है, इसलिए किसी git होस्ट पर उसका कोई पेज नहीं है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Repositori ini tidak memiliki remote, jadi tidak memiliki halaman di layanan hosting git."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il repository non ha un remote, quindi non ha una pagina su un host git."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リポジトリにリモートがないため、gitホスト上にページがありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장소에 리모트가 없으므로 git 호스트에 페이지도 없습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "रेपॉझिटरीला कोणताही रिमोट नाही, त्यामुळे git होस्टवर तिचे पृष्ठ नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Repositori ini tiada remote, jadi ia tiada halaman pada hos git."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De repository heeft geen remote, dus hij heeft geen pagina op een git-host."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Repozytorium nie ma zdalnego repozytorium (remote), więc nie ma strony w żadnym serwisie git."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O repositório não tem remote, então não tem página em um host git."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Depozitul nu are niciun remote, deci nu are nicio pagină pe o gazdă git."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В репозитории не настроен ни один удаленный репозиторий (remote), поэтому у него нет страницы на git-хостинге."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த repository-க்கு remote இல்லை, எனவே git ஹோஸ்டில் அதற்குப் பக்கம் இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ రిపోజిటరీకి రిమోట్ లేదు, కాబట్టి git హోస్ట్‌లో దానికి పేజీ లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รีโพซิทอรีนี้ไม่มีรีโมต จึงไม่มีหน้าบนโฮสต์ git"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Depoda tanımlı bir remote yok, bu yüzden bir git barındırma hizmetinde sayfası yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У репозиторію немає жодного remote, тож він не має сторінки на git-хостингу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس ریپازٹری کا کوئی ریموٹ نہیں ہے، اس لیے git ہوسٹ پر اس کا کوئی صفحہ نہیں ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kho git không có remote nào nên không có trang trên dịch vụ lưu trữ git."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该仓库没有远程仓库，因此在 git 托管平台上没有页面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該儲存庫沒有遠端儲存庫，因此在 git 代管平台上沒有頁面。"
          }
        }
      }
    },
    "refusal.repository.notInCommit": {
      "comment": "Why an action did nothing, shown in the alert after a click in Finder (and, in English, by the command line). %@ is a file or folder name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%@ ليس ضمن الإيداع الحالي (الملف الجديد أو غير المتتبَّع ليست له صفحة بعد). أودعه وادفعه (commit وpush)، ثم حاول مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ চেক-আউট করা কমিটে নেই (নতুন বা আনট্র্যাকড ফাইলের এখনও কোনো পৃষ্ঠা নেই)। এটি কমিট ও পুশ করুন, তারপর আবার চেষ্টা করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist nicht im ausgecheckten Commit enthalten (eine neue oder nicht verfolgte Datei hat noch keine Seite). Committe und pushe es und versuche es dann erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %@ δεν βρίσκεται στο τρέχον commit (ένα νέο ή μη παρακολουθούμενο αρχείο δεν έχει ακόμη σελίδα). Κάντε commit και push και δοκιμάστε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is not in the checked-out commit (a new or untracked file has no page yet). Commit and push it, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no está en el commit actual (un archivo nuevo o sin seguimiento todavía no tiene página). Haz commit y push y vuelve a intentarlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%@ در کامیت فعلی نیست (فایل جدید یا ردیابی‌نشده هنوز صفحه‌ای ندارد). آن را commit و push کنید و دوباره تلاش کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne figure pas dans le commit extrait (un fichier nouveau ou non suivi n’a pas encore de page). Faites-en un commit et poussez-le, puis réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%@ אינו נמצא ב-commit הנוכחי (לקובץ חדש או לקובץ שאינו במעקב עדיין אין עמוד). יש לבצע commit ו-push ולנסות שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ चेक-आउट किए हुए कमिट में नहीं है (नई या अनट्रैक्ड फ़ाइल का अभी कोई पेज नहीं होता)। इसे कमिट और पुश करें, फिर दोबारा कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tidak ada dalam commit yang sedang di-checkout (file baru atau yang tidak dilacak belum memiliki halaman). Commit dan push item tersebut, lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non è nel commit del checkout attuale (un file nuovo o non tracciato non ha ancora una pagina). Esegui commit e push, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はチェックアウト中のコミットに含まれていません（新規ファイルや追跡されていないファイルには、まだページがありません）。コミットしてプッシュしてから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 항목은 체크아웃된 커밋에 없습니다(새 파일이나 추적되지 않는 파일에는 아직 페이지가 없습니다). 커밋하고 푸시한 다음 다시 시도하십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ चेक आउट केलेल्या कमिटमध्ये नाही (नवीन किंवा ट्रॅक न केलेल्या फाइलचे अजून पृष्ठ नसते). ते कमिट आणि पुश करा, आणि पुन्हा प्रयत्न करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tiada dalam komit yang di-checkout (fail baharu atau fail yang tidak dijejaki belum mempunyai halaman). Komit dan push item itu, kemudian cuba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ zit niet in de uitgecheckte commit (een nieuw of niet-gevolgd bestand heeft nog geen pagina). Commit en push het en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elementu %@ nie ma w bieżącym commicie (nowy lub nieśledzony plik nie ma jeszcze strony). Zatwierdź go (commit) i wypchnij (push), a następnie spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não está no commit em checkout (um arquivo novo ou não rastreado ainda não tem página). Faça o commit e o push e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nu se află în commitul curent (un fișier nou sau neurmărit nu are încă o pagină). Faceți commit și push, apoi încercați din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объекта %@ нет в текущем коммите (у нового или неотслеживаемого файла еще нет страницы). Сделайте коммит и push, затем повторите попытку."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ checkout செய்யப்பட்ட commit-இல் இல்லை (புதிய அல்லது track செய்யப்படாத கோப்புக்கு இன்னும் பக்கம் இல்லை). அதை commit செய்து push செய்த பின், மீண்டும் முயலவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ చెక్‌అవుట్ చేసిన కమిట్‌లో లేదు (కొత్త లేదా ట్రాక్ చేయని ఫైల్‌కు ఇంకా పేజీ ఉండదు). దాన్ని కమిట్ చేసి push చేయండి, ఆ తర్వాత మళ్లీ ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ไม่อยู่ใน commit ที่ checkout อยู่ (ไฟล์ใหม่หรือไฟล์ที่ยังไม่ได้ติดตามจะยังไม่มีหน้า) commit และ push แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ geçerli commit’te yok (yeni veya izlenmeyen bir dosyanın henüz sayfası olmaz). Commit edip push edin ve tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Елемент %@ відсутній у поточному коміті (новий або невідстежуваний файл ще не має сторінки). Закомітьте його й надішліть (push), а потім повторіть спробу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%@ چیک آؤٹ شدہ کمٹ میں نہیں ہے (نئی یا غیر ٹریک شدہ فائل کا ابھی کوئی صفحہ نہیں ہوتا)۔ اسے کمٹ اور پش کریں، پھر دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ không có trong commit đang được checkout (tệp mới hoặc chưa được theo dõi thì chưa có trang). Hãy commit và push nó, rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不在当前检出的提交中（新文件或未跟踪的文件还没有页面）。请提交并推送它，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不在目前檢出的提交中（新檔案或未追蹤的檔案還沒有頁面）。請提交並推送它，然後重試。"
          }
        }
      }
    },
