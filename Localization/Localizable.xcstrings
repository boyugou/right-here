    "app.variantNewCaption": {
      "comment": "Caption of the form for a new start option of an agent.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضيف خيار التشغيل وسيطات إلى الأمر الذي يشغّل الوكيل. أعطِه عنوانًا للقائمة، وتُكتب وسيطاته في صفحته."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি শুরুর বিকল্প এজেন্ট শুরু করে এমন কমান্ডে আর্গুমেন্ট যোগ করে। মেনুর জন্য এর একটি শিরোনাম দিন; এর আর্গুমেন্টগুলো যাবে এর পৃষ্ঠায়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Startoption fügt dem Befehl, der den Agenten startet, Argumente hinzu. Gib ihr einen Titel für das Menü; ihre Argumente stehen auf ihrer Seite."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια επιλογή εκκίνησης προσθέτει ορίσματα στην εντολή που ξεκινά τον πράκτορα. Δώστε της έναν τίτλο για το μενού· τα ορίσματά της μπαίνουν στη σελίδα της."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A start option adds arguments to the command that starts the agent. Give it a title for the menu; its arguments go on its page."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una opción de inicio añade argumentos al comando que inicia el agente. Ponle un título para el menú; sus argumentos van en su página."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "گزینهٔ شروع، آرگومان‌هایی را به دستوری که عامل را شروع می‌کند می‌افزاید. برایش عنوانی برای منو بگذارید؛ آرگومان‌هایش در صفحهٔ خودش قرار می‌گیرند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une option de démarrage ajoute des arguments à la commande qui démarre l’agent. Donnez-lui un titre pour le menu ; vous saisirez ses arguments dans sa page."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשרות הפעלה מוסיפה ארגומנטים לפקודה שמפעילה את הסוכן. יש לתת לה כותרת לתפריט; הארגומנטים שלה נכתבים בעמוד שלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शुरू करने का विकल्प उस कमांड में आर्ग्युमेंट जोड़ता है जो एजेंट को शुरू करती है। इसे मेन्यू के लिए एक शीर्षक दें; इसके आर्ग्युमेंट इसके पेज पर लिखे जाएँगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Opsi mulai menambahkan argumen ke perintah yang memulai agen. Beri judul untuk menu; argumennya ditulis di halamannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’opzione di avvio aggiunge argomenti al comando che avvia l’agente. Dalle un titolo per il menu; i suoi argomenti vanno nella sua pagina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起動オプションは、エージェントを起動するコマンドに引数を追加します。メニューに表示するタイトルを付けてください。引数はそのページに入力します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작 옵션은 에이전트를 시작하는 명령에 인수를 추가합니다. 메뉴에 표시할 제목을 입력하십시오. 인수는 해당 페이지에서 지정합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सुरुवातीचा पर्याय एजंट सुरू करणाऱ्या कमांडमध्ये आर्ग्युमेंट्स जोडतो. मेनूसाठी त्याला एक शीर्षक द्या; त्याचे आर्ग्युमेंट्स त्याच्या पृष्ठावर जातील."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilihan permulaan menambah argumen pada perintah yang memulakan ejen. Berikan tajuk untuk menu; argumennya diletakkan pada halamannya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een startoptie voegt argumenten toe aan het commando dat de agent start. Geef hem een titel voor het menu; zijn argumenten komen op zijn pagina."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcja uruchamiania dodaje argumenty do polecenia, które uruchamia agenta. Nadaj jej tytuł widoczny w menu; argumenty ustawisz na jej stronie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma opção de início adiciona argumentos ao comando que inicia o agente. Dê a ela um título para o menu; os argumentos ficam na página da opção."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O opțiune de pornire adaugă argumente la comanda care pornește agentul. Dați-i un titlu pentru meniu; argumentele ei se completează pe pagina ei."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Параметр запуска добавляет аргументы к команде, которая запускает агента. Задайте ему название для меню; его аргументы указываются на его странице."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு தொடக்க விருப்பம் முகவரைத் தொடங்கும் கட்டளையுடன் வாதங்களைச் சேர்க்கிறது. மெனுவுக்காக அதற்கு ஒரு தலைப்பு கொடுங்கள்; அதன் வாதங்கள் அதன் பக்கத்தில் இருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రారంభ ఎంపిక ఏజెంట్‌ను ప్రారంభించే ఆదేశానికి ఆర్గ్యుమెంట్‌లను జోడిస్తుంది. మెనూ కోసం దానికి ఒక శీర్షిక ఇవ్వండి; దాని ఆర్గ్యుమెంట్‌లు దాని పేజీలో ఉంటాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวเลือกการเริ่มต้นจะเพิ่มอาร์กิวเมนต์ให้คำสั่งที่เริ่มเอเจนต์ ตั้งชื่อที่จะแสดงในเมนู ส่วนอาร์กิวเมนต์ของตัวเลือกจะอยู่ในหน้าของตัวเลือก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir başlatma seçeneği, ajanı başlatan komuta argüman ekler. Ona menü için bir başlık verin; argümanları kendi sayfasında yer alır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Параметр запуску додає аргументи до команди, яка запускає агента. Дайте йому назву для меню; його аргументи вказуються на його сторінці."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شروع کرنے کا اختیار اس ایجنٹ کو شروع کرنے والی کمانڈ میں آرگیومنٹ شامل کرتا ہے۔ اسے مینو کے لیے ایک عنوان دیں؛ اس کے آرگیومنٹ اس کے صفحے پر ہوں گے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tùy chọn khởi chạy thêm đối số vào lệnh khởi chạy tác tử. Đặt cho nó một tiêu đề hiển thị trong menu; đối số của nó nằm trên trang của nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动选项会在启动智能体的命令后添加参数。请为它填写一个菜单标题；它的参数填在它自己的页面上。"
          }
        },
