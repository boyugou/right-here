    "app.terminalNoAgents": {
      "comment": "Warning on the Overview page. %@ is the name of the default terminal (for example Warp). It can open a folder but cannot run a command in it, which AI agents need. Keep the %@.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "‏التطبيق %@ يفتح المجلدات فقط، ولا يستطيع تشغيل الوكلاء، لذلك يحتاجون إلى وحدة طرفية أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ শুধু ফোল্ডার খোলে। এটি এজেন্ট চালাতে পারে না, তাই এজেন্টদের জন্য অন্য একটি টার্মিনাল লাগবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ kann nur Ordner öffnen. Agenten lassen sich damit nicht starten, daher brauchen sie ein anderes Terminal."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Το %@ ανοίγει μόνο φακέλους. Δεν μπορεί να ξεκινήσει πράκτορες, γι’ αυτό χρειάζονται άλλο τερματικό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ only opens folders. It cannot start agents, so they need another terminal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ solo abre carpetas. No puede iniciar agentes, así que estos necesitan otra terminal."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "‏%@ فقط می‌تواند پوشه را باز کند. نمی‌تواند عامل‌ها را اجرا کند، پس آن‌ها به ترمینال دیگری نیاز دارند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ ne peut qu’ouvrir des dossiers. Impossible d’y lancer des agents : il leur faut donc un autre terminal."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "‏%@ פותח רק תיקיות. הוא לא יכול להפעיל סוכנים, ולכן הם זקוקים למסוף אחר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ केवल फ़ोल्डर खोल सकता है। वह एजेंट नहीं चला सकता, इसलिए एजेंटों को कोई दूसरा टर्मिनल चाहिए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ hanya bisa membuka folder. Terminal ini tidak bisa menjalankan agen, sehingga agen memerlukan terminal lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ apre solo le cartelle. Non può avviare agenti, quindi questi hanno bisogno di un altro terminale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ はフォルダを開くだけです。エージェントを起動できないため、エージェントには別のターミナルが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 앱은 폴더만 열 수 있고 에이전트를 시작할 수 없으므로, 에이전트에는 다른 터미널이 필요합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ फक्त फोल्डर उघडते. ते एजंट सुरू करू शकत नाही, त्यामुळे एजंटसाठी दुसरे टर्मिनल लागते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ hanya membuka folder. Ia tidak boleh memulakan ejen, jadi ejen memerlukan terminal lain."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ opent alleen mappen. Er kunnen geen agenten mee worden gestart, dus daarvoor is een andere terminal nodig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ tylko otwiera foldery. Nie potrafi uruchamiać agentów, więc do nich potrzebny jest inny terminal."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ só abre pastas. Ele não pode iniciar agentes, então os agentes precisam de outro terminal."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ deschide doar dosare. Nu poate porni agenți, așa că aceștia au nevoie de alt terminal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ только открывает папки и не может запускать агентов, поэтому для них нужен другой терминал."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ கோப்புறைகளை மட்டுமே திறக்கும். அதனால் முகவர்களைத் தொடங்க முடியாது, எனவே அவற்றுக்கு வேறொரு டெர்மினல் தேவை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ కేవలం ఫోల్డర్‌లను మాత్రమే తెరుస్తుంది. ఏజెంట్లను ప్రారంభించడం సాధ్యం కాదు, కాబట్టి వాటికి మరో టెర్మినల్ అవసరం."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ เปิดได้เฉพาะโฟลเดอร์ ไม่สามารถเริ่มเอเจนต์ได้ จึงต้องใช้เทอร์มินัลอื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ yalnızca klasör açar. Ajanları başlatamaz, bu yüzden ajanlara başka bir terminal gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ лише відкриває папки і не може запускати агентів, тому їм потрібен інший термінал."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "‏%@ صرف فولڈر کھولتا ہے۔ یہ ایجنٹس شروع نہیں کر سکتا، اس لیے انہیں کسی دوسرے ٹرمینل کی ضرورت ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ chỉ mở thư mục. Nó không thể khởi chạy tác tử, nên các tác tử cần một terminal khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 只能打开文件夹，无法启动智能体，因此智能体需要使用其他终端。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 只能開啟檔案夾，無法啟動代理程式，因此代理程式需要使用其他終端機。"
          }
        }
      }
    },
