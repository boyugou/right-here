            "value": "‏`%@` در پوستهٔ ورود شما پیدا نشد"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "`%@` est introuvable dans votre shell de connexion"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏`%@` לא נמצא במעטפת ההתחברות"
