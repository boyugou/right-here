    "refusal.prompt.leadingDash": {
      "comment": "Why an action did nothing, shown in the alert after a click in Finder (and, in English, by the command line). Follows refusal.presetPrompt; It is the prompt.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدأ الموجّه بشرطة، وسيقرؤها الوكيل على أنها خيار."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রম্পটটি একটি ড্যাশ দিয়ে শুরু হয়, যা এজেন্ট একটি অপশন হিসেবে পড়বে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Prompt beginnt mit einem Bindestrich, den der Agent als Option lesen würde."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η προτροπή ξεκινά με παύλα, την οποία ο πράκτορας θα διάβαζε ως επιλογή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It starts with a dash, which the agent would read as an option."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El prompt empieza con un guion, que el agente leería como una opción."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پرامپت با خط تیره شروع می‌شود و عامل آن را یک گزینه می‌خواند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le prompt commence par un tiret, que l’agent lirait comme une option."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההנחיה מתחילה במקף, שהסוכן יקרא כאפשרות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रॉम्प्ट डैश से शुरू होता है, जिसे एजेंट एक विकल्प के रूप में पढ़ेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Prompt diawali tanda hubung, yang akan dibaca agen sebagai opsi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il prompt inizia con un trattino, che l’agente leggerebbe come un’opzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロンプトがダッシュで始まっています。エージェントはこれをオプションとして解釈してしまいます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프롬프트가 대시로 시작합니다. 에이전트는 이를 옵션으로 읽게 됩니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रॉम्प्ट डॅशने सुरू होतो, आणि एजंट तो पर्याय म्हणून वाचेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesaan itu bermula dengan sengkang, yang akan dibaca oleh ejen sebagai pilihan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De prompt begint met een streepje, dat de agent als optie zou lezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Treść zaczyna się od myślnika, który agent odczytałby jako opcję."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O prompt começa com um hífen, que o agente leria como uma opção."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Promptul începe cu o liniuță, pe care agentul ar citi-o ca pe o opțiune."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Промпт начинается с дефиса, который агент воспринял бы как опцию."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ப்ராம்ப்ட் ஒரு சிறுகோட்டுடன் தொடங்குகிறது; முகவர் அதை ஒரு கட்டளை விருப்பமாகப் படித்துவிடும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రాంప్ట్ డాష్‌తో ప్రారంభమవుతుంది; ఏజెంట్ దాన్ని ఒక ఆప్షన్‌గా చదువుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พรอมต์ขึ้นต้นด้วยขีด ซึ่งเอเจนต์จะอ่านเป็นตัวเลือกของคำสั่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstem bir tireyle başlıyor; ajan bunu bir seçenek olarak okur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Промпт починається з дефіса, і агент сприйме його як параметр."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پرامپٹ ڈیش سے شروع ہوتا ہے، جسے ایجنٹ ایک آپشن سمجھے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lời nhắc bắt đầu bằng dấu gạch ngang, mà tác tử sẽ hiểu là một tùy chọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提示词以短横线开头，智能体会将其视为一个选项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提示詞以短橫線開頭，代理程式會將其視為一個選項。"
          }
        }
      }
    },
    "refusal.prompt.misleadingCharacter": {
      "comment": "Why an action did nothing, shown in the alert after a click in Finder (and, in English, by the command line). Follows refusal.presetPrompt; It is the prompt.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتوي الموجّه على حرف لا يُظهر شيئًا أو يغيّر طريقة قراءة النص (حرف لفرض الاتجاه، أو مسافة بعرض صفري، أو حرف وسم)."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রম্পটে এমন একটি ক্যারেক্টার আছে যা কিছু দেখায় না বা লেখাটি কীভাবে পড়া হবে তা বদলে দেয় (দিক বদলানোর ক্যারেক্টার, শূন্য-প্রস্থের স্পেস, ট্যাগ ক্যারেক্টার)।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Prompt enthält ein Zeichen, das nichts anzeigt oder verändert, wie der Text zu lesen ist (eine Überschreibung der Schreibrichtung, ein Leerzeichen ohne Breite, ein Tag-Zeichen)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η προτροπή περιέχει χαρακτήρα που δεν εμφανίζει τίποτα ή αλλάζει τον τρόπο που διαβάζεται το κείμενο (παράκαμψη κατεύθυνσης, κενό μηδενικού πλάτους, χαρακτήρα ετικέτας)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It has a character that shows nothing or changes how the text reads (a direction override, a zero-width space, a tag character)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El prompt tiene un carácter que no muestra nada o que cambia cómo se lee el texto (un cambio forzado de dirección, un espacio de ancho cero, un carácter de etiqueta)."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پرامپت نویسه‌ای دارد که چیزی نشان نمی‌دهد یا نحوهٔ خوانده شدن متن را تغییر می‌دهد (نویسهٔ تغییر اجباری جهت، فاصلهٔ بدون پهنا، نویسهٔ برچسب)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le prompt contient un caractère qui n’affiche rien ou qui change la façon dont le texte se lit (un forçage de direction, une espace sans chasse, un caractère d’étiquette)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההנחיה מכילה תו שאינו מציג דבר או שמשנה את אופן הקריאה של הטקסט (תו לכפיית כיוון, רווח ברוחב אפס, תו תגית)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रॉम्प्ट में ऐसा कैरेक्टर है जो कुछ नहीं दिखाता या टेक्स्ट के पढ़े जाने का तरीका बदल देता है (दिशा बदलने वाला कैरेक्टर, शून्य-चौड़ाई वाली स्पेस, टैग कैरेक्टर)।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Prompt berisi karakter yang tidak menampilkan apa pun atau mengubah cara teks dibaca (penimpaan arah, spasi lebar nol, karakter tag)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il prompt contiene un carattere che non mostra nulla o che cambia il modo in cui si legge il testo (un override di direzione, uno spazio a larghezza zero, un carattere tag)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロンプトに、何も表示されない文字や、テキストの読まれ方を変える文字（方向オーバーライド、ゼロ幅スペース、タグ文字）が含まれています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프롬프트에 아무것도 표시하지 않거나 텍스트가 읽히는 방식을 바꾸는 문자(방향 재정의 문자, 폭 없는 공백, 태그 문자)가 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रॉम्प्टमध्ये असे कॅरेक्टर आहे जे काहीही दाखवत नाही किंवा मजकूर कसा वाचला जातो ते बदलते (दिशा बदलणारे ओव्हरराइड, शून्य रुंदीची स्पेस, टॅग कॅरेक्टर)."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesaan itu mengandungi aksara yang tidak memaparkan apa-apa atau mengubah cara teks dibaca (penggantian arah, ruang lebar sifar, aksara tag)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De prompt bevat een teken dat niets toont of verandert hoe de tekst wordt gelezen (een richtingsoverschrijving, een spatie zonder breedte, een tagteken)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Treść zawiera znak, który nic nie wyświetla lub zmienia sposób odczytu tekstu (wymuszenie kierunku, spację o zerowej szerokości, znak tagu)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O prompt tem um caractere que não mostra nada ou que muda como o texto é lido (uma substituição de direção, um espaço de largura zero, um caractere de tag)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Promptul conține un caracter care nu afișează nimic sau schimbă modul în care se citește textul (o suprascriere de direcție, un spațiu de lățime zero, un caracter etichetă)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В промпте есть символ, который ничего не показывает или меняет то, как читается текст (переопределение направления, пробел нулевой ширины, символ тега)."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ப்ராம்ப்ட்டில் எதையும் காட்டாத அல்லது உரை படிக்கப்படும் விதத்தை மாற்றும் ஓர் எழுத்து உள்ளது (திசை மேலெழுதல் குறி, பூஜ்ஜிய அகல இடைவெளி, டேக் எழுத்து)."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రాంప్ట్‌లో ఏమీ చూపించని లేదా టెక్స్ట్ చదివే విధానాన్ని మార్చే అక్షరం ఉంది (దిశ ఓవర్‌రైడ్, సున్నా-వెడల్పు ఖాళీ, ట్యాగ్ అక్షరం)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พรอมต์มีอักขระที่ไม่แสดงอะไรเลยหรือเปลี่ยนวิธีอ่านข้อความ (เช่น อักขระบังคับทิศทาง ช่องว่างความกว้างศูนย์ หรืออักขระแท็ก)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstemde hiçbir şey göstermeyen ya da metnin okunuşunu değiştiren bir karakter var (yön geçersiz kılma karakteri, sıfır genişlikli boşluk, etiket karakteri)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У промпті є символ, який нічого не показує або змінює те, як читається текст (зміна напрямку тексту, пробіл нульової ширини, символ-тег)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پرامپٹ میں ایسا کیریکٹر ہے جو کچھ نہیں دکھاتا یا متن کے پڑھے جانے کا انداز بدل دیتا ہے (سمت بدلنے والا نشان، صفر چوڑائی والی جگہ، ٹیگ کیریکٹر)۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lời nhắc có một ký tự không hiển thị gì hoặc thay đổi cách đọc văn bản (ký tự ghi đè hướng, khoảng trắng độ rộng bằng không, ký tự thẻ)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提示词中有不显示任何内容或会改变文本阅读方式的字符（方向覆盖符、零宽空格、标签字符）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提示詞中有不顯示任何內容或會改變文字閱讀方式的字元（方向覆寫字元、零寬空格、標籤字元）。"
          }
        }
      }
    },
