          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiere ihn, oder ändere general.editor (entferne die Einstellung, um den ersten installierten Editor zu verwenden)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εγκαταστήστε τον επεξεργαστή, ή αλλάξτε το general.editor (αφαιρέστε τη ρύθμιση για να χρησιμοποιηθεί ο πρώτος εγκατεστημένος επεξεργαστής)."
          }
        },
        "en": {
