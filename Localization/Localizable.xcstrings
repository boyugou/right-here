    "app.menuNothingHere": {
      "comment": "Said in the menu editor on a line whose entries are not in the Finder menu on this Mac, for example because an app is not installed or no agent is enabled. A short sentence with no final period.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يُعرض شيء لهذا على هذا الـ Mac"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই Mac-এ এর জন্য কিছু দেখানো হচ্ছে না"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dafür wird auf diesem Mac nichts angezeigt"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν εμφανίζεται τίποτα γι’ αυτό σε αυτό το Mac"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is shown for this on this Mac"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se muestra nada para esto en este Mac"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای این مورد روی این مک چیزی نشان داده نمی‌شود"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne s’affiche pour cette ligne sur ce Mac"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שורה זו לא מציגה דבר ב-Mac זה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस Mac पर इसके लिए कुछ नहीं दिखाया जाता"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada yang ditampilkan untuk ini di Mac ini"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su questo Mac non viene mostrato nulla per questa riga"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac では何も表示されません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서는 아무것도 표시되지 않습니다"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या Mac वर यासाठी काहीही दाखवले जात नाही"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada apa-apa dipaparkan untuk ini pada Mac ini"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op deze Mac wordt hiervoor niets getoond"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na tym Macu nic tu nie jest pokazywane"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada disto é exibido neste Mac"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pe acest Mac nu se afișează nimic aici"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом Mac для этого ничего не отображается"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த Mac-இல் இதற்கு எதுவும் காட்டப்படுவதில்லை"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ Macలో దీనికి ఏదీ చూపబడదు"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่แสดงอะไรสำหรับรายการนี้บน Mac เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac’te bunun için hiçbir şey gösterilmiyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На цьому Mac для цього нічого не відображається"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس Mac پر اس کے لیے کچھ نہیں دکھایا جاتا"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không hiển thị gì cho mục này trên máy Mac này"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 上不显示此项内容"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台 Mac 上不顯示此項內容"
          }
        }
      }
    },
    "app.menuRemoveItem": {
