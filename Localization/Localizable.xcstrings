    "app.olderCopyReveal": {
      "comment": "Button on that card: shows the old copy of the app in a Finder window, so the person can move it to the Trash. macOS title case in English. 'Show in Finder' is macOS's own wording: reuse each language's existing translation of it from the catalog.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "إظهار هذه النسخة في فايندر"
          }
        },
        "bn": {
