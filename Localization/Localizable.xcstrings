    "alert.permissionMessage": {
      "comment": "Alert text. %@ is an app name, or the phrase for 'the app'. Settings names follow macOS.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "منع macOS تطبيق Right Here من التحكم في %@. اسمح بذلك من إعدادات النظام › الخصوصية والأمن › الأتمتة، ثم حاول مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS Right Here-কে %@ নিয়ন্ত্রণ করতে বাধা দিয়েছে। সিস্টেম সেটিংস › গোপনীয়তা ও নিরাপত্তা › অটোমেশনে অনুমতি দিন, তারপর আবার চেষ্টা করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS hat Right Here daran gehindert, %@ zu steuern. Erlaube es unter Systemeinstellungen › Datenschutz & Sicherheit › Automation und versuche es dann erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Το macOS εμπόδισε το Right Here να ελέγξει το %@. Επιτρέψτε το στις Ρυθμίσεις συστήματος › Απόρρητο και ασφάλεια › Αυτοματισμός και δοκιμάστε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS blocked Right Here from controlling %@. Allow it in System Settings › Privacy & Security › Automation, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS impidió que Right Here controlara %@. Permítelo en Ajustes del Sistema › Privacidad y seguridad › Automatización y vuelve a intentarlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "‏macOS به Right Here اجازهٔ کنترل %@ را نداد. در تنظیمات سیستم › حریم خصوصی و امنیت › خودکارسازی اجازه دهید و دوباره تلاش کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS a empêché Right Here de contrôler %@. Autorisez-le dans Réglages Système › Confidentialité et sécurité › Automatisation, puis réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "‏macOS מנע מ-Right Here לשלוט על %@. אפשר זאת בהגדרות המערכת › פרטיות ואבטחה › אוטומציה ונסה שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS ने Right Here को %@ को नियंत्रित करने से रोक दिया। सिस्टम सेटिंग्ज़ › गोपनीयता और सुरक्षा › ऑटोमेशन में इसकी अनुमति दें, फिर दोबारा कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS mencegah Right Here mengendalikan %@. Izinkan di Pengaturan Sistem › Privasi & Keamanan › Otomatisasi, lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS ha impedito a Right Here di controllare %@. Consentilo in Impostazioni di Sistema › Privacy e sicurezza › Automazione, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOSがRight Hereによる%@の制御をブロックしました。システム設定 › プライバシーとセキュリティ › オートメーションで許可してから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS가 Right Here의 %@ 제어를 차단했습니다. 시스템 설정 › 개인정보 보호 및 보안 › 자동화에서 허용한 다음 다시 시도하세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS ने Right Here ला %@ नियंत्रित करण्यापासून रोखले. सिस्टम सेटिंग्ज › गोपनीयता आणि सुरक्षा › ऑटोमेशन मध्ये परवानगी द्या आणि पुन्हा प्रयत्न करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS menghalang Right Here daripada mengawal %@. Benarkan dalam Tetapan Sistem › Privasi & Keselamatan › Automasi, kemudian cuba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS heeft voorkomen dat Right Here %@ bedient. Sta dit toe in Systeeminstellingen › Privacy en beveiliging › Automatisering en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS zablokował Right Here możliwość sterowania %@. Zezwól na to w Ustawieniach systemowych › Prywatność i ochrona › Automatyzacja, a następnie spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O macOS impediu o Right Here de controlar %@. Permita em Ajustes do Sistema › Privacidade e Segurança › Automação e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS a împiedicat Right Here să controleze %@. Permite acest lucru în Setări de sistem › Confidențialitate și securitate › Automatizare, apoi încearcă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS не позволила Right Here управлять %@. Разрешите это в Системных настройках › Конфиденциальность и безопасность › Автоматизация и повторите попытку."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ ஐக் கட்டுப்படுத்த Right Here ஐ macOS தடுத்தது. கணினி அமைப்புகள் › தனியுரிமை & பாதுகாப்பு › தானியக்கத்தில் அனுமதித்து, மீண்டும் முயலவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ను నియంత్రించకుండా Right Hereను macOS అడ్డుకుంది. సిస్టమ్ సెట్టింగ్‌లు › గోప్యత & భద్రత › ఆటోమేషన్‌లో అనుమతించి, మళ్లీ ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS ป้องกันไม่ให้ Right Here ควบคุม %@ อนุญาตได้ที่การตั้งค่าระบบ › ความเป็นส่วนตัวและความปลอดภัย › ระบบอัตโนมัติ แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS, Right Here’ın %@ üzerinde denetim kurmasını engelledi. Sistem Ayarları › Gizlilik ve Güvenlik › Otomasyon bölümünden izin verin ve tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS не дозволила Right Here керувати %@. Дозвольте це в Системних параметрах › Приватність і безпека › Автоматизація та повторіть спробу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "‏macOS نے Right Here کو %@ کنٹرول کرنے سے روک دیا۔ سسٹم سیٹنگز › پرائیویسی اور سیکیورٹی › آٹومیشن میں اجازت دیں، پھر دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS đã chặn Right Here điều khiển %@. Hãy cho phép trong Cài đặt Hệ thống › Quyền riêng tư & Bảo mật › Tự động hóa, rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS 阻止了 Right Here 控制%@。请在“系统设置” › “隐私与安全性” › “自动化”中允许，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS 阻止了 Right Here 控制%@。請在「系統設定」›「隱私權與安全性」›「自動化」中允許，然後重試。"
          }
        }
      }
    },
