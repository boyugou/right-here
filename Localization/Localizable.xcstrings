            "value": "هیچ‌کدام نصب نشده؛ Quick Actions و میان‌برهای صفحه‌کلید در دسترس نیستند"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "aucun service installé ; les Actions rapides et les raccourcis clavier ne sont pas disponibles"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין שירותים מותקנים; פעולות מהירות וקיצורי מקלדת אינם זמינים"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई इंस्टॉल नहीं; त्वरित क्रियाएँ और कीबोर्ड शॉर्टकट उपलब्ध नहीं हैं"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "tidak ada yang diinstal; Tindakan Cepat dan pintasan papan ketik tidak tersedia"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "nessuno installato; Azioni rapide e scorciatoie da tastiera non sono disponibili"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストールされていません；クイックアクションとキーボードショートカットは使用できません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치된 항목 없음; 빠른 동작과 키보드 단축키를 사용할 수 없음"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "काहीही इन्स्टॉल नाही; Quick Actions आणि कीबोर्ड शॉर्टकट उपलब्ध नाहीत"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "tiada dipasang; Tindakan Cepat dan pintasan papan kekunci tidak tersedia"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "niets geïnstalleerd; snelle taken en sneltoetsen zijn niet beschikbaar"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "brak zainstalowanych; Szybkie czynności i skróty klawiszowe są niedostępne"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "nenhuma instalada; Ações Rápidas e atalhos de teclado não estão disponíveis"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "niciunul instalat; Acțiunile rapide și scurtăturile din tastatură nu sunt disponibile"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ничего не установлено; «Быстрые действия» и сочетания клавиш недоступны"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எதுவும் நிறுவப்படவில்லை; Quick Actions மற்றும் விசைப்பலகை குறுக்குவழிகள் கிடைக்கவில்லை"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఏదీ ఇన్‌స్టాల్ చేయబడలేదు; Quick Actions మరియు కీబోర్డ్ షార్ట్‌కట్‌లు అందుబాటులో లేవు"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้ติดตั้งเลย การทำงานด่วนและปุ่มลัดแป้นพิมพ์จึงใช้ไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "hiçbiri yüklü değil; Hızlı Eylemler ve klavye kestirmeleri kullanılamıyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "не інстальовано; швидкі дії та клавіатурні скорочення недоступні"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی انسٹال نہیں؛ Quick Actions اور کی بورڈ شارٹ کٹس دستیاب نہیں ہیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "chưa cài đặt; Tác vụ nhanh và phím tắt không khả dụng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未安装；无法使用快速操作和键盘快捷键"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未安裝；無法使用快速動作與鍵盤快速鍵"
          }
        }
      }
    },
