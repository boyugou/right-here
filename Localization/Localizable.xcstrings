            "state": "translated",
            "value": "Yüklü: %1$@; ancak yapılandırmadan farklılar (eksik: %2$@, eski: %3$@)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "інстальовано: %1$@, але вони відрізняються від конфігурації (відсутні: %2$@, застарілі: %3$@)"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "انسٹال شدہ: %1$@؛ مگر یہ کنفیگ سے مختلف ہیں (غائب: %2$@، پرانے: %3$@)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "đã cài đặt: %1$@, nhưng khác với cấu hình (thiếu: %2$@, cũ: %3$@)"
