    "intent.noFolder": {
      "comment": "Shortcuts shows it when an action was run with neither its Folder nor its Saved Folder set.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مجلدًا، أو أحد مجلداتك المحفوظة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি ফোল্ডার, অথবা আপনার সংরক্ষিত ফোল্ডারগুলির একটি বেছে নিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Ordner oder einen deiner gespeicherten Ordner."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε έναν φάκελο ή έναν από τους αποθηκευμένους φακέλους σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a folder, or one of your saved folders."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una carpeta o una de tus carpetas guardadas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک پوشه یا یکی از پوشه‌های ذخیره‌شدهٔ خود را انتخاب کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un dossier ou l’un de vos dossiers enregistrés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לבחור תיקיה או אחת מהתיקיות השמורות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई फ़ोल्डर या अपने सहेजे गए फ़ोल्डरों में से एक चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih folder, atau salah satu folder tersimpan Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una cartella o una delle tue cartelle salvate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダか、保存済みフォルダのいずれかを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더 또는 저장된 폴더 중 하나를 선택하십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एखादे फोल्डर किंवा तुमच्या जतन केलेल्या फोल्डरपैकी एक निवडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih folder, atau salah satu folder anda yang disimpan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een map of een van je bewaarde mappen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz folder lub jeden z zapisanych folderów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma pasta ou uma das suas pastas salvas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alegeți un dosar sau unul dintre dosarele salvate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите папку или одну из сохраненных папок."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு கோப்புறையை அல்லது உங்கள் சேமித்த கோப்புறைகளில் ஒன்றைத் தேர்ந்தெடுக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఒక ఫోల్డర్‌ను లేదా మీ సేవ్ చేసిన ఫోల్డర్‌లలో ఒకదాన్ని ఎంచుకోండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกโฟลเดอร์ หรือหนึ่งในโฟลเดอร์ที่บันทึกไว้ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir klasör veya kaydedilmiş klasörlerinizden birini seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть папку або одну зі збережених папок."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی فولڈر یا اپنے محفوظ شدہ فولڈرز میں سے ایک منتخب کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn một thư mục hoặc một trong các thư mục đã lưu của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择一个文件夹，或你已保存的文件夹之一。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇一個檔案夾，或你已儲存的檔案夾之一。"
          }
        }
      }
    },
