            "state": "translated",
            "value": "Agenten starten zonder te vragen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uruchamiaj agentów bez pytania"
          }
        },
        "pt-BR": {
          "stringUnit": {
