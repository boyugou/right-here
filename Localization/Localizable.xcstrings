    "app.noPinned": {
      "comment": "Text shown when the list of pinned folders is empty. The command between backticks stays exactly as it is, <folder> included.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا توجد مجلدات مثبّتة. ثبّت مجلدًا من المجلدات الحديثة أدناه، أو اضغط «تثبيت مجلد…»."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "কোনো পিন করা ফোল্ডার নেই। নিচের একটি সাম্প্রতিক ফোল্ডার পিন করুন, অথবা “একটি ফোল্ডার পিন করুন…” চাপ দিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Keine angepinnten Ordner. Pinne unten einen zuletzt verwendeten Ordner an oder drücke „Ordner anpinnen…“"
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Δεν υπάρχουν καρφιτσωμένοι φάκελοι. Καρφιτσώστε έναν πρόσφατο φάκελο παρακάτω ή πατήστε «Καρφίτσωμα φακέλου…»"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No pinned folders. Pin a recent folder below, or press Pin a Folder…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No hay carpetas fijadas. Fija una carpeta reciente de abajo o pulsa «Fijar una carpeta…»"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "هیچ پوشه‌ای سنجاق نشده است. یکی از پوشه‌های اخیر زیر را سنجاق کنید، یا «سنجاق کردن یک پوشه…» را بزنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aucun dossier épinglé. Épinglez un dossier récent ci-dessous, ou appuyez sur Épingler un dossier…"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "אין תיקיות מוצמדות. ניתן להצמיד תיקיה אחרונה מהרשימה שלמטה, או ללחוץ על ״הצמדת תיקיה…״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कोई पिन किया गया फ़ोल्डर नहीं है। नीचे से कोई हाल का फ़ोल्डर पिन करें, या “फ़ोल्डर पिन करें…” बटन दबाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Belum ada folder yang disematkan. Sematkan folder terbaru di bawah, atau tekan Sematkan Folder…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nessuna cartella fissata. Fissa una cartella recente qui sotto, oppure premi Fissa una cartella…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "固定したフォルダはありません。下の最近使ったフォルダを固定するか、「フォルダを固定…」を押してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "고정된 폴더가 없습니다. 아래의 최근 폴더를 고정하거나 “폴더 고정…”을 누르십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "पिन केलेले फोल्डर नाहीत. खालील एखादा अलीकडील फोल्डर पिन करा, किंवा “फोल्डर पिन करा…” दाबा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tiada folder dipin. Pinkan folder terbaharu di bawah, atau tekan Pinkan Folder…"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Geen vastgemaakte mappen. Maak hieronder een recente map vast, of klik op „Maak map vast…”"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Brak przypiętych folderów. Przypnij poniżej jeden z ostatnich folderów albo kliknij w Przypnij folder…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nenhuma pasta fixada. Fixe uma pasta recente abaixo ou clique em Fixar Pasta…"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Niciun dosar fixat. Fixați mai jos un dosar recent sau faceți clic pe Fixați un dosar…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Закрепленных папок нет. Закрепите одну из недавних папок ниже или нажмите «Закрепить папку…»"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "பின் செய்யப்பட்ட கோப்புறைகள் எதுவும் இல்லை. கீழே உள்ள சமீபத்திய கோப்புறை ஒன்றைப் பின் செய்யுங்கள், அல்லது “ஒரு கோப்புறையைப் பின் செய்…” பொத்தானை அழுத்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "needs_review",
            "value": "పిన్ చేసిన ఫోల్డర్లు ఏవీ లేవు. కింద ఉన్న ఇటీవలి ఫోల్డర్‌ను పిన్ చేయండి, లేదా “ఫోల్డర్‌ను పిన్ చేయండి…” బటన్‌ను నొక్కండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ยังไม่มีโฟลเดอร์ที่ปักหมุดไว้ ปักหมุดโฟลเดอร์ล่าสุดด้านล่าง หรือกดปุ่ม “ปักหมุดโฟลเดอร์…”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sabitlenmiş klasör yok. Aşağıdan son kullanılan bir klasörü sabitleyin veya Klasör Sabitle… düğmesine basın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Закріплених папок немає. Закріпіть одну з останніх папок нижче або натисніть «Закріпити папку…»"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "کوئی پن کیا ہوا فولڈر نہیں ہے۔ نیچے سے کوئی حالیہ فولڈر پن کریں، یا “فولڈر پن کریں…” دبائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chưa có thư mục nào được ghim. Hãy ghim một thư mục gần đây bên dưới, hoặc nhấn Ghim thư mục…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "没有已固定的文件夹。请固定下方的一个最近的文件夹，或点按“固定文件夹…”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "沒有已釘選的檔案夾。請釘選下方的一個最近的檔案夾，或按一下「釘選檔案夾…」。"
          }
        }
      }
    },
    "app.noRecents": {
      "comment": "Text shown when the list of recent folders is empty.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا توجد مجلدات حديثة حتى الآن. يعرض Right Here المجلدات التي أرسلها إلى جهة ما."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এখনো কোনো সাম্প্রতিক ফোল্ডার নেই। Right Here সেই ফোল্ডারগুলো তালিকায় দেখায়, যেগুলো এটি কোথাও পাঠিয়েছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Noch keine zuletzt verwendeten Ordner. Right Here listet die Ordner auf, die es irgendwohin gesendet hat."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Δεν υπάρχουν ακόμη πρόσφατοι φάκελοι. Το Right Here εμφανίζει τους φακέλους που έχει στείλει κάπου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No recent folders yet. Right Here lists the folders it has sent somewhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Todavía no hay carpetas recientes. Right Here muestra las carpetas que ha enviado a algún destino."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "هنوز پوشهٔ اخیری وجود ندارد. Right Here پوشه‌هایی را فهرست می‌کند که جایی فرستاده است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aucun dossier récent pour l’instant. Right Here affiche les dossiers qu’il a envoyés quelque part."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "אין עדיין תיקיות אחרונות. Right Here מציג את התיקיות שהוא שלח למקום כלשהו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अभी तक कोई हाल का फ़ोल्डर नहीं है। Right Here उन फ़ोल्डरों की सूची दिखाता है जिन्हें उसने कहीं भेजा है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Belum ada folder terbaru. Right Here menampilkan folder yang pernah dikirimnya ke suatu tempat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nessuna cartella recente per ora. Right Here elenca le cartelle che ha inviato a un’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "最近使ったフォルダはまだありません。Right Here が送信したフォルダが一覧に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "최근 폴더가 아직 없습니다. Right Here는 보냈던 폴더를 여기에 나열합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अलीकडील फोल्डर अद्याप नाहीत. Right Here ने कुठेतरी पाठवलेले फोल्डर इथे सूचीबद्ध केले जातात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Belum ada folder terbaharu. Right Here menyenaraikan folder yang telah dihantarnya ke suatu tempat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nog geen recente mappen. Right Here toont de mappen die het ergens naartoe heeft gestuurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie ma jeszcze ostatnich folderów. Right Here wyświetla foldery, które zostały gdzieś wysłane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ainda não há pastas recentes. O Right Here lista as pastas que já enviou para algum lugar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Încă nu există dosare recente. Right Here afișează dosarele pe care le-a trimis undeva."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Недавних папок пока нет. Right Here показывает папки, которые были отправлены куда-либо."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இன்னும் சமீபத்திய கோப்புறைகள் இல்லை. Right Here எங்கோ அனுப்பிய கோப்புறைகளைப் பட்டியலிடுகிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ఇంకా ఇటీవలి ఫోల్డర్లు లేవు. Right Here ఎక్కడికో పంపిన ఫోల్డర్లను జాబితా చేస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ยังไม่มีโฟลเดอร์ล่าสุด Right Here แสดงรายการโฟลเดอร์ที่เคยส่งไปยังที่ใดที่หนึ่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Henüz son kullanılan klasör yok. Right Here, bir yere gönderdiği klasörleri listeler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Останніх папок ще немає. Right Here показує папки, які було надіслано кудись."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ابھی تک کوئی حالیہ فولڈر نہیں ہے۔ Right Here ان فولڈرز کی فہرست دکھاتا ہے جنہیں اس نے کہیں بھیجا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chưa có thư mục gần đây nào. Right Here sẽ liệt kê các thư mục mà nó đã gửi đi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "还没有最近的文件夹。Right Here 会列出它曾经发送过的文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "尚無最近的檔案夾。Right Here 會列出它曾經傳送過的檔案夾。"
          }
        }
      }
    },
