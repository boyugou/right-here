    "doctor.fix.agentLauncher": {
      "comment": "Fix line under a check in the setup window's Details list: what the person should do. A sentence. general.terminal and launcher = \"link\" or \"desktop\" are config text: keep them exactly (translate only the word or).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اختر طرفية أخرى باستخدام general.terminal، أو اضبط launcher = \"link\" أو \"desktop\"."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "general.terminal দিয়ে অন্য একটি টার্মিনাল বেছে নিন, অথবা launcher = \"link\" বা \"desktop\" সেট করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wählen Sie mit general.terminal ein anderes Terminal, oder setzen Sie launcher = \"link\" oder \"desktop\"."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Επιλέξτε άλλο τερματικό με το general.terminal ή ορίστε launcher = \"link\" ή \"desktop\"."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose another terminal with general.terminal, or set launcher = \"link\" or \"desktop\"."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elija otra terminal con general.terminal o defina launcher = \"link\" o \"desktop\"."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "با general.terminal ترمینال دیگری انتخاب کنید، یا launcher = \"link\" یا \"desktop\" را تنظیم کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
