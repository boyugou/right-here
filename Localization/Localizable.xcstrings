    "app.fixAgentRemoveWindow": {
      "comment": "Checks page: an agent in the menu whose command is not found. 'it' = the agent. 'Agents' = app.tabAgents. Window form of doctor.fix.agentRemove.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ثبّته، أو ألغِ تحديده في صفحة «الوكلاء»."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এটি ইনস্টল করুন, অথবা “এজেন্ট” পৃষ্ঠায় এর টিক তুলে দিন।"
          }
        },
        "de": {
          "stringUnit": {
