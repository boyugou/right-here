            "state": "translated",
            "value": "Install it, or change general.editor (remove the setting to use the first installed editor)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instálalo, o cambia general.editor (quita el ajuste para usar el primer editor instalado)."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آن را نصب کنید، یا general.editor را تغییر دهید (برای استفاده از اولین ویرایشگر نصب‌شده، این تنظیم را حذف کنید)."
          }
        },
        "fr": {
