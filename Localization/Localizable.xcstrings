    "app.quickActionsInexactNote": {
      "comment": "Gray caption above the list of Quick Actions, shown only when the config file writes the list in an unusual way (for example an action that does not exist). Same wording and structure as the existing glossary entry app.agentArgumentsInexactNote, with 'The Quick Actions' instead of 'The arguments'. 'Quick Actions' is the macOS name (glossary entry app.quickActionsHeading). 'The Config page' is a section of the app (glossary entry app.tabConfig).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "كُتبت الإجراءات السريعة في ملف الإعداد بطريقة لا تسمح لهذه القائمة بتغييرها واحدةً تلو الأخرى. عدِّلها كنص في صفحة ملف الإعداد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quick Actions কনফিগারেশন ফাইলে এমনভাবে লেখা আছে যে এই তালিকা সেগুলো একটি একটি করে বদলাতে পারে না। কনফিগ পৃষ্ঠায় টেক্সট হিসেবে সেগুলো বদলান।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Schnellaktionen sind so in deiner Konfigurationsdatei geschrieben, dass diese Liste sie nicht einzeln ändern kann. Ändere sie als Text auf der Seite „Konfiguration“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Οι Γρήγορες ενέργειες είναι γραμμένες στο αρχείο ρυθμίσεων με τρόπο που αυτή η λίστα δεν μπορεί να τις αλλάξει μία μία. Αλλάξτε τις ως κείμενο στη σελίδα «Ρυθμίσεις»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Quick Actions are written in your config file in a way this list cannot change one by one. Change them as text on the Config page."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las Acciones rápidas están escritas en tu archivo de configuración de una forma que esta lista no puede cambiar una por una. Cámbialas como texto en la página Configuración."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "در فایل پیکربندی شما، Quick Actions به شکلی نوشته شده‌اند که این فهرست نمی‌تواند آن‌ها را یکی‌یکی تغییر دهد. آن‌ها را به‌صورت متن در صفحهٔ پیکربندی تغییر دهید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les Actions rapides sont écrites dans votre fichier de configuration d’une façon qui ne permet pas à cette liste de les modifier une par une. Modifiez-les sous forme de texte dans la page Configuration."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "הפעולות המהירות כתובות בקובץ התצורה באופן שרשימה זו לא יכולה לשנות כל אחת מהן בנפרד. יש לשנות אותן כטקסט בעמוד ״תצורה״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "त्वरित क्रियाएँ आपकी कॉन्फ़िगरेशन फ़ाइल में इस तरह लिखी गई हैं कि यह सूची उन्हें एक-एक करके नहीं बदल सकती। उन्हें कॉन्फ़िग पेज पर टेक्स्ट के रूप में बदलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tindakan Cepat ditulis di file konfigurasi Anda dengan cara yang tidak dapat diubah satu per satu oleh daftar ini. Ubahlah sebagai teks di halaman Konfigurasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le Azioni rapide sono scritte nel file di configurazione in un modo che questo elenco non può modificare una alla volta. Modificale come testo nella pagina Configurazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "クイックアクションは、この一覧では一つずつ変更できない形で設定ファイルに書かれています。設定ページでテキストとして変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "빠른 동작은 이 목록에서 한 개씩 바꿀 수 없는 방식으로 설정 파일에 적혀 있습니다. 설정 페이지에서 텍스트로 바꾸십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quick Actions कॉन्फिगरेशन फाइलमध्ये अशा प्रकारे लिहिलेले आहेत की ही यादी त्यांना एकेक करून बदलू शकत नाही. कॉन्फिग पृष्ठावर मजकूर म्हणून ते बदला."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tindakan Cepat ditulis dalam fail konfigurasi anda dengan cara yang senarai ini tidak dapat mengubahnya satu demi satu. Ubahlah sebagai teks pada halaman Konfigurasi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De snelle taken staan in het configuratiebestand op een manier die deze lijst niet één voor één kan wijzigen. Wijzig ze als tekst op de pagina Configuratie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Szybkie czynności są zapisane w pliku konfiguracji w taki sposób, że nie można ich zmieniać pojedynczo na tej liście. Zmień je jako tekst na stronie Konfiguracja."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As Ações Rápidas estão escritas no arquivo de configuração de uma forma que esta lista não consegue alterar uma por uma. Altere-as como texto na página Configuração."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Acțiunile rapide sunt scrise în fișierul de configurare într-un mod în care această listă nu le poate modifica una câte una. Modificați-le ca text pe pagina Configurație."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Быстрые действия записаны в файле конфигурации таким образом, что этот список не может изменять их по одному. Измените их в виде текста на странице «Конфигурация»."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quick Actions உங்கள் உள்ளமைவுக் கோப்பில், இந்தப் பட்டியலால் ஒவ்வொன்றாக மாற்ற முடியாத விதத்தில் எழுதப்பட்டுள்ளன. உரையாக, உள்ளமைவுப் பக்கத்தில் அவற்றை மாற்றவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quick Actions మీ కాన్ఫిగరేషన్ ఫైల్‌లో ఈ జాబితా ఒక్కొక్కటిగా మార్చలేని విధంగా రాయబడ్డాయి. కాన్ఫిగరేషన్ పేజీలో వాటిని టెక్స్ట్‌గా మార్చండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การทำงานด่วนถูกเขียนไว้ในไฟล์การกำหนดค่าของคุณในลักษณะที่รายการนี้ไม่สามารถเปลี่ยนทีละรายการได้ แก้ไขเป็นข้อความในหน้าการกำหนดค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hızlı Eylemler yapılandırma dosyanızda, bu listenin tek tek değiştiremeyeceği bir biçimde yazılmış. Bunları Yapılandırma sayfasında metin olarak değiştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Швидкі дії записані у вашому файлі конфігурації так, що цей список не може змінювати їх по одній. Змініть їх у вигляді тексту на сторінці «Конфігурація»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "‏Quick Actions آپ کی کنفیگریشن فائل میں اس طرح لکھے گئے ہیں کہ یہ فہرست انہیں ایک ایک کر کے تبدیل نہیں کر سکتی۔ انہیں کنفیگ صفحے پر متن کے طور پر تبدیل کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Các Tác vụ nhanh được viết trong tệp cấu hình của bạn theo cách danh sách này không thể thay đổi từng cái một. Chỉnh sửa chúng dưới dạng văn bản trên trang Cấu hình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "配置文件中快速操作的写法使此列表无法逐个更改它们。请在“配置”页面以文本形式更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "設定檔中快速動作的寫法讓這份清單無法逐一變更。請在「設定檔」頁面以文字形式變更。"
          }
        }
      }
    },
