    "app.proposalsWaiting": {
      "comment": "Sentence on the Overview page of the setup window when an AI assistant has proposed changes to the config that need the person's decision.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اقترح مساعد ذكاء اصطناعي تغييرات تنتظر قرارك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি AI সহকারী কিছু পরিবর্তনের প্রস্তাব করেছে, যেগুলো আপনার সিদ্ধান্তের অপেক্ষায় আছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein KI-Assistent hat Änderungen vorgeschlagen, die auf deine Entscheidung warten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένας βοηθός AI πρότεινε αλλαγές που περιμένουν την απόφασή σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An AI assistant proposed changes that are waiting for you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un asistente de IA ha propuesto cambios que esperan tu decisión."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک دستیار هوش مصنوعی تغییراتی پیشنهاد کرده که منتظر تصمیم شماست."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un assistant IA a proposé des modifications qui attendent votre décision."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עוזר AI הציע שינויים שממתינים להחלטה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक AI असिस्टेंट ने कुछ बदलावों का सुझाव दिया है, जो आपके फ़ैसले का इंतज़ार कर रहे हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Asisten AI mengusulkan perubahan yang menunggu keputusan Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un assistente IA ha proposto modifiche che attendono la tua decisione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIアシスタントから、確認を待っている変更の提案があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 어시스턴트가 제안한 변경 사항이 확인을 기다리고 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI असिस्टंटने सुचवलेले बदल तुमच्या निर्णयासाठी थांबले आहेत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembantu AI telah mencadangkan perubahan yang menunggu keputusan anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een AI-assistent heeft wijzigingen voorgesteld die op een beslissing wachten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Asystent AI zaproponował zmiany, które czekają na decyzję."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um assistente de IA propôs alterações que aguardam sua decisão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un asistent AI a propus modificări care așteaptă o decizie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ИИ-ассистент предложил изменения, которые ждут Вашего решения."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் முடிவுக்காகக் காத்திருக்கும் மாற்றங்களை AI உதவியாளர் பரிந்துரைத்துள்ளார்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "AI సహాయకుడు మీ నిర్ణయం కోసం వేచి ఉన్న మార్పులను ప్రతిపాదించారు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้ช่วย AI เสนอการเปลี่ยนแปลงที่รอให้คุณตัดสินใจ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir YZ asistanı, sizin kararınızı bekleyen değişiklikler önerdi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "ШІ-асистент запропонував зміни, які чекають на ваше рішення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک AI اسسٹنٹ نے کچھ تبدیلیاں تجویز کی ہیں جو آپ کی منظوری کی منتظر ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trợ lý AI đã đề xuất một số thay đổi đang chờ bạn quyết định."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 助手提出了一些更改，正等待你确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 助理提出了一些變更，正等待你確認。"
          }
        }
      }
    },
    "app.quickActionRemoveItem": {
      "comment": "Accessibility label and tooltip of the check box of a line of the Quick Actions list, and the item of its context menu: it takes the action out of the Quick Actions. %1$@ is the title of the action, for example 'Open in Ghostty'. Same pattern as the glossary entry app.menuRemoveItem ('Remove %@ from the menu'). 'Quick Actions' is the macOS name (glossary entry app.quickActionsHeading). Keep the quotation marks of the language around the title.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إزالة «%1$@» من الإجراءات السريعة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Quick Actions থেকে “%1$@” সরান"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ aus den Schnellaktionen entfernen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφαίρεση «%1$@» από τις Γρήγορες ενέργειες"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove “%1$@” from the Quick Actions"
          }
        },
        "es": {
