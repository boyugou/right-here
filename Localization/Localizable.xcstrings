    "refusal.notATerminal": {
      "comment": "Why an action did nothing, shown in the alert after a click in Finder (and, in English, by the command line). %1$@ is an app name, %2$@ an action id.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%1$@ ليس وحدة طرفية. استخدم %2$@ لفتح الملفات به."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ কোনো টার্মিনাল নয়। এটি দিয়ে ফাইল খুলতে %2$@ ব্যবহার করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ist kein Terminal. Nutze %2$@, um Dateien damit zu öffnen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %1$@ δεν είναι τερματικό. Χρησιμοποιήστε το %2$@ για να ανοίξετε αρχεία με αυτό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is not a terminal. Use %2$@ to open files with it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ no es una terminal. Usa %2$@ para abrir archivos con esa app."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%1$@ ترمینال نیست. برای باز کردن فایل‌ها با آن از %2$@ استفاده کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ n’est pas un terminal. Utilisez %2$@ pour ouvrir des fichiers avec cette app."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%1$@ אינו מסוף. כדי לפתוח בו קבצים יש להשתמש ב-%2$@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ टर्मिनल नहीं है। इससे फ़ाइलें खोलने के लिए %2$@ इस्तेमाल करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ bukan terminal. Gunakan %2$@ untuk membuka file dengan app tersebut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ non è un terminale. Usa %2$@ per aprire dei file con questa app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@はターミナルではありません。このアプリでファイルを開くには%2$@を使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 앱은 터미널이 아닙니다. 이 앱으로 파일을 열려면 %2$@ 동작을 사용하십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ हे टर्मिनल नाही. त्यासह फाइल उघडण्यासाठी %2$@ वापरा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ bukan terminal. Gunakan %2$@ untuk membuka fail dengannya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is geen terminal. Gebruik %2$@ om er bestanden mee te openen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja %1$@ nie jest terminalem. Aby otwierać nią pliki, użyj czynności %2$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O %1$@ não é um terminal. Use %2$@ para abrir arquivos com ele."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ nu este un terminal. Folosiți %2$@ pentru a deschide fișiere cu el."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение «%1$@» не является терминалом. Чтобы открывать в нем файлы, используйте действие %2$@."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ஒரு டெர்மினல் அல்ல. அதன் மூலம் கோப்புகளைத் திறக்க %2$@ ஐப் பயன்படுத்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ టెర్మినల్ కాదు. దానితో ఫైళ్లను తెరవడానికి %2$@ ను ఉపయోగించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ไม่ใช่เทอร์มินัล ใช้ %2$@ เพื่อเปิดไฟล์ด้วยแอปนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ bir terminal değil. Dosyaları onunla açmak için %2$@ eylemini kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — не термінал. Щоб відкрити файли в цій програмі, використайте дію %2$@."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%1$@ ٹرمینل نہیں ہے۔ اس سے فائلیں کھولنے کے لیے %2$@ استعمال کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ không phải là terminal. Hãy dùng %2$@ để mở tệp bằng ứng dụng này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 不是终端。要用它打开文件，请使用 %2$@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 不是終端機。若要用它開啟檔案，請使用 %2$@。"
          }
        }
      }
    },
