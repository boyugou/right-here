    "app.agentVariantsCaption": {
      "comment": "Caption under the heading 'Start Options'. 'More Agent Options' is the title of that Finder submenu: use its existing translation (glossary group.moreAgents).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
