        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ కాన్ఫిగరేషన్ ఫైల్‌ను ఉపయోగించలేము: %2$@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ไฟล์การกำหนดค่า %1$@ ไม่ได้: %2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ yapılandırma dosyası kullanılamıyor: %2$@"
          }
        },
        "uk": {
