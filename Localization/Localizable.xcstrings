    "doctor.sync.commandsMore": {
      "comment": "Extra line under a check in the setup window's Details list; it adds to the detail line above it, which lists the first few settings of a config: this says how many more there are that the detail does not list. %@ is a number.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
