    "app.settingsNeedValidConfig": {
      "comment": "Said on the Agents page and on the Overview page when the settings file has an error and so the controls are off. 'Config page' is the section named by the glossary entry app.tabConfig.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتوي ملف الإعداد على خطأ، لذلك لا يمكن تغييره هنا. أصلِحه أولًا في صفحة ملف الإعداد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কনফিগারেশন ফাইলে একটি ত্রুটি আছে, তাই এখান থেকে সেটি বদলানো যাবে না। প্রথমে কনফিগ পৃষ্ঠায় এটি ঠিক করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Konfigurationsdatei enthält einen Fehler, daher lässt sie sich hier nicht ändern. Behebe ihn zuerst auf der Seite „Konfiguration“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το αρχείο ρυθμίσεων έχει ένα σφάλμα, γι’ αυτό δεν μπορεί να αλλαχθεί εδώ. Διορθώστε το πρώτα στη σελίδα «Ρυθμίσεις»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The config has an error, so it cannot be changed here. Fix it on the Config page first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo de configuración tiene un error, así que no se puede cambiar aquí. Primero corrígelo en la página Configuración."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فایل پیکربندی خطا دارد، پس اینجا نمی‌توان آن را تغییر داد. ابتدا آن را در صفحهٔ پیکربندی برطرف کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier de configuration contient une erreur : il ne peut donc pas être modifié ici. Corrigez-la d’abord dans la page Configuration."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בקובץ התצורה יש שגיאה, ולכן לא ניתן לשנות אותו כאן. יש לתקן אותה תחילה בעמוד ״תצורה״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कॉन्फ़िगरेशन फ़ाइल में एक एरर है, इसलिए इसे यहाँ नहीं बदला जा सकता। पहले इसे कॉन्फ़िग पेज पर ठीक करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File konfigurasi memiliki kesalahan, sehingga tidak bisa diubah di sini. Perbaiki dulu di halaman Konfigurasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file di configurazione contiene un errore, quindi qui non si può modificare. Correggilo prima nella pagina Configurazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定ファイルにエラーがあるため、ここでは変更できません。先に「設定」ページで修正してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 파일에 오류가 있어 여기서 변경할 수 없습니다. 먼저 설정 페이지에서 오류를 수정하십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कॉन्फिगरेशन फाइलमध्ये एक त्रुटी आहे, त्यामुळे इथे ती बदलता येत नाही. आधी कॉन्फिग पृष्ठावर ती दुरुस्त करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fail konfigurasi mempunyai ralat, jadi ia tidak boleh diubah di sini. Betulkannya dahulu pada halaman Konfigurasi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De configuratie bevat een fout, daarom kan er hier niets worden gewijzigd. Herstel eerst de fout op de pagina Configuratie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfiguracja zawiera błąd, dlatego nie można jej tutaj zmienić. Najpierw napraw błąd na stronie Konfiguracja."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A configuração tem um erro, então ela não pode ser alterada aqui. Corrija o erro na página Configuração primeiro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurația are o eroare, așa că nu poate fi modificată aici. Mai întâi corectați eroarea de pe pagina Configurație."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В конфигурации есть ошибка, поэтому ее нельзя изменить здесь. Сначала исправьте ошибку на странице «Конфигурация»."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உள்ளமைவுக் கோப்பில் பிழை உள்ளது, எனவே இங்கே அதை மாற்ற முடியாது. முதலில் உள்ளமைவுப் பக்கத்தில் அதைச் சரிசெய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కాన్ఫిగరేషన్ ఫైల్‌లో లోపం ఉంది, కాబట్టి దీనిని ఇక్కడ మార్చడం సాధ్యం కాదు. ముందుగా కాన్ఫిగరేషన్ పేజీలో దానిని సరిచేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์การกำหนดค่ามีข้อผิดพลาด จึงเปลี่ยนแปลงที่นี่ไม่ได้ โปรดแก้ไขในหน้าการกำหนดค่าก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapılandırma dosyanızda bir hata var, bu yüzden burada değiştirilemez. Önce Yapılandırma sayfasında düzeltin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У файлі конфігурації є помилка, тому його не можна змінити тут. Спочатку виправте її на сторінці «Конфігурація»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کنفیگریشن فائل میں ایک خرابی ہے، اس لیے اسے یہاں تبدیل نہیں کیا جا سکتا۔ پہلے اسے کنفیگ صفحے پر درست کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp cấu hình có lỗi, nên không thể thay đổi ở đây. Hãy sửa lỗi trên trang Cấu hình trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置文件有错误，因此无法在此处更改。请先在“配置”页面中修正。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定檔有錯誤，因此無法在此處變更。請先在「設定檔」頁面中修正。"
          }
        }
      }
    },
