    "doctor.app.fallback": {
      "comment": "Detail line of the check \"Default terminal\" or \"Default editor\" in the setup window's Details list: the app the config chooses is not installed on this Mac, so another app of the same kind is used. %1$@ is the app the config chooses (for example iTerm), %2$@ the app used instead (for example Ghostty). A sentence with a final period.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏التطبيق %1$@ غير مثبَّت؛ يُستخدم %2$@ بدلًا منه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ইনস্টল করা নেই; তার বদলে %2$@ ব্যবহার করা হয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ist nicht installiert; stattdessen wird %2$@ verwendet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %1$@ δεν είναι εγκατεστημένο· χρησιμοποιείται το %2$@ στη θέση του."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is not installed; %2$@ is used instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app %1$@ no está instalada; se usa %2$@ en su lugar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%1$@ نصب نشده است؛ به‌جای آن از %2$@ استفاده می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app %1$@ n’est pas installée ; Right Here utilise %2$@ à la place."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%1$@ לא מותקן; במקומו נעשה שימוש ב-%2$@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ इंस्टॉल नहीं है; उसकी जगह %2$@ इस्तेमाल होता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tidak diinstal; %2$@ digunakan sebagai gantinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app %1$@ non è installata; viene usata invece l’app %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ はインストールされていないため、代わりに %2$@ が使われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 앱이 설치되어 있지 않아 대신 %2$@ 앱을 사용합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ इन्स्टॉल नाही; त्याऐवजी %2$@ वापरले जाते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tidak dipasang; %2$@ digunakan sebagai gantinya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is niet geïnstalleerd; %2$@ wordt in plaats daarvan gebruikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja %1$@ nie jest zainstalowana; zamiast niej używana jest aplikacja %2$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app %1$@ não está instalado; em vez dele, é usado o app %2$@."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicația %1$@ nu este instalată; în locul ei este folosită aplicația %2$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение «%1$@» не установлено; вместо него используется «%2$@»."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ நிறுவப்படவில்லை; அதற்குப் பதிலாக %2$@ பயன்படுத்தப்படுகிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ఇన్‌స్టాల్ చేయబడలేదు; బదులుగా %2$@ ఉపయోగించబడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้ติดตั้ง %1$@ จึงใช้ %2$@ แทน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ yüklü değil; bunun yerine %2$@ kullanılıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Програму «%1$@» не інстальовано; натомість використовується «%2$@»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%1$@ انسٹال نہیں ہے؛ اس کی جگہ %2$@ استعمال ہوتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ chưa được cài đặt; thay vào đó đang dùng %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 未安装；改用 %2$@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 未安裝；改用 %2$@。"
          }
        }
      }
