    "app.setupBody": {
      "comment": "Text under app.setupTitle. 'config file' is translated as in app.checkConfig and app.openConfig.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اختر ما تستخدمه. يُنشئ Right Here ملف الإعداد بناءً على اختياراتك ويربط فايندر. يمكنك تغيير كل ذلك لاحقًا في هذه النافذة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনি যা ব্যবহার করেন তা বেছে নিন। সেই পছন্দ থেকে Right Here আপনার কনফিগারেশন ফাইল তৈরি করে এবং Finder-এর সঙ্গে সংযুক্ত করে। পরে এই উইন্ডোতেই আপনি এর সবকিছু বদলাতে পারবেন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wähle aus, was du verwendest. Right Here erstellt daraus deine Konfigurationsdatei und verbindet sich mit dem Finder. Du kannst später alles davon in diesem Fenster ändern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Επιλέξτε όσα χρησιμοποιείτε. Το Right Here δημιουργεί από αυτά το αρχείο ρυθμίσεων και συνδέει το Finder. Μπορείτε να τα αλλάξετε όλα αργότερα σε αυτό το παράθυρο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose what you use. Right Here writes your config file from it and connects Finder. You can change all of it later in this window."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elige lo que usas. Right Here crea tu archivo de configuración con esas opciones y conecta el Finder. Puedes cambiarlo todo más adelante en esta ventana."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ابزارهایی را که از آن‌ها استفاده می‌کنید انتخاب کنید. Right Here فایل پیکربندی را بر اساس آن می‌نویسد و به Finder وصل می‌شود. بعداً می‌توانید همهٔ این‌ها را در همین پنجره تغییر دهید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Choisissez ce que vous utilisez. Right Here crée votre fichier de configuration à partir de ces choix et se connecte au Finder. Vous pourrez tout changer plus tard dans cette fenêtre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "יש לבחור את הכלים שבהם נעשה שימוש. לפי הבחירה, Right Here כותב את קובץ התצורה ומתחבר ל-Finder. ניתן לשנות הכול מאוחר יותר בחלון זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आप जो इस्तेमाल करते हैं, वह चुनें। Right Here उन चुनावों से कॉन्फ़िगरेशन फ़ाइल बनाता है और Finder से जुड़ जाता है। बाद में आप यह सब इसी विंडो में बदल सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pilih yang Anda gunakan. Right Here membuat file konfigurasi dari pilihan Anda dan terhubung ke Finder. Nanti Anda dapat mengubah semuanya di jendela ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scegli ciò che usi. Right Here crea con queste scelte il file di configurazione e collega il Finder. Puoi cambiare tutto in seguito in questa finestra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "使うものを選んでください。Right Here は選んだ内容で設定ファイルを作成し、Finder と連携します。あとからこのウインドウですべて変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "사용하는 항목을 선택하십시오. Right Here가 선택한 내용으로 설정 파일을 만들고 Finder에 연결합니다. 나중에 이 윈도우에서 모두 변경할 수 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुम्ही वापरता ते निवडा. तुमच्या निवडींवरून Right Here कॉन्फिगरेशन फाइल तयार करतो आणि Finder ला जोडतो. नंतर तुम्ही हे सर्व याच विंडोमध्ये बदलू शकता."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pilih apa yang anda gunakan. Right Here mencipta fail konfigurasi berdasarkan pilihan anda dan menyambungkan Finder. Anda boleh menukar semuanya kemudian dalam tetingkap ini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kies wat je gebruikt. Right Here maakt daarmee je configuratiebestand en koppelt de app aan Finder. Je kunt dit later allemaal in dit venster wijzigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wybierz, czego używasz. Right Here zapisze na tej podstawie plik konfiguracji i włączy integrację z Finderem. Wszystko to możesz później zmienić w tym oknie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escolha o que você usa. O Right Here cria o arquivo de configuração com base nisso e ativa a integração com o Finder. Você pode alterar tudo isso depois nesta janela."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alegeți ce folosiți. Right Here creează fișierul de configurare pe baza acestor alegeri și activează integrarea cu Finder. Puteți schimba totul mai târziu în această fereastră."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Выберите, чем Вы пользуетесь. Right Here создаст по Вашему выбору файл конфигурации и подключит Finder. Все это можно позже изменить в этом окне."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "நீங்கள் பயன்படுத்துவதைத் தேர்ந்தெடுக்கவும். அதிலிருந்து Right Here உங்கள் உள்ளமைவுக் கோப்பை எழுதி, Finder-உடன் இணைக்கும். பின்னர் இவை அனைத்தையும் இந்தச் சாளரத்திலேயே மாற்றலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "needs_review",
            "value": "మీరు ఉపయోగించేవి ఎంచుకోండి. దాని ఆధారంగా Right Here మీ కాన్ఫిగరేషన్ ఫైల్‌ను రాసి, Finder ను కనెక్ట్ చేస్తుంది. తర్వాత వీటన్నింటినీ ఈ విండోలోనే మార్చుకోవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เลือกสิ่งที่คุณใช้ Right Here จะสร้างไฟล์การกำหนดค่าจากตัวเลือกเหล่านั้นและเชื่อมต่อกับ Finder คุณเปลี่ยนทั้งหมดนี้ภายหลังได้ในหน้าต่างนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kullandıklarınızı seçin. Right Here, yapılandırma dosyanızı bu seçimlere göre oluşturur ve Finder ile bağlantı kurar. Bunların hepsini daha sonra bu pencereden değiştirebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Оберіть те, чим користуєтеся. Right Here створить файл конфігурації на основі вибору і підключить Finder. Згодом усе це можна змінити в цьому вікні."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "آپ جو استعمال کرتے ہیں، وہ منتخب کریں۔ Right Here اسی کے مطابق آپ کی کنفیگریشن فائل بناتا ہے اور Finder سے جوڑ دیتا ہے۔ بعد میں آپ یہ سب اسی ونڈو میں بدل سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chọn những gì bạn dùng. Right Here sẽ tạo tệp cấu hình từ các lựa chọn này và kết nối với Finder. Sau này, bạn có thể thay đổi tất cả trong cửa sổ này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请选择你使用的工具。Right Here 会据此生成配置文件，并连接访达。之后你可以在这个窗口中更改所有这些设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "請選擇你使用的工具。Right Here 會據此產生設定檔，並連接 Finder。之後你可以在這個視窗中變更所有這些設定。"
          }
        }
      }
    },
