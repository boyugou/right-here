    "doctor.extension.multiple": {
      "comment": "Detail line of a check in the setup window's Details list; it follows the check's title, so it is a fragment with no final period. %1$@ is a number (2 or more) of places the Finder extension is registered from; %2$@ is the list of their paths.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مفعَّل، لكنه مسجَّل من مواقع عددها %1$@: %2$@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চালু আছে, কিন্তু %1$@ স্থান থেকে নিবন্ধিত: %2$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "aktiviert, aber an %1$@ Orten registriert: %2$@"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "ενεργοποιημένη, αλλά καταχωρισμένη από %1$@ τοποθεσίες: %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "enabled, but registered from %1$@ locations: %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "activada, pero registrada desde %1$@ ubicaciones: %2$@"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فعال، اما از %1$@ مکان ثبت شده: %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "activée, mais enregistrée depuis %1$@ emplacements : %2$@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מופעלת, אבל רשומה מ-%1$@ מיקומים: %2$@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सक्षम है, लेकिन %1$@ स्थानों से पंजीकृत है: %2$@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "diaktifkan, tetapi terdaftar dari %1$@ lokasi: %2$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "attivata, ma registrata da %1$@ posizioni: %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効ですが、%1$@ か所から登録されています：%2$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜져 있지만 %1$@곳에서 등록됨: %2$@"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सक्षम, पण नोंदणीची ठिकाणे (%1$@): %2$@"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "didayakan, tetapi didaftarkan dari %1$@ lokasi: %2$@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "ingeschakeld, maar geregistreerd vanaf %1$@ locaties: %2$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "włączone, ale zarejestrowane z lokalizacji (%1$@): %2$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "ativada, mas registrada a partir de %1$@ locais: %2$@"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "activată, dar înregistrată din mai multe locații (%1$@): %2$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "включено, но зарегистрировано из нескольких мест (%1$@): %2$@"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இயக்கப்பட்டுள்ளது, ஆனால் பல இடங்களிலிருந்து பதிவு செய்யப்பட்டுள்ளது (%1$@): %2$@"
