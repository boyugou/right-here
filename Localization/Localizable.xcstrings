    "doctor.fix.agentRemove": {
      "comment": "Fix line under a check in the setup window's Details list: what the person should do. A sentence. %@ is the id of an AI agent, for example claude; general.agents is a config setting: keep it exactly.",
      "extractionState": "manual",
      "localizations": {
