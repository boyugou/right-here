        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Εκτελέστε `rh config validate`· οι προειδοποιήσεις είναι συνήθως τυπογραφικά λάθη, και λείπει αυτό που έπρεπε να οριστεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run `rh config validate`; warnings are usually typos, and what they were meant to set is missing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ejecuta `rh config validate`; las advertencias suelen ser errores tipográficos, y falta lo que se pretendía configurar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "‏`rh config validate` را اجرا کنید؛ هشدارها معمولاً غلط‌های تایپی هستند و مقداری که قرار بوده تنظیم شود، وجود ندارد."
          }
