    "app.presetMaxFilesHelp": {
      "comment": "Caption under the setting 'Most files'. The placeholders {files}, {folder} and {name} are written exactly like that in every language and are never translated.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يُقترح إعداد مسبق يحتوي على {files} عند تحديد عدد من الملفات أكبر من هذا العدد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "যে প্রিসেটে {files} আছে, এর চেয়ে বেশি ফাইল নির্বাচন করলে সেটি দেখানো হয় না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eine Voreinstellung, die {files} enthält, wird nicht angeboten, wenn mehr Dateien ausgewählt sind als hier angegeben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Μια προεπιλογή που περιλαμβάνει το {files} δεν προσφέρεται για επιλογή με περισσότερα αρχεία από αυτόν τον αριθμό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A preset that names {files} is not offered for a selection of more files than this."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un preajuste que incluye {files} no se ofrece si la selección supera este número de archivos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "پیش‌تنظیمی که {files} را دارد، برای انتخابی با بیش از این تعداد فایل پیشنهاد نمی‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un préréglage qui contient {files} n’est pas proposé si la sélection compte plus de fichiers que ce nombre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "הגדרה מוכנה שמכילה {files} אינה מוצעת כשנבחרים יותר קבצים ממספר זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "जो प्रीसेट {files} का उपयोग करता है, उसे इससे अधिक फ़ाइलों वाले चयन के लिए पेश नहीं किया जाता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Preset yang memuat {files} tidak ditawarkan untuk pilihan dengan lebih banyak file daripada jumlah ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un preset che contiene {files} non viene proposto se selezioni più file di così."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{files} を含むプリセットは、この数より多くのファイルを選択しているときには表示されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{files} 항목을 사용하는 프리셋은 이 개수보다 많은 파일을 선택하면 표시되지 않습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{files} असलेला प्रीसेट, या संख्येपेक्षा जास्त फाइली निवडल्यावर सुचवला जात नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Praset yang menyebut {files} tidak ditawarkan untuk pilihan yang mempunyai lebih banyak fail daripada bilangan ini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Een voorinstelling die {files} gebruikt, wordt niet aangeboden voor een selectie van meer bestanden dan dit aantal."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gotowy prompt zawierający {files} nie jest proponowany, gdy zaznaczono więcej plików, niż wynosi ta liczba."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uma predefinição que inclui {files} não é oferecida para uma seleção com mais arquivos do que este número."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O presetare care include {files} nu este oferită pentru o selecție cu mai multe fișiere decât acest număr."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Пресет, в котором указано {files}, не предлагается, если выбрано больше файлов, чем это число."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{files} எனக் குறிப்பிடும் முன்னமைவு, இதைவிட அதிகக் கோப்புகள் தேர்ந்தெடுக்கப்பட்டால் காட்டப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{files} అని పేర్కొనే ప్రీసెట్ దీని కంటే ఎక్కువ ఫైల్‌లు ఎంచుకున్నప్పుడు అందించబడదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "พรีเซ็ตที่ระบุ {files} จะไม่ถูกเสนอเมื่อเลือกไฟล์มากกว่าจำนวนนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{files} ifadesini içeren bir ön ayar, bundan daha fazla dosya seçildiğinde sunulmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Пресет, у якому вказано {files}, не пропонується, якщо вибрано більше файлів, ніж це число."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "وہ پری سیٹ جس میں {files} درج ہو، اس سے زیادہ فائلوں کے انتخاب کے لیے پیش نہیں کیا جاتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mẫu có ghi {files} sẽ không được đề xuất khi chọn nhiều tệp hơn số này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "包含 {files} 的预设不会在所选文件数超过此数量时提供。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "所選檔案超過此數量時，不會提供包含 {files} 的預設組。"
          }
        }
      }
    },
