            "value": "远程仓库“%1$@”位于 %2$@；Right Here 只为 github.com、gitlab.com、codeberg.org 和 bitbucket.org 生成链接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遠端儲存庫「%1$@」位於 %2$@；Right Here 只為 github.com、gitlab.com、codeberg.org 和 bitbucket.org 產生連結。"
          }
        }
      }
    },
    "refusal.repository.unreadableCommit": {
      "comment": "Why an action did nothing, shown in the alert after a click in Finder (and, in English, by the command line).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة الإيداع الحالي للمستودع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রিপোজিটরির চেক-আউট করা কমিটটি পড়া যায়নি।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der ausgecheckte Commit des Repositorys konnte nicht gelesen werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η ανάγνωση του τρέχοντος commit του αποθετηρίου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The checked-out commit of the repository could not be read."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el commit actual del repositorio."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کامیت فعلی مخزن خوانده نشد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le commit extrait du dépôt n’a pas pu être lu."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה לקרוא את ה-commit הנוכחי של המאגר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिपॉज़िटरी का चेक-आउट किया हुआ कमिट पढ़ा नहीं जा सका।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Commit yang sedang di-checkout dari repositori ini tidak dapat dibaca."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile leggere il commit del checkout attuale del repository."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リポジトリのチェックアウト中のコミットを読み取れませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장소의 체크아웃된 커밋을 읽을 수 없습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "रेपॉझिटरीचा चेक आउट केलेला कमिट वाचता आला नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Komit repositori yang di-checkout tidak dapat dibaca."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De uitgecheckte commit van de repository kon niet worden gelezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można odczytać bieżącego commita repozytorium."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o commit em checkout do repositório."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Commitul curent al depozitului nu a putut fi citit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать текущий коммит репозитория."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "repository-இல் checkout செய்யப்பட்ட commit-ஐப் படிக்க முடியவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రిపోజిటరీలో చెక్‌అవుట్ చేసిన కమిట్‌ను చదవడం సాధ్యం కాలేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่าน commit ที่ checkout อยู่ของรีโพซิทอรีไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deponun geçerli commit’i okunamadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося прочитати поточний коміт репозиторію."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ریپازٹری کا چیک آؤٹ شدہ کمٹ نہیں پڑھا جا سکا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể đọc commit đang được checkout của kho git."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取该仓库当前检出的提交。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取該儲存庫目前檢出的提交。"
          }
        }
      }
    },
    "refusal.repository.unreadableRemote": {
      "comment": "Why an action did nothing, shown in the alert after a click in Finder (and, in English, by the command line). %@ is a remote name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عنوان URL للمستودع البعيد «%@» ليس عنوان مستودع على خدمة استضافة git."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রিমোট “%@”-এর URL কোনো git হোস্টের রিপোজিটরির URL নয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die URL des Remotes „%@“ gehört zu keinem Repository auf einem Git-Hosting-Dienst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το URL του απομακρυσμένου αποθετηρίου «%@» δεν είναι URL αποθετηρίου σε υπηρεσία φιλοξενίας git."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The URL of remote \"%@\" is not one of a repository on a git host."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La URL del remoto «%@» no es la de un repositorio en un servicio de alojamiento de git."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نشانی URL مخزن راه‌دور «%@» نشانی مخزنی روی یک میزبان git نیست."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’URL du dépôt distant « %@ » n’est pas celle d’un dépôt sur un hébergeur git."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כתובת ה-URL של המאגר המרוחק ״%@״ אינה כתובת של מאגר בשירות אירוח של git."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिमोट “%@” का URL किसी git होस्ट पर किसी रिपॉज़िटरी का URL नहीं है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "URL remote “%@” bukan URL repositori di layanan hosting git."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’URL del remote “%@” non è quello di un repository su un host git."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモート「%@」のURLは、gitホスト上のリポジトリのURLではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” 리모트의 URL은 git 호스트에 있는 저장소의 URL이 아닙니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "रिमोट “%@” ची URL ही git होस्टवरील रेपॉझिटरीची URL नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "URL remote “%@” bukan URL repositori pada hos git."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De URL van remote „%@” is niet die van een repository op een git-host."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Adres URL zdalnego repozytorium „%@” nie jest adresem repozytorium w serwisie git."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A URL do remote “%@” não é a de um repositório em um host git."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "URL-ul remote-ului „%@” nu este cel al unui depozit de pe o gazdă git."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "URL удаленного репозитория «%@» не является адресом репозитория на git-хостинге."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” என்ற remote-இன் URL, git ஹோஸ்டில் உள்ள ஒரு repository-இன் URL அல்ல."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” రిమోట్ URL, git హోస్ట్‌లోని రిపోజిటరీ URL కాదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "URL ของรีโมต “%@” ไม่ใช่ URL ของรีโพซิทอรีบนโฮสต์ git"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” adlı remote’un URL’si bir git barındırma hizmetindeki bir deponun URL’si değil."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "URL-адреса remote «%@» не є адресою репозиторію на git-хостингу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ریموٹ “%@” کا URL کسی git ہوسٹ پر موجود ریپازٹری کا URL نہیں ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "URL của remote “%@” không phải là URL của một kho git trên dịch vụ lưu trữ git."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远程仓库“%@”的 URL 不是 git 托管平台上某个仓库的地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遠端儲存庫「%@」的 URL 不是 git 代管平台上某個儲存庫的位址。"
          }
        }
      }
    },
    "refusal.repository.wiki": {
      "comment": "Why an action did nothing, shown in the alert after a click in Finder (and, in English, by the command line). %@ is a remote name. The remote is a clone of a repository's wiki (its URL ends in .wiki), whose pages Right Here does not link to. Use the same words for remote and repository as refusal.repository.unreadableRemote.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المستودع البعيد «%@» هو ويكي لمستودع: ينشئ Right Here روابط لملفات المستودع، لا لصفحات الويكي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রিমোট “%@” একটি রিপোজিটরির উইকি: Right Here রিপোজিটরির ফাইলের লিংক তৈরি করে, উইকির পৃষ্ঠার নয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Remote „%@“ ist das Wiki eines Repositorys: Right Here erstellt Links zu den Dateien eines Repositorys, nicht zu den Seiten eines Wikis."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το απομακρυσμένο αποθετήριο «%@» είναι το wiki ενός αποθετηρίου: το Right Here δημιουργεί συνδέσμους προς τα αρχεία ενός αποθετηρίου, όχι προς τις σελίδες ενός wiki."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote \"%@\" is the wiki of a repository: Right Here makes links to the files of a repository, not to the pages of a wiki."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El remoto «%@» es la wiki de un repositorio: Right Here crea enlaces a los archivos de un repositorio, no a las páginas de una wiki."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مخزن راه‌دور «%@» ویکیِ یک مخزن است: Right Here به فایل‌های یک مخزن پیوند می‌سازد، نه به صفحه‌های یک ویکی."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dépôt distant « %@ » est le wiki d’un dépôt : Right Here crée des liens vers les fichiers d’un dépôt, pas vers les pages d’un wiki."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המאגר המרוחק ״%@״ הוא ויקי של מאגר: Right Here יוצר קישורים לקבצים של מאגר, לא לעמודים של ויקי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिमोट “%@” किसी रिपॉज़िटरी का विकी है: Right Here रिपॉज़िटरी की फ़ाइलों के लिंक बनाता है, विकी के पेजों के नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote “%@” adalah wiki sebuah repositori: Right Here membuat tautan ke file repositori, bukan ke halaman wiki."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il remote “%@” è il wiki di un repository: Right Here crea link ai file di un repository, non alle pagine di un wiki."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモート「%@」はリポジトリのWikiです。Right Hereがリンクを作成するのはリポジトリのファイルで、Wikiのページではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” 리모트는 저장소의 위키입니다. Right Here는 저장소의 파일에 대한 링크를 만들며, 위키 페이지에 대한 링크는 만들지 않습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "रिमोट “%@” हे एका रेपॉझिटरीचे विकी आहे: Right Here रेपॉझिटरीमधील फाइलच्या लिंक तयार करतो, विकीच्या पृष्ठांच्या नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote “%@” ialah wiki sebuah repositori: Right Here membuat pautan ke fail repositori, bukan ke halaman wiki."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote „%@” is de wiki van een repository: Right Here maakt links naar de bestanden van een repository, niet naar de pagina’s van een wiki."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdalne repozytorium „%@” jest wiki repozytorium: Right Here tworzy łącza do plików repozytorium, a nie do stron wiki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O remote “%@” é a wiki de um repositório: o Right Here cria links para os arquivos de um repositório, não para as páginas de uma wiki."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote-ul „%@” este wiki-ul unui depozit: Right Here creează linkuri către fișierele unui depozit, nu către paginile unui wiki."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаленный репозиторий «%@» — это вики репозитория: Right Here создает ссылки на файлы репозитория, а не на страницы вики."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” என்ற remote ஒரு repository-இன் விக்கி: Right Here ஒரு repository-இன் கோப்புகளுக்கு இணைப்பு உருவாக்கும், விக்கியின் பக்கங்களுக்கு அல்ல."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” రిమోట్ ఒక రిపోజిటరీ యొక్క వికీ: Right Here రిపోజిటరీలోని ఫైళ్లకు లింక్‌లు చేస్తుంది, వికీ పేజీలకు కాదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รีโมต “%@” เป็นวิกิของรีโพซิทอรี: Right Here สร้างลิงก์ไปยังไฟล์ของรีโพซิทอรี ไม่ใช่หน้าของวิกิ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” adlı remote bir deponun vikisidir: Right Here bir deponun dosyalarına bağlantı oluşturur, bir vikinin sayfalarına değil."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote «%@» — це вікі репозиторію: Right Here створює посилання на файли репозиторію, а не на сторінки вікі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ریموٹ “%@” کسی ریپازٹری کی وکی ہے: Right Here ریپازٹری کی فائلوں کے لنک بناتا ہے، وکی کے صفحات کے نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote “%@” là wiki của một kho git: Right Here tạo liên kết tới các tệp của kho, không tới các trang của wiki."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远程仓库“%@”是某个仓库的 Wiki：Right Here 生成的是仓库中文件的链接，而不是 Wiki 页面的链接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遠端儲存庫「%@」是某個儲存庫的 Wiki：Right Here 產生的是儲存庫中檔案的連結，而不是 Wiki 頁面的連結。"
          }
        }
      }
