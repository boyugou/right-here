{
  "sourceLanguage": "en",
  "strings": {
    "intent.copyPath.description": {
      "comment": "Description of that action.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ينسخ مسار ملف أو مجلد إلى الحافظة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "একটি ফাইল বা ফোল্ডারের পাথ ক্লিপবোর্ডে কপি করে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kopiert den Pfad einer Datei oder eines Ordners in die Zwischenablage."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Αντιγράφει τη διαδρομή ενός αρχείου ή φακέλου στο πρόχειρο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies the path of a file or folder to the clipboard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Copia la ruta de un archivo o carpeta en el portapapeles."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "مسیر یک فایل یا پوشه را در کلیپ‌بورد کپی می‌کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Copie le chemin d'un fichier ou d'un dossier dans le presse-papiers."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "מעתיק את הנתיב של קובץ או תיקייה אל הלוח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "किसी फ़ाइल या फ़ोल्डर का पथ क्लिपबोर्ड पर कॉपी करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Menyalin path file atau folder ke clipboard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Copia negli appunti il percorso di un file o di una cartella."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ファイルまたはフォルダのパスをクリップボードにコピーします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "파일 또는 폴더의 경로를 클립보드에 복사합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "फाइल किंवा फोल्डरचा पाथ क्लिपबोर्डवर कॉपी करते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Menyalin laluan fail atau folder ke papan keratan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kopieert het pad van een bestand of map naar het klembord."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kopiuje ścieżkę pliku lub folderu do schowka."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Copia o caminho de um arquivo ou pasta para a área de transferência."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Copiază calea unui fișier sau dosar în clipboard."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Копирует путь к файлу или папке в буфер обмена."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "கோப்பு அல்லது கோப்புறையின் பாதையை கிளிப்போர்டுக்கு நகலெடுக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ఫైల్ లేదా ఫోల్డర్ పాత్‌ను క్లిప్‌బోర్డ్‌కు కాపీ చేస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "คัดลอกพาธของไฟล์หรือโฟลเดอร์ไปยังคลิปบอร์ด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bir dosyanın veya klasörün yolunu panoya kopyalar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Копіює шлях до файлу або папки в буфер обміну."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "کسی فائل یا فولڈر کا پاتھ کلپ بورڈ پر کاپی کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sao chép đường dẫn của tệp hoặc thư mục vào bảng nhớ tạm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "将文件或文件夹的路径拷贝到剪贴板。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "將檔案或資料夾的路徑拷貝到剪貼簿。"
          }
        }
      }
    },
