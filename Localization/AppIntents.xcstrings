    "intent.newFile.description": {
      "comment": "Description of that action.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ينشئ ملفا جديدا من أحد قوالبك في مجلد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "একটি ফোল্ডারে আপনার একটি টেমপ্লেট থেকে নতুন ফাইল তৈরি করে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Erstellt eine neue Datei aus einer Ihrer Vorlagen in einem Ordner."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Δημιουργεί ένα νέο αρχείο από ένα από τα πρότυπά σας σε έναν φάκελο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creates a new file from one of your templates in a folder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Crea un archivo nuevo a partir de una plantilla en una carpeta."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "از یکی از قالب‌های شما یک فایل جدید در پوشه ایجاد می‌کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Crée un nouveau fichier à partir de l'un de vos modèles, dans un dossier."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "יוצר קובץ חדש מאחת התבניות שלכם בתיקייה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "किसी फ़ोल्डर में आपके टेम्पलेट से नई फ़ाइल बनाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Membuat file baru dari salah satu templat Anda di sebuah folder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Crea un nuovo file da un modello in una cartella."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "フォルダ内にテンプレートから新しいファイルを作成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "폴더에 템플릿으로 새 파일을 만듭니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "फोल्डरमध्ये तुमच्या टेम्पलेटवरून नवीन फाइल तयार करते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mencipta fail baharu daripada salah satu templat anda dalam folder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Maakt een nieuw bestand op basis van een sjabloon in een map."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tworzy nowy plik z wybranego szablonu w folderze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cria um novo arquivo a partir de um dos seus modelos em uma pasta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Creează un fișier nou dintr-unul dintre șabloanele tale, într-un dosar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Создаёт новый файл по одному из ваших шаблонов в папке."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "கோப்புறையில் உங்கள் வார்ப்புருவிலிருந்து புதிய கோப்பை உருவாக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ఫోల్డర్‌లో మీ టెంప్లేట్ నుండి కొత్త ఫైల్‌ను సృష్టిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "สร้างไฟล์ใหม่จากเทมเพลตที่คุณเลือกไว้ในโฟลเดอร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bir klasörde şablonlarınızdan birinden yeni bir dosya oluşturur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Створює новий файл за одним із ваших шаблонів у папці."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ایک فولڈر میں آپ کے ایک ٹیمپلیٹ سے نئی فائل بناتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tạo tệp mới từ một trong các mẫu của bạn trong một thư mục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "根据模板在文件夹中新建文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "依據範本在資料夾中建立新檔案。"
          }
        }
      }
    },
