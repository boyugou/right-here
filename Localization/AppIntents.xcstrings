    "intent.startAgent.description": {
      "comment": "Description of that action.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يشغّل وكيل ذكاء اصطناعي في مجلد، في تطبيق الوحدة الطرفية لديك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনার টার্মিনাল অ্যাপে একটি ফোল্ডারে AI এজেন্ট শুরু করে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Startet einen KI-Agenten in einem Ordner, in deiner Terminal-App."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ξεκινά έναν πράκτορα AI σε έναν φάκελο, στην εφαρμογή τερματικού σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts an AI agent in a folder, in your terminal app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inicia un agente de IA en una carpeta, en tu app de terminal."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "یک عامل هوش مصنوعی را در یک پوشه، در برنامهٔ ترمینال شما شروع می‌کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Démarre un agent IA dans un dossier, dans votre app de terminal."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "מפעיל סוכן AI בתיקיה, ביישום המסוף שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपके टर्मिनल ऐप में किसी फ़ोल्डर में AI एजेंट शुरू करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Memulai agen AI di sebuah folder, di app terminal Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Avvia un agente IA in una cartella, nella tua app di terminale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ターミナルアプリでフォルダ内にAIエージェントを起動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "폴더에서 터미널 앱으로 AI 에이전트를 시작합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुमच्या टर्मिनल ॲपमध्ये एका फोल्डरमध्ये AI एजंट सुरू करते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Memulakan ejen AI dalam folder, dalam aplikasi terminal anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Start een AI-agent in een map, in je terminalapp."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uruchamia agenta AI w folderze, w aplikacji terminala."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inicia um agente de IA em uma pasta, no seu app de terminal."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pornește un agent AI într-un dosar, în aplicația dvs. de terminal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Запустить ИИ-агента в папке через приложение терминала."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "உங்கள் டெர்மினல் செயலியில் ஒரு கோப்புறையில் AI முகவரைத் தொடங்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "needs_review",
            "value": "మీ టెర్మినల్ యాప్‌లో ఒక ఫోల్డర్‌లో AI ఏజెంట్‌ను ప్రారంభిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เริ่มเอเจนต์ AI ในโฟลเดอร์ ผ่านแอปเทอร์มินัลของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terminal uygulamanızda bir klasörde YZ ajanı başlatır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Запускає ШІ-агента в папці у вашому терміналі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "آپ کی ٹرمینل ایپ کے ذریعے کسی فولڈر میں AI ایجنٹ شروع کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Khởi chạy tác tử AI trong một thư mục, trong ứng dụng terminal của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在终端 App 中于文件夹内启动 AI 智能体。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在終端機 App 中於檔案夾內啟動 AI 代理程式。"
          }
        }
      }
    },
