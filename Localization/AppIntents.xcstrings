    "intent.openTerminal.description": {
      "comment": "Description of that action.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يفتح مجلدًا في تطبيق الوحدة الطرفية لديك."
          }
        },
