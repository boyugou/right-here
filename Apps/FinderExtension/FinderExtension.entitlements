<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- A Finder extension must be sandboxed. -->
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <!-- Read-only access to the config folder, so the menu follows the config file with no
       helper process running. Everything that needs more is done by rh, outside the sandbox,
       through the runner script in Application Scripts. -->
  <key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
  <array>
    <string>/.config/right-here/</string>
  </array>
</dict>
</plist>
