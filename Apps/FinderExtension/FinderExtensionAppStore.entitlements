<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- A Finder extension must be sandboxed -->
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <!-- Shared App Group for config and state sharing with main app without temporary exceptions -->
  <key>com.apple.security.application-groups</key>
  <array>
    <string>group.com.boyugou.righthere</string>
  </array>
  <!-- Apple events for terminal control prompts -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
