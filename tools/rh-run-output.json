  "preset.review": {
    "summary": "Run claude with preset review in Sources with Ghostty",
    "steps": [
      {
        "kind": "appleScript",
        "app": "Ghostty",
        "types": "claude 'Review @main.swift for bugs, unclear code and risky changes. Do not modify any files; reply with your findings, most serious first.'"
      }
    ]
  },
  "preset.explain": {
    "summary": "Run claude with preset explain in Sources with Ghostty",
    "steps": [
      {
        "kind": "appleScript",
        "app": "Ghostty",
        "types": "claude 'Explain what @main.swift does and how it fits into the rest of Sources. Do not modify any files.'"
      }
    ]
  },
  "preset.tests": {
    "summary": "Run claude with preset tests in Sources with Ghostty",
    "steps": [
      {
        "kind": "appleScript",
        "app": "Ghostty",
        "types": "claude 'Read @main.swift and propose a test plan: the behaviors and edge cases that need tests, and where the tests would live. Write the plan only; do not create or modify any files.'"
      }
    ]
  },
